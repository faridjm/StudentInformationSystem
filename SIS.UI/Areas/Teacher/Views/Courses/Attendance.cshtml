@{
    ViewData["Title"] = "Davamiyyət";
    var offering = ViewBag.Offering as SIS.BLL.Services.DTOs.CourseOffering.CourseOfferingDetailDto;
    var enrollments = ViewBag.Enrollments as IEnumerable<SIS.BLL.Services.DTOs.Enrollment.EnrollmentListDto>;
}

<div style="display:flex; align-items:center; gap:12px; margin-bottom:20px;">
    <a href="/Teacher/Courses/Detail/@offering?.Id" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left"></i></a>
    <div>
        <h2 style="font-size:20px; font-weight:700;">Davamiyyət — @offering?.CourseName</h2>
        <p style="color:var(--text-secondary); font-size:13px;">@offering?.TermName</p>
    </div>
</div>

<div class="card">
    <div class="card-header">Davamiyyət Qeydiyyatı</div>
    <div class="card-body">
        <form method="post" action="/Teacher/Courses/RecordAttendance">
            @Html.AntiForgeryToken()
            <input type="hidden" name="courseOfferingId" value="@offering?.Id" />

            <div class="form-group" style="max-width:200px; margin-bottom:20px;">
                <label class="form-label">Tarix</label>
                <input type="date" name="sessionDate" class="form-control" value="@ViewBag.Today" />
            </div>

            <table class="table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Tələbə</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (enrollments != null)
                    {
                        int i = 1;
                        @foreach (var e in enrollments)
                        {
                            <input type="hidden" name="enrollmentIds" value="@e.Id" />
                            <tr>
                                <td>@i</td>
                                <td style="font-weight:500;">@e.StudentName</td>
                                <td>
                                    <select name="statuses" class="form-control" style="width:150px;">
                                        <option value="0">✅ İştirak etdi</option>
                                        <option value="1">❌ Qayıb</option>
                                        <option value="2">⚠️ Gecikdi</option>
                                    </select>
                                </td>
                            </tr>
                            i++;
                        }
                    }
                </tbody>
            </table>

            <div style="margin-top:16px;">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> Davamiyyəti Saxla
                </button>
            </div>
        </form>
    </div>
</div>