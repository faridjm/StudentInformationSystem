@using SIS.Entities.Enums
@{
    ViewData["Title"] = "Davamiyyət";
    var offering = ViewBag.Offering as SIS.BLL.Services.DTOs.CourseOffering.CourseOfferingDetailDto;
    var enrollments = ViewBag.Enrollments as List<SIS.BLL.Services.DTOs.Enrollment.EnrollmentListDto> ?? new();
    var sessions = ViewBag.Sessions as List<SIS.BLL.Services.DTOs.ClassSession.ClassSessionDto> ?? new();
    var selected = ViewBag.SelectedSession as SIS.BLL.Services.DTOs.ClassSession.ClassSessionDto;
    var existing = ViewBag.ExistingStatuses as Dictionary<int, AttendanceStatus> ?? new();

    string[] azDayNames = { "Bazar", "B.e.", "Ç.a.", "Çər.", "C.a.", "Cüm.", "Şən." };
}

<div style="display:flex; align-items:center; gap:12px; margin-bottom:20px;">
    <a href="/Teacher/Courses/Detail/@offering?.Id" class="btn btn-secondary btn-sm">
        <i class="fas fa-arrow-left"></i>
    </a>
    <div>
        <h2 style="font-size:20px; font-weight:700;">Davamiyyət — @offering?.CourseName</h2>
        <p style="color:var(--text-secondary); font-size:13px;">@offering?.TermName</p>
    </div>
</div>

@if (sessions.Count == 0)
{
    <div class="card">
        <div class="card-body" style="text-align:center; color:var(--text-secondary); padding:40px;">
            <i class="fas fa-calendar-times" style="font-size:32px; margin-bottom:12px; display:block;"></i>
            Heç bir dərs sessiyası yoxdur.<br />
            <small>Admin əvvəl cədvəl qurub sessiyaları yaratmalıdır.</small>
        </div>
    </div>
}
else
{
    <div style="display:grid; grid-template-columns:300px 1fr; gap:16px;">
        <!-- Sessiya siyahısı (sol panel) -->
        <div class="card" style="height:fit-content; max-height:80vh; overflow-y:auto;">
            <div class="card-header">
                <span>Dərs Sessiyaları</span>
                <span style="font-size:11px; color:var(--text-secondary);">@sessions.Count</span>
            </div>
            <div style="padding:8px;">
                @foreach (var s in sessions)
                {
                    var isSelected = selected != null && s.Id == selected.Id;
                    var bg = isSelected ? "rgba(59,130,246,0.15)" : "transparent";
                    var border = isSelected ? "1px solid var(--accent)" : "1px solid transparent";

                    <a href="?sessionId=@s.Id"
                       style="display:block; padding:10px; border-radius:8px; background:@bg; border:@border; text-decoration:none; color:inherit; margin-bottom:4px;">
                        <div style="display:flex; justify-content:space-between; align-items:start;">
                            <div>
                                <div style="font-weight:600; font-size:13px;">@s.Date.ToString("dd.MM.yyyy") (@azDayNames[(int)s.Date.DayOfWeek])</div>
                                <div style="font-size:11px; color:var(--text-secondary);">
                                    @s.StartTime.ToString("HH:mm") – @s.EndTime.ToString("HH:mm") @(s.Room != null ? "• " + s.Room : "")
                                </div>
                                @if (!string.IsNullOrEmpty(s.Topic))
                                {
                                    <div style="font-size:11px; color:var(--text-secondary); margin-top:2px;">@s.Topic</div>
                                }
                            </div>
                            <span style="font-size:10px;">
                                @switch (s.Status)
                                {
                                    case ClassSessionStatus.Scheduled:
                                        <span class="badge badge-info">Plan</span>
                                        break;
                                    case ClassSessionStatus.Completed:
                                        <span class="badge badge-success">✓</span>
                                        break;
                                    case ClassSessionStatus.Cancelled:
                                        <span class="badge badge-danger">Ləğv</span>
                                        break;
                                    case ClassSessionStatus.Makeup:
                                        <span class="badge badge-warning">M</span>
                                        break;
                                }
                            </span>
                        </div>
                    </a>
                }
            </div>
        </div>

        <!-- Davamiyyət forması (sağ panel) -->
        <div>
            @if (selected == null)
            {
                <div class="card">
                    <div class="card-body" style="text-align:center; color:var(--text-secondary); padding:40px;">
                        <i class="fas fa-hand-pointer" style="font-size:32px; margin-bottom:12px; display:block;"></i>
                        Sol siyahıdan bir sessiya seçin
                    </div>
                </div>
            }
            else if (selected.Status == ClassSessionStatus.Cancelled)
            {
                <div class="card">
                    <div class="card-header">
                        @selected.Date.ToString("dd.MM.yyyy") — @selected.StartTime.ToString("HH:mm")
                    </div>
                    <div class="card-body" style="text-align:center; color:var(--text-secondary); padding:40px;">
                        <i class="fas fa-ban" style="font-size:32px; margin-bottom:12px; display:block; color:#ef4444;"></i>
                        Bu sessiya ləğv olunub.<br />
                        @if (!string.IsNullOrEmpty(selected.CancellationReason))
                        {
                            <small>Səbəb: @selected.CancellationReason</small>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="card">
                    <div class="card-header">
                        <div>
                            <strong>@selected.Date.ToString("dd.MM.yyyy") (@azDayNames[(int)selected.Date.DayOfWeek])</strong>
                            <span style="color:var(--text-secondary); margin-left:8px; font-weight:normal; font-size:13px;">
                                @selected.StartTime.ToString("HH:mm") – @selected.EndTime.ToString("HH:mm")
                                @(selected.Room != null ? "• " + selected.Room : "")
                            </span>
                        </div>
                        <span style="font-size:12px; color:var(--text-secondary);">@enrollments.Count tələbə</span>
                    </div>
                    <div class="card-body">
                        <form method="post" action="/Teacher/Courses/RecordAttendance">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="courseOfferingId" value="@offering?.Id" />
                            <input type="hidden" name="sessionId" value="@selected.Id" />

                            @if (!string.IsNullOrEmpty(selected.Topic))
                            {
                                <div style="background:rgba(59,130,246,0.1); padding:10px 14px; border-radius:8px; margin-bottom:14px; font-size:13px;">
                                    <i class="fas fa-bookmark"></i> <strong>Mövzu:</strong> @selected.Topic
                                </div>
                            }

                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Tələbə</th>
                                        <th style="width:200px;">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ int i = 1; }
                                    @foreach (var e in enrollments)
                                    {
                                        var current = existing.ContainsKey(e.Id) ? existing[e.Id] : AttendanceStatus.Present;
                                        <tr>
                                            <td>
                                                <input type="hidden" name="enrollmentIds" value="@e.Id" />
                                                @i
                                            </td>
                                            <td style="font-weight:500;">@e.StudentName</td>
                                            <td>
                                                <select name="statuses" class="form-control" style="width:170px;">
                                                    <option value="0" @(current == AttendanceStatus.Present ? "selected" : "")>✅ İştirak etdi</option>
                                                    <option value="1" @(current == AttendanceStatus.Absent ? "selected" : "")>❌ Qayıb</option>
                                                    <option value="2" @(current == AttendanceStatus.Late ? "selected" : "")>⚠️ Gecikdi</option>
                                                </select>
                                            </td>
                                        </tr>
                                        i++;
                                    }
                                </tbody>
                            </table>

                            <div style="margin-top:16px;">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-save"></i> Davamiyyəti Saxla
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
}
