@model IEnumerable<SIS.BLL.Services.DTOs.CourseOffering.CourseOfferingListDto>

@{
    ViewData["Title"] = "Kurslarım";
}

<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
    <h2 style="font-size:20px; font-weight:700;">Kurslarım</h2>
</div>

<div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(320px,1fr)); gap:16px;">
    @foreach (var o in Model)
    {
        <div class="card">
            <div class="card-header">
                <div>
                    <div style="font-weight:700;">@o.CourseName</div>
                    <div style="font-size:12px; color:var(--text-secondary);">@o.CourseCode • @o.TermName</div>
                </div>
                <span class="badge badge-info">@o.EnrolledCount / @o.Capacity</span>
            </div>
            <div class="card-body">
                <div style="color:var(--text-secondary); font-size:13px; margin-bottom:16px;">
                    <i class="fas fa-door-open"></i> @(o.Room ?? "Otaq təyin edilməyib")
                </div>
                <div style="display:flex; gap:8px; flex-wrap:wrap;">
                    <a href="/Teacher/Courses/Detail/@o.Id" class="btn btn-secondary btn-sm">
                        <i class="fas fa-users"></i> Tələbələr
                    </a>
                    <a href="/Teacher/Schedule/Sessions/@o.Id" class="btn btn-secondary btn-sm">
                        <i class="fas fa-calendar-day"></i> Dərslər
                    </a>
                    <a href="/Teacher/Courses/Grades/@o.Id" class="btn btn-primary btn-sm">
                        <i class="fas fa-star"></i> Qiymətlər
                    </a>
                    <a href="/Teacher/Courses/Attendance/@o.Id" class="btn btn-success btn-sm">
                        <i class="fas fa-clipboard-check"></i> Davamiyyət
                    </a>
                </div>
            </div>
        </div>
    }
</div>