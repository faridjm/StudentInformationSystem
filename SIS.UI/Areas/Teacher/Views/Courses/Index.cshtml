@model IEnumerable<SIS.BLL.Services.DTOs.Groups.GroupListDto>
@{
    ViewData["Title"] = L["MyGroups"].Value;
}
<h2 style="font-size:20px; font-weight:700; margin-bottom:20px;">@L["MyGroups"]</h2>
<div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(300px, 1fr)); gap:16px;">
    @foreach (var g in Model)
    {
        <a href="/Teacher/Courses/Detail/@g.Id" style="text-decoration:none;">
            <div class="card" style="padding:20px; cursor:pointer; transition:border-color 0.2s;" onmouseover="this.style.borderColor='var(--accent)'" onmouseout="this.style.borderColor='var(--border)'">
                <div style="font-size:16px; font-weight:700; margin-bottom:4px;">@g.Name</div>
                <div style="font-size:13px; color:var(--text-secondary); margin-bottom:12px;">@g.CourseName</div>
                <div style="font-size:12px; color:var(--text-secondary); margin-bottom:12px;">
                    @g.StartDate.ToString("dd.MM.yyyy") — @g.EndDate.ToString("dd.MM.yyyy")
                </div>
                <div style="font-size:13px; color:var(--text-secondary);">
                    <i class="fas fa-users"></i> @g.EnrolledCount / @g.Capacity @L["Student"]
                </div>
            </div>
        </a>
    }
    @if (!Model.Any())
    {
        <p style="color:var(--text-secondary);">Sizə qrup təyin edilməyib</p>
    }
</div>
