@model SIS.BLL.Services.DTOs.Groups.GroupDetailDto
@using SIS.Entities.Enums
@using SIS.BLL.Services.DTOs.ClassSession
@using SIS.BLL.Services.DTOs.Assessment
@using SIS.BLL.Services.DTOs.Enrollment
@using SIS.BLL.Services.DTOs.Assignment
@using SIS.BLL.Services.DTOs.Announcement
@using SIS.BLL.Services.DTOs.Attendance
@using SIS.BLL.Services.DTOs.OnlineLesson
@using SIS.UI.Helpers
@{
    ViewData["Title"] = Model.Name;
    var enrollments = ViewBag.Enrollments as List<EnrollmentListDto> ?? new();
    var sessions = ViewBag.Sessions as List<ClassSessionDto> ?? new();
    var assessments = ViewBag.Assessments as List<AssessmentItemDto> ?? new();
    var announcements = ViewBag.Announcements as List<AnnouncementDto> ?? new();
    var assignments = ViewBag.Assignments as List<AssignmentDto> ?? new();
    var summaries = ViewBag.AttendanceSummaries as Dictionary<int, AttendanceSummaryDto> ?? new();
    var transcripts = ViewBag.Transcripts as Dictionary<int, SIS.BLL.Services.DTOs.Transcript.TranscriptDto> ?? new();
    var attPerSession = ViewBag.AttendancePerSession as Dictionary<int, List<AttendanceDto>> ?? new();
    var onlineLessons = ViewBag.OnlineLessons as Dictionary<int, OnlineLessonDto> ?? new();
    var joinedByLesson = ViewBag.JoinedStudentsByLesson as Dictionary<int, HashSet<int>> ?? new();
    var today = (DateOnly)ViewBag.Today;
    var activeTab = (string)ViewBag.ActiveTab ?? "overview";

    var completedSessions = sessions.Count(s => s.Status == ClassSessionStatus.Completed);
    var totalSessions = sessions.Count;
    var progressPct = totalSessions > 0 ? (int)((double)completedSessions / totalSessions * 100) : 0;
}

<style>
    .tabs { display:flex; gap:2px; border-bottom:2px solid var(--border); margin-bottom:20px; overflow-x:auto; }
    .tab { padding:10px 16px; font-size:13px; font-weight:500; color:var(--text-secondary); cursor:pointer;
           border-bottom:2px solid transparent; margin-bottom:-2px; white-space:nowrap; text-decoration:none; transition:all .15s; }
    .tab:hover { color:var(--text-primary); background:var(--bg-hover); border-radius:6px 6px 0 0; }
    .tab.active { color:var(--accent); border-bottom-color:var(--accent); font-weight:600; }
    .tab-content { display:none; }
    .tab-content.active { display:block; }
    .mini-table { width:100%; border-collapse:collapse; font-size:13px; }
    .mini-table th { color:var(--text-secondary); font-size:11px; font-weight:600; text-transform:uppercase;
                     letter-spacing:.5px; padding:8px 10px; border-bottom:1px solid var(--border); text-align:left; }
    .mini-table td { padding:8px 10px; border-bottom:1px solid var(--border); vertical-align:middle; }
    .mini-table tbody tr:hover { background:var(--bg-hover); }
    .progress-bar { height:6px; background:var(--bg-hover); border-radius:3px; overflow:hidden; }
    .progress-fill { height:100%; border-radius:3px; transition:width .3s; }
    .toast-msg { position:fixed; top:80px; right:24px; z-index:9999; padding:14px 24px; border-radius:10px;
                 font-size:14px; font-weight:500; display:flex; align-items:center; gap:10px;
                 box-shadow:0 8px 24px rgba(0,0,0,0.3); animation:slideIn .3s ease-out; }
    .toast-success { background:#16a34a; color:#fff; }
    .toast-error { background:#dc2626; color:#fff; }
    @@keyframes slideIn { from { transform:translateX(100%); opacity:0; } to { transform:translateX(0); opacity:1; } }
    @@keyframes slideOut { from { opacity:1; } to { transform:translateX(100%); opacity:0; } }
</style>

<!-- Header -->
<div style="display:flex; align-items:center; gap:14px; margin-bottom:20px;">
    <a href="/Teacher/Courses" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left"></i></a>
    <div style="flex:1;">
        <h2 style="font-size:20px; font-weight:700; margin:0;">@Model.Name</h2>
        <div style="font-size:13px; color:var(--text-secondary); margin-top:2px;">
            @Model.CourseName · @Model.TeacherName
        </div>
    </div>
    <div style="text-align:right; font-size:12px; color:var(--text-secondary);">
        <div>@Model.StartDate.ToString("dd.MM.yyyy") — @Model.EndDate.ToString("dd.MM.yyyy")</div>
        <div style="margin-top:4px;">
            <span style="font-weight:600; color:var(--text-primary);">@enrollments.Count(e => e.Status == EnrollmentStatus.Active)</span> / @Model.Capacity @L["Student"]
        </div>
    </div>
</div>

<!-- Progress -->
<div class="card" style="padding:14px 20px; margin-bottom:16px; display:flex; align-items:center; gap:16px;">
    <div style="font-size:12px; color:var(--text-secondary); white-space:nowrap;">
        @L["ClassSessions"]: <strong style="color:var(--text-primary);">@completedSessions / @totalSessions</strong>
    </div>
    <div class="progress-bar" style="flex:1;">
        <div class="progress-fill" style="width:@(progressPct)%; background:var(--accent);"></div>
    </div>
    <div style="font-size:13px; font-weight:700; color:var(--accent);">@progressPct%</div>
</div>

<!-- Tabs -->
<div class="tabs">
    <a class="tab @(activeTab == "overview" ? "active" : "")" onclick="switchTab('overview')"><i class="fas fa-chart-pie" style="margin-right:6px;"></i>@L["Dashboard"]</a>
    <a class="tab @(activeTab == "schedule" ? "active" : "")" onclick="switchTab('schedule')"><i class="fas fa-calendar-alt" style="margin-right:6px;"></i>@L["Schedule"]</a>
    <a class="tab @(activeTab == "assessments" ? "active" : "")" onclick="switchTab('assessments')"><i class="fas fa-tasks" style="margin-right:6px;"></i>@L["Assessment"]</a>
    <a class="tab @(activeTab == "attendance" ? "active" : "")" onclick="switchTab('attendance')"><i class="fas fa-user-check" style="margin-right:6px;"></i>@L["Attendance"]</a>
    <a class="tab @(activeTab == "students" ? "active" : "")" onclick="switchTab('students')"><i class="fas fa-users" style="margin-right:6px;"></i>@L["Students"]</a>
    <a class="tab @(activeTab == "assignments" ? "active" : "")" onclick="switchTab('assignments')"><i class="fas fa-file-alt" style="margin-right:6px;"></i>@L["Assignments"]</a>
    <a class="tab @(activeTab == "materials" ? "active" : "")" onclick="switchTab('materials')"><i class="fas fa-folder-open" style="margin-right:6px;"></i>Materiallar</a>
    <a class="tab @(activeTab == "announcements" ? "active" : "")" onclick="switchTab('announcements')"><i class="fas fa-bullhorn" style="margin-right:6px;"></i>@L["Announcements"]</a>
</div>

<!-- ==================== TAB 1: Ümumi Baxış ==================== -->
<div id="tab-overview" class="tab-content @(activeTab == "overview" ? "active" : "")">
    <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:12px; margin-bottom:20px;">
        <div class="stat-card">
            <div class="stat-icon" style="background:rgba(59,130,246,0.15); color:#3b82f6;"><i class="fas fa-users"></i></div>
            <div><div class="stat-value">@enrollments.Count(e => e.Status == EnrollmentStatus.Active)</div><div class="stat-label">@L["Student"]</div></div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background:rgba(34,197,94,0.15); color:#22c55e;"><i class="fas fa-chalkboard"></i></div>
            <div><div class="stat-value">@completedSessions / @totalSessions</div><div class="stat-label">@L["ClassSessions"]</div></div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background:rgba(234,179,8,0.15); color:#eab308;"><i class="fas fa-clipboard-check"></i></div>
            <div><div class="stat-value">@assessments.Count</div><div class="stat-label">@L["Assessment"]</div></div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background:rgba(168,85,247,0.15); color:#a855f7;"><i class="fas fa-file-alt"></i></div>
            <div><div class="stat-value">@assignments.Count</div><div class="stat-label">@L["Assignments"]</div></div>
        </div>
    </div>

    @if (Model.ScheduleDays.Any())
    {
        <div style="margin-bottom:16px;">
            <div style="font-size:13px; font-weight:600; margin-bottom:8px; color:var(--text-secondary);">@L["Schedule"]</div>
            <div style="display:flex; gap:8px; flex-wrap:wrap;">
                @foreach (var d in Model.ScheduleDays.OrderBy(x => x.DayOfWeek))
                {
                    var dayName = d.DayOfWeek switch { DayOfWeek.Monday => "B.e", DayOfWeek.Tuesday => "Ç.a", DayOfWeek.Wednesday => "Ç", DayOfWeek.Thursday => "C.a", DayOfWeek.Friday => "C", DayOfWeek.Saturday => "Ş", _ => "B" };
                    <div style="background:var(--accent-soft); border:1px solid rgba(59,130,246,0.3); border-radius:8px; padding:8px 14px; text-align:center;">
                        <div style="font-weight:700; color:var(--accent); font-size:12px;">@dayName</div>
                        <div style="font-size:11px; color:var(--text-secondary); margin-top:2px;">@d.StartTime–@d.EndTime</div>
                    </div>
                }
            </div>
        </div>
    }

    @{
        var todaySession = sessions.FirstOrDefault(s => s.Date == today);
    }
    @if (todaySession != null)
    {
        <div class="card" style="border-left:3px solid var(--accent); padding:16px 20px; display:flex; justify-content:space-between; align-items:center;">
            <div>
                <div style="font-size:12px; font-weight:600; color:var(--accent); margin-bottom:4px;">
                    <i class="fas fa-calendar-day"></i> @L["TodaysLessons"] — #@todaySession.SessionNumber
                </div>
                <div style="font-size:14px; font-weight:500;">
                    @(string.IsNullOrEmpty(todaySession.Topic) ? L["NoData"].Value : todaySession.Topic)
                </div>
                <div style="font-size:12px; color:var(--text-secondary); margin-top:4px;">@todaySession.StartTime — @todaySession.EndTime</div>
            </div>
            @if (todaySession.Status != ClassSessionStatus.Completed)
            {
                <form method="post" action="/Teacher/Courses/CompleteSession" style="margin:0;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="groupId" value="@Model.Id" />
                    <input type="hidden" name="sessionId" value="@todaySession.Id" />
                    <button type="submit" class="btn btn-success btn-sm"><i class="fas fa-check-circle"></i> @L["Save"]</button>
                </form>
            }
            else
            {
                <span class="badge badge-success"><i class="fas fa-check"></i> @L["Save"]</span>
            }
        </div>
    }

    @if (announcements.Any())
    {
        <div style="margin-top:16px;">
            <div style="font-size:13px; font-weight:600; margin-bottom:8px; color:var(--text-secondary);">@L["Announcements"]</div>
            @foreach (var a in announcements.Take(3))
            {
                <div style="padding:10px 14px; background:var(--bg-card); border:1px solid var(--border); border-radius:8px; margin-bottom:6px;">
                    <div style="display:flex; justify-content:space-between;">
                        <strong style="font-size:13px;">@a.Title</strong>
                        <span style="font-size:11px; color:var(--text-secondary);">@a.CreatedAt.ToString("dd.MM")</span>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- ==================== TAB 2: Dərs Cədvəli ==================== -->
<div id="tab-schedule" class="tab-content @(activeTab == "schedule" ? "active" : "")">
    <div class="card">
        <div class="card-body" style="padding:0;">
            <table class="mini-table">
                <thead>
                    <tr><th>#</th><th>@L["Date"]</th><th></th><th></th><th>@L["TodaysTopic"]</th><th>@L["Status"]</th><th>Online dərs</th><th>@L["Score"]</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var s in sessions)
                    {
                        var isToday = s.Date == today;
                        var isPast = s.Date < today;
                        var rowStyle = isToday ? "background:rgba(59,130,246,0.08);" : isPast && s.Status != ClassSessionStatus.Completed ? "opacity:0.6;" : "";
                        var dayName = s.Date.DayOfWeek switch { DayOfWeek.Monday => "B.e", DayOfWeek.Tuesday => "Ç.a", DayOfWeek.Wednesday => "Çər", DayOfWeek.Thursday => "C.a", DayOfWeek.Friday => "Fri", DayOfWeek.Saturday => "Şnb", _ => "Baz" };
                        var aOnDate = assessments.Where(a => DateOnly.FromDateTime(a.Date) == s.Date).ToList();
                        <tr style="@rowStyle">
                            <td style="color:var(--text-secondary);">@s.SessionNumber</td>
                            <td>
                                @s.Date.ToString("dd.MM.yy")
                                @if (isToday) { <span style="font-size:9px; background:#3b82f6; color:#fff; padding:1px 5px; border-radius:3px; margin-left:4px;">@L["Today"]</span> }
                            </td>
                            <td style="color:var(--text-secondary);">@dayName</td>
                            <td style="color:var(--text-secondary);">@s.StartTime–@s.EndTime</td>
                            <td>@(string.IsNullOrEmpty(s.Topic) ? "—" : s.Topic)</td>
                            <td>
                                @if (s.Status == ClassSessionStatus.Completed) { <span class="badge badge-success">@L["Active"]</span> }
                                else if (s.Status == ClassSessionStatus.Cancelled) { <span class="badge badge-danger">@L["Cancel"]</span> }
                                else if (isToday) { <span class="badge badge-info">@L["Today"]</span> }
                                else { <span class="badge badge-warning">@L["NoData"]</span> }
                            </td>
                            <td>
                                @{ onlineLessons.TryGetValue(s.Id, out var ol); }
                                @if (Model.DeliveryMode != DeliveryMode.InPerson)
                                {
                                    @OnlineLessonBadges.DeliveryBadge(Model.DeliveryMode)
                                }
                                @if (ol != null)
                                {
                                    <div style="margin:4px 0;">@OnlineLessonBadges.StatusBadge(ol.Status)</div>
                                    @if (ol.Status == OnlineLessonStatus.Live)
                                    {
                                        <div style="font-size:10px; color:var(--text-secondary); margin-bottom:4px;">
                                            <i class="fas fa-user-check"></i> @ol.ParticipantCount qoşuldu
                                        </div>
                                        <div style="display:flex; gap:4px; flex-wrap:wrap;">
                                            <a href="/Teacher/OnlineLessons/Classroom/@ol.Id" class="btn btn-sm btn-primary" style="padding:2px 8px; font-size:11px;"><i class="fas fa-video"></i> Classroom</a>
                                            <form method="post" action="/Teacher/Courses/EndOnlineLesson" style="margin:0;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="groupId" value="@Model.Id" />
                                                <input type="hidden" name="id" value="@ol.Id" />
                                                <button type="submit" class="btn btn-sm btn-secondary" style="padding:2px 8px; font-size:11px;"><i class="fas fa-stop"></i> Bitir</button>
                                            </form>
                                        </div>
                                    }
                                    else if (ol.Status == OnlineLessonStatus.Scheduled)
                                    {
                                        <div style="display:flex; gap:4px; flex-wrap:wrap;">
                                            <form method="post" action="/Teacher/Courses/StartOnlineLesson" style="margin:0;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="groupId" value="@Model.Id" />
                                                <input type="hidden" name="sessionId" value="@s.Id" />
                                                <button type="submit" class="btn btn-sm btn-success" style="padding:2px 8px; font-size:11px;"><i class="fas fa-play"></i> Başlat</button>
                                            </form>
                                            <button type="button" class="btn btn-sm btn-secondary" style="padding:2px 8px; font-size:11px;"
                                                    onclick="openEditOL(@ol.Id, '@Html.Raw(ol.Title?.Replace("'","\\'"))', '@Html.Raw(ol.Description?.Replace("'","\\'"))')"><i class="fas fa-pen"></i></button>
                                            <form method="post" action="/Teacher/Courses/CancelOnlineLesson" style="margin:0;" onsubmit="return confirm('Online dərsi ləğv et?')">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="groupId" value="@Model.Id" />
                                                <input type="hidden" name="id" value="@ol.Id" />
                                                <button type="submit" class="btn btn-sm btn-danger" style="padding:2px 8px; font-size:11px;"><i class="fas fa-times"></i></button>
                                            </form>
                                        </div>
                                    }
                                }
                                else if (s.Status != ClassSessionStatus.Cancelled)
                                {
                                    <div style="display:flex; gap:4px;">
                                        @if (Model.DeliveryMode != DeliveryMode.InPerson)
                                        {
                                            <form method="post" action="/Teacher/Courses/StartOnlineLesson" style="margin:0;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="groupId" value="@Model.Id" />
                                                <input type="hidden" name="sessionId" value="@s.Id" />
                                                <button type="submit" class="btn btn-sm btn-success" style="padding:2px 8px; font-size:11px;"><i class="fas fa-play"></i> Başlat</button>
                                            </form>
                                        }
                                        <button type="button" class="btn btn-sm btn-secondary" style="padding:2px 8px; font-size:11px;"
                                                onclick="openCreateOL(@s.Id, @s.SessionNumber)"><i class="fas fa-plus"></i> Online</button>
                                    </div>
                                }
                            </td>
                            <td>
                                @foreach (var a in aOnDate)
                                {
                                    var c = a.Type == AssessmentType.Quiz ? "#3b82f6" : a.Type == AssessmentType.FinalProject ? "#e94560" : "#eab308";
                                    var l = a.Type == AssessmentType.Quiz ? "Quiz" : a.Type == AssessmentType.FinalProject ? "Final" : "Tapş.";
                                    <span style="font-size:9px; background:@(c)22; color:@c; padding:1px 6px; border-radius:3px; font-weight:600;">@l</span>
                                }
                            </td>
                            <td>
                                @if ((isToday || isPast) && s.Status != ClassSessionStatus.Completed && s.Status != ClassSessionStatus.Cancelled)
                                {
                                    <form method="post" action="/Teacher/Courses/CompleteSession" style="margin:0; display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="groupId" value="@Model.Id" />
                                        <input type="hidden" name="sessionId" value="@s.Id" />
                                        <button type="submit" class="btn btn-success btn-sm" style="padding:2px 8px; font-size:11px;">
                                            <i class="fas fa-check"></i> @L["Save"]
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ==================== TAB 3: Qiymətləndirmə ==================== -->
<div id="tab-assessments" class="tab-content @(activeTab == "assessments" ? "active" : "")">
    <div class="card">
        <div class="card-body" style="padding:0;">
            <table class="mini-table">
                <thead>
                    <tr><th>@L["Type"]</th><th>@L["Title"]</th><th>@L["Date"]</th><th>@L["MaxScore"]</th><th>@L["Weight"]</th><th>@L["Grades"]</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var a in assessments)
                    {
                        var typeColor = a.Type == AssessmentType.Quiz ? "#3b82f6" : a.Type == AssessmentType.FinalProject ? "#e94560" : "#eab308";
                        var typeLabel = a.Type == AssessmentType.Quiz ? "Quiz" : a.Type == AssessmentType.FinalProject ? "Final" : L["AssessmentType_Assignment"].Value;
                        <tr>
                            <td><span style="font-size:10px; background:@(typeColor)22; color:@typeColor; padding:2px 7px; border-radius:4px; font-weight:600;">@typeLabel</span></td>
                            <td><strong>@a.Title</strong></td>
                            <td>@a.Date.ToString("dd.MM.yyyy")</td>
                            <td>@a.MaxScore</td>
                            <td>%@a.WeightPercent</td>
                            <td>
                                <span style="color:@(a.GradedCount == a.SubmissionCount && a.SubmissionCount > 0 ? "#22c55e" : "#eab308");">
                                    @a.GradedCount / @a.SubmissionCount
                                </span>
                            </td>
                            <td>
                                <a href="/Teacher/Assessments/Grade/@a.Id" class="btn btn-sm btn-primary" style="padding:4px 10px;">
                                    <i class="fas fa-pen"></i> @L["Assessment"]
                                </a>
                            </td>
                        </tr>
                    }
                    @if (!assessments.Any())
                    {
                        <tr><td colspan="7" style="text-align:center; color:var(--text-secondary); padding:24px;">@L["NoData"]</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ==================== TAB 4: Davamiyyət ==================== -->
<div id="tab-attendance" class="tab-content @(activeTab == "attendance" ? "active" : "")">
    @{
        var minSn = sessions.Any() ? sessions.Min(s => s.SessionNumber) : 1;
        var maxSn = sessions.Any() ? sessions.Max(s => s.SessionNumber) : 1;
    }

    <!-- Demo Quick Fill (kompakt — yalnız təqdimat/test) -->
    <div style="background:var(--bg-card); border:1px solid var(--border); border-radius:8px; padding:12px 14px; margin-bottom:14px;">
        <div style="display:flex; align-items:center; gap:8px; margin-bottom:8px;">
            <i class="fas fa-flask" style="color:#f59e0b; font-size:13px;"></i>
            <strong style="font-size:13px;">Demo Quick Fill</strong>
            <span style="background:#f59e0b; color:#fff; padding:1px 7px; border-radius:4px; font-size:9px; font-weight:700;">DEMO</span>
            <span style="font-size:11px; color:var(--text-secondary); margin-left:6px;">Yalnız təqdimat/test üçün — real davamiyyət üçün yuxarıdakı sessiya seçimini istifadə edin</span>
        </div>
        <form method="post" action="/Teacher/Courses/GenerateDemoAttendance" id="demoForm"
              style="display:grid; grid-template-columns:repeat(auto-fit, minmax(110px, auto)); gap:8px; align-items:end;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="groupId" value="@Model.Id" />
            <div>
                <label style="font-size:10px; color:var(--text-secondary); display:block; margin-bottom:2px;">Sessiya №-dan</label>
                <input type="number" name="fromSessionNumber" id="demoFrom" min="@minSn" max="@maxSn" value="@minSn" required
                       class="form-control" style="width:80px; padding:4px 8px; font-size:12px;" oninput="updateDemoEstimate()" />
            </div>
            <div>
                <label style="font-size:10px; color:var(--text-secondary); display:block; margin-bottom:2px;">-ə qədər</label>
                <input type="number" name="toSessionNumber" id="demoTo" min="@minSn" max="@maxSn" value="@maxSn" required
                       class="form-control" style="width:80px; padding:4px 8px; font-size:12px;" oninput="updateDemoEstimate()" />
            </div>
            <div>
                <label style="font-size:10px; color:var(--text-secondary); display:block; margin-bottom:2px;">Mode</label>
                <select name="mode" id="demoMode" class="form-control" style="width:140px; padding:4px 8px; font-size:12px;" onchange="toggleCustomCounts()">
                    <option value="RealisticDemo">Realistic Demo</option>
                    <option value="AllPresent">All Present</option>
                    <option value="CustomCounts">Custom Counts</option>
                </select>
            </div>
            <div style="display:flex; align-items:center; gap:5px;">
                <input type="checkbox" id="demoOverwrite" name="overwriteExisting" value="true" />
                <label for="demoOverwrite" style="font-size:11px; cursor:pointer; color:var(--text-secondary);">Overwrite</label>
            </div>
            <button type="button" onclick="openDemoConfirm()" class="btn" style="background:#f59e0b; color:#fff; padding:5px 12px; font-size:12px; font-weight:600;">
                <i class="fas fa-magic-wand-sparkles"></i> Apply Demo Fill
            </button>
        </form>
        <!-- Custom Counts inputs — yalnız mode = CustomCounts olduqda görünür -->
        <div id="customCountsBox" style="display:none; margin-top:10px; padding:10px; background:var(--bg-hover); border-radius:6px;">
            <div style="display:grid; grid-template-columns:repeat(4, 1fr) auto; gap:8px; align-items:end;">
                <div>
                    <label style="font-size:10px; color:var(--text-secondary); display:block; margin-bottom:2px;">Present</label>
                    <input type="number" name="presentCount" id="cntPresent" min="0" form="demoForm"
                           class="form-control" style="padding:4px 8px; font-size:12px;" oninput="updateDemoEstimate()" />
                </div>
                <div>
                    <label style="font-size:10px; color:var(--text-secondary); display:block; margin-bottom:2px;">Absent</label>
                    <input type="number" name="absentCount" id="cntAbsent" min="0" form="demoForm"
                           class="form-control" style="padding:4px 8px; font-size:12px;" oninput="updateDemoEstimate()" />
                </div>
                <div>
                    <label style="font-size:10px; color:var(--text-secondary); display:block; margin-bottom:2px;">Late</label>
                    <input type="number" name="lateCount" id="cntLate" min="0" form="demoForm"
                           class="form-control" style="padding:4px 8px; font-size:12px;" oninput="updateDemoEstimate()" />
                </div>
                <div>
                    <label style="font-size:10px; color:var(--text-secondary); display:block; margin-bottom:2px;">Excused</label>
                    <input type="number" name="excusedCount" id="cntExcused" min="0" form="demoForm"
                           class="form-control" style="padding:4px 8px; font-size:12px;" oninput="updateDemoEstimate()" />
                </div>
            </div>
            <div id="demoEstimate" style="margin-top:8px; font-size:11px; color:var(--text-secondary);"></div>
        </div>
    </div>

    <!-- Generation summary (yalnız demo-dan sonra) -->
    @if (TempData["DemoCreated"] != null)
    {
        var dCreated = (int)TempData["DemoCreated"]!;
        var dUpdated = (int)(TempData["DemoUpdated"] ?? 0);
        var dSkipped = (int)(TempData["DemoSkipped"] ?? 0);
        var dMode = (string)(TempData["DemoMode"] ?? "");
        var dPattern = (string?)TempData["DemoPattern"];
        <div style="background:rgba(34,197,94,0.08); border:1px solid rgba(34,197,94,0.3); border-left:3px solid #22c55e; border-radius:6px; padding:10px 14px; margin-bottom:14px; font-size:13px;">
            <i class="fas fa-check-circle" style="color:#16a34a;"></i>
            <strong style="color:#15803d; margin-left:4px;">Demo davamiyyət tətbiq edildi</strong>
            <span style="margin-left:10px;">Created: <strong>@dCreated</strong> · Updated: <strong>@dUpdated</strong> · Skipped: <strong>@dSkipped</strong></span>
            @if (!string.IsNullOrEmpty(dPattern))
            {
                <div style="margin-top:4px; font-size:11px; color:var(--text-secondary);">Pattern: @dPattern</div>
            }
        </div>
    }

    <!-- Demo Confirmation Modal -->
    <div id="demoConfirmModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.6); z-index:1000; align-items:center; justify-content:center;">
        <div style="background:var(--bg-card); border-radius:12px; padding:24px; width:520px; border:1px solid var(--border); box-shadow:0 12px 40px rgba(0,0,0,0.3);">
            <div style="display:flex; align-items:center; gap:10px; margin-bottom:14px;">
                <i class="fas fa-flask" style="color:#f59e0b; font-size:22px;"></i>
                <h3 style="margin:0; font-size:16px;">Demo Quick Fill</h3>
                <span style="background:#f59e0b; color:#fff; padding:2px 8px; border-radius:4px; font-size:10px; font-weight:700; margin-left:auto;">DEMO</span>
            </div>
            <div style="background:#fffbeb; border:1px solid #fde68a; border-radius:8px; padding:12px 14px; margin-bottom:14px;">
                <div style="font-size:13px; color:#92400e; margin-bottom:6px;">
                    Bu əməliyyat seçilmiş aralıqda <strong>demo attendance yazıları</strong> yaradacaq.
                </div>
                <div id="demoConfirmRange" style="font-size:12px; color:#78350f;"></div>
            </div>
            <div style="font-size:12px; color:var(--text-secondary); margin-bottom:14px;">
                ⚠ Bu yalnız təqdimat və test üçündür. Yaradılan yazılar Attendance %, Student panel və Transkript PDF hesablamalarında istifadə olunacaq.
            </div>
            <div style="display:flex; gap:8px; justify-content:flex-end;">
                <button type="button" onclick="closeDemoConfirm()" class="btn btn-secondary">İmtina</button>
                <button type="button" onclick="document.getElementById('demoForm').submit()" class="btn" style="background:#f59e0b; color:#fff;">
                    <i class="fas fa-magic-wand-sparkles"></i> Bəli, tətbiq et
                </button>
            </div>
        </div>
    </div>

    @{
        var pastSessions = sessions.Where(s => s.Date <= today).OrderByDescending(s => s.Date).ToList();
        // Bu sessiya üçün assessment-ləri tapırıq
    }
    @if (pastSessions.Any())
    {
        <div style="margin-bottom:12px;">
            <label class="form-label">@L["ClassSessions"]:</label>
            <select id="sessionSelect" class="form-control" style="max-width:500px;" onchange="selectSession(this.value)">
                @foreach (var s in pastSessions)
                {
                    var hasAtt = attPerSession.ContainsKey(s.Id) && attPerSession[s.Id].Any();
                    var statusIcon = hasAtt ? "✅" : "⚠️";
                    var label = $"{statusIcon} #{s.SessionNumber} — {s.Date:dd.MM.yyyy} ({s.StartTime}–{s.EndTime})";
                    if (s.Date == today) { label += " ★ " + L["Today"].Value; }
                    if (!string.IsNullOrEmpty(s.Topic)) { label += $" · {s.Topic}"; }
                    <option value="@s.Id">@label</option>
                }
            </select>
        </div>

        @foreach (var s in pastSessions)
        {
            var existingAtt = attPerSession.ContainsKey(s.Id) ? attPerSession[s.Id] : new List<AttendanceDto>();
            var hasSavedAtt = existingAtt.Any();
            var sessionAssessments = assessments.Where(a => DateOnly.FromDateTime(a.Date) == s.Date).ToList();
            onlineLessons.TryGetValue(s.Id, out var attOl);
            var joinedSet = joinedByLesson.ContainsKey(s.Id) ? joinedByLesson[s.Id] : new HashSet<int>();

            <div class="attendance-panel" id="att-@s.Id" style="display:@(s.Id == pastSessions.First().Id ? "block" : "none");">
                <div class="card">
                    <div class="card-header">
                        <div>
                            <span>#@s.SessionNumber — @s.Date.ToString("dd.MM.yyyy")</span>
                            @if (!string.IsNullOrEmpty(s.Topic))
                            {
                                <span style="color:var(--text-secondary); font-size:12px; margin-left:8px;">@s.Topic</span>
                            }
                            @if (hasSavedAtt)
                            {
                                <span class="badge badge-success" style="margin-left:8px;"><i class="fas fa-check"></i> Qeyd olunub</span>
                            }
                        </div>
                        @if (s.Status != ClassSessionStatus.Completed && (s.Date == today || s.Date < today))
                        {
                            <form method="post" action="/Teacher/Courses/CompleteSession" style="margin:0;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="groupId" value="@Model.Id" />
                                <input type="hidden" name="sessionId" value="@s.Id" />
                                <button type="submit" class="btn btn-success btn-sm" style="padding:3px 10px;">
                                    <i class="fas fa-check-circle"></i> @L["Save"]
                                </button>
                            </form>
                        }
                        else if (s.Status == ClassSessionStatus.Completed)
                        {
                            <span class="badge badge-success">@L["Active"]</span>
                        }
                    </div>
                    <div class="card-body">
                        @if (attOl != null)
                        {
                            <form method="post" action="/Teacher/Courses/MarkOnlinePresent" id="markPresentForm-@s.Id" style="margin:0;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="groupId" value="@Model.Id" />
                                <input type="hidden" name="id" value="@attOl.Id" />
                            </form>
                        }
                        <form method="post" action="/Teacher/Courses/SaveAttendance" id="attForm-@s.Id">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="groupId" value="@Model.Id" />
                            <input type="hidden" name="sessionId" value="@s.Id" />
                            <div style="display:flex; gap:8px; margin-bottom:10px;">
                                <button type="button" class="btn btn-success btn-sm" onclick="setAll(this, 0)">
                                    <i class="fas fa-check-double"></i> @L["Present"]
                                </button>
                                @if (attOl != null && joinedSet.Any())
                                {
                                    <button type="submit" form="markPresentForm-@s.Id" class="btn btn-sm" style="background:rgba(147,51,234,0.15); color:#9333ea; padding:3px 10px; font-size:11px;">
                                        <i class="fas fa-video"></i> Qoşulanları Present (@joinedSet.Count)
                                    </button>
                                }
                                @foreach (var sa in sessionAssessments)
                                {
                                    var ac = sa.Type == AssessmentType.Quiz ? "#3b82f6" : sa.Type == AssessmentType.FinalProject ? "#e94560" : "#eab308";
                                    var al = sa.Type == AssessmentType.Quiz ? "Quiz" : sa.Type == AssessmentType.FinalProject ? "Final" : L["AssessmentType_Assignment"].Value;
                                    <a href="/Teacher/Assessments/Grade/@sa.Id" class="btn btn-sm" style="background:@(ac)22; color:@ac; padding:3px 10px; font-size:11px;">
                                        <i class="fas fa-pen"></i> @al: @sa.Title
                                    </a>
                                }
                            </div>
                            <table class="mini-table">
                                <thead>
                                    <tr>
                                        <th style="width:35%;">@L["Student"]</th>
                                        <th style="text-align:center;">@L["Present"]</th>
                                        <th style="text-align:center;">@L["Late"]</th>
                                        <th style="text-align:center;">@L["Absent"]</th>
                                        <th style="text-align:center;">Üzrlü</th>
                                        @if (hasSavedAtt)
                                        {
                                            <th style="text-align:center;">@L["Status"]</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ var rowIdx = 0; }
                                    @foreach (var e in enrollments.Where(x => x.Status == EnrollmentStatus.Active).OrderBy(x => x.StudentName))
                                    {
                                        var savedRecord = existingAtt.FirstOrDefault(a => a.EnrollmentId == e.Id);
                                        var curStatus = savedRecord?.Status ?? AttendanceStatus.Present;
                                        var radioName = $"status_{s.Id}_{rowIdx}";
                                        <tr>
                                            <td>
                                                <input type="hidden" name="enrollmentIds" value="@e.Id" />
                                                <input type="hidden" class="status-value" name="statuses" value="@((int)curStatus)" />
                                                <strong>@e.StudentName</strong>
                                                @if (attOl != null && joinedSet.Contains(e.StudentId))
                                                {
                                                    <span style="display:inline-flex; align-items:center; gap:3px; background:rgba(147,51,234,0.15); color:#9333ea; padding:1px 6px; border-radius:5px; font-size:10px; font-weight:600; margin-left:6px;"><i class="fas fa-video" style="font-size:8px;"></i> Qoşuldu</span>
                                                }
                                                <div style="font-size:11px; color:var(--text-secondary);">@e.StudentNumber</div>
                                            </td>
                                            <td style="text-align:center;">
                                                <input type="radio" name="@radioName" value="0"
                                                       @(curStatus == AttendanceStatus.Present ? "checked" : "")
                                                       onchange="this.closest('tr').querySelector('.status-value').value=this.value"
                                                       style="accent-color:#22c55e; width:16px; height:16px;" />
                                            </td>
                                            <td style="text-align:center;">
                                                <input type="radio" name="@radioName" value="2"
                                                       @(curStatus == AttendanceStatus.Late ? "checked" : "")
                                                       onchange="this.closest('tr').querySelector('.status-value').value=this.value"
                                                       style="accent-color:#eab308; width:16px; height:16px;" />
                                            </td>
                                            <td style="text-align:center;">
                                                <input type="radio" name="@radioName" value="1"
                                                       @(curStatus == AttendanceStatus.Absent ? "checked" : "")
                                                       onchange="this.closest('tr').querySelector('.status-value').value=this.value"
                                                       style="accent-color:#ef4444; width:16px; height:16px;" />
                                            </td>
                                            <td style="text-align:center;">
                                                <input type="radio" name="@radioName" value="3"
                                                       @(curStatus == AttendanceStatus.Excused ? "checked" : "")
                                                       onchange="this.closest('tr').querySelector('.status-value').value=this.value"
                                                       style="accent-color:#3b82f6; width:16px; height:16px;" />
                                            </td>
                                            @if (hasSavedAtt)
                                            {
                                                <td style="text-align:center;">
                                                    @if (savedRecord != null)
                                                    {
                                                        @switch (savedRecord.Status)
                                                        {
                                                            case AttendanceStatus.Present:
                                                                <span style="color:#22c55e; font-size:12px;">✓ @L["Present"]</span>
                                                                break;
                                                            case AttendanceStatus.Late:
                                                                <span style="color:#eab308; font-size:12px;">⚠ @L["Late"]</span>
                                                                break;
                                                            case AttendanceStatus.Absent:
                                                                <span style="color:#ef4444; font-size:12px;">✗ @L["Absent"]</span>
                                                                break;
                                                            case AttendanceStatus.Excused:
                                                                <span style="color:#3b82f6; font-size:12px;">ⓘ Üzrlü</span>
                                                                break;
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span style="color:var(--text-secondary); font-size:11px;">—</span>
                                                    }
                                                </td>
                                            }
                                        </tr>
                                        rowIdx++;
                                    }
                                </tbody>
                            </table>
                            <div style="display:flex; gap:8px; align-items:center; margin-top:12px;">
                                <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> @L["Save"]</button>
                                @if (hasSavedAtt)
                                {
                                    <span style="font-size:12px; color:var(--text-secondary);">
                                        <i class="fas fa-info-circle"></i>
                                    </span>
                                }
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="card" style="padding:30px; text-align:center; color:var(--text-secondary);">
            @L["NoData"]
        </div>
    }
</div>

<!-- ==================== TAB 5: Tələbə Siyahısı ==================== -->
<div id="tab-students" class="tab-content @(activeTab == "students" ? "active" : "")">
    <div class="card">
        <div class="card-body" style="padding:0;">
            <table class="mini-table">
                <thead>
                    <tr><th>@L["Name"]</th><th>@L["PDF_StudentNo"]</th><th>@L["Attendance"]</th><th>@L["OfficialGrade"] %</th><th>GPA</th><th>@L["Assignments"]</th><th>@L["Status"]</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var e in enrollments.OrderBy(x => x.StudentName))
                    {
                        var sum = summaries.GetValueOrDefault(e.Id);
                        var hasAttRow = sum != null && sum.AttendanceTakenSessions > 0;
                        var attPct = sum?.AttendancePercentage ?? 0;
                        var attColor = attPct >= 80 ? "#22c55e" : attPct >= 60 ? "#eab308" : "#ef4444";
                        var t = transcripts.GetValueOrDefault(e.Id);
                        var missing = t?.HomeworkAssignments?.Count(h => !h.IsSubmitted) ?? 0;
                        // Risk: aşağı davamiyyət (yalnız qeyd olunmuşsa), aşağı rəsmi qiymət, və ya çox təhvil verilməmiş tapşırıq
                        var isRisk = (hasAttRow && attPct < 60) || (t != null && t.OfficialGrade < 50) || missing >= 3;
                        <tr>
                            <td><strong>@e.StudentName</strong></td>
                            <td style="color:var(--text-secondary);">@e.StudentNumber</td>
                            <td>
                                @if (hasAttRow)
                                {
                                    <div style="display:flex; align-items:center; gap:8px;">
                                        <div class="progress-bar" style="width:60px;">
                                            <div class="progress-fill" style="width:@attPct%; background:@attColor;"></div>
                                        </div>
                                        <span style="font-size:12px; color:@attColor; font-weight:600;">@attPct.ToString("F1")%</span>
                                    </div>
                                }
                                else
                                {
                                    <span style="color:var(--text-secondary); font-size:11px; font-style:italic;">qeyd olunmayıb</span>
                                }
                            </td>
                            <td style="font-weight:600;">@(t != null ? t.OfficialGrade.ToString("F1") + "%" : "—")</td>
                            <td style="font-weight:700;">@(t != null ? t.GPA.ToString("F2") : "—")</td>
                            <td>
                                @if (missing > 0)
                                {
                                    <span class="badge badge-warning">@missing @L["Missing"]</span>
                                }
                                else { <span style="color:var(--text-secondary);">—</span> }
                            </td>
                            <td>
                                @if (isRisk) { <span class="badge badge-danger"><i class="fas fa-triangle-exclamation"></i> @L["RiskStudent"]</span> }
                                else if (e.Status == EnrollmentStatus.Active) { <span class="badge badge-success">@L["Active"]</span> }
                                else if (e.Status == EnrollmentStatus.Dropped) { <span class="badge badge-danger">@L["Dropped"]</span> }
                                else { <span class="badge badge-info">@L["Completed"]</span> }
                            </td>
                            <td>
                                <a href="/Teacher/Messages/Start?groupId=@Model.Id&studentId=@e.StudentId" title="@L["Messages"]"
                                   style="display:inline-flex; align-items:center; gap:4px; padding:4px 8px; border-radius:6px;
                                          background:var(--accent-soft); color:var(--accent); text-decoration:none;
                                          font-size:11px; font-weight:600; transition:all .15s; margin-right:4px;"
                                   onmouseover="this.style.background='var(--accent)'; this.style.color='#fff'"
                                   onmouseout="this.style.background='var(--accent-soft)'; this.style.color='var(--accent)'">
                                    <i class="fas fa-comment"></i>
                                </a>
                                <a href="/Teacher/Courses/Transcript?enrollmentId=@e.Id" target="_blank" title="Transkript PDF"
                                   style="display:inline-flex; align-items:center; gap:5px; padding:4px 10px; border-radius:6px;
                                          background:linear-gradient(135deg, #e94560, #c2185b); color:#fff; text-decoration:none;
                                          font-size:11px; font-weight:600; box-shadow:0 2px 8px rgba(233,69,96,0.3);
                                          transition:all .15s;"
                                   onmouseover="this.style.transform='translateY(-1px)'; this.style.boxShadow='0 4px 12px rgba(233,69,96,0.4)'"
                                   onmouseout="this.style.transform=''; this.style.boxShadow='0 2px 8px rgba(233,69,96,0.3)'">
                                    <i class="fas fa-file-pdf"></i> PDF
                                </a>
                            </td>
                        </tr>
                    }
                    @if (!enrollments.Any())
                    {
                        <tr><td colspan="8" style="text-align:center; color:var(--text-secondary); padding:24px;">@L["NoData"]</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ==================== TAB 6: Tapşırıqlar ==================== -->
<div id="tab-assignments" class="tab-content @(activeTab == "assignments" ? "active" : "")">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
        <span style="font-size:13px; color:var(--text-secondary);">@assignments.Count @L["Assignments"]</span>
        <a href="/Teacher/Assignments/Create?groupId=@Model.Id" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> @L["Create"]</a>
    </div>
    <div class="card">
        <div class="card-body" style="padding:0;">
            <table class="mini-table">
                <thead>
                    <tr><th>@L["Title"]</th><th>@L["Type"]</th><th>@L["DueDate"]</th><th>@L["MaxScore"]</th><th>@L["Submissions"]</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var a in assignments.OrderBy(x => x.DueDate))
                    {
                        var isOverdue = a.DueDate < DateTime.Now;
                        <tr>
                            <td>
                                <strong>@a.Title</strong>
                                @if (a.IsLinkedToAssessment)
                                {
                                    <span style="font-size:9px; background:rgba(34,197,94,0.15); color:#22c55e; padding:1px 6px; border-radius:3px; margin-left:4px; font-weight:600;">
                                        <i class="fas fa-link"></i> GPA
                                    </span>
                                }
                            </td>
                            <td><span class="badge badge-info" style="font-size:10px;">@a.TypeLabel</span></td>
                            <td>
                                @a.DueDate.ToString("dd.MM.yy HH:mm")
                                @if (isOverdue) { <span style="color:#ef4444; font-size:10px; margin-left:4px;">✗</span> }
                            </td>
                            <td>@a.MaxScore</td>
                            <td>@a.SubmissionCount</td>
                            <td>
                                <a href="/Teacher/Assignments/Submissions/@a.Id" class="btn btn-sm btn-secondary" style="padding:3px 8px;">
                                    <i class="fas fa-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                    @if (!assignments.Any())
                    {
                        <tr><td colspan="6" style="text-align:center; color:var(--text-secondary); padding:24px;">@L["NoData"]</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ==================== TAB 7: Elanlar ==================== -->
<div id="tab-announcements" class="tab-content @(activeTab == "announcements" ? "active" : "")">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
        <span style="font-size:13px; color:var(--text-secondary);">@announcements.Count @L["Announcements"]</span>
        <button class="btn btn-primary btn-sm" onclick="document.getElementById('newAnnForm').style.display = document.getElementById('newAnnForm').style.display === 'none' ? 'block' : 'none'">
            <i class="fas fa-plus"></i> @L["NewAnnouncement"]
        </button>
    </div>

    <div id="newAnnForm" style="display:none; margin-bottom:16px;">
        <div class="card">
            <div class="card-body">
                <form method="post" action="/Teacher/Courses/CreateAnnouncement">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="groupId" value="@Model.Id" />
                    <div class="form-group">
                        <label class="form-label">@L["Title"] *</label>
                        <input name="title" class="form-control" required placeholder="@L["Title"]" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">@L["Content"] *</label>
                        <textarea name="content" class="form-control" rows="3" required placeholder="@L["Content"]"></textarea>
                    </div>
                    <div style="display:flex; gap:8px;">
                        <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-paper-plane"></i> @L["Submit"]</button>
                        <button type="button" class="btn btn-secondary btn-sm" onclick="document.getElementById('newAnnForm').style.display='none'">@L["Cancel"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @if (announcements.Any())
    {
        <div style="display:flex; flex-direction:column; gap:8px;">
            @foreach (var a in announcements)
            {
                <div class="card" style="padding:14px 18px;">
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:4px;">
                        <strong style="font-size:14px;">@a.Title</strong>
                        <span style="font-size:11px; color:var(--text-secondary);">@a.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                    </div>
                    <p style="font-size:13px; color:var(--text-secondary); margin:0; white-space:pre-wrap;">@a.Content</p>
                    @if (!string.IsNullOrEmpty(a.AuthorName))
                    {
                        <div style="font-size:11px; color:var(--text-secondary); margin-top:6px;"><i class="fas fa-user"></i> @a.AuthorName</div>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div class="card" style="padding:30px; text-align:center; color:var(--text-secondary);">@L["NoAnnouncements"]</div>
    }
</div>

<!-- ==================== TAB: Materiallar ==================== -->
<div id="tab-materials" class="tab-content @(activeTab == "materials" ? "active" : "")">
    @{
        var materials = ViewBag.Materials as List<SIS.BLL.Services.DTOs.Material.CourseMaterialDto> ?? new();
        Func<MaterialType, string> matIcon = t => t switch
        {
            MaterialType.Link => "fa-link",
            MaterialType.Video => "fa-video",
            MaterialType.Document => "fa-file-word",
            MaterialType.Presentation => "fa-file-powerpoint",
            MaterialType.Code => "fa-file-code",
            MaterialType.File => "fa-file",
            _ => "fa-file-alt"
        };
        Func<MaterialType, string> matLabel = t => t switch
        {
            MaterialType.Link => "Keçid",
            MaterialType.Video => "Video",
            MaterialType.Document => "Sənəd",
            MaterialType.Presentation => "Təqdimat",
            MaterialType.Code => "Kod",
            MaterialType.File => "Fayl",
            _ => "Digər"
        };
    }
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; flex-wrap:wrap; gap:10px;">
        <h3 style="font-size:16px; font-weight:700;">Tədris materialları (@materials.Count)</h3>
        <button class="btn btn-sm btn-primary" onclick="openMaterialModal()"><i class="fas fa-plus"></i> Material əlavə et</button>
    </div>

    @if (!materials.Any())
    {
        <div class="card" style="padding:40px; text-align:center; color:var(--text-secondary);">
            <i class="fas fa-folder-open" style="font-size:48px; opacity:.3; margin-bottom:12px; display:block;"></i>
            <p>Hələ material yoxdur. İlk materialı əlavə edin.</p>
        </div>
    }
    else
    {
        <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(270px,1fr)); gap:14px;">
            @foreach (var m in materials)
            {
                var open = (m.MaterialType == MaterialType.Link || m.MaterialType == MaterialType.Video) ? m.LinkUrl : m.FilePath;
                <div class="card" style="padding:16px; @(m.IsActive ? "" : "opacity:.55;")">
                    <div style="display:flex; align-items:center; gap:10px; margin-bottom:8px;">
                        <i class="fas @matIcon(m.MaterialType)" style="font-size:20px; color:var(--accent);"></i>
                        <span style="font-size:10px; padding:2px 8px; border-radius:12px; background:var(--bg-hover); color:var(--text-secondary);">@matLabel(m.MaterialType)</span>
                        @if (!m.IsActive)
                        {
                            <span style="font-size:10px; padding:2px 8px; border-radius:12px; background:#fee2e2; color:#dc2626;">Gizli</span>
                        }
                    </div>
                    <div style="font-weight:700; font-size:14px; margin-bottom:4px;">@m.Title</div>
                    @if (!string.IsNullOrEmpty(m.Description))
                    {
                        <div style="font-size:12px; color:var(--text-secondary); margin-bottom:8px;">@m.Description</div>
                    }
                    @if (!string.IsNullOrEmpty(open))
                    {
                        <a href="@open" target="_blank" style="display:inline-flex; align-items:center; gap:6px; font-size:12px; color:var(--accent); text-decoration:none; margin-bottom:10px;">
                            <i class="fas fa-external-link-alt"></i> @((m.MaterialType == MaterialType.Link || m.MaterialType == MaterialType.Video) ? "Aç" : (m.FileName ?? "Yüklə"))
                        </a>
                    }
                    <div style="display:flex; gap:6px; border-top:1px solid var(--border); padding-top:10px; margin-top:4px;">
                        <button class="btn btn-sm btn-secondary"
                                onclick='openEditMaterial(@System.Text.Json.JsonSerializer.Serialize(new { m.Id, m.Title, m.Description, Type = (int)m.MaterialType, m.LinkUrl, m.FilePath, m.FileName, m.FileSize }))'
                                style="flex:1;"><i class="fas fa-edit"></i></button>
                        <form method="post" action="/Teacher/Courses/ToggleMaterial" style="flex:1;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@m.Id" />
                            <input type="hidden" name="groupId" value="@Model.Id" />
                            <input type="hidden" name="active" value="@((!m.IsActive).ToString().ToLower())" />
                            <button type="submit" class="btn btn-sm btn-secondary" style="width:100%;" title="@(m.IsActive ? "Gizlət" : "Göstər")">
                                <i class="fas @(m.IsActive ? "fa-eye-slash" : "fa-eye")"></i>
                            </button>
                        </form>
                        <form method="post" action="/Teacher/Courses/DeleteMaterial" style="flex:1;" onsubmit="return confirm('Material silinsin?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@m.Id" />
                            <input type="hidden" name="groupId" value="@Model.Id" />
                            <button type="submit" class="btn btn-sm btn-danger" style="width:100%;"><i class="fas fa-trash"></i></button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Material modal -->
<div id="materialModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,.5); z-index:1000; align-items:center; justify-content:center; padding:20px;">
    <div class="card" style="max-width:520px; width:100%; padding:0; max-height:90vh; overflow-y:auto;">
        <div style="padding:16px 20px; border-bottom:1px solid var(--border); font-weight:700;" id="materialModalTitle">Yeni material</div>
        <form method="post" id="materialForm" action="/Teacher/Courses/CreateMaterial" style="padding:20px;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="matId" value="0" />
            <input type="hidden" name="groupId" value="@Model.Id" />
            <input type="hidden" name="FilePath" id="matFilePath" />
            <input type="hidden" name="FileName" id="matFileName" />
            <input type="hidden" name="FileSize" id="matFileSize" />
            <div class="form-group">
                <label class="form-label">Başlıq *</label>
                <input name="Title" id="matTitle" class="form-control" required />
            </div>
            <div class="form-group">
                <label class="form-label">Təsvir</label>
                <textarea name="Description" id="matDesc" class="form-control" rows="2"></textarea>
            </div>
            <div class="form-group">
                <label class="form-label">Növ *</label>
                <select name="MaterialType" id="matType" class="form-control" onchange="onMatTypeChange()">
                    <option value="0">Fayl</option>
                    <option value="3">Sənəd</option>
                    <option value="4">Təqdimat</option>
                    <option value="5">Kod</option>
                    <option value="1">Keçid (link)</option>
                    <option value="2">Video (link)</option>
                    <option value="6">Digər</option>
                </select>
            </div>
            <div class="form-group" id="matLinkGroup">
                <label class="form-label">URL</label>
                <input name="LinkUrl" id="matLinkUrl" class="form-control" placeholder="https://..." />
            </div>
            <div class="form-group" id="matFileGroup">
                <label class="form-label">Fayl (maks 25 MB)</label>
                <div onclick="document.getElementById('matFileInput').click()" style="border:2px dashed var(--border); border-radius:8px; padding:16px; text-align:center; cursor:pointer;">
                    <i class="fas fa-cloud-upload-alt" style="font-size:22px; color:var(--text-secondary);"></i>
                    <div id="matFileLabel" style="font-size:12px; color:var(--text-secondary); margin-top:6px;">Faylı seçin</div>
                </div>
                <input type="file" id="matFileInput" style="display:none" onchange="uploadMatFile(this.files[0])" />
                <div id="matUploadErr" style="color:#ef4444; font-size:12px; margin-top:6px; display:none;"></div>
            </div>
            <div style="display:flex; gap:10px; justify-content:flex-end; margin-top:8px;">
                <button type="button" class="btn btn-secondary" onclick="closeMaterialModal()">Ləğv</button>
                <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Yadda saxla</button>
            </div>
        </form>
    </div>
</div>

<!-- Online dərs yarat modal -->
<div id="createOLModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.6); z-index:1000; align-items:center; justify-content:center;">
    <div style="background:var(--bg-card); border-radius:12px; padding:24px; width:480px; border:1px solid var(--border);">
        <h3 style="margin-bottom:16px; font-size:16px;"><i class="fas fa-video"></i> Online dərs yarat</h3>
        <form method="post" action="/Teacher/Courses/CreateOnlineLesson">
            @Html.AntiForgeryToken()
            <input type="hidden" name="groupId" value="@Model.Id" />
            <input type="hidden" name="sessionId" id="createOLSession" />
            <div class="form-group">
                <label class="form-label">Başlıq</label>
                <input name="title" id="createOLTitle" class="form-control" placeholder="Avtomatik qurulur (boş buraxa bilərsiniz)" />
            </div>
            <div class="form-group">
                <label class="form-label">Təsvir</label>
                <textarea name="description" class="form-control" rows="2"></textarea>
            </div>
            <div style="font-size:11px; color:var(--text-secondary); margin-bottom:8px; padding:8px; background:rgba(147,51,234,0.08); border-radius:6px;">
                <i class="fas fa-info-circle"></i> Dərs Acadex-in öz daxili classroom-unda açılacaq — xarici link tələb olunmur.
            </div>
            <div style="display:flex; gap:8px; margin-top:8px;">
                <button type="submit" class="btn btn-primary">Yarat</button>
                <button type="button" onclick="document.getElementById('createOLModal').style.display='none'" class="btn btn-secondary">@L["Cancel"]</button>
            </div>
        </form>
    </div>
</div>

<!-- Online dərs başlıq redaktə modal -->
<div id="editOLModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.6); z-index:1000; align-items:center; justify-content:center;">
    <div style="background:var(--bg-card); border-radius:12px; padding:24px; width:480px; border:1px solid var(--border);">
        <h3 style="margin-bottom:16px; font-size:16px;"><i class="fas fa-pen"></i> Online dərs başlığını redaktə et</h3>
        <form method="post" action="/Teacher/Courses/UpdateOnlineLesson">
            @Html.AntiForgeryToken()
            <input type="hidden" name="groupId" value="@Model.Id" />
            <input type="hidden" name="id" id="editOLId" />
            <div class="form-group">
                <label class="form-label">Başlıq</label>
                <input name="title" id="editOLTitle" class="form-control" required />
            </div>
            <div class="form-group">
                <label class="form-label">Təsvir</label>
                <textarea name="description" id="editOLDesc" class="form-control" rows="2"></textarea>
            </div>
            <div style="display:flex; gap:8px; margin-top:8px;">
                <button type="submit" class="btn btn-primary">@L["Save"]</button>
                <button type="button" onclick="document.getElementById('editOLModal').style.display='none'" class="btn btn-secondary">@L["Cancel"]</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
// ── Demo Attendance modal ──
function toggleCustomCounts() {
    var mode = document.getElementById('demoMode').value;
    document.getElementById('customCountsBox').style.display = mode === 'CustomCounts' ? '' : 'none';
    updateDemoEstimate();
}

function selectedSessionCount() {
    var f = parseInt(document.getElementById('demoFrom').value, 10);
    var t = parseInt(document.getElementById('demoTo').value, 10);
    if (isNaN(f) || isNaN(t) || t < f) return 0;
    return t - f + 1;
}

function updateDemoEstimate() {
    var box = document.getElementById('demoEstimate');
    if (!box) return;
    var mode = document.getElementById('demoMode').value;
    if (mode !== 'CustomCounts') { box.textContent = ''; return; }

    var sessions = selectedSessionCount();
    var p = parseInt(document.getElementById('cntPresent').value, 10) || 0;
    var a = parseInt(document.getElementById('cntAbsent').value, 10) || 0;
    var l = parseInt(document.getElementById('cntLate').value, 10) || 0;
    var x = parseInt(document.getElementById('cntExcused').value, 10) || 0;
    var sum = p + a + l + x;

    var line = 'Selected sessions: <strong>' + sessions + '</strong> · '
        + 'Present: ' + p + ' · Absent: ' + a + ' · Late: ' + l + ' · Excused: ' + x;

    if (sum !== sessions) {
        box.innerHTML = line + ' · <span style="color:#ef4444; font-weight:600;">Cəm: ' + sum
            + ' — sessiya sayına bərabər deyil</span>';
        return;
    }

    var score = p + l * 0.5 + x;
    var pct = sessions > 0 ? (score / sessions * 100) : 0;
    box.innerHTML = line + ' · <strong>Estimated Attendance: ' + pct.toFixed(2) + '%</strong>';
}

function openDemoConfirm() {
    var f = document.getElementById('demoFrom').value;
    var t = document.getElementById('demoTo').value;
    var m = document.getElementById('demoMode').value;
    var o = document.getElementById('demoOverwrite').checked ? 'mövcud yazılar yenilənəcək' : 'mövcud yazılar saxlanılacaq';

    // CustomCounts validation client-side
    if (m === 'CustomCounts') {
        var sessions = selectedSessionCount();
        var p = parseInt(document.getElementById('cntPresent').value, 10) || 0;
        var a = parseInt(document.getElementById('cntAbsent').value, 10) || 0;
        var l = parseInt(document.getElementById('cntLate').value, 10) || 0;
        var x = parseInt(document.getElementById('cntExcused').value, 10) || 0;
        if (p + a + l + x !== sessions) {
            alert('Status saylarının cəmi seçilmiş sessiya sayına bərabər olmalıdır (' + sessions + ').');
            return;
        }
    }

    document.getElementById('demoConfirmRange').innerHTML =
        '<strong>Sessiyalar:</strong> #' + f + ' — #' + t + ' &middot; ' +
        '<strong>Mode:</strong> ' + m + ' &middot; ' + o;
    document.getElementById('demoConfirmModal').style.display = 'flex';
}
function closeDemoConfirm() {
    document.getElementById('demoConfirmModal').style.display = 'none';
}
document.getElementById('demoConfirmModal')?.addEventListener('click', function(e) {
    if (e.target === this) closeDemoConfirm();
});

// ── Online dərs modalları ──
function openCreateOL(sessionId, sessionNumber) {
    document.getElementById('createOLSession').value = sessionId;
    document.getElementById('createOLTitle').value = '';
    document.getElementById('createOLModal').style.display = 'flex';
}
function openEditOL(id, title, desc) {
    document.getElementById('editOLId').value = id;
    document.getElementById('editOLTitle').value = title;
    document.getElementById('editOLDesc').value = desc || '';
    document.getElementById('editOLModal').style.display = 'flex';
}

function switchTab(name) {
    document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
    document.querySelectorAll('.tab').forEach(el => el.classList.remove('active'));
    document.getElementById('tab-' + name).classList.add('active');
    event.target.closest('.tab').classList.add('active');
    // Update URL without reload
    const url = new URL(window.location);
    url.searchParams.set('tab', name);
    history.replaceState(null, '', url);
}

function selectSession(sessionId) {
    document.querySelectorAll('.attendance-panel').forEach(el => el.style.display = 'none');
    var panel = document.getElementById('att-' + sessionId);
    if (panel) panel.style.display = 'block';
}

function setAll(btn, value) {
    var form = btn.closest('form');
    form.querySelectorAll('input[type="radio"][value="' + value + '"]').forEach(r => r.checked = true);
    form.querySelectorAll('.status-value').forEach(h => h.value = value);
}

// ── Materiallar ──
function onMatTypeChange() {
    var t = document.getElementById('matType').value;
    var isLink = (t === '1' || t === '2');
    document.getElementById('matLinkGroup').style.display = isLink ? 'block' : 'none';
    document.getElementById('matFileGroup').style.display = isLink ? 'none' : 'block';
}
function openMaterialModal() {
    var f = document.getElementById('materialForm');
    f.action = '/Teacher/Courses/CreateMaterial';
    document.getElementById('materialModalTitle').textContent = 'Yeni material';
    document.getElementById('matId').value = '0';
    document.getElementById('matTitle').value = '';
    document.getElementById('matDesc').value = '';
    document.getElementById('matType').value = '0';
    document.getElementById('matLinkUrl').value = '';
    document.getElementById('matFilePath').value = '';
    document.getElementById('matFileName').value = '';
    document.getElementById('matFileSize').value = '';
    document.getElementById('matFileLabel').textContent = 'Faylı seçin';
    onMatTypeChange();
    document.getElementById('materialModal').style.display = 'flex';
}
function openEditMaterial(m) {
    document.getElementById('materialForm').action = '/Teacher/Courses/UpdateMaterial';
    document.getElementById('materialModalTitle').textContent = 'Materialı redaktə et';
    document.getElementById('matId').value = m.Id;
    document.getElementById('matTitle').value = m.Title || '';
    document.getElementById('matDesc').value = m.Description || '';
    document.getElementById('matType').value = m.Type;
    document.getElementById('matLinkUrl').value = m.LinkUrl || '';
    document.getElementById('matFilePath').value = m.FilePath || '';
    document.getElementById('matFileName').value = m.FileName || '';
    document.getElementById('matFileSize').value = m.FileSize || '';
    document.getElementById('matFileLabel').textContent = m.FileName || 'Faylı seçin';
    onMatTypeChange();
    document.getElementById('materialModal').style.display = 'flex';
}
function closeMaterialModal() { document.getElementById('materialModal').style.display = 'none'; }
async function uploadMatFile(file) {
    if (!file) return;
    var err = document.getElementById('matUploadErr'); err.style.display = 'none';
    var token = document.querySelector('#materialForm input[name="__RequestVerificationToken"]').value;
    var fd = new FormData(); fd.append('file', file);
    document.getElementById('matFileLabel').textContent = 'Yüklənir…';
    try {
        var res = await fetch('/Upload/MaterialFile', { method: 'POST', headers: { 'RequestVerificationToken': token }, body: fd });
        if (!res.ok) { var e = await res.json(); err.textContent = e.error || 'Yüklənmədi'; err.style.display = 'block'; document.getElementById('matFileLabel').textContent = 'Faylı seçin'; return; }
        var d = await res.json();
        document.getElementById('matFilePath').value = d.url;
        document.getElementById('matFileName').value = d.name;
        document.getElementById('matFileSize').value = d.size;
        document.getElementById('matFileLabel').textContent = d.name;
    } catch { err.textContent = 'Yüklənmədi'; err.style.display = 'block'; document.getElementById('matFileLabel').textContent = 'Faylı seçin'; }
}

// Toast auto-hide
var toast = document.getElementById('toastMsg');
if (toast) {
    setTimeout(function() {
        toast.style.animation = 'slideOut .3s ease-in forwards';
        setTimeout(function() { toast.remove(); }, 300);
    }, 3500);
}
</script>
}
