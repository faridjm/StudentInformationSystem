@{
    ViewData["Title"] = "Dashboard";
    var teacher = ViewBag.Teacher as SIS.BLL.Services.DTOs.Teacher.TeacherDetailDto;
    var offerings = ViewBag.Offerings as IEnumerable<SIS.BLL.Services.DTOs.CourseOffering.CourseOfferingListDto>;
    var announcements = ViewBag.Announcements as IEnumerable<SIS.BLL.Services.DTOs.Announcement.AnnouncementDto>;
}

<div style="margin-bottom:24px;">
    <h2 style="font-size:20px; font-weight:700;">
        Xoş gəldiniz, @(teacher?.FullName ?? User.Identity?.Name)!
    </h2>
    <p style="color:var(--text-secondary); font-size:14px;">@DateTime.Now.ToString("dd MMMM yyyy, dddd")</p>
</div>

<div style="display:grid; grid-template-columns:repeat(3,1fr); gap:16px; margin-bottom:24px;">
    <div class="stat-card">
        <div class="stat-icon" style="background:rgba(59,130,246,0.15); color:#3b82f6;">
            <i class="fas fa-book"></i>
        </div>
        <div>
            <div class="stat-value">@ViewBag.CourseCount</div>
            <div class="stat-label">Aktiv Kurs</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon" style="background:rgba(34,197,94,0.15); color:#22c55e;">
            <i class="fas fa-users"></i>
        </div>
        <div>
            <div class="stat-value">@(offerings?.Sum(o => o.EnrolledCount) ?? 0)</div>
            <div class="stat-label">Ümumi Tələbə</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon" style="background:rgba(168,85,247,0.15); color:#a855f7;">
            <i class="fas fa-bullhorn"></i>
        </div>
        <div>
            <div class="stat-value">@(announcements?.Count() ?? 0)</div>
            <div class="stat-label">Elanlar</div>
        </div>
    </div>
</div>

<div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
    <div class="card">
        <div class="card-header">
            <span><i class="fas fa-book" style="margin-right:8px;"></i>Kurslarım</span>
            <a href="/Teacher/Courses" class="btn btn-primary btn-sm">Hamısı</a>
        </div>
        <div style="overflow-x:auto;">
            <table class="table">
                <thead>
                    <tr>
                        <th>Kurs</th>
                        <th>Tələbə</th>
                        <th>Otaq</th>
                    </tr>
                </thead>
                <tbody>
                    @if (offerings != null)
                    {
                        @foreach (var o in offerings.Take(5))
                        {
                            <tr>
                                <td>
                                    <div style="font-weight:500;">@o.CourseName</div>
                                    <div style="font-size:12px; color:var(--text-secondary);">@o.CourseCode</div>
                                </td>
                                <td><span class="badge badge-info">@o.EnrolledCount / @o.Capacity</span></td>
                                <td style="color:var(--text-secondary);">@(o.Room ?? "—")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <span><i class="fas fa-bullhorn" style="margin-right:8px;"></i>Son Elanlar</span>
            <a href="/Teacher/Announcements" class="btn btn-primary btn-sm">Hamısı</a>
        </div>
        <div class="card-body">
            @if (announcements != null && announcements.Any())
            {
                @foreach (var a in announcements)
                {
                    <div style="padding:10px 0; border-bottom:1px solid var(--border);">
                        <div style="font-weight:500; font-size:14px;">@a.Title</div>
                        <div style="font-size:12px; color:var(--text-secondary);">@a.CreatedAt.ToString("dd.MM.yyyy")</div>
                    </div>
                }
            }
            else
            {
                <p style="color:var(--text-secondary); text-align:center;">Elan yoxdur</p>
            }
        </div>
    </div>
</div>