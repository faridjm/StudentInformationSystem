@model SIS.BLL.Services.DTOs.Quiz.CreateQuizDto
@{
    ViewData["Title"] = "Yeni Quiz";
    var groupId = (int)ViewBag.GroupId;
    var item = ViewBag.Item as SIS.BLL.Services.DTOs.Assessment.AssessmentItemDto;
}

<div style="max-width:560px; margin:0 auto;">
    <div style="display:flex; align-items:center; gap:12px; margin-bottom:20px;">
        <a href="/Teacher/Quizzes/Index?groupId=@groupId" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left"></i></a>
        <h2 style="font-size:20px; font-weight:700;">Yeni Quiz</h2>
    </div>

    <div class="card" style="padding:14px 18px; margin-bottom:16px; background:var(--accent-soft);">
        <div style="font-size:13px;">
            <i class="fas fa-link"></i> Bağlı qiymətləndirmə:
            <strong>@item?.Title</strong>
            <span style="color:var(--text-secondary);">(@item?.Date.ToString("dd.MM.yyyy") · %@item?.WeightPercent çəki · maks @item?.MaxScore)</span>
        </div>
    </div>

    <form method="post" action="/Teacher/Quizzes/Create">
        @Html.AntiForgeryToken()
        <input type="hidden" name="AssessmentItemId" value="@Model.AssessmentItemId" />
        <input type="hidden" name="groupId" value="@groupId" />
        <div class="card">
            <div class="card-body" style="padding:20px;">
                <div class="form-group">
                    <label class="form-label">Başlıq *</label>
                    <input name="Title" class="form-control" value="@Model.Title" required />
                </div>
                <div class="form-group">
                    <label class="form-label">Təsvir</label>
                    <textarea name="Description" class="form-control" rows="3"></textarea>
                </div>
                <div class="form-group">
                    <label class="form-label">Vaxt limiti (dəqiqə, boş = limitsiz)</label>
                    <input name="DurationMinutes" type="number" min="1" class="form-control" placeholder="məs: 20" />
                </div>
            </div>
        </div>
        <div style="display:flex; gap:12px; margin-top:16px;">
            <button type="submit" class="btn btn-primary"><i class="fas fa-arrow-right"></i> Yarat və suallara keç</button>
            <a href="/Teacher/Quizzes/Index?groupId=@groupId" class="btn btn-secondary">Ləğv et</a>
        </div>
    </form>
</div>
