@model IEnumerable<SIS.BLL.Services.DTOs.Quiz.QuizResultDto>
@{
    var quiz = ViewBag.Quiz as SIS.BLL.Services.DTOs.Quiz.QuizDto;
    ViewData["Title"] = "Quiz nəticələri";
    var submitted = Model.Where(r => r.IsSubmitted).ToList();
    var avg = submitted.Any() ? submitted.Average(r => r.Score ?? 0) : 0;
    var highest = submitted.Any() ? submitted.Max(r => r.Score ?? 0) : 0;
    var lowest = submitted.Any() ? submitted.Min(r => r.Score ?? 0) : 0;
    var passed = submitted.Count(r => (r.Score ?? 0) >= 50);
    var failed = submitted.Count(r => (r.Score ?? 0) < 50);

    string ScoreClr(decimal s) => s >= 70 ? "#22c55e" : s >= 50 ? "#eab308" : "#ef4444";
}

<div style="display:flex; align-items:center; gap:12px; margin-bottom:8px;">
    <a href="/Teacher/Quizzes/Manage/@quiz?.Id" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left"></i></a>
    <h2 style="font-size:20px; font-weight:700;">@quiz?.Title — Nəticələr</h2>
</div>
<p style="font-size:13px; color:var(--text-secondary); margin-bottom:16px;">
    @quiz?.AssessmentItemTitle · maks @quiz?.MaxScore bal · %@quiz?.WeightPercent çəki
</p>

@if (!submitted.Any())
{
    <div class="card" style="padding:40px; text-align:center; color:var(--text-secondary);">
        <i class="fas fa-inbox" style="font-size:48px; margin-bottom:12px; opacity:.3;"></i>
        <p>Hələ heç bir tələbə bu quiz-i cavablandırmayıb</p>
    </div>
}
else
{
    <!-- Summary cards -->
    <div style="display:grid; grid-template-columns:repeat(5,1fr); gap:10px; margin-bottom:16px;">
        <div class="stat-card">
            <div class="stat-icon" style="background:rgba(79,70,229,0.15); color:#4f46e5;"><i class="fas fa-users"></i></div>
            <div><div class="stat-value">@submitted.Count</div><div class="stat-label">Təhvil verən</div></div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background:rgba(59,130,246,0.15); color:#3b82f6;"><i class="fas fa-percentage"></i></div>
            <div><div class="stat-value" style="color:@ScoreClr(avg);">@avg.ToString("F1")%</div><div class="stat-label">Ortalama</div></div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background:rgba(34,197,94,0.15); color:#22c55e;"><i class="fas fa-arrow-trend-up"></i></div>
            <div><div class="stat-value" style="color:#22c55e;">@highest.ToString("F0")%</div><div class="stat-label">Ən yüksək</div></div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background:rgba(239,68,68,0.15); color:#ef4444;"><i class="fas fa-arrow-trend-down"></i></div>
            <div><div class="stat-value" style="color:#ef4444;">@lowest.ToString("F0")%</div><div class="stat-label">Ən aşağı</div></div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background:rgba(234,179,8,0.15); color:#eab308;"><i class="fas fa-circle-check"></i></div>
            <div><div class="stat-value">@passed / @(passed + failed)</div><div class="stat-label">Keçdi / Cəmi</div></div>
        </div>
    </div>

    <div class="card" style="padding:0; overflow:hidden;">
        <table style="width:100%; border-collapse:collapse;">
            <thead>
                <tr style="background:var(--bg-hover); text-align:left;">
                    <th style="padding:10px 16px; font-size:12px;">Tələbə</th>
                    <th style="padding:10px 16px; font-size:12px;">№</th>
                    <th style="padding:10px 16px; font-size:12px;">Nəticə</th>
                    <th style="padding:10px 16px; font-size:12px;">Rəsmi qiymət</th>
                    <th style="padding:10px 16px; font-size:12px;">Status</th>
                    <th style="padding:10px 16px; font-size:12px;">Tarix</th>
                    <th style="padding:10px 16px; font-size:12px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in submitted.OrderByDescending(x => x.Score))
                {
                    var official = quiz != null ? Math.Round((r.Score ?? 0) / 100m * quiz.MaxScore, 2) : 0;
                    var isPassed = (r.Score ?? 0) >= 50;
                    <tr style="border-top:1px solid var(--border);">
                        <td style="padding:10px 16px; font-weight:600;">@r.StudentName</td>
                        <td style="padding:10px 16px;"><code style="font-size:12px;">@r.StudentNumber</code></td>
                        <td style="padding:10px 16px; font-weight:700; color:@ScoreClr(r.Score ?? 0);">@(r.Score?.ToString("F1") ?? "—")%</td>
                        <td style="padding:10px 16px; font-size:13px;">@official / @quiz?.MaxScore</td>
                        <td style="padding:10px 16px;">
                            @if (isPassed)
                            {
                                <span style="background:#dcfce7; color:#166534; padding:2px 8px; border-radius:999px; font-size:11px; font-weight:700;">Keçdi</span>
                            }
                            else
                            {
                                <span style="background:#fee2e2; color:#991b1b; padding:2px 8px; border-radius:999px; font-size:11px; font-weight:700;">Keçmədi</span>
                            }
                        </td>
                        <td style="padding:10px 16px; font-size:12px; color:var(--text-secondary);">@r.SubmittedAt?.ToString("dd.MM.yyyy HH:mm")</td>
                        <td style="padding:10px 16px;">
                            <a href="/Teacher/Quizzes/AttemptDetail/@r.AttemptId" class="btn btn-sm btn-secondary" style="padding:4px 10px; font-size:12px;">
                                <i class="fas fa-list-ul"></i> Sual-sual
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
