@model SIS.BLL.Services.DTOs.Auth.ChangePasswordDto

@{
    ViewData["Title"] = "Şifrəmi Dəyiş";
}

<div style="display:flex; align-items:center; gap:12px; margin-bottom:20px;">
    <a href="/Teacher/Dashboard" class="btn btn-secondary btn-sm">
        <i class="fas fa-arrow-left"></i>
    </a>
    <h2 style="font-size:20px; font-weight:700;">Şifrəmi Dəyiş</h2>
</div>

<div class="card" style="max-width:500px;">
    <div class="card-body">
        <form method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" 
                 style="color:#f87171; margin-bottom:12px; font-size:13px;"></div>

            <div class="form-group">
                <label class="form-label">Cari Şifrə</label>
                <input asp-for="CurrentPassword" type="password" class="form-control" />
                <span asp-validation-for="CurrentPassword" 
                      style="color:#f87171; font-size:12px;"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Yeni Şifrə</label>
                <input asp-for="NewPassword" type="password" class="form-control" />
                <span asp-validation-for="NewPassword" 
                      style="color:#f87171; font-size:12px;"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Yeni Şifrəni Təsdiqlə</label>
                <input asp-for="ConfirmNewPassword" type="password" class="form-control" />
                <span asp-validation-for="ConfirmNewPassword" 
                      style="color:#f87171; font-size:12px;"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save"></i> Dəyiş
            </button>
        </form>
    </div>
</div>