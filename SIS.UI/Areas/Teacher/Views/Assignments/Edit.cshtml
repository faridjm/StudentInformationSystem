@model SIS.BLL.Services.DTOs.Assignment.UpdateAssignmentDto
@{
    ViewData["Title"] = L["EditAssignment"].Value;
}
<div style="max-width:560px; margin:0 auto;">
    <div style="display:flex; align-items:center; gap:12px; margin-bottom:20px;">
        <a href="/Teacher/Courses" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left"></i></a>
        <h2 style="font-size:20px; font-weight:700;">@L["EditAssignment"]</h2>
    </div>
    <form method="post" action="/Teacher/Assignments/Edit">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="@Model.Id" />
        <div class="card">
            <div class="card-body">
                <div class="form-group">
                    <label class="form-label">@L["Title"] *</label>
                    <input name="Title" value="@Model.Title" class="form-control" required />
                </div>
                <div class="form-group">
                    <label class="form-label">@L["Description"]</label>
                    <textarea name="Description" class="form-control" rows="3">@Model.Description</textarea>
                </div>
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
                    <div class="form-group">
                        <label class="form-label">Max bal</label>
                        <input name="MaxScore" type="number" value="@Model.MaxScore" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Son tarix</label>
                        <input name="DueDate" type="datetime-local" value="@Model.DueDate.ToString("yyyy-MM-ddTHH:mm")" class="form-control" />
                    </div>
                </div>
            </div>
        </div>
        <div style="display:flex; gap:12px; margin-top:16px;">
            <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> @L["Save"]</button>
        </div>
    </form>
</div>
