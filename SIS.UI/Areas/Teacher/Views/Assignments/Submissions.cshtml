@model IEnumerable<SIS.BLL.Services.DTOs.Assignment.SubmissionDto>
@{
    var assignment = ViewBag.Assignment as SIS.BLL.Services.DTOs.Assignment.AssignmentDto;
    ViewData["Title"] = "Cavablar";
}

<div style="margin-bottom:20px;">
    <a href="/Teacher/Assignments/Index?courseOfferingId=@assignment?.GroupId" style="color:var(--text-secondary); text-decoration:none;">
        <i class="fas fa-arrow-left"></i> Geri
    </a>
</div>

<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
    <div>
        <h2 style="font-size:20px; font-weight:700;">@assignment?.Title — Cavablar</h2>
        <p style="color:var(--text-secondary); font-size:13px; margin:4px 0 0;">
            Maks: @assignment?.MaxScore xal • Son tarix: @assignment?.DueDate.ToString("dd.MM.yyyy HH:mm")
        </p>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card" style="padding:40px; text-align:center; color:var(--text-secondary);">
        <i class="fas fa-inbox" style="font-size:48px; margin-bottom:12px; opacity:.3;"></i>
        <p>Hələ cavab yoxdur</p>
    </div>
}
else
{
    <div style="display:flex; flex-direction:column; gap:12px;">
        @foreach (var s in Model)
        {
            <div class="card" style="padding:16px 20px;">
                <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:12px;">
                    <div style="flex:1;">
                        <div style="display:flex; align-items:center; gap:8px; margin-bottom:6px;">
                            <strong>@s.StudentName</strong>
                            <code style="background:var(--bg-hover); padding:2px 6px; border-radius:4px; font-size:12px;">@s.StudentNumber</code>
                            @if (s.IsGraded)
                            {
                                <span class="badge badge-success">Qiymətləndirildi</span>
                            }
                            else
                            {
                                <span class="badge badge-warning">Gözləyir</span>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(s.Comment))
                        {
                            <p style="font-size:13px; color:var(--text-secondary); margin:0 0 6px; padding:8px; background:var(--bg-hover); border-radius:6px;">
                                @s.Comment
                            </p>
                        }
                        @if (!string.IsNullOrEmpty(s.FileUrl))
                        {
                            <div style="margin-bottom:6px;">
                                <a href="@s.FileUrl" target="_blank" style="display:inline-flex; align-items:center; gap:6px; font-size:12px; color:var(--accent); padding:4px 10px; background:var(--accent-soft); border-radius:6px; text-decoration:none;">
                                    <i class="fas fa-paperclip"></i> Əlavə fayl
                                </a>
                            </div>
                        }
                        <div style="font-size:12px; color:var(--text-secondary);">
                            <i class="fas fa-clock"></i> @s.SubmittedAt.ToString("dd.MM.yyyy HH:mm")
                            @if (s.IsGraded)
                            {
                                <span style="margin-left:12px; color:#22c55e; font-weight:600;">
                                    <i class="fas fa-star"></i> @s.Score / @s.MaxScore
                                </span>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(s.Feedback))
                        {
                            <p style="font-size:12px; color:var(--text-secondary); margin:6px 0 0; font-style:italic;">Rəy: @s.Feedback</p>
                        }
                    </div>

                    <div style="min-width:240px;">
                        <form method="post" action="/Teacher/Assignments/Grade">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="SubmissionId" value="@s.Id" />
                            <input type="hidden" name="assignmentId" value="@assignment?.Id" />
                            <input type="hidden" name="courseOfferingId" value="@assignment?.GroupId" />
                            <div style="display:flex; gap:6px; align-items:flex-end;">
                                <div style="flex:1;">
                                    <label style="font-size:12px; color:var(--text-secondary);">Xal (maks: @assignment?.MaxScore)</label>
                                    <input type="number" name="Score" class="form-control"
                                           value="@(s.Score?.ToString() ?? "")"
                                           min="0" max="@assignment?.MaxScore" step="0.5" required
                                           style="height:36px;" />
                                </div>
                                <button type="submit" class="btn btn-sm btn-primary" style="height:36px;">
                                    <i class="fas fa-check"></i> Qiymətləndir
                                </button>
                            </div>
                            <input type="text" name="Feedback" class="form-control"
                                   value="@s.Feedback" placeholder="Rəy (istəyə bağlı)"
                                   style="margin-top:6px; height:32px; font-size:13px;" />
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
