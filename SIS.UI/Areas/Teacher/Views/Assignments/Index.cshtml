@model IEnumerable<SIS.BLL.Services.DTOs.Assignment.AssignmentDto>
@{
    ViewData["Title"] = "Tapşırıqlar";
    var groupId = (int)ViewBag.GroupId;
}
<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
    <h2 style="font-size:20px; font-weight:700;">Tapşırıqlar</h2>
    <a href="/Teacher/Assignments/Create?groupId=@groupId" class="btn btn-primary"><i class="fas fa-plus"></i> Yeni</a>
</div>
<div class="card">
    <div class="card-body" style="padding:0;">
        <table class="table">
            <thead>
                <tr><th>Başlıq</th><th>Növ</th><th>Son tarix</th><th>Max bal</th><th>Cavablar</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td>
                            <strong>@a.Title</strong>
                            @if (!string.IsNullOrEmpty(a.AttachmentUrl))
                            {
                                <a href="@a.AttachmentUrl" target="_blank" style="margin-left:6px; color:var(--accent); font-size:11px;" title="Material faylı"><i class="fas fa-paperclip"></i></a>
                            }
                        </td>
                        <td>@a.TypeLabel</td>
                        <td>@a.DueDate.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@a.MaxScore</td>
                        <td>@a.SubmissionCount</td>
                        <td>
                            <a href="/Teacher/Assignments/Submissions/@a.Id" class="btn btn-sm btn-secondary">
                                <i class="fas fa-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" style="text-align:center; color:var(--text-secondary); padding:24px;">Tapşırıq yoxdur</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
