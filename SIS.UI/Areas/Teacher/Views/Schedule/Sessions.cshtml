@model IEnumerable<SIS.BLL.Services.DTOs.ClassSession.ClassSessionDto>
@using SIS.Entities.Enums
@{
    ViewData["Title"] = L["ClassSessions"].Value;
}
<div style="display:flex; align-items:center; gap:12px; margin-bottom:20px;">
    <a href="/Teacher/Courses" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left"></i></a>
    <h2 style="font-size:20px; font-weight:700;">@L["ClassSessions"]</h2>
</div>
<div class="card">
    <div class="card-body" style="padding:0;">
        <table class="table">
            <thead>
                <tr><th>#</th><th>@L["Date"]</th><th>Saat</th><th>@L["TodaysTopic"]</th><th>@L["Status"]</th></tr>
            </thead>
            <tbody>
                @foreach (var s in Model.OrderBy(x => x.Date))
                {
                    <tr>
                        <td style="color:var(--text-secondary);">@s.SessionNumber</td>
                        <td>@s.Date.ToString("dd.MM.yyyy")</td>
                        <td style="font-size:13px; color:var(--text-secondary);">@s.StartTime — @s.EndTime</td>
                        <td>@(string.IsNullOrEmpty(s.Topic) ? "—" : s.Topic)</td>
                        <td>
                            @if (s.Status == ClassSessionStatus.Scheduled)
                            {
                                <span class="badge badge-info">@L["NoData"]</span>
                            }
                            else if (s.Status == ClassSessionStatus.Completed)
                            {
                                <span class="badge badge-success">@L["Active"]</span>
                            }
                            else
                            {
                                <span class="badge badge-danger">@L["Cancel"]</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
