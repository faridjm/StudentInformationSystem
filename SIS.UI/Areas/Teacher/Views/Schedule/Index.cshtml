@model IEnumerable<SIS.BLL.Services.DTOs.Groups.GroupListDto>
@{
    ViewData["Title"] = "Dərs Cədvəli";
}

<h2 style="font-size:20px; font-weight:700; margin-bottom:20px;">Dərs Cədvəli — Qrup Seçin</h2>

<div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(300px, 1fr)); gap:16px;">
    @foreach (var g in Model)
    {
        <a href="/Teacher/Courses/Detail/@g.Id?tab=schedule" style="text-decoration:none;">
            <div class="card" style="padding:20px; cursor:pointer; transition:border-color 0.2s;" onmouseover="this.style.borderColor='var(--accent)'" onmouseout="this.style.borderColor='var(--border)'">
                <div style="font-size:16px; font-weight:700; margin-bottom:4px;">@g.Name</div>
                <div style="font-size:13px; color:var(--text-secondary); margin-bottom:12px;">@g.CourseName</div>
                <div style="display:flex; justify-content:space-between; font-size:12px; color:var(--text-secondary);">
                    <span><i class="fas fa-users"></i> @g.EnrolledCount tələbə</span>
                    <span><i class="fas fa-calendar"></i> @g.StartDate.ToString("dd.MM.yy") — @g.EndDate.ToString("dd.MM.yy")</span>
                </div>
            </div>
        </a>
    }
    @if (!Model.Any())
    {
        <p style="color:var(--text-secondary);">Sizə təyin olunmuş qrup yoxdur</p>
    }
</div>
