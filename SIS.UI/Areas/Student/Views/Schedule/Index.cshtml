@using SIS.BLL.Services.DTOs.ClassSession
@using SIS.BLL.Services.DTOs.Assessment
@using SIS.Entities.Enums
@{
    ViewData["Title"] = L["MyClassSchedule"].Value;
    var sessions = (List<ClassSessionDto>)ViewBag.Sessions;
    var assessments = (List<AssessmentItemDto>)ViewBag.Assessments;
    var today = (DateOnly)ViewBag.Today;
    var from = (DateOnly)ViewBag.From;
    var to = (DateOnly)ViewBag.To;
}

<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
    <h2 style="font-size:20px; font-weight:700;">@L["MyClassSchedule"]</h2>
    <form method="get" style="display:flex; gap:8px; align-items:center;">
        <input type="date" name="from" value="@from.ToString("yyyy-MM-dd")"
               class="form-control" style="width:145px;" />
        <span style="color:var(--text-secondary);">—</span>
        <input type="date" name="to" value="@to.ToString("yyyy-MM-dd")"
               class="form-control" style="width:145px;" />
        <button type="submit" class="btn btn-secondary btn-sm">
            <i class="fas fa-filter"></i>
        </button>
    </form>
</div>

<!-- Upcoming assessments -->
@{
    var upcomingAssessments = assessments
        .Where(a => DateOnly.FromDateTime(a.Date) >= today)
        .OrderBy(a => a.Date).Take(5).ToList();
}
@if (upcomingAssessments.Any())
{
    <div style="display:flex; gap:10px; margin-bottom:16px; overflow-x:auto; padding-bottom:4px;">
        @foreach (var a in upcomingAssessments)
        {
            var color = a.Type == AssessmentType.Quiz ? "#3b82f6" :
                        a.Type == AssessmentType.FinalProject ? "#e94560" : "#eab308";
            var icon = a.Type == AssessmentType.Quiz ? "fa-question-circle" :
                       a.Type == AssessmentType.FinalProject ? "fa-trophy" : "fa-file-alt";
            var label = a.Type == AssessmentType.Quiz ? "Quiz" :
                        a.Type == AssessmentType.FinalProject ? "Final" : L["AssessmentType_Assignment"].Value;
            var daysLeft = DateOnly.FromDateTime(a.Date).DayNumber - today.DayNumber;
            <div style="min-width:160px; background:@(color)15; border:1px solid @(color)44; border-radius:10px; padding:12px; flex-shrink:0;">
                <div style="font-size:10px; font-weight:700; color:@color; text-transform:uppercase; margin-bottom:4px;">
                    <i class="fas @icon"></i> @label
                </div>
                <div style="font-size:13px; font-weight:600; margin-bottom:4px;">@a.Title</div>
                <div style="font-size:11px; color:var(--text-secondary);">@a.Date.ToString("dd.MM.yyyy")</div>
                <div style="font-size:11px; color:@color; font-weight:600; margin-top:4px;">
                    @(daysLeft == 0 ? L["Today"].Value + "!" : daysLeft == 1 ? "→" : $"{daysLeft}")
                </div>
            </div>
        }
    </div>
}

<!-- Main schedule table -->
<div class="card">
    <div class="card-body" style="padding:0;">
        <table class="table">
            <thead>
                <tr>
                    <th style="width:50px;">#</th>
                    <th style="width:100px;">@L["Date"]</th>
                    <th style="width:80px;">Gün</th>
                    <th style="width:120px;">Saat</th>
                    <th>@L["TodaysTopic"]</th>
                    <th style="width:100px;">@L["Score"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in sessions)
                {
                    var isToday = s.Date == today;
                    var isPast = s.Date < today;
                    var aOnDate = assessments
                        .Where(a => DateOnly.FromDateTime(a.Date) == s.Date).ToList();
                    var rowBg = isToday ? "background:rgba(59,130,246,0.08);" :
                                isPast ? "opacity:0.65;" : "";
                    <tr style="@rowBg">
                        <td style="color:var(--text-secondary); font-size:13px;">@s.SessionNumber</td>
                        <td>
                            <div style="font-weight:@(isToday ? "700" : "400");">
                                @s.Date.ToString("dd.MM.yyyy")
                            </div>
                            @if (isToday)
                            {
                                <span style="font-size:10px; background:#3b82f6; color:#fff; padding:1px 6px; border-radius:4px; font-weight:600;">@L["Today"]</span>
                            }
                        </td>
                        @{
                            var dayName = s.Date.DayOfWeek switch {
                                DayOfWeek.Monday => "Mon",
                                DayOfWeek.Tuesday => "Tue",
                                DayOfWeek.Wednesday => "Wed",
                                DayOfWeek.Thursday => "C.ax.",
                                DayOfWeek.Friday => "Fri",
                                DayOfWeek.Saturday => "Sat",
                                _ => "Bazar"
                            };
                        }
                        <td style="font-size:12px; color:var(--text-secondary);">@dayName</td>
                        <td style="font-size:12px; color:var(--text-secondary);">@s.StartTime — @s.EndTime</td>
                        <td>
                            @if (!string.IsNullOrEmpty(s.Topic))
                            {
                                <span style="font-size:13px;">@s.Topic</span>
                            }
                            else
                            {
                                <span style="color:var(--text-secondary); font-size:12px; font-style:italic;">—</span>
                            }
                        </td>
                        <td>
                            @foreach (var a in aOnDate)
                            {
                                var color = a.Type == AssessmentType.Quiz ? "#3b82f6" :
                                            a.Type == AssessmentType.FinalProject ? "#e94560" : "#eab308";
                                var label = a.Type == AssessmentType.Quiz ? "Quiz" :
                                            a.Type == AssessmentType.FinalProject ? "Final" : "Tapş.";
                                <div style="font-size:10px; background:@(color)22; color:@color; padding:2px 7px; border-radius:4px; font-weight:700; margin-bottom:2px; white-space:nowrap;">
                                    @label: @a.Title
                                </div>
                            }
                        </td>
                    </tr>
                }
                @if (!sessions.Any())
                {
                    <tr>
                        <td colspan="6" style="text-align:center; color:var(--text-secondary); padding:30px;">
                            @L["NoData"]
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
