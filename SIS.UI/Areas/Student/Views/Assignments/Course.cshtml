@model IEnumerable<SIS.BLL.Services.DTOs.Assignment.AssignmentDto>
@{
    var enrollment = ViewBag.Enrollment as SIS.BLL.Services.DTOs.Enrollment.EnrollmentListDto;
    var submissionMap = ViewBag.SubmissionMap as Dictionary<int, SIS.BLL.Services.DTOs.Assignment.SubmissionDto>;
    ViewData["Title"] = L["Assignments"].Value;
}

<div style="display:flex; align-items:center; gap:12px; margin-bottom:20px;">
    <a href="/Student/Assignments" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left"></i></a>
    <div>
        <h2 style="font-size:20px; font-weight:700;">@enrollment?.CourseName</h2>
        <p style="color:var(--text-secondary); font-size:13px;">@L["Assignments"]</p>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card" style="padding:60px; text-align:center; color:var(--text-secondary);">
        <i class="fas fa-tasks" style="font-size:48px; margin-bottom:12px; opacity:.3;"></i>
        <p>@L["NoData"]</p>
    </div>
}
else
{
    <div style="display:flex; flex-direction:column; gap:16px;">
        @foreach (var a in Model)
        {
            var submitted = submissionMap != null && submissionMap.ContainsKey(a.Id);
            var submission = submitted ? submissionMap![a.Id] : null;
            var isOverdue = a.DueDate < DateTime.Now;

            <div class="card">
                <div class="card-header" style="display:flex; justify-content:space-between; align-items:center;">
                    <div style="display:flex; align-items:center; gap:8px;">
                        <span style="font-weight:600;">@a.Title</span>
                        <span class="badge badge-secondary" style="font-size:11px;">@a.TypeLabel</span>
                        @if (submitted && submission!.IsGraded)
                        {
                            <span class="badge badge-success">@L["Grades"]</span>
                        }
                        else if (submitted)
                        {
                            <span class="badge badge-warning">@L["Submit"]</span>
                        }
                        else if (isOverdue)
                        {
                            <span class="badge badge-danger">Vaxt bitib</span>
                        }
                    </div>
                    <div style="font-size:12px; color:var(--text-secondary);">
                        <i class="fas fa-clock"></i> @a.DueDate.ToString("dd.MM.yyyy HH:mm")
                        <span style="margin-left:8px;"><i class="fas fa-star"></i> @a.MaxScore xal</span>
                    </div>
                </div>
                <div class="card-body" style="padding:16px 20px;">
                    @if (!string.IsNullOrEmpty(a.Description))
                    {
                        <p style="font-size:14px; color:var(--text-secondary); margin-bottom:12px; padding:10px; background:var(--bg-hover); border-radius:6px;">
                            @a.Description
                        </p>
                    }
                    @if (!string.IsNullOrEmpty(a.AttachmentUrl))
                    {
                        <div style="margin-bottom:14px;">
                            <a href="@a.AttachmentUrl" target="_blank"
                               style="display:inline-flex; align-items:center; gap:6px; font-size:13px; color:var(--primary-color); padding:6px 12px; border:1px solid var(--border-color); border-radius:6px; text-decoration:none;">
                                <i class="fas fa-file-download"></i> @L["Download"]
                            </a>
                        </div>
                    }

                    @if (submitted)
                    {
                        <div style="padding:12px; background:var(--bg-hover); border-radius:8px; margin-bottom:@(submission!.IsGraded ? "12px" : "0");">
                            <div style="font-size:13px; font-weight:600; margin-bottom:6px; color:var(--text-secondary);">
                                <i class="fas fa-paper-plane"></i> @L["Submissions"] (@submission.SubmittedAt.ToString("dd.MM.yyyy HH:mm"))
                            </div>
                            @if (!string.IsNullOrEmpty(submission.Comment))
                            {
                                <p style="font-size:13px; margin:0;">@submission.Comment</p>
                            }
                            @if (!string.IsNullOrEmpty(submission.FileUrl))
                            {
                                <a href="@submission.FileUrl" target="_blank" style="font-size:12px; color:var(--primary-color);">
                                    <i class="fas fa-link"></i> @submission.FileUrl
                                </a>
                            }
                        </div>

                        @if (submission!.IsGraded)
                        {
                            <div style="display:flex; align-items:center; gap:16px; padding:12px; background:#f0fdf4; border-radius:8px; border:1px solid #bbf7d0;">
                                <div style="font-size:18px; font-weight:700; color:#22c55e;">
                                    <i class="fas fa-star"></i> @submission.Score / @a.MaxScore
                                </div>
                                @if (!string.IsNullOrEmpty(submission.Feedback))
                                {
                                    <div style="font-size:13px; color:var(--text-secondary); font-style:italic;">
                                        @L["Content"]: @submission.Feedback
                                    </div>
                                }
                            </div>
                        }
                    }
                    else if (!isOverdue)
                    {
                        <form method="post" action="/Student/Assignments/Submit" class="submit-form" data-id="@a.Id">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="assignmentId" value="@a.Id" />
                            <input type="hidden" name="enrollmentId" value="@enrollment!.Id" />
                            <input type="hidden" name="fileUrl" class="fileUrlInput" value="" />
                            <div class="form-group" style="margin-bottom:10px;">
                                <label style="font-size:13px; color:var(--text-secondary);">Cavab / Şərh</label>
                                <textarea name="comment" class="form-control" rows="3"
                                          placeholder="..."
                                          style="font-size:13px;"></textarea>
                            </div>
                            <div class="form-group" style="margin-bottom:12px;">
                                <label style="font-size:13px; color:var(--text-secondary);">Fayl (istəyə bağlı)</label>
                                <div class="upload-zone" data-id="@a.Id"
                                     style="border:2px dashed var(--border-color); border-radius:8px; padding:14px; text-align:center; cursor:pointer; font-size:13px;"
                                     onclick="document.getElementById('fi_@a.Id').click()">
                                    <div class="up-prompt">
                                        <i class="fas fa-paperclip" style="color:var(--text-secondary);"></i>
                                        <span style="color:var(--text-secondary); margin-left:6px;">Fayl seçin (PDF, Word, Şəkil, max 10MB)</span>
                                    </div>
                                    <div class="up-done" style="display:none; align-items:center; gap:8px; justify-content:center;">
                                        <i class="fas fa-file-alt" style="color:#22c55e;"></i>
                                        <span class="up-name" style="font-weight:500;"></span>
                                        <button type="button" class="up-clear" style="background:none;border:none;color:#ef4444;cursor:pointer;">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    </div>
                                </div>
                                <input type="file" id="fi_@a.Id" style="display:none"
                                       accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png,.gif,.zip,.txt,.pptx"
                                       data-id="@a.Id" />
                                <div class="up-err" style="color:#ef4444; font-size:12px; margin-top:4px; display:none;"></div>
                            </div>
                            <button type="submit" class="btn btn-primary btn-sm">
                                <i class="fas fa-paper-plane"></i> @L["Submit"]
                            </button>
                        </form>
                    }
                    else
                    {
                        <p style="font-size:13px; color:#ef4444;">
                            <i class="fas fa-lock"></i> @L["NoData"]
                        </p>
                    }
                </div>
            </div>
        }
    </div>
}

@section Scripts {
<script>
document.querySelectorAll('input[type="file"][data-id]').forEach(input => {
    input.addEventListener('change', async function() {
        const id = this.dataset.id;
        const file = this.files[0];
        if (!file) return;
        await uploadFile(id, file);
    });
});

document.querySelectorAll('.up-clear').forEach(btn => {
    btn.addEventListener('click', function(e) {
        e.stopPropagation();
        const zone = this.closest('.upload-zone');
        const form = this.closest('form');
        zone.querySelector('.up-done').style.display = 'none';
        zone.querySelector('.up-prompt').style.display = 'block';
        form.querySelector('.fileUrlInput').value = '';
        const id = zone.dataset.id;
        document.getElementById('fi_' + id).value = '';
    });
});

async function uploadFile(id, file) {
    const form = document.querySelector('form[data-id="' + id + '"]');
    const zone = form.querySelector('.upload-zone');
    const errEl = form.querySelector('.up-err');
    errEl.style.display = 'none';

    const token = form.querySelector('input[name="__RequestVerificationToken"]').value;
    const formData = new FormData();
    formData.append('file', file);

    try {
        const res = await fetch('/Upload/File', {
            method: 'POST',
            headers: { 'RequestVerificationToken': token },
            body: formData
        });
        if (!res.ok) {
            const err = await res.json();
            errEl.textContent = err.error || 'Fayl yüklənmədi';
            errEl.style.display = 'block';
            return;
        }
        const data = await res.json();
        form.querySelector('.fileUrlInput').value = data.url;
        zone.querySelector('.up-name').textContent = data.name;
        zone.querySelector('.up-prompt').style.display = 'none';
        zone.querySelector('.up-done').style.display = 'flex';
    } catch {
        errEl.textContent = 'Fayl yüklənmədi, yenidən cəhd edin';
        errEl.style.display = 'block';
    }
}
</script>
}
