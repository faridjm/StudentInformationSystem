@model List<(SIS.BLL.Services.DTOs.Enrollment.EnrollmentListDto enrollment, SIS.BLL.Services.DTOs.Quiz.QuizDto quiz, SIS.BLL.Services.DTOs.Quiz.QuizResultDto? myResult)>
@{
    ViewData["Title"] = "Quizlər";
}

<h2 style="font-size:20px; font-weight:700; margin-bottom:20px;">Aktiv Quizlər</h2>

@if (!Model.Any())
{
    <div class="card" style="padding:40px; text-align:center; color:var(--text-secondary);">
        <i class="fas fa-clipboard-question" style="font-size:48px; margin-bottom:12px; opacity:.3;"></i>
        <p>Hazırda cavablandıra biləcəyiniz aktiv quiz yoxdur</p>
    </div>
}
else
{
    <div style="display:flex; flex-direction:column; gap:12px;">
        @foreach (var (enrollment, quiz, myResult) in Model)
        {
            var taken = myResult != null && myResult.IsSubmitted;
            <div class="card" style="padding:16px 20px;">
                <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
                    <div>
                        <div style="display:flex; align-items:center; gap:8px;">
                            <strong style="font-size:15px;">@quiz.Title</strong>
                            @if (taken)
                            {
                                <span class="badge badge-success">Cavablandırılıb</span>
                            }
                        </div>
                        <div style="font-size:12px; color:var(--text-secondary); margin-top:4px;">
                            <i class="fas fa-book"></i> @enrollment.CourseName · @enrollment.GroupName ·
                            <i class="fas fa-question"></i> @quiz.QuestionCount sual
                            @if (quiz.DurationMinutes.HasValue) { <text>· <i class="fas fa-clock"></i> @quiz.DurationMinutes dəq</text> }
                        </div>
                    </div>
                    <div>
                        @if (taken)
                        {
                            <span style="font-weight:700; color:#22c55e; margin-right:8px;"><i class="fas fa-star"></i> @myResult!.Score%</span>
                            <a href="/Student/Quizzes/Take?quizId=@quiz.Id&enrollmentId=@enrollment.Id" class="btn btn-sm btn-secondary">Bax</a>
                        }
                        else
                        {
                            <a href="/Student/Quizzes/Take?quizId=@quiz.Id&enrollmentId=@enrollment.Id" class="btn btn-sm btn-primary">
                                <i class="fas fa-play"></i> Başla
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
