@model SIS.BLL.Services.DTOs.Quiz.QuizAttemptDetailDto
@{
    ViewData["Title"] = $"{Model.QuizTitle} — Nəticəm";
}

<div style="max-width:900px; margin:0 auto;">
    <div style="display:flex; align-items:center; gap:12px; margin-bottom:16px;">
        <a href="/Student/Quizzes" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left"></i></a>
        <div>
            <h2 style="font-size:20px; font-weight:700; margin:0;">@Model.QuizTitle</h2>
            <div style="font-size:13px; color:var(--text-secondary);">Təhvil verildi: @Model.SubmittedAt?.ToString("dd.MM.yyyy HH:mm")</div>
        </div>
    </div>

    <!-- Stat cards -->
    <div style="display:grid; grid-template-columns:repeat(5,1fr); gap:12px; margin-bottom:18px;">
        <div class="stat-card"><div><div class="stat-value">@(Model.Score?.ToString("F0") ?? "—")%</div><div class="stat-label">Nəticə</div></div></div>
        <div class="stat-card"><div><div class="stat-value">@Model.TotalQuestions</div><div class="stat-label">Sual</div></div></div>
        <div class="stat-card"><div><div class="stat-value" style="color:#22c55e;">@Model.CorrectCount</div><div class="stat-label">Doğru</div></div></div>
        <div class="stat-card"><div><div class="stat-value" style="color:#ef4444;">@Model.WrongCount</div><div class="stat-label">Səhv</div></div></div>
        <div class="stat-card"><div><div class="stat-value" style="color:#94a3b8;">@Model.EmptyCount</div><div class="stat-label">Boş</div></div></div>
    </div>

    @{ int qIdx = 0; }
    @foreach (var q in Model.Questions)
    {
        qIdx++;
        bool isEmpty = q.SelectedOptionIds == null || q.SelectedOptionIds.Count == 0;
        var border = isEmpty ? "#94a3b8" : (q.IsCorrect ? "#22c55e" : "#ef4444");
        <div class="card" style="margin-bottom:14px; border-left:4px solid @border;">
            <div class="card-body">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
                    <strong>Sual #@qIdx</strong>
                    @if (isEmpty)
                    {
                        <span class="badge" style="background:#e2e8f0; color:#475569;"><i class="fas fa-circle-minus"></i> Boş buraxıldı</span>
                    }
                    else if (q.IsCorrect)
                    {
                        <span class="badge badge-success"><i class="fas fa-check"></i> Doğru</span>
                    }
                    else
                    {
                        <span class="badge badge-danger"><i class="fas fa-times"></i> Səhv</span>
                    }
                </div>
                <div style="font-size:14px; margin-bottom:10px;">@q.Text</div>
                <div style="display:flex; flex-direction:column; gap:6px;">
                    @foreach (var o in q.Options)
                    {
                        // Tələbəyə yalnız: öz seçimi (yaşıl ya qırmızı) və səhv etmişsə doğru cavab
                        var showAsCorrect = o.IsCorrect && (q.IsCorrect ? o.WasSelected : true);
                        var showAsWrong = o.WasSelected && !o.IsCorrect;
                        var bg = showAsCorrect ? "rgba(34,197,94,0.12)" : showAsWrong ? "rgba(239,68,68,0.12)" : "var(--bg-hover)";
                        var color = showAsCorrect ? "#22c55e" : showAsWrong ? "#ef4444" : "var(--text-primary)";
                        <div style="padding:8px 12px; border-radius:6px; background:@bg; color:@color; display:flex; justify-content:space-between; align-items:center;">
                            <span>@o.Text</span>
                            <span style="font-size:11px; font-weight:600;">
                                @if (o.WasSelected && o.IsCorrect) { <span><i class="fas fa-check"></i> Cavabınız doğrudur</span> }
                                else if (o.WasSelected && !o.IsCorrect) { <span><i class="fas fa-times"></i> Cavabınız</span> }
                                else if (o.IsCorrect && !q.IsCorrect) { <span><i class="fas fa-check"></i> Doğru cavab</span> }
                            </span>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>
