@using SIS.Entities.Enums
@using SIS.BLL.Services.DTOs.Enrollment
@using SIS.BLL.Services.DTOs.Assessment
@using SIS.BLL.Services.DTOs.Assignment
@using SIS.BLL.Services.DTOs.Attendance
@using SIS.BLL.Services.DTOs.ClassSession
@using SIS.BLL.Services.DTOs.Announcement
@{
    var enrollment = ViewBag.Enrollment as EnrollmentListDto;
    ViewData["Title"] = enrollment?.CourseName ?? "Kurs";
    var attendance = ViewBag.Attendance as List<AttendanceDto> ?? new();
    var summary = ViewBag.Summary as AttendanceSummaryDto;
    var assessmentSubs = ViewBag.AssessmentSubs as List<AssessmentSubmissionDto> ?? new();
    var assignmentSubs = ViewBag.AssignmentSubs as List<SubmissionDto> ?? new();
    var sessions = ViewBag.Sessions as List<ClassSessionDto> ?? new();
    var announcements = ViewBag.Announcements as List<AnnouncementDto> ?? new();
    var assignments = ViewBag.Assignments as List<AssignmentDto> ?? new();
    var today = (DateOnly)ViewBag.Today;
    var activeTab = (string)ViewBag.ActiveTab ?? "overview";

    // Rəsmi qiymət
    var gradedOfficial = assessmentSubs.Where(s => s.IsGraded && s.MaxScore > 0).ToList();
    decimal offSum = 0; int offCnt = 0;
    foreach (var s in gradedOfficial) { offSum += (s.Score ?? 0) / s.MaxScore * 100; offCnt++; }
    var officialGrade = offCnt > 0 ? offSum / offCnt : (decimal?)null;
    var offColor = officialGrade == null ? "var(--text-secondary)" : officialGrade >= 70 ? "#22c55e" : officialGrade >= 50 ? "#eab308" : "#ef4444";

    // Tapşırıq ortalaması
    var gradedHw = assignmentSubs.Where(s => s.IsGraded && s.MaxScore > 0).ToList();
    decimal hwSum = 0; int hwCnt = 0;
    foreach (var s in gradedHw) { hwSum += (s.Score ?? 0) / s.MaxScore * 100; hwCnt++; }
    var hwAvg = hwCnt > 0 ? hwSum / hwCnt : (decimal?)null;

    var attPct = summary?.AttendancePercentage ?? 0;
    var attColor = attPct >= 80 ? "#22c55e" : attPct >= 60 ? "#eab308" : "#ef4444";

    var completedSessions = sessions.Count(s => s.Status == ClassSessionStatus.Completed);
}

<style>
    .tabs { display:flex; gap:2px; border-bottom:2px solid var(--border); margin-bottom:20px; overflow-x:auto; }
    .tab { padding:10px 16px; font-size:13px; font-weight:500; color:var(--text-secondary); cursor:pointer;
           border-bottom:2px solid transparent; margin-bottom:-2px; white-space:nowrap; text-decoration:none; transition:all .15s; }
    .tab:hover { color:var(--text-primary); background:var(--bg-hover); border-radius:6px 6px 0 0; }
    .tab.active { color:var(--accent); border-bottom-color:var(--accent); font-weight:600; }
    .tab-content { display:none; }
    .tab-content.active { display:block; }
    .mini-table { width:100%; border-collapse:collapse; font-size:13px; }
    .mini-table th { color:var(--text-secondary); font-size:11px; font-weight:600; text-transform:uppercase;
                     letter-spacing:.5px; padding:8px 10px; border-bottom:1px solid var(--border); text-align:left; }
    .mini-table td { padding:8px 10px; border-bottom:1px solid var(--border); vertical-align:middle; }
    .mini-table tbody tr:hover { background:var(--bg-hover); }
    .progress-bar { height:6px; background:var(--bg-hover); border-radius:3px; overflow:hidden; }
    .progress-fill { height:100%; border-radius:3px; }
</style>

<!-- Header -->
<div style="display:flex; align-items:center; gap:14px; margin-bottom:20px;">
    <a href="/Student/Courses" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left"></i></a>
    <div style="flex:1;">
        <h2 style="font-size:20px; font-weight:700; margin:0;">@enrollment?.CourseName</h2>
        <div style="font-size:13px; color:var(--text-secondary); margin-top:2px;">
            @enrollment?.GroupName · <i class="fas fa-chalkboard-teacher"></i> @enrollment?.TeacherName
        </div>
    </div>
    <a href="/Student/Messages/Start?groupId=@enrollment?.GroupId&teacherId=@enrollment?.TeacherId"
       style="display:inline-flex; align-items:center; gap:8px; padding:10px 18px; border-radius:10px;
              background:linear-gradient(135deg, #3b82f6, #2563eb); color:#fff; text-decoration:none;
              font-size:13px; font-weight:600; box-shadow:0 4px 15px rgba(59,130,246,0.4);
              transition:all .2s; margin-right:8px;"
       onmouseover="this.style.transform='translateY(-2px)'"
       onmouseout="this.style.transform=''">
        <i class="fas fa-comment-dots" style="font-size:15px;"></i>
        <span>@L["Messages"]</span>
    </a>
    <a href="/Student/Courses/Transcript/@enrollment?.Id" target="_blank"
       style="display:inline-flex; align-items:center; gap:10px; padding:10px 20px; border-radius:10px;
              background:linear-gradient(135deg, #e94560 0%, #c2185b 100%); color:#fff; text-decoration:none;
              font-size:13px; font-weight:600; box-shadow:0 4px 15px rgba(233,69,96,0.4);
              transition:all .2s; position:relative; overflow:hidden;"
       onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 6px 20px rgba(233,69,96,0.5)'"
       onmouseout="this.style.transform=''; this.style.boxShadow='0 4px 15px rgba(233,69,96,0.4)'">
        <span style="display:flex; align-items:center; justify-content:center; width:32px; height:32px; background:rgba(255,255,255,0.2); border-radius:8px;">
            <i class="fas fa-file-pdf" style="font-size:16px;"></i>
        </span>
        <span>
            <div style="line-height:1.2;">Transkript</div>
            <div style="font-size:10px; font-weight:400; opacity:.8;">PDF yüklə</div>
        </span>
        <i class="fas fa-download" style="font-size:11px; opacity:.7;"></i>
    </a>
</div>

<!-- Stat cards -->
<div style="display:grid; grid-template-columns:repeat(4,1fr); gap:12px; margin-bottom:16px;">
    <div class="stat-card">
        <div class="stat-icon" style="background:rgba(59,130,246,0.15); color:#3b82f6;"><i class="fas fa-graduation-cap"></i></div>
        <div>
            <div class="stat-value" style="color:@offColor;">@(officialGrade != null ? $"%{officialGrade.Value:F0}" : "—")</div>
            <div class="stat-label">@L["Score"]</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon" style="background:rgba(168,85,247,0.15); color:#a855f7;"><i class="fas fa-book"></i></div>
        <div>
            <div class="stat-value">@(hwAvg != null ? $"%{hwAvg.Value:F0}" : "—")</div>
            <div class="stat-label">@L["PDF_HomeworkAvg"]</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon" style="background:rgba(34,197,94,0.15); color:#22c55e;"><i class="fas fa-clipboard-check"></i></div>
        <div>
            <div class="stat-value" style="color:@attColor;">@attPct.ToString("F0")%</div>
            <div class="stat-label">@L["Attendance"]</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon" style="background:rgba(234,179,8,0.15); color:#eab308;"><i class="fas fa-chalkboard"></i></div>
        <div>
            <div class="stat-value">@completedSessions / @sessions.Count</div>
            <div class="stat-label">@L["ClassSessions"]</div>
        </div>
    </div>
</div>

<!-- Tabs -->
<div class="tabs">
    <a class="tab @(activeTab == "overview" ? "active" : "")" onclick="switchTab('overview')"><i class="fas fa-chart-pie" style="margin-right:6px;"></i>Ümumi</a>
    <a class="tab @(activeTab == "grades" ? "active" : "")" onclick="switchTab('grades')"><i class="fas fa-star" style="margin-right:6px;"></i>@L["Grades"]</a>
    <a class="tab @(activeTab == "attendance" ? "active" : "")" onclick="switchTab('attendance')"><i class="fas fa-user-check" style="margin-right:6px;"></i>@L["Attendance"]</a>
    <a class="tab @(activeTab == "schedule" ? "active" : "")" onclick="switchTab('schedule')"><i class="fas fa-calendar-alt" style="margin-right:6px;"></i>@L["Schedule"]</a>
    <a class="tab @(activeTab == "assignments" ? "active" : "")" onclick="switchTab('assignments')"><i class="fas fa-file-alt" style="margin-right:6px;"></i>@L["Assignments"]</a>
    <a class="tab @(activeTab == "announcements" ? "active" : "")" onclick="switchTab('announcements')"><i class="fas fa-bullhorn" style="margin-right:6px;"></i>@L["Announcements"]</a>
</div>

<!-- ====== TAB: Ümumi ====== -->
<div id="tab-overview" class="tab-content @(activeTab == "overview" ? "active" : "")">
    @{
        var todaySession = sessions.FirstOrDefault(s => s.Date == today);
        var nextSession = sessions.FirstOrDefault(s => s.Date > today);
        var upcomingAssessments = assessmentSubs.Where(s => !s.IsGraded).Take(3).ToList();
    }
    @if (todaySession != null)
    {
        <div class="card" style="border-left:3px solid var(--accent); padding:16px 20px; margin-bottom:12px;">
            <div style="font-size:12px; font-weight:600; color:var(--accent); margin-bottom:4px;">
                <i class="fas fa-calendar-day"></i> @L["TodaysLessons"] — #@todaySession.SessionNumber
            </div>
            <div style="font-size:14px; font-weight:500;">@(todaySession.Topic ?? L["NoData"].Value)</div>
            <div style="font-size:12px; color:var(--text-secondary); margin-top:4px;">@todaySession.StartTime — @todaySession.EndTime</div>
        </div>
    }
    else if (nextSession != null)
    {
        <div class="card" style="padding:16px 20px; margin-bottom:12px;">
            <div style="font-size:12px; color:var(--text-secondary);">Növbəti dərs:</div>
            <div style="font-size:14px; font-weight:500;">@nextSession.Date.ToString("dd.MM.yyyy") · #@nextSession.SessionNumber</div>
        </div>
    }

    @if (announcements.Any())
    {
        <div style="margin-bottom:16px;">
            <div style="font-size:13px; font-weight:600; margin-bottom:8px; color:var(--text-secondary);">Son Elanlar</div>
            @foreach (var a in announcements.Take(3))
            {
                <div style="padding:10px 14px; background:var(--bg-card); border:1px solid var(--border); border-radius:8px; margin-bottom:6px;">
                    <div style="display:flex; justify-content:space-between;">
                        <strong style="font-size:13px;">@a.Title</strong>
                        <span style="font-size:11px; color:var(--text-secondary);">@a.CreatedAt.ToString("dd.MM")</span>
                    </div>
                    <p style="font-size:12px; color:var(--text-secondary); margin:4px 0 0;">@(a.Content.Length > 100 ? a.Content[..100] + "..." : a.Content)</p>
                </div>
            }
        </div>
    }
</div>

<!-- ====== TAB: Qiymətlər ====== -->
<div id="tab-grades" class="tab-content @(activeTab == "grades" ? "active" : "")">
    <!-- Rəsmi Qiymətləndirmə -->
    @if (assessmentSubs.Any())
    {
        <div style="font-size:12px; font-weight:600; color:var(--accent); text-transform:uppercase; letter-spacing:.5px; margin-bottom:8px;">
            <i class="fas fa-graduation-cap"></i> @L["Assessment"]
            @if (officialGrade != null)
            {
                <span style="margin-left:12px; font-size:16px; font-weight:800; color:@offColor;">%@officialGrade.Value.ToString("F0")</span>
            }
        </div>
        <div class="card" style="margin-bottom:20px;">
            <div class="card-body" style="padding:0;">
                <table class="mini-table">
                    <thead><tr><th>@L["Title"]</th><th>@L["Score"]</th><th>@L["Percentage"]</th><th>@L["Status"]</th></tr></thead>
                    <tbody>
                        @foreach (var s in assessmentSubs.OrderBy(x => x.AssessmentTitle))
                        {
                            var pct = s.IsGraded && s.MaxScore > 0 ? (double)(s.Score ?? 0) / (double)s.MaxScore * 100 : (double?)null;
                            var sc = pct == null ? "var(--text-secondary)" : pct >= 70 ? "#22c55e" : pct >= 50 ? "#eab308" : "#ef4444";
                            <tr>
                                <td><strong>@s.AssessmentTitle</strong></td>
                                <td>
                                    @if (s.IsGraded) { <span style="font-weight:700; color:@sc;">@s.Score / @s.MaxScore</span> }
                                    else { <span style="color:var(--text-secondary);">—</span> }
                                </td>
                                <td>@if (pct != null) { <span style="color:@sc; font-weight:600;">%@pct.Value.ToString("F0")</span> }</td>
                                <td>
                                    @if (s.IsGraded) { <span class="badge badge-success">@L["Grades"]</span> }
                                    else { <span class="badge badge-warning">@L["Loading"]</span> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- Ev Tapşırıqları -->
    @if (assignmentSubs.Any())
    {
        <div style="font-size:12px; font-weight:600; color:#a855f7; text-transform:uppercase; letter-spacing:.5px; margin-bottom:8px;">
            <i class="fas fa-book"></i> @L["Assignments"]
            @if (hwAvg != null)
            {
                <span style="margin-left:12px; font-size:14px; font-weight:700;">%@hwAvg.Value.ToString("F0")</span>
            }
        </div>
        <div class="card">
            <div class="card-body" style="padding:0;">
                <table class="mini-table">
                    <thead><tr><th>@L["Title"]</th><th>@L["Score"]</th><th>@L["Percentage"]</th><th>@L["Status"]</th></tr></thead>
                    <tbody>
                        @foreach (var s in assignmentSubs.OrderBy(x => x.AssignmentTitle))
                        {
                            var pct = s.IsGraded && s.MaxScore > 0 ? (double)(s.Score ?? 0) / (double)s.MaxScore * 100 : (double?)null;
                            var sc = pct == null ? "var(--text-secondary)" : pct >= 70 ? "#22c55e" : pct >= 50 ? "#eab308" : "#ef4444";
                            <tr>
                                <td><strong>@s.AssignmentTitle</strong></td>
                                <td>
                                    @if (s.IsGraded) { <span style="font-weight:700; color:@sc;">@s.Score / @s.MaxScore</span> }
                                    else { <span style="color:var(--text-secondary);">—</span> }
                                </td>
                                <td>@if (pct != null) { <span style="color:@sc; font-weight:600;">%@pct.Value.ToString("F0")</span> }</td>
                                <td>
                                    @if (s.IsGraded) { <span class="badge badge-success">@L["Grades"]</span> }
                                    else { <span class="badge badge-warning">@L["Loading"]</span> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (!assessmentSubs.Any() && !assignmentSubs.Any())
    {
        <div class="card" style="padding:30px; text-align:center; color:var(--text-secondary);">@L["NoData"]</div>
    }

    @if (assessmentSubs.Any() || assignmentSubs.Any())
    {
        <div style="margin-top:12px; text-align:right;">
            <a href="/Student/Messages/Start?groupId=@enrollment?.GroupId&teacherId=@enrollment?.TeacherId&prefill=@Uri.EscapeDataString($"Salam, {enrollment?.CourseName} kursunda qiymətlərim haqqında sual vermək istəyirəm: ")"
               style="display:inline-flex; align-items:center; gap:6px; padding:6px 14px; border-radius:8px; background:var(--accent-soft); color:var(--accent); text-decoration:none; font-size:12px; font-weight:500; transition:all .15s;"
               onmouseover="this.style.background='var(--accent)'; this.style.color='#fff'" onmouseout="this.style.background='var(--accent-soft)'; this.style.color='var(--accent)'">
                <i class="fas fa-comment-dots"></i> @L["Messages"]
            </a>
        </div>
    }
</div>

<!-- ====== TAB: Davamiyyət ====== -->
<div id="tab-attendance" class="tab-content @(activeTab == "attendance" ? "active" : "")">
    <div style="display:flex; gap:16px; margin-bottom:16px;">
        <div class="stat-card" style="flex:1;">
            <div><div class="stat-value" style="color:#22c55e;">@(summary?.PresentCount ?? 0)</div><div class="stat-label">@L["Present"]</div></div>
        </div>
        <div class="stat-card" style="flex:1;">
            <div><div class="stat-value" style="color:#eab308;">@(summary?.LateCount ?? 0)</div><div class="stat-label">@L["Late"]</div></div>
        </div>
        <div class="stat-card" style="flex:1;">
            <div><div class="stat-value" style="color:#ef4444;">@(summary?.AbsentCount ?? 0)</div><div class="stat-label">@L["Absent"]</div></div>
        </div>
    </div>
    <div class="card">
        <div class="card-body" style="padding:0;">
            <table class="mini-table">
                <thead><tr><th>@L["Date"]</th><th>Sessiya</th><th>@L["Status"]</th></tr></thead>
                <tbody>
                    @foreach (var a in attendance.OrderByDescending(x => x.SessionDate))
                    {
                        <tr>
                            <td>@a.SessionDate.ToString("dd.MM.yyyy")</td>
                            <td style="color:var(--text-secondary);">#@(a.ClassSessionId)</td>
                            <td>
                                @switch (a.Status)
                                {
                                    case AttendanceStatus.Present: <span class="badge badge-success">@L["Present"]</span> break;
                                    case AttendanceStatus.Late: <span class="badge badge-warning">@L["Late"]</span> break;
                                    case AttendanceStatus.Absent: <span class="badge badge-danger">@L["Absent"]</span> break;
                                }
                            </td>
                        </tr>
                    }
                    @if (!attendance.Any())
                    {
                        <tr><td colspan="3" style="text-align:center; color:var(--text-secondary); padding:24px;">@L["NoData"]</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div style="margin-top:12px; text-align:right;">
        <a href="/Student/Messages/Start?groupId=@enrollment?.GroupId&teacherId=@enrollment?.TeacherId&prefill=@Uri.EscapeDataString($"Salam, {enrollment?.CourseName} kursunda davamiyyətim haqqında sual vermək istəyirəm: ")"
           style="display:inline-flex; align-items:center; gap:6px; padding:6px 14px; border-radius:8px; background:var(--accent-soft); color:var(--accent); text-decoration:none; font-size:12px; font-weight:500; transition:all .15s;"
           onmouseover="this.style.background='var(--accent)'; this.style.color='#fff'" onmouseout="this.style.background='var(--accent-soft)'; this.style.color='var(--accent)'">
            <i class="fas fa-comment-dots"></i> @L["Messages"]
        </a>
    </div>
</div>

<!-- ====== TAB: Cədvəl ====== -->
<div id="tab-schedule" class="tab-content @(activeTab == "schedule" ? "active" : "")">
    <div class="card">
        <div class="card-body" style="padding:0;">
            <table class="mini-table">
                <thead><tr><th>#</th><th>@L["Date"]</th><th>Saat</th><th>@L["TodaysTopic"]</th><th>@L["Status"]</th></tr></thead>
                <tbody>
                    @foreach (var s in sessions)
                    {
                        var isToday = s.Date == today;
                        var isPast = s.Date < today;
                        var rowStyle = isToday ? "background:rgba(59,130,246,0.08);" : isPast ? "opacity:0.6;" : "";
                        <tr style="@rowStyle">
                            <td style="color:var(--text-secondary);">@s.SessionNumber</td>
                            <td>
                                @s.Date.ToString("dd.MM.yy")
                                @if (isToday) { <span style="font-size:9px; background:#3b82f6; color:#fff; padding:1px 5px; border-radius:3px; margin-left:4px;">@L["Today"]</span> }
                            </td>
                            <td style="color:var(--text-secondary);">@s.StartTime–@s.EndTime</td>
                            <td>@(string.IsNullOrEmpty(s.Topic) ? "—" : s.Topic)</td>
                            <td>
                                @if (s.Status == ClassSessionStatus.Completed) { <span class="badge badge-success">@L["Active"]</span> }
                                else if (isToday) { <span class="badge badge-info">@L["Today"]</span> }
                                else { <span class="badge badge-warning">@L["NoData"]</span> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ====== TAB: Tapşırıqlar ====== -->
<div id="tab-assignments" class="tab-content @(activeTab == "assignments" ? "active" : "")">
    @if (assignments.Any())
    {
        <div style="display:flex; flex-direction:column; gap:10px;">
            @foreach (var a in assignments.OrderBy(x => x.DueDate))
            {
                var mySub = assignmentSubs.FirstOrDefault(s => s.AssignmentId == a.Id);
                var isOverdue = a.DueDate < DateTime.Now;
                <div class="card" style="padding:14px 18px;">
                    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px;">
                        <div style="flex:1;">
                            <div style="display:flex; align-items:center; gap:8px; margin-bottom:4px;">
                                <strong>@a.Title</strong>
                                @if (mySub != null && mySub.IsGraded) { <span class="badge badge-success">@L["Grades"]</span> }
                                else if (mySub != null) { <span class="badge badge-warning">@L["Submit"]</span> }
                                else if (isOverdue) { <span class="badge badge-danger">Vaxt bitib</span> }
                                @if (!string.IsNullOrEmpty(a.AttachmentUrl))
                                {
                                    <a href="@a.AttachmentUrl" target="_blank" style="color:var(--accent); font-size:11px;"><i class="fas fa-paperclip"></i></a>
                                }
                            </div>
                            <div style="font-size:12px; color:var(--text-secondary);">
                                Son tarix: @a.DueDate.ToString("dd.MM.yyyy HH:mm") · Max: @a.MaxScore xal
                                @if (mySub?.IsGraded == true) { <span style="color:#22c55e; margin-left:8px; font-weight:600;">@mySub.Score / @mySub.MaxScore</span> }
                            </div>
                        </div>
                        <div style="display:flex; gap:6px; align-items:center;">
                            @if (mySub == null && !isOverdue)
                            {
                                <a href="/Student/Assignments/Course?groupId=@enrollment?.GroupId&enrollmentId=@enrollment?.Id" class="btn btn-sm btn-primary">
                                    <i class="fas fa-paper-plane"></i> Cavab ver
                                </a>
                            }
                            <a href="/Student/Messages/Start?groupId=@enrollment?.GroupId&teacherId=@enrollment?.TeacherId&prefill=@Uri.EscapeDataString($"Salam, \"{a.Title}\" tapşırığı haqqında sualım var: ")"
                               style="padding:4px 8px; border-radius:6px; background:var(--accent-soft); color:var(--accent); text-decoration:none; font-size:11px; transition:all .15s;"
                               onmouseover="this.style.background='var(--accent)'; this.style.color='#fff'" onmouseout="this.style.background='var(--accent-soft)'; this.style.color='var(--accent)'"
                               title="@L["Messages"]">
                                <i class="fas fa-comment-dots"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card" style="padding:30px; text-align:center; color:var(--text-secondary);">@L["NoData"]</div>
    }
</div>

<!-- ====== TAB: Elanlar ====== -->
<div id="tab-announcements" class="tab-content @(activeTab == "announcements" ? "active" : "")">
    @if (announcements.Any())
    {
        <div style="display:flex; flex-direction:column; gap:8px;">
            @foreach (var a in announcements)
            {
                <div class="card" style="padding:14px 18px;">
                    <div style="display:flex; justify-content:space-between; margin-bottom:4px;">
                        <strong style="font-size:14px;">@a.Title</strong>
                        <span style="font-size:11px; color:var(--text-secondary);">@a.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                    </div>
                    <p style="font-size:13px; color:var(--text-secondary); margin:0; white-space:pre-wrap;">@a.Content</p>
                    <div style="font-size:11px; color:var(--text-secondary); margin-top:6px;"><i class="fas fa-user"></i> @a.AuthorName</div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card" style="padding:30px; text-align:center; color:var(--text-secondary);">Hələ elan yoxdur</div>
    }
</div>

@section Scripts {
<script>
function switchTab(name) {
    document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
    document.querySelectorAll('.tab').forEach(el => el.classList.remove('active'));
    document.getElementById('tab-' + name).classList.add('active');
    event.target.closest('.tab').classList.add('active');
    var url = new URL(window.location);
    url.searchParams.set('tab', name);
    history.replaceState(null, '', url);
}
</script>
}
