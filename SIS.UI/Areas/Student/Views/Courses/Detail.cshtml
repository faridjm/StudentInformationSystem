@{
    ViewData["Title"] = "Kurs Detalları";
    var enrollment = ViewBag.Enrollment as SIS.BLL.Services.DTOs.Enrollment.EnrollmentDetailDto;
    var grades = ViewBag.Grades as IEnumerable<SIS.BLL.Services.DTOs.Grade.GradeDto>;
    var attendance = ViewBag.Attendance as IEnumerable<SIS.BLL.Services.DTOs.Attendance.AttendanceDto>;
    var summary = ViewBag.Summary as SIS.BLL.Services.DTOs.Attendance.AttendanceSummaryDto;
}

<div style="display:flex; align-items:center; gap:12px; margin-bottom:20px;">
    <a href="/Student/Courses" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left"></i></a>
    <div>
        <h2 style="font-size:20px; font-weight:700;">@enrollment?.CourseName</h2>
        <p style="color:var(--text-secondary); font-size:13px;">@enrollment?.TeacherName • @enrollment?.TermName</p>
    </div>
</div>

<div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:16px;">
    <div class="stat-card">
        <div class="stat-icon" style="background:rgba(59,130,246,0.15); color:#3b82f6;">
            <i class="fas fa-star"></i>
        </div>
        <div>
            <div class="stat-value">@(enrollment?.AverageScore.ToString("F1") ?? "—")</div>
            <div class="stat-label">Orta Bal</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon" style="background:rgba(34,197,94,0.15); color:#22c55e;">
            <i class="fas fa-clipboard-check"></i>
        </div>
        <div>
            <div class="stat-value">@(summary?.AttendancePercentage.ToString("F0") ?? "—")%</div>
            <div class="stat-label">Davamiyyət</div>
        </div>
    </div>
</div>

<div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
    <div class="card">
        <div class="card-header">Qiymətlərim</div>
        <div style="overflow-x:auto;">
            <table class="table">
                <thead>
                    <tr>
                        <th>Növ</th>
                        <th>Bal</th>
                        <th>Hərf</th>
                    </tr>
                </thead>
                <tbody>
                    @if (grades != null)
                    {
                        @foreach (var g in grades)
                        {
                            <tr>
                                <td>@g.Type</td>
                                <td>@g.Score / @g.MaxScore</td>
                                <td>
                                    <span class="badge @(g.LetterGrade == "A" || g.LetterGrade == "B" ? "badge-success" : g.LetterGrade == "C" ? "badge-warning" : "badge-danger")">
                                        @g.LetterGrade
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card">
        <div class="card-header">Davamiyyətim</div>
        <div style="overflow-x:auto;">
            <table class="table">
                <thead>
                    <tr>
                        <th>Tarix</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (attendance != null)
                    {
                        @foreach (var a in attendance)
                        {
                            <tr>
                                <td>@a.SessionDate.ToString("dd.MM.yyyy")</td>
                                <td>
                                    @switch (a.Status)
                                    {
                                        case SIS.Entities.Enums.AttendanceStatus.Present:
                                            <span class="badge badge-success">✅ İştirak</span>
                                            break;
                                        case SIS.Entities.Enums.AttendanceStatus.Absent:
                                            <span class="badge badge-danger">❌ Qayıb</span>
                                            break;
                                        case SIS.Entities.Enums.AttendanceStatus.Late:
                                            <span class="badge badge-warning">⚠️ Gecikdi</span>
                                            break;
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>