@model IEnumerable<SIS.BLL.Services.DTOs.Enrollment.EnrollmentListDto>
@using SIS.Entities.Enums
@{
    ViewData["Title"] = L["MyCourses"].Value;
}

<div style="margin-bottom:20px;">
    <h2 style="font-size:20px; font-weight:700;">@L["MyCourses"]</h2>
</div>

<div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(320px,1fr)); gap:16px;">
    @foreach (var e in Model)
    {
        var statusBadge = e.Status == EnrollmentStatus.Active ? "badge-success" : e.Status == EnrollmentStatus.Completed ? "badge-info" : "badge-danger";
        var statusLabel = e.Status == EnrollmentStatus.Active ? L["Active"].Value : e.Status == EnrollmentStatus.Completed ? "✓" : "—";
        <a href="/Student/Courses/Detail/@e.Id" style="text-decoration:none;">
            <div class="card" style="cursor:pointer; transition:border-color .2s;" onmouseover="this.style.borderColor='var(--accent)'" onmouseout="this.style.borderColor='var(--border)'">
                <div class="card-header">
                    <div>
                        <div style="font-weight:700;">@e.CourseName</div>
                        <div style="font-size:12px; color:var(--text-secondary);">@e.GroupName</div>
                    </div>
                    <span class="badge @statusBadge">@statusLabel</span>
                </div>
                <div class="card-body" style="padding:12px 20px;">
                    <div style="color:var(--text-secondary); font-size:13px;">
                        <i class="fas fa-chalkboard-teacher"></i> @e.TeacherName
                    </div>
                </div>
            </div>
        </a>
    }
    @if (!Model.Any())
    {
        <div class="card" style="padding:40px; text-align:center; color:var(--text-secondary);">
            <i class="fas fa-book" style="font-size:32px; opacity:.3; margin-bottom:12px; display:block;"></i>
            @L["NoData"]
        </div>
    }
</div>
