@model IEnumerable<SIS.BLL.Services.DTOs.Enrollment.EnrollmentListDto>

@{
    ViewData["Title"] = "Kurslarım";
}

<div style="margin-bottom:20px;">
    <h2 style="font-size:20px; font-weight:700;">Kurslarım</h2>
</div>

<div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(320px,1fr)); gap:16px;">
    @foreach (var e in Model)
    {
        <div class="card">
            <div class="card-header">
                <div>
                    <div style="font-weight:700;">@e.CourseName</div>
                    <div style="font-size:12px; color:var(--text-secondary);">@e.CourseCode • @e.TermName</div>
                </div>
                <span class="badge badge-success">Aktiv</span>
            </div>
            <div class="card-body">
                <div style="color:var(--text-secondary); font-size:13px; margin-bottom:16px;">
                    <i class="fas fa-chalkboard-teacher"></i> @e.TeacherName
                </div>
                <a href="/Student/Courses/Detail/@e.Id" class="btn btn-primary btn-sm">
                    <i class="fas fa-eye"></i> Detallara bax
                </a>
            </div>
        </div>
    }
</div>