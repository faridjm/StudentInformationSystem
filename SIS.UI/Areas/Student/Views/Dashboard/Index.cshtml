@{
    ViewData["Title"] = L["Dashboard"].Value;
    var student = ViewBag.Student as SIS.BLL.Services.DTOs.Student.StudentDetailDto;
    var enrollments = ViewBag.Enrollments as IEnumerable<SIS.BLL.Services.DTOs.Enrollment.EnrollmentListDto>;
    var announcements = ViewBag.Announcements as IEnumerable<SIS.BLL.Services.DTOs.Announcement.AnnouncementDto>;
}

<div style="margin-bottom:24px;">
    <h2 style="font-size:20px; font-weight:700;">
        @L["Welcome"], @(student?.FullName ?? User.Identity?.Name)!
    </h2>
    <p style="color:var(--text-secondary); font-size:14px;">@DateTime.Now.ToString("dd MMMM yyyy")</p>
</div>

<div style="display:grid; grid-template-columns:repeat(3,1fr); gap:16px; margin-bottom:24px;">
    <div class="stat-card">
        <div class="stat-icon" style="background:rgba(34,197,94,0.15); color:#22c55e;">
            <i class="fas fa-book"></i>
        </div>
        <div>
            <div class="stat-value">@ViewBag.ActiveCourses</div>
            <div class="stat-label">Aktiv Kurs</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon" style="background:rgba(59,130,246,0.15); color:#3b82f6;">
            <i class="fas fa-star"></i>
        </div>
        <div>
            <div class="stat-value">@(student?.CurrentGPA.ToString("F2") ?? "0.00")</div>
            <div class="stat-label">GPA</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon" style="background:rgba(168,85,247,0.15); color:#a855f7;">
            <i class="fas fa-bell"></i>
        </div>
        <div>
            <div class="stat-value">@ViewBag.UnreadCount</div>
            <div class="stat-label">@L["NewNotification"]</div>
        </div>
    </div>
</div>

<div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
    <div class="card">
        <div class="card-header">
            <span><i class="fas fa-book" style="margin-right:8px;"></i>@L["MyCourses"]</span>
            <a href="/Student/Courses" class="btn btn-primary btn-sm">@L["ViewAll"]</a>
        </div>
        <div style="overflow-x:auto;">
            <table class="table">
                <thead>
                    <tr>
                        <th>@L["Course"]</th>
                        <th>@L["Teacher"]</th>
                        <th>@L["Status"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (enrollments != null)
                    {
                        @foreach (var e in enrollments)
                        {
                            <tr>
                                <td>
                                    <div style="font-weight:500;">@e.CourseName</div>
                                    <div style="font-size:12px; color:var(--text-secondary);">@e.CourseName ?? ""</div>
                                </td>
                                <td style="color:var(--text-secondary); font-size:13px;">@e.TeacherName</td>
                                <td><span class="badge badge-success">@L["Active"]</span></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <span><i class="fas fa-bullhorn" style="margin-right:8px;"></i>@L["Announcements"]</span>
            <a href="/Student/Announcements" class="btn btn-primary btn-sm">@L["ViewAll"]</a>
        </div>
        <div class="card-body">
            @if (announcements != null && announcements.Any())
            {
                @foreach (var a in announcements)
                {
                    <div style="padding:10px 0; border-bottom:1px solid var(--border);">
                        <div style="font-weight:500; font-size:14px;">@a.Title</div>
                        <div style="font-size:12px; color:var(--text-secondary);">@a.CreatedAt.ToString("dd.MM.yyyy")</div>
                    </div>
                }
            }
            else
            {
                <p style="color:var(--text-secondary); text-align:center;">@L["NoAnnouncements"]</p>
            }
        </div>
    </div>
</div>