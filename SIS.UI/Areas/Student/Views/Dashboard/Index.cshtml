@{
    ViewData["Title"] = L["Dashboard"].Value;
    var student = ViewBag.Student as SIS.BLL.Services.DTOs.Student.StudentDetailDto;
    var enrollments = ViewBag.Enrollments as IEnumerable<SIS.BLL.Services.DTOs.Enrollment.EnrollmentListDto>;
    var announcements = ViewBag.Announcements as IEnumerable<SIS.BLL.Services.DTOs.Announcement.AnnouncementDto>;

    var attendancePct = ViewBag.AttendancePct as double?;
    var officialGrade = ViewBag.OfficialGrade as decimal?;
    int pendingAssignments = ViewBag.PendingAssignments ?? 0;
    int certEligible = ViewBag.CertificateEligibleCount ?? 0;
    int certTotal = ViewBag.CertificateTotal ?? 0;
}

<div style="margin-bottom:24px; display:flex; justify-content:space-between; align-items:flex-start; gap:12px; flex-wrap:wrap;">
    <div>
        <h2 style="font-size:20px; font-weight:700;">
            @L["Welcome"], @(student?.FullName ?? User.Identity?.Name)! 🎓
        </h2>
        <p style="color:var(--text-muted); font-size:14px; margin-top:2px;">Keep learning, keep growing!</p>
    </div>
    <span class="badge badge-primary" style="font-size:12px;"><i class="fas fa-calendar-day"></i> @DateTime.Now.ToString("dd MMMM yyyy")</span>
</div>

<div class="workspace-grid" style="margin-bottom:24px;">
    <div class="stat-card card-accent">
        <div class="stat-icon"><i class="fas fa-book"></i></div>
        <div>
            <div class="stat-value">@ViewBag.ActiveCourses</div>
            <div class="stat-label">@L["ActiveCourses"]</div>
        </div>
    </div>
    <div class="stat-card card-accent">
        <div class="stat-icon"><i class="fas fa-user-check"></i></div>
        <div>
            <div class="stat-value">@(attendancePct.HasValue ? attendancePct.Value.ToString("F0") + "%" : "—")</div>
            <div class="stat-label">@L["Attendance"] %</div>
        </div>
    </div>
    <div class="stat-card card-accent">
        <div class="stat-icon"><i class="fas fa-percent"></i></div>
        <div>
            <div class="stat-value">@(officialGrade.HasValue ? officialGrade.Value.ToString("F1") + "%" : "—")</div>
            <div class="stat-label">@L["OfficialGrade"] %</div>
        </div>
    </div>
    <div class="stat-card card-accent">
        <div class="stat-icon"><i class="fas fa-graduation-cap"></i></div>
        <div>
            <div class="stat-value">@(student?.CurrentGPA.ToString("F2") ?? "0.00")</div>
            <div class="stat-label">GPA</div>
        </div>
    </div>
    <div class="stat-card card-accent">
        <div class="stat-icon"><i class="fas fa-file-pen"></i></div>
        <div>
            <div class="stat-value">@pendingAssignments</div>
            <div class="stat-label">@L["PendingAssignments"]</div>
        </div>
    </div>
    <div class="stat-card card-accent">
        <div class="stat-icon"><i class="fas fa-certificate"></i></div>
        <div>
            <div class="stat-value" style="font-size:18px;">
                @if (certTotal > 0)
                {
                    <span class="badge @(certEligible > 0 ? "badge-success" : "badge-warning")">@certEligible / @certTotal @L["Eligible"]</span>
                }
                else { <span style="color:var(--text-muted);">—</span> }
            </div>
            <div class="stat-label">@L["CertificateStatus"]</div>
        </div>
    </div>
</div>

<div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
    <div class="card">
        <div class="card-header">
            <span><i class="fas fa-book" style="margin-right:8px;"></i>@L["MyCourses"]</span>
            <a href="/Student/Courses" class="btn btn-primary btn-sm">@L["ViewAll"]</a>
        </div>
        <div style="overflow-x:auto;">
            <table class="table">
                <thead>
                    <tr>
                        <th>@L["Course"]</th>
                        <th>@L["Teacher"]</th>
                        <th>@L["Status"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (enrollments == null || !enrollments.Any())
                    {
                        <tr><td colspan="3"><div class="empty-state" style="padding:24px;"><i class="fas fa-book-open"></i><p>Hələ aktiv kursunuz yoxdur</p></div></td></tr>
                    }
                    else
                    {
                        @foreach (var e in enrollments)
                        {
                            <tr>
                                <td>
                                    <div style="font-weight:600;">@e.CourseName</div>
                                </td>
                                <td style="color:var(--text-secondary); font-size:13px;">@e.TeacherName</td>
                                <td><span class="badge badge-success">@L["Active"]</span></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <span><i class="fas fa-bullhorn" style="margin-right:8px;"></i>@L["Announcements"]</span>
            <a href="/Student/Announcements" class="btn btn-primary btn-sm">@L["ViewAll"]</a>
        </div>
        <div class="card-body">
            @if (announcements != null && announcements.Any())
            {
                @foreach (var a in announcements)
                {
                    <div style="padding:10px 0; border-bottom:1px solid var(--border);">
                        <div style="font-weight:500; font-size:14px;">@a.Title</div>
                        <div style="font-size:12px; color:var(--text-secondary);">@a.CreatedAt.ToString("dd.MM.yyyy")</div>
                    </div>
                }
            }
            else
            {
                <p style="color:var(--text-secondary); text-align:center;">@L["NoAnnouncements"]</p>
            }
        </div>
    </div>
</div>