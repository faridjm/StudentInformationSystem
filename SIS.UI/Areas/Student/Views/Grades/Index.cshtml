@using SIS.BLL.Services.DTOs.Enrollment
@using SIS.BLL.Services.DTOs.Assessment
@using SIS.BLL.Services.DTOs.Assignment
@using SIS.BLL.Services.DTOs.Transcript
@using SIS.Entities.Enums
@{
    ViewData["Title"] = L["MyGrades"].Value;
    var enrollments = (List<EnrollmentListDto>)ViewBag.Enrollments;
    var submissionsMap = (Dictionary<int, IEnumerable<AssessmentSubmissionDto>>)ViewBag.SubmissionsPerEnrollment;
    var assignmentSubsMap = (Dictionary<int, IEnumerable<SubmissionDto>>)ViewBag.AssignmentSubsPerEnrollment;
    var transcriptsMap = (Dictionary<int, TranscriptDto>)ViewBag.TranscriptsPerEnrollment;
}

<div style="margin-bottom:20px;">
    <h2 style="font-size:20px; font-weight:700;">@L["MyGrades"]</h2>
</div>

@if (!enrollments.Any())
{
    <div class="card"><div class="card-body" style="color:var(--text-secondary); text-align:center; padding:40px;">
        @L["NoData"]
    </div></div>
}

@foreach (var enrollment in enrollments)
{
    var subs = submissionsMap.GetValueOrDefault(enrollment.Id, []).ToList();
    var assignmentSubs = assignmentSubsMap.GetValueOrDefault(enrollment.Id, []).ToList();
    var transcript = transcriptsMap.GetValueOrDefault(enrollment.Id);

    // Vahid mənbə: transcript service (paneldə və PDF-də eyni)
    var officialGrade = transcript != null ? (decimal?)transcript.OfficialGrade : null;
    var hwAvg = transcript?.HomeworkAverage;
    var officialColor = officialGrade == null ? "var(--text-secondary)" : officialGrade >= 70 ? "#22c55e" : officialGrade >= 50 ? "#eab308" : "#ef4444";
    var hwColor = hwAvg == null ? "var(--text-secondary)" : hwAvg >= 70 ? "#22c55e" : hwAvg >= 50 ? "#eab308" : "#ef4444";

    <div class="card" style="margin-bottom:20px;">
        <div class="card-header">
            <div>
                <strong>@enrollment.GroupName</strong>
                <span style="color:var(--text-secondary); font-size:13px; margin-left:8px;">@enrollment.CourseName</span>
            </div>
            <div style="display:flex; align-items:center; gap:16px;">
                @if (officialGrade != null)
                {
                    <div style="text-align:center;">
                        <div style="font-size:20px; font-weight:800; color:@officialColor;">%@officialGrade.Value.ToString("F1")</div>
                        <div style="font-size:10px; color:var(--text-secondary);">@L["Score"]</div>
                    </div>
                }
                @if (hwAvg != null)
                {
                    <div style="text-align:center;">
                        <div style="font-size:16px; font-weight:600; color:@hwColor;">%@hwAvg.Value.ToString("F1")</div>
                        <div style="font-size:10px; color:var(--text-secondary);">@L["PDF_HomeworkAvg"]</div>
                    </div>
                }
                @if (officialGrade == null && hwAvg == null)
                {
                    <span style="color:var(--text-secondary); font-size:13px;">Hələ qiymət yoxdur</span>
                }
            </div>
        </div>

        <!-- Rəsmi Qiymətləndirmə -->
        @if (subs.Any())
        {
            <div style="padding:12px 20px 4px; font-size:12px; font-weight:600; color:var(--accent); text-transform:uppercase; letter-spacing:.5px;">
                <i class="fas fa-graduation-cap" style="margin-right:4px;"></i> @L["Assessment"]
            </div>
            <div style="padding:0;">
                <table class="table">
                    <thead>
                        <tr><th>@L["Title"]</th><th>@L["Score"]</th><th>@L["Percentage"]</th><th>@L["Status"]</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var s in subs.OrderBy(x => x.AssessmentTitle))
                        {
                            var pct = s.IsGraded && s.MaxScore > 0 ? (double)(s.Score ?? 0) / (double)s.MaxScore * 100 : (double?)null;
                            var scoreColor = pct == null ? "var(--text-secondary)" : pct >= 70 ? "#22c55e" : pct >= 50 ? "#eab308" : "#ef4444";
                            <tr>
                                <td><strong>@s.AssessmentTitle</strong></td>
                                <td>
                                    @if (s.IsGraded)
                                    {
                                        <span style="font-weight:700; color:@scoreColor;">@s.Score / @s.MaxScore</span>
                                    }
                                    else { <span style="color:var(--text-secondary);">—</span> }
                                </td>
                                <td>
                                    @if (pct != null) { <span style="color:@scoreColor; font-weight:600;">%@pct.Value.ToString("F1")</span> }
                                </td>
                                <td>
                                    @if (s.IsGraded) { <span class="badge badge-success">@L["Grades"]</span> }
                                    else { <span class="badge badge-warning">@L["Loading"]</span> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <!-- Ev Tapşırıqları -->
        @if (assignmentSubs.Any())
        {
            <div style="padding:12px 20px 4px; font-size:12px; font-weight:600; color:#a855f7; text-transform:uppercase; letter-spacing:.5px; border-top:1px solid var(--border);">
                <i class="fas fa-book" style="margin-right:4px;"></i> @L["Assignments"]
            </div>
            <div style="padding:0;">
                <table class="table">
                    <thead>
                        <tr><th>@L["Title"]</th><th>@L["Score"]</th><th>@L["Percentage"]</th><th>@L["Status"]</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var s in assignmentSubs.OrderBy(x => x.AssignmentTitle))
                        {
                            var pct = s.IsGraded && s.MaxScore > 0 ? (double)(s.Score ?? 0) / (double)s.MaxScore * 100 : (double?)null;
                            var scoreColor = pct == null ? "var(--text-secondary)" : pct >= 70 ? "#22c55e" : pct >= 50 ? "#eab308" : "#ef4444";
                            <tr>
                                <td><strong>@s.AssignmentTitle</strong></td>
                                <td>
                                    @if (s.IsGraded)
                                    {
                                        <span style="font-weight:700; color:@scoreColor;">@s.Score / @s.MaxScore</span>
                                    }
                                    else { <span style="color:var(--text-secondary);">—</span> }
                                </td>
                                <td>
                                    @if (pct != null) { <span style="color:@scoreColor; font-weight:600;">%@pct.Value.ToString("F1")</span> }
                                </td>
                                <td>
                                    @if (s.IsGraded) { <span class="badge badge-success">@L["Grades"]</span> }
                                    else { <span class="badge badge-warning">@L["Loading"]</span> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (!subs.Any() && !assignmentSubs.Any())
        {
            <div class="card-body" style="color:var(--text-secondary); font-size:13px;">Bu qrup üçün hələ qiymətləndirmə planı yoxdur</div>
        }
    </div>
}
