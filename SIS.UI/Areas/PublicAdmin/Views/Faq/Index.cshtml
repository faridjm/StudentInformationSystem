@model List<SIS.BLL.Services.DTOs.PublicAdmin.PublicFaqDto>
@{ ViewData["Title"] = "FAQ"; }

<style>
    .faq-row { background: #fff; border: 1px solid var(--pa-border); border-radius: 12px;
        padding: 16px 18px; margin-bottom: 10px; display: grid; grid-template-columns: 1fr auto; gap: 14px; align-items: start; }
    .faq-q { font-weight: 700; font-size: 14.5px; }
    .faq-cat { display: inline-block; font-size: 11px; color: var(--pa-primary); margin-top: 4px;
        background: rgba(124,58,237,.10); padding: 2px 8px; border-radius: 999px; }
    .faq-a { font-size: 13px; color: var(--pa-muted); margin-top: 6px; line-height: 1.55;
        display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .faq-chip { display: inline-flex; padding: 3px 9px; border-radius: 999px; font-size: 11px;
        font-weight: 700; text-transform: uppercase; letter-spacing: .4px; margin-right: 6px; }
    .faq-on { background: rgba(16,185,129,.12); color: #047857; }
    .faq-off { background: #F1F5F9; color: #475569; }
    .faq-actions { display: flex; gap: 8px; }
    .faq-btn { padding: 8px 12px; border-radius: 8px; border: 1px solid var(--pa-border); background: #fff;
        cursor: pointer; font-size: 12.5px; font-weight: 600; color: var(--pa-ink); text-decoration: none;
        display: inline-flex; align-items: center; gap: 5px; }
    .faq-btn:hover { border-color: var(--pa-primary); color: var(--pa-primary); }
    .faq-btn-danger { color: #DC2626; }
    .faq-btn-danger:hover { border-color: #DC2626; }
</style>

<div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:16px;">
    <div>
        <h1 style="font-size:20px; font-weight:800;"><i class="fas fa-circle-question" style="color:var(--pa-primary);"></i> FAQ</h1>
        <p style="font-size:13px; color:var(--pa-muted); margin-top:4px;">Tez-tez verilən sualları idarə edin.</p>
    </div>
    <a href="/PublicAdmin/Faq/Create"
       style="padding:9px 16px; background:linear-gradient(135deg,var(--pa-primary),var(--pa-primary-2));
              color:#fff; border-radius:10px; text-decoration:none; font-size:13.5px; font-weight:600;">
        <i class="fas fa-plus"></i> Yeni
    </a>
</div>

@if (!Model.Any())
{
    <div style="background:#fff; border:1px dashed var(--pa-border); border-radius:14px; padding:50px 20px; text-align:center; color:var(--pa-muted);">
        <i class="fas fa-circle-question" style="font-size:32px; opacity:.35; color:var(--pa-primary);"></i>
        <p style="margin-top:10px;">Hələ FAQ əlavə edilməyib.</p>
    </div>
}
else
{
    @foreach (var f in Model)
    {
        <div class="faq-row">
            <div>
                <div class="faq-q">@f.Question</div>
                @if (!string.IsNullOrEmpty(f.Category)) { <span class="faq-cat">@f.Category</span> }
                <div class="faq-a">@f.Answer</div>
                <div style="margin-top:8px;">
                    @if (f.IsVisible) { <span class="faq-chip faq-on">Görünür</span> }
                    else { <span class="faq-chip faq-off">Gizli</span> }
                    <span style="font-size:11px; color:var(--pa-muted);">Sıra: @f.SortOrder</span>
                </div>
            </div>
            <div class="faq-actions">
                <a href="/PublicAdmin/Faq/Edit?id=@f.Id" class="faq-btn"><i class="fas fa-pen"></i> Düzəliş</a>
                <form method="post" action="/PublicAdmin/Faq/Delete"
                      data-confirm="Bu FAQ silinsin?"
                      data-confirm-title="FAQ silinsin?"
                      data-confirm-text="Sil">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@f.Id" />
                    <button type="submit" class="faq-btn faq-btn-danger"><i class="fas fa-trash"></i></button>
                </form>
            </div>
        </div>
    }
}
