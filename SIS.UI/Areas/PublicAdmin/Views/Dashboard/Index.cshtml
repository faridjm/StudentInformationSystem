@model SIS.BLL.Services.DTOs.PublicAdmin.PublicAdminStatsDto
@{
    ViewData["Title"] = "Dashboard";
}

<style>
    .pa-hero { background: linear-gradient(135deg, var(--pa-primary), var(--pa-primary-2));
        color: #fff; padding: 26px 28px; border-radius: 16px; margin-bottom: 22px; }
    .pa-hero h1 { font-size: 22px; font-weight: 800; letter-spacing: -.4px; }
    .pa-hero p  { opacity: .9; margin-top: 6px; font-size: 14px; max-width: 720px; }

    .pa-kpi { display: grid; grid-template-columns: repeat(5, 1fr); gap: 14px; margin-bottom: 22px; }
    .pa-kpi .c { background: #fff; border: 1px solid var(--pa-border); padding: 16px;
        border-radius: 14px; display: flex; align-items: center; gap: 12px; }
    .pa-kpi .ico { width: 42px; height: 42px; border-radius: 11px;
        display: inline-flex; align-items: center; justify-content: center; font-size: 18px; }
    .pa-kpi .n { font-size: 22px; font-weight: 800; line-height: 1; color: var(--pa-ink); }
    .pa-kpi .l { font-size: 12px; color: var(--pa-muted); margin-top: 3px; }
    .pa-kpi .c.v1 .ico { background: rgba(124,58,237,.12); color: #6D28D9; }
    .pa-kpi .c.v2 .ico { background: rgba(79,70,229,.12); color: #4F46E5; }
    .pa-kpi .c.v3 .ico { background: rgba(16,185,129,.12); color: #059669; }
    .pa-kpi .c.v4 .ico { background: rgba(245,158,11,.14); color: #B45309; }
    .pa-kpi .c.v5 .ico { background: rgba(14,165,233,.12); color: #0369A1; }

    .pa-grid-2 { display: grid; grid-template-columns: 1.6fr 1fr; gap: 18px; }
    .pa-card { background: #fff; border: 1px solid var(--pa-border); border-radius: 14px; padding: 22px; }
    .pa-card h2 { font-size: 15px; font-weight: 800; margin-bottom: 14px;
        display: flex; align-items: center; gap: 8px; }
    .pa-card h2 i { color: var(--pa-primary); }

    .pa-quick { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .pa-quick a { padding: 14px 14px; border-radius: 12px; background: var(--pa-bg);
        text-decoration: none; color: var(--pa-ink); border: 1px solid var(--pa-border);
        display: flex; align-items: center; gap: 12px; transition: border-color .15s, transform .15s; }
    .pa-quick a:hover { border-color: var(--pa-primary); transform: translateY(-2px); }
    .pa-quick i { color: var(--pa-primary); font-size: 18px; }
    .pa-quick .t { font-weight: 700; font-size: 13.5px; }
    .pa-quick .s { font-size: 11.5px; color: var(--pa-muted); }

    @@media (max-width: 1180px) { .pa-kpi { grid-template-columns: repeat(2, 1fr); } .pa-grid-2 { grid-template-columns: 1fr; } }
    @@media (max-width: 480px)  { .pa-kpi { grid-template-columns: 1fr; } .pa-quick { grid-template-columns: 1fr; } }
</style>

<div class="pa-hero">
    <h1><i class="fas fa-globe"></i> Public Website İdarəetməsi</h1>
    <p>
        Bu panel public saytın vitrinini idarə edir — müraciətlər, public kurs/müəllim profilləri,
        akademiya şəraiti, məzun hekayələri, FAQ və contact mesajları.
    </p>
</div>

<div class="pa-kpi">
    <div class="c v1">
        <div class="ico"><i class="fas fa-book-open"></i></div>
        <div><div class="n">@Model.CoursesPublished<span style="color:var(--pa-muted); font-size:14px;">/@Model.CoursesTotal</span></div>
            <div class="l">Public Kurslar</div></div>
    </div>
    <div class="c v2">
        <div class="ico"><i class="fas fa-chalkboard-teacher"></i></div>
        <div><div class="n">@Model.TeachersPublished<span style="color:var(--pa-muted); font-size:14px;">/@Model.TeachersTotal</span></div>
            <div class="l">Public Müəllimlər</div></div>
    </div>
    <div class="c v3">
        <div class="ico"><i class="fas fa-school"></i></div>
        <div><div class="n">@Model.FacilitiesCount</div><div class="l">Facilities</div></div>
    </div>
    <div class="c v4">
        <div class="ico"><i class="fas fa-inbox"></i></div>
        <div><div class="n">@Model.NewApplications</div><div class="l">Yeni Müraciət</div></div>
    </div>
    <div class="c v5">
        <div class="ico"><i class="fas fa-envelope"></i></div>
        <div><div class="n">@Model.NewContactMessages</div><div class="l">Yeni Mesaj</div></div>
    </div>
</div>

<div class="pa-grid-2">
    <div class="pa-card">
        <h2><i class="fas fa-bolt"></i> Sürətli əməliyyatlar</h2>
        <div class="pa-quick">
            <a href="/PublicAdmin/Applications">
                <i class="fas fa-inbox"></i>
                <div><div class="t">Müraciətlər</div><div class="s">Yeni müraciətləri yoxla</div></div>
            </a>
            <a href="/PublicAdmin/PublicCourses">
                <i class="fas fa-book-open"></i>
                <div><div class="t">Public Kurslar</div><div class="s">Vitrin və profil idarə et</div></div>
            </a>
            <a href="/PublicAdmin/PublicTeachers">
                <i class="fas fa-chalkboard-teacher"></i>
                <div><div class="t">Public Müəllimlər</div><div class="s">Profil + şəkil + bio</div></div>
            </a>
            <a href="/PublicAdmin/Facilities">
                <i class="fas fa-school"></i>
                <div><div class="t">Facilities</div><div class="s">Akademiya şəraiti</div></div>
            </a>
            <a href="/PublicAdmin/Graduates">
                <i class="fas fa-user-graduate"></i>
                <div><div class="t">Məzun hekayələri</div><div class="s">Uğur hekayələri</div></div>
            </a>
            <a href="/PublicAdmin/Faq">
                <i class="fas fa-circle-question"></i>
                <div><div class="t">FAQ</div><div class="s">Suallar və cavablar</div></div>
            </a>
            <a href="/PublicAdmin/ContactMessages">
                <i class="fas fa-envelope"></i>
                <div><div class="t">Contact mesajları</div><div class="s">Ziyarətçi sorğuları</div></div>
            </a>
            <a href="/Public" target="_blank">
                <i class="fas fa-up-right-from-square"></i>
                <div><div class="t">Public sayt</div><div class="s">Vitrin görünüşünü aç</div></div>
            </a>
        </div>
    </div>

    <div class="pa-card">
        <h2><i class="fas fa-info-circle"></i> Kontent statusu</h2>
        <p style="color:var(--pa-muted); font-size:13.5px; line-height:1.65;">
            Akademik panel daxili idarəetmə üçündür. Bu panel public saytda nəyin görünəcəyini idarə edir.
            Akademik admindəki Course/Teacher yaradıldıqda public saytda <strong>avtomatik görünmür</strong> —
            ilk növbədə bu panelə qayıdıb Public Profile yaratmaq lazımdır.
        </p>
        <div style="margin-top:14px; padding-top:14px; border-top:1px solid var(--pa-border);
                    font-size:13px; color:var(--pa-muted); display:flex; flex-direction:column; gap:6px;">
            <div><i class="fas fa-check-circle" style="color:#10B981;"></i> Course üçün PublicProfile yarat</div>
            <div><i class="fas fa-check-circle" style="color:#10B981;"></i> IsVisible = true et</div>
            <div><i class="fas fa-check-circle" style="color:#10B981;"></i> Public saytda görüntülə</div>
        </div>
    </div>
</div>
