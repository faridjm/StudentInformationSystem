@model IEnumerable<SIS.Entities.Models.ActivityLog>

@{
    ViewData["Title"] = "Aktivlik Loqu";
}

<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
    <h2 style="font-size:20px; font-weight:700;">Aktivlik Loqu</h2>
    <form method="get" style="display:flex; gap:8px; align-items:center;">
        <label style="color:var(--text-secondary); font-size:13px;">Son</label>
        <select name="count" class="form-control" style="width:80px;" onchange="this.form.submit()">
            @{
                var counts = new[] { 25, 50, 100 };
                foreach (var c in counts)
                {
                    if (ViewBag.Count == c)
                    {
                        <option value="@c" selected>@c</option>
                    }
                    else
                    {
                        <option value="@c">@c</option>
                    }
                }
            }
        </select>
        <label style="color:var(--text-secondary); font-size:13px;">qeyd</label>
    </form>
</div>

<div class="card">
    <div style="overflow-x:auto;">
        <table class="table">
            <thead>
                <tr>
                    <th>Tarix</th>
                    <th>Əməliyyat</th>
                    <th>Entity</th>
                    <th>Entity ID</th>
                    <th>İstifadəçi</th>
                    <th>IP</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model)
                {
                    <tr>
                        <td style="color:var(--text-secondary); font-size:13px; white-space:nowrap;">
                            @log.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                        </td>
                        <td>
                            @switch (log.Action)
                            {
                                case "Create":
                                    <span class="badge badge-success"><i class="fas fa-plus"></i> Yarat</span>
                                    break;
                                case "Update":
                                    <span class="badge badge-warning"><i class="fas fa-edit"></i> Yenilə</span>
                                    break;
                                case "Delete":
                                    <span class="badge badge-danger"><i class="fas fa-trash"></i> Sil</span>
                                    break;
                                default:
                                    <span class="badge badge-info">@log.Action</span>
                                    break;
                            }
                        </td>
                        <td style="font-weight:500;">@log.EntityName</td>
                        <td style="color:var(--text-secondary);">@(log.EntityId ?? "—")</td>
                        <td style="color:var(--text-secondary); font-size:13px;">@log.UserId</td>
                        <td style="color:var(--text-secondary); font-size:13px;">@(log.IpAddress ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>