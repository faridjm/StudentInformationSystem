@model SIS.BLL.Services.DTOs.Teacher.TeacherDetailDto

@{
    ViewData["Title"] = "Müəllim Detalları";
}

<div style="display:flex; align-items:center; gap:12px; margin-bottom:20px;">
    <a href="/Admin/Teacher" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left"></i></a>
    <h2 style="font-size:20px; font-weight:700;">@Model.FullName</h2>
    <span class="badge @(Model.IsActive ? "badge-success" : "badge-danger")">
        @(Model.IsActive ? "Aktiv" : "Deaktiv")
    </span>
</div>

<div class="card" style="max-width:600px;">
    <div class="card-header">Müəllim Məlumatları</div>
    <div class="card-body">
        <table style="width:100%; font-size:14px;">
            <tr style="border-bottom:1px solid var(--border);">
                <td style="padding:10px 0; color:var(--text-secondary); width:40%;">Ad Soyad</td>
                <td style="padding:10px 0; font-weight:500;">@Model.FullName</td>
            </tr>
            <tr style="border-bottom:1px solid var(--border);">
                <td style="padding:10px 0; color:var(--text-secondary);">FIN Kod</td>
                <td style="padding:10px 0;">@(Model.FinCode ?? "—")</td>
            </tr>
            <tr style="border-bottom:1px solid var(--border);">
                <td style="padding:10px 0; color:var(--text-secondary);">Email</td>
                <td style="padding:10px 0;">@Model.Email</td>
            </tr>
            <tr style="border-bottom:1px solid var(--border);">
                <td style="padding:10px 0; color:var(--text-secondary);">Telefon</td>
                <td style="padding:10px 0;">@(Model.PhoneNumber ?? "—")</td>
            </tr>
            <tr style="border-bottom:1px solid var(--border);">
                <td style="padding:10px 0; color:var(--text-secondary);">İşçi №</td>
                <td style="padding:10px 0;"><code style="background:var(--bg-hover); padding:2px 8px; border-radius:4px;">@Model.EmployeeNumber</code></td>
            </tr>
            <tr style="border-bottom:1px solid var(--border);">
                <td style="padding:10px 0; color:var(--text-secondary);">Titul</td>
                <td style="padding:10px 0;">@Model.Title</td>
            </tr>
            <tr style="border-bottom:1px solid var(--border);">
                <td style="padding:10px 0; color:var(--text-secondary);">Departament</td>
                <td style="padding:10px 0;">@Model.DepartmentName</td>
            </tr>
            <tr>
                <td style="padding:10px 0; color:var(--text-secondary);">İşə Başlama</td>
                <td style="padding:10px 0;">@Model.HireDate.ToString("dd.MM.yyyy")</td>
            </tr>
        </table>
    </div>
</div>

<div style="margin-top:16px;">
    <a href="/Admin/Teacher/Edit/@Model.Id" class="btn btn-primary">
        <i class="fas fa-edit"></i> Düzəlt
    </a>
</div>