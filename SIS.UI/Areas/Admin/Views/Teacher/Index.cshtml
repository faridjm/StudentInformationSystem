@model IEnumerable<SIS.BLL.Services.DTOs.Teacher.TeacherListDto>

@{
    ViewData["Title"] = "Müəllimlər";
}

<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
    <h2 style="font-size:20px; font-weight:700;">Müəllimlər</h2>
    <a href="/Admin/Teacher/Create" class="btn btn-primary">
        <i class="fas fa-plus"></i> Yeni Müəllim
    </a>
</div>

<div class="card" style="margin-bottom:16px;">
    <div class="card-body" style="padding:14px 20px;">
        <form method="get" class="search-box">
            <input type="text" name="search" value="@ViewBag.SearchTerm"
                   class="search-input" placeholder="Ad, email və ya işçi nömrəsi ilə axtar..."
                   style="width:300px;" />
            <button type="submit" class="btn btn-secondary">
                <i class="fas fa-search"></i> Axtar
            </button>
            @if (!string.IsNullOrEmpty(ViewBag.SearchTerm as string))
            {
                <a href="/Admin/Teacher" class="btn btn-secondary">
                    <i class="fas fa-times"></i> Təmizlə
                </a>
            }
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <span>Cəmi: @Model.Count() müəllim</span>
    </div>
    <div style="overflow-x:auto;">
        <table class="table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Ad Soyad</th>
                    <th>Email</th>
                    <th>İşçi №</th>
                    <th>Qrup sayı</th>
                    <th>Status</th>
                    <th>Əməliyyat</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var teacher in Model)
                {
                    <tr>
                        <td>@teacher.Id</td>
                        <td>@teacher.FullName</td>
                        <td style="color:var(--text-secondary);">@teacher.Email</td>
                        <td><code style="background:var(--bg-hover); padding:2px 8px; border-radius:4px;">@teacher.EmployeeNumber</code></td>
                        <td>@teacher.GroupCount</td>
                        <td>
                            @if (teacher.IsActive)
                            {
                                <span class="badge badge-success">Aktiv</span>
                            }
                            else
                            {
                                <span class="badge badge-danger">Deaktiv</span>
                            }
                        </td>
                        <td>
                            <div style="display:flex; gap:6px;">
                                <a href="/Admin/Teacher/Detail/@teacher.Id" class="btn btn-sm btn-secondary">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="/Admin/Teacher/Edit/@teacher.Id" class="btn btn-sm btn-secondary">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form method="post" action="/Admin/Teacher/Delete/@teacher.Id"
                                      onsubmit="return confirm('Müəllimi silmək istədiyinizdən əminsinizmi?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>