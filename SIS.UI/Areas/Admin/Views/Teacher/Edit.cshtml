@model SIS.BLL.Services.DTOs.Teacher.UpdateTeacherDto
@{
    ViewData["Title"] = L["EditTeacher"].Value;
}
<div style="max-width:560px; margin:0 auto;">
    <div style="display:flex; align-items:center; gap:12px; margin-bottom:20px;">
        <a href="/Admin/Teacher/Detail/@Model.Id" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left"></i></a>
        <h2 style="font-size:20px; font-weight:700;">@L["EditTeacher"]</h2>
    </div>
    <form method="post" action="/Admin/Teacher/Edit">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="@Model.Id" />
        <div class="card">
            <div class="card-body">
                <div class="form-group">
                    <label class="form-label">@L["FullName"] *</label>
                    <input name="FullName" value="@Model.FullName" class="form-control" required />
                </div>
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
                    <div class="form-group">
                        <label class="form-label">@L["Phone"]</label>
                        <input name="PhoneNumber" value="@Model.PhoneNumber" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">FİN</label>
                        <input name="FinCode" value="@Model.FinCode" class="form-control" />
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">@L["Date"]</label>
                    <input name="BirthDate" type="date" value="@(Model.BirthDate?.ToString("yyyy-MM-dd"))" class="form-control" />
                </div>
            </div>
        </div>
        <div style="display:flex; gap:12px; margin-top:16px;">
            <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> @L["Save"]</button>
            <a href="/Admin/Teacher/Detail/@Model.Id" class="btn btn-secondary">@L["Cancel"]</a>
        </div>
    </form>
</div>
