@model SIS.BLL.Services.DTOs.Teacher.UpdateTeacherDto

@{
    ViewData["Title"] = "Müəllimi Düzəlt";
}

<div style="display:flex; align-items:center; gap:12px; margin-bottom:20px;">
    <a href="/Admin/Teacher" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left"></i></a>
    <h2 style="font-size:20px; font-weight:700;">Müəllimi Düzəlt</h2>
</div>

<div class="card" style="max-width:600px;">
    <div class="card-body">
        <form method="post">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" style="color:#f87171; margin-bottom:12px; font-size:13px;"></div>

            <div class="form-group">
                <label class="form-label">Ad Soyad</label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" style="color:#f87171; font-size:12px;"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Telefon</label>
                <input asp-for="PhoneNumber" class="form-control" />
            </div>

            <div class="form-group">
                <label class="form-label">Titul</label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" style="color:#f87171; font-size:12px;"></span>
            </div>

            <div class="form-group">
                <label class="form-label">FIN Kod</label>
                <input asp-for="FinCode" class="form-control" placeholder="5XB9Z23" />
            </div>

            <div class="form-group">
                <label class="form-label">Departament</label>
                <select asp-for="DepartmentId" class="form-control">
                    <option value="">Departament seçin</option>
                    @foreach (var d in ViewBag.Departments as IEnumerable<SIS.BLL.Services.DTOs.Department.DepartmentDto> ?? [])
                    {
                        if (Model != null && d.Id == Model.DepartmentId)
                        {
                            <option value="@d.Id" selected>@d.Name</option>
                        }
                        else
                        {
                            <option value="@d.Id">@d.Name</option>
                        }
                    }
                </select>
            </div>

            <div style="display:flex; gap:10px; margin-top:8px;">
                <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Yenilə</button>
                <a href="/Admin/Teacher" class="btn btn-secondary">Ləğv et</a>
            </div>
        </form>
    </div>
</div>