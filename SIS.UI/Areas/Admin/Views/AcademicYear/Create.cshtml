@model SIS.BLL.Services.DTOs.AcademicYear.CreateAcademicYearDto

@{
    ViewData["Title"] = "Yeni Dərs Sezonu";
}

<div style="display:flex; align-items:center; gap:12px; margin-bottom:20px;">
    <a href="/Admin/AcademicYear" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left"></i></a>
    <h2 style="font-size:20px; font-weight:700;">Yeni Dərs Sezonu</h2>
</div>

<div class="card" style="max-width:500px;">
    <div class="card-body">
        <form method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" style="color:#f87171; margin-bottom:12px; font-size:13px;"></div>

            <div class="form-group">
                <label class="form-label">Ad</label>
                <input asp-for="Name" class="form-control" placeholder="2026-27" maxlength="20" required />
                <span asp-validation-for="Name" style="color:#f87171; font-size:12px;"></span>
                <small style="color:var(--text-secondary); font-size:12px;">Məsələn: 2026-27</small>
            </div>

            <div class="form-group">
                <label class="form-label">Başlama Tarixi</label>
                <input asp-for="StartDate" type="date" class="form-control" required />
                <span asp-validation-for="StartDate" style="color:#f87171; font-size:12px;"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Bitmə Tarixi</label>
                <input asp-for="EndDate" type="date" class="form-control" required />
                <span asp-validation-for="EndDate" style="color:#f87171; font-size:12px;"></span>
            </div>

            <div style="display:flex; gap:10px; margin-top:8px;">
                <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Yarat</button>
                <a href="/Admin/AcademicYear" class="btn btn-secondary">Ləğv et</a>
            </div>
        </form>
    </div>
</div>
