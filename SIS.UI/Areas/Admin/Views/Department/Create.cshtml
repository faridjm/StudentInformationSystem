@model SIS.BLL.Services.DTOs.Department.CreateDepartmentDto

@{
    ViewData["Title"] = "Yeni Departament";
}

<div style="display:flex; align-items:center; gap:12px; margin-bottom:20px;">
    <a href="/Admin/Department" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left"></i></a>
    <h2 style="font-size:20px; font-weight:700;">Yeni Departament</h2>
</div>

<div class="card" style="max-width:500px;">
    <div class="card-body">
        <form method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" style="color:#f87171; margin-bottom:12px; font-size:13px;"></div>

            <div class="form-group">
                <label class="form-label">Ad</label>
                <input asp-for="Name" class="form-control" placeholder="Departament adı" />
                <span asp-validation-for="Name" style="color:#f87171; font-size:12px;"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Kod</label>
                <input asp-for="Code" class="form-control" placeholder="CS" />
                <span asp-validation-for="Code" style="color:#f87171; font-size:12px;"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Təsvir</label>
                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Departament haqqında qısa məlumat"></textarea>
            </div>

            <div style="display:flex; gap:10px; margin-top:8px;">
                <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Yarat</button>
                <a href="/Admin/Department" class="btn btn-secondary">Ləğv et</a>
            </div>
        </form>
    </div>
</div>