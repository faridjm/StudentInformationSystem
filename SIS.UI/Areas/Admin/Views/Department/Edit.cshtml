@model SIS.BLL.Services.DTOs.Department.UpdateDepartmentDto
@{
    ViewData["Title"] = L["EditDepartment"].Value;
}
<div style="max-width:560px; margin:0 auto;">
    <div style="display:flex; align-items:center; gap:12px; margin-bottom:20px;">
        <a href="/Admin/Department" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left"></i></a>
        <h2 style="font-size:20px; font-weight:700;">@L["EditDepartment"]</h2>
    </div>
    <form method="post" action="/Admin/Department/Edit">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="@Model.Id" />
        <div class="card">
            <div class="card-body">
                <div class="form-group">
                    <label class="form-label">@L["Name"] *</label>
                    <input name="Name" value="@Model.Name" class="form-control" required />
                </div>
                <div class="form-group">
                    <label class="form-label">@L["Description"]</label>
                    <textarea name="Description" class="form-control" rows="3">@Model.Description</textarea>
                </div>
                <div class="form-group">
                    <label class="form-label">@L["Status"]</label>
                    <select name="IsActive" class="form-control">
                        @if (Model.IsActive)
                        {
                            <option value="true" selected="selected">@L["Active"]</option>
                            <option value="false">Deaktiv</option>
                        }
                        else
                        {
                            <option value="true">@L["Active"]</option>
                            <option value="false" selected="selected">Deaktiv</option>
                        }
                    </select>
                </div>
            </div>
        </div>
        <div style="display:flex; gap:12px; margin-top:16px;">
            <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> @L["Save"]</button>
            <a href="/Admin/Department" class="btn btn-secondary">@L["Cancel"]</a>
        </div>
    </form>
</div>
