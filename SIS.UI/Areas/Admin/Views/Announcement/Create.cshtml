@model SIS.BLL.Services.DTOs.Announcement.CreateAnnouncementDto
@{
    ViewData["Title"] = L["NewAnnouncement"].Value;
    var groups = ViewBag.Groups as List<SIS.BLL.Services.DTOs.Groups.GroupListDto> ?? new();
}

<div style="display:flex; align-items:center; gap:12px; margin-bottom:20px;">
    <a href="/Admin/Announcement" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left"></i></a>
    <h2 style="font-size:20px; font-weight:700;">@L["NewAnnouncement"]</h2>
</div>

<div class="card" style="max-width:720px;">
    <div class="card-body">
        <form method="post" id="announcementForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="AttachmentUrl" id="attachmentUrlInput" />
            <div asp-validation-summary="ModelOnly" style="color:#f87171; margin-bottom:12px; font-size:13px;"></div>

            <div class="form-group">
                <label class="form-label">@L["Title"] *</label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" style="color:#f87171; font-size:12px;"></span>
            </div>

            <div class="form-group">
                <label class="form-label">@L["Content"] *</label>
                <textarea asp-for="Content" class="form-control" rows="5"></textarea>
                <span asp-validation-for="Content" style="color:#f87171; font-size:12px;"></span>
            </div>

            <!-- TARGET TYPE -->
            <div class="form-group">
                <label class="form-label">@L["AnnouncementTarget"] *</label>
                <select asp-for="TargetType" class="form-control" id="targetTypeSelect" onchange="onTargetChange(this.value)">
                    <option value="0">@L["TargetAll"]</option>
                    <option value="1">@L["TargetStudents"]</option>
                    <option value="2">@L["TargetTeachers"]</option>
                    <option value="4">@L["TargetGroupStudents"]</option>
                    <option value="5">@L["TargetSelectedUsers"]</option>
                </select>
            </div>

            <!-- GROUP STUDENTS — yalnız TargetType = GroupStudents (4) -->
            <div id="groupSection" class="form-group" style="display:none;">
                <label class="form-label">@L["Group"] *</label>
                <select asp-for="GroupId" class="form-control">
                    <option value="">@L["SelectGroup"]</option>
                    @foreach (var g in groups)
                    {
                        <option value="@g.Id">@g.Name — @g.CourseName @(string.IsNullOrEmpty(g.SeasonName) ? "" : "· " + g.SeasonName)</option>
                    }
                </select>
            </div>

            <!-- SELECTED USERS — yalnız TargetType = SelectedUsers (5) -->
            <div id="selectedUsersSection" class="form-group" style="display:none;">
                <label class="form-label">@L["SearchUsers"] *</label>
                <input type="text" id="userSearchInput" class="form-control" placeholder="@L["Search"]"
                       autocomplete="off" oninput="onSearchInput(this.value)" />
                <small style="color:var(--text-secondary); font-size:11px;">@L["MinimumTwoChars"]</small>
                <div id="userSearchResults" style="margin-top:8px; max-height:220px; overflow-y:auto; border-radius:6px;"></div>
                <div id="selectedUsersChips" style="margin-top:10px; display:flex; flex-wrap:wrap; gap:6px;"></div>
            </div>

            <!-- SEND EMAIL -->
            <div class="form-group">
                <label style="display:flex; align-items:center; gap:8px; cursor:pointer;">
                    <input type="checkbox" asp-for="SendEmail" style="width:16px; height:16px;" />
                    <span>@L["SendAsEmail"]</span>
                </label>
                <small style="color:var(--text-secondary); font-size:12px;">
                    @L["SendAsEmailHelp"]
                </small>
            </div>

            <!-- FILE UPLOAD -->
            <div class="form-group">
                <label class="form-label">Əlavə Fayl <span style="color:var(--text-secondary); font-size:12px;">(şəkil, PDF, Word, ZIP...)</span></label>
                <div id="dropZone" style="border:2px dashed var(--border); border-radius:8px; padding:18px; text-align:center; cursor:pointer; transition:border-color .2s;"
                     onclick="document.getElementById('attachFile').click()"
                     ondragover="event.preventDefault(); this.style.borderColor='#e94560';"
                     ondragleave="this.style.borderColor='var(--border)'"
                     ondrop="handleDrop(event)">
                    <i class="fas fa-paperclip" style="font-size:18px; color:var(--text-secondary); margin-bottom:6px; display:block;"></i>
                    <p style="color:var(--text-secondary); font-size:12px; margin:0;">Faylı sürükləyin və ya klikləyin</p>
                    <input type="file" id="attachFile" style="display:none;" onchange="uploadFile(this.files[0])" />
                </div>
                <div id="attachPreview" style="display:none; margin-top:8px; padding:8px 12px; background:var(--bg-hover); border-radius:6px; align-items:center; gap:10px;">
                    <i class="fas fa-file-alt" style="color:#e94560;"></i>
                    <span id="attachName" style="font-size:13px; flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"></span>
                    <button type="button" onclick="removeAttachment()" style="background:none; border:none; color:var(--text-secondary); cursor:pointer;"><i class="fas fa-times"></i></button>
                </div>
                <div id="uploadProgress" style="display:none; margin-top:6px; font-size:12px; color:var(--text-secondary);"><i class="fas fa-spinner fa-spin"></i> @L["Loading"]</div>
            </div>

            <div style="display:flex; gap:10px; margin-top:8px;">
                <button type="submit" class="btn btn-primary"><i class="fas fa-bullhorn"></i> @L["Submit"]</button>
                <a href="/Admin/Announcement" class="btn btn-secondary">@L["Cancel"]</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
// ── Target type → conditional sections ──
function onTargetChange(val) {
    document.getElementById('groupSection').style.display          = (val === '4') ? 'block' : 'none';
    document.getElementById('selectedUsersSection').style.display  = (val === '5') ? 'block' : 'none';
}
onTargetChange(document.getElementById('targetTypeSelect').value);

// ── Selected Users search + chips ──
const selectedUsers = new Map(); // userId → {fullName, email, role}
let searchTimer = null;

function onSearchInput(value) {
    clearTimeout(searchTimer);
    if (value.trim().length < 2) {
        document.getElementById('userSearchResults').innerHTML = '';
        return;
    }
    searchTimer = setTimeout(() => doSearch(value.trim()), 350);
}

function doSearch(q) {
    fetch('/Admin/Announcement/SearchUsers?query=' + encodeURIComponent(q))
        .then(r => r.ok ? r.json() : [])
        .then(renderSearchResults)
        .catch(() => renderSearchResults([]));
}

function renderSearchResults(users) {
    const box = document.getElementById('userSearchResults');
    if (!users || users.length === 0) {
        box.innerHTML = '<div style="padding:10px; color:var(--text-secondary); font-size:12px;">Nəticə yoxdur</div>';
        return;
    }
    box.innerHTML = users.map(u => {
        const isSel = selectedUsers.has(u.userId);
        return `<div style="display:flex; align-items:center; padding:8px 10px; border-radius:6px; cursor:pointer; ${isSel ? 'opacity:.5;' : ''}"
                     onmouseenter="this.style.background='var(--bg-hover)'" onmouseleave="this.style.background=''"
                     onclick="addUser('${u.userId}','${escapeJs(u.fullName)}','${escapeJs(u.email)}','${escapeJs(u.role)}')">
            <i class="fas fa-user" style="margin-right:8px; color:var(--text-secondary);"></i>
            <div style="flex:1; min-width:0;">
                <div style="font-weight:500; font-size:13px;">${escapeHtml(u.fullName)}</div>
                <div style="font-size:11px; color:var(--text-secondary);">${escapeHtml(u.email)} · ${escapeHtml(u.role || '—')}</div>
            </div>
            ${isSel ? '<i class="fas fa-check" style="color:#16a34a;"></i>' : '<i class="fas fa-plus" style="color:var(--text-secondary);"></i>'}
        </div>`;
    }).join('');
}

function addUser(id, fullName, email, role) {
    if (selectedUsers.has(id)) return;
    selectedUsers.set(id, { fullName, email, role });
    renderChips();
    document.getElementById('userSearchInput').value = '';
    document.getElementById('userSearchResults').innerHTML = '';
}

function removeUser(id) {
    selectedUsers.delete(id);
    renderChips();
}

function renderChips() {
    const box = document.getElementById('selectedUsersChips');
    const chips = [];
    selectedUsers.forEach((u, id) => {
        chips.push(`<span style="display:inline-flex; align-items:center; gap:6px; padding:4px 10px; background:rgba(233,69,96,.12); color:#e94560; border-radius:14px; font-size:12px;">
            ${escapeHtml(u.fullName)} · ${escapeHtml(u.role || '')}
            <button type="button" onclick="removeUser('${id}')" style="background:none; border:none; color:#e94560; cursor:pointer; font-size:11px;">
                <i class="fas fa-times"></i>
            </button>
        </span>`);
    });
    box.innerHTML = chips.join('');
}

// Form submit-də UserIds-ı array kimi göndər
document.getElementById('announcementForm').addEventListener('submit', function (e) {
    // Köhnə hidden input-ları sil
    document.querySelectorAll('input[name="UserIds"]').forEach(el => el.remove());

    selectedUsers.forEach((_, id) => {
        const input = document.createElement('input');
        input.type  = 'hidden';
        input.name  = 'UserIds';
        input.value = id;
        this.appendChild(input);
    });
});

function escapeHtml(s) { return (s || '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
function escapeJs(s)   { return (s || '').replace(/'/g, "\\'"); }

// ── File upload ──
function handleDrop(e) {
    e.preventDefault();
    document.getElementById('dropZone').style.borderColor = 'var(--border)';
    const file = e.dataTransfer.files[0];
    if (file) uploadFile(file);
}
async function uploadFile(file) {
    if (!file) return;
    document.getElementById('uploadProgress').style.display = 'block';
    document.getElementById('attachPreview').style.display = 'none';
    const formData = new FormData();
    formData.append('file', file);
    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
    const res = await fetch('/Upload/File', { method: 'POST', headers: { 'RequestVerificationToken': token }, body: formData });
    document.getElementById('uploadProgress').style.display = 'none';
    if (res.ok) {
        const data = await res.json();
        document.getElementById('attachmentUrlInput').value = data.url;
        document.getElementById('attachName').textContent = data.name;
        document.getElementById('attachPreview').style.display = 'flex';
    }
}
function removeAttachment() {
    document.getElementById('attachmentUrlInput').value = '';
    document.getElementById('attachPreview').style.display = 'none';
    document.getElementById('attachFile').value = '';
}
</script>
}
