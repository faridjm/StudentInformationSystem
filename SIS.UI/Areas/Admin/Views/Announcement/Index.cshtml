@using SIS.Entities.Enums
@model IEnumerable<SIS.BLL.Services.DTOs.Announcement.AnnouncementDto>

@{
    ViewData["Title"] = L["Announcements"].Value;

    string TargetLabel(AnnouncementTarget t) => t switch
    {
        AnnouncementTarget.All           => L["TargetAll"].Value,
        AnnouncementTarget.Students      => L["TargetStudents"].Value,
        AnnouncementTarget.Teachers      => L["TargetTeachers"].Value,
        AnnouncementTarget.GroupStudents => L["TargetGroupStudents"].Value,
        AnnouncementTarget.SelectedUsers => L["TargetSelectedUsers"].Value,
        AnnouncementTarget.Course        => L["GroupAnnouncement"].Value,
        _ => t.ToString()
    };
}

<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
    <h2 style="font-size:20px; font-weight:700;">@L["Announcements"]</h2>
    <a href="/Admin/Announcement/Create" class="btn btn-primary btn-sm">
        <i class="fas fa-plus"></i> @L["NewAnnouncement"]
    </a>
</div>

@if (!Model.Any())
{
    <div style="text-align:center; padding:60px 20px; color:var(--text-secondary);">
        <i class="fas fa-bullhorn" style="font-size:40px; opacity:.3; margin-bottom:12px; display:block;"></i>
        <p>@L["NoData"]</p>
    </div>
}
else
{
    <div class="card" style="padding:0; overflow-x:auto;">
        <table style="width:100%; border-collapse:collapse; font-size:13px;">
            <thead>
                <tr style="background:var(--bg-hover); text-align:left;">
                    <th style="padding:10px 14px;">@L["Title"]</th>
                    <th style="padding:10px 14px;">@L["AnnouncementTarget"]</th>
                    <th style="padding:10px 14px; text-align:center;">@L["Recipients"]</th>
                    <th style="padding:10px 14px; text-align:center;">@L["Read"]</th>
                    <th style="padding:10px 14px; text-align:center;">Email</th>
                    <th style="padding:10px 14px;">@L["CreatedAt"]</th>
                    <th style="padding:10px 14px;">@L["FullName"]</th>
                    <th style="padding:10px 14px; text-align:right;">@L["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model.OrderByDescending(x => x.CreatedAt))
                {
                    <tr style="border-top:1px solid var(--border);">
                        <td style="padding:10px 14px; font-weight:500;">
                            <a href="/Admin/Announcement/Detail/@a.Id" style="color:inherit; text-decoration:none;">
                                @a.Title
                            </a>
                            @if (!string.IsNullOrEmpty(a.AttachmentUrl))
                            {
                                <i class="fas fa-paperclip" style="color:var(--text-secondary); margin-left:6px; font-size:11px;"></i>
                            }
                        </td>
                        <td style="padding:10px 14px;">
                            <span class="badge badge-info">@TargetLabel(a.TargetType)</span>
                        </td>
                        <td style="padding:10px 14px; text-align:center;">@a.RecipientCount</td>
                        <td style="padding:10px 14px; text-align:center;">
                            @{
                                var readPct = a.RecipientCount > 0 ? (int)Math.Round(100.0 * a.ReadCount / a.RecipientCount) : 0;
                            }
                            <div style="display:flex; flex-direction:column; align-items:center; gap:4px;">
                                <span style="font-weight:600;">@a.ReadCount<span style="color:var(--text-secondary); font-weight:400;"> / @a.RecipientCount</span></span>
                                <div style="width:60px; height:4px; background:var(--bg-hover); border-radius:2px; overflow:hidden;">
                                    <div style="width:@(readPct)%; height:100%; background:#16a34a;"></div>
                                </div>
                            </div>
                        </td>
                        <td style="padding:10px 14px; text-align:center;">
                            @if (a.SendEmail)
                            {
                                var allSent = a.EmailSentCount >= a.RecipientCount && a.RecipientCount > 0;
                                var color   = allSent ? "#16a34a" : (a.EmailSentCount > 0 ? "#f59e0b" : "#dc2626");
                                <span style="color:@color; font-weight:600;">
                                    @a.EmailSentCount<span style="color:var(--text-secondary); font-weight:400;"> / @a.RecipientCount</span>
                                </span>
                            }
                            else
                            {
                                <span style="color:var(--text-secondary);">—</span>
                            }
                        </td>
                        <td style="padding:10px 14px; color:var(--text-secondary);">@a.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                        <td style="padding:10px 14px; color:var(--text-secondary);">@a.AuthorName</td>
                        <td style="padding:10px 14px; text-align:right; white-space:nowrap;">
                            <a href="/Admin/Announcement/Detail/@a.Id" class="btn btn-sm btn-secondary"><i class="fas fa-eye"></i></a>
                            <form method="post" action="/Admin/Announcement/Delete/@a.Id" style="display:inline;"
                                  data-confirm="Elanı silmək istədiyinizdən əminsinizmi?"
                                  data-confirm-title="Elanı silmək?"
                                  data-confirm-text="Sil">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
