@using SIS.Entities.Enums
@model SIS.BLL.Services.DTOs.Announcement.AnnouncementDetailDto

@{
    ViewData["Title"] = Model.Title;
    string TargetLabel(AnnouncementTarget t) => t switch
    {
        AnnouncementTarget.All           => L["TargetAll"].Value,
        AnnouncementTarget.Students      => L["TargetStudents"].Value,
        AnnouncementTarget.Teachers      => L["TargetTeachers"].Value,
        AnnouncementTarget.GroupStudents => L["TargetGroupStudents"].Value,
        AnnouncementTarget.SelectedUsers => L["TargetSelectedUsers"].Value,
        AnnouncementTarget.Course        => L["GroupAnnouncement"].Value,
        _ => t.ToString()
    };
}

<div style="display:flex; align-items:center; gap:12px; margin-bottom:20px;">
    <a href="/Admin/Announcement" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left"></i></a>
    <h2 style="font-size:20px; font-weight:700;">@Model.Title</h2>
    <span class="badge badge-info">@TargetLabel(Model.TargetType)</span>
</div>

<div style="display:grid; grid-template-columns:1fr 1fr 1fr 1fr; gap:12px; margin-bottom:18px;">
    <div class="card" style="padding:14px;">
        <div style="font-size:11px; color:var(--text-secondary);">@L["Recipients"]</div>
        <div style="font-size:22px; font-weight:700;">@Model.RecipientCount</div>
    </div>
    <div class="card" style="padding:14px;">
        <div style="font-size:11px; color:var(--text-secondary);">@L["Read"]</div>
        <div style="font-size:22px; font-weight:700; color:#16a34a;">@Model.ReadCount</div>
    </div>
    <div class="card" style="padding:14px;">
        <div style="font-size:11px; color:var(--text-secondary);">Email göndərildi</div>
        <div style="font-size:22px; font-weight:700;">
            @(Model.SendEmail ? $"{Model.EmailSentCount}/{Model.RecipientCount}" : "—")
        </div>
    </div>
    <div class="card" style="padding:14px;">
        <div style="font-size:11px; color:var(--text-secondary);">@L["CreatedAt"]</div>
        <div style="font-size:14px; font-weight:600; margin-top:4px;">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</div>
        <div style="font-size:11px; color:var(--text-secondary);">@Model.AuthorName</div>
    </div>
</div>

<div class="card" style="padding:18px; margin-bottom:18px;">
    <div style="font-weight:700; margin-bottom:10px;">@L["Content"]</div>
    <p style="line-height:1.7; white-space:pre-wrap; margin:0;">@Model.Content</p>
    @if (!string.IsNullOrEmpty(Model.AttachmentUrl))
    {
        <div style="margin-top:14px; padding:10px 14px; background:var(--bg-hover); border-radius:6px;">
            <a href="@Model.AttachmentUrl" target="_blank" style="color:#e94560; text-decoration:none;">
                <i class="fas fa-paperclip"></i> Əlavə faylı yüklə
            </a>
        </div>
    }
</div>

<div class="card" style="padding:0; overflow-x:auto;">
    <div style="padding:14px 16px; font-weight:700; border-bottom:1px solid var(--border);">
        @L["Recipients"] (@Model.Recipients.Count)
    </div>
    <table style="width:100%; border-collapse:collapse; font-size:13px;">
        <thead>
            <tr style="background:var(--bg-hover); text-align:left;">
                <th style="padding:10px 14px;">@L["FullName"]</th>
                <th style="padding:10px 14px;">@L["Email"]</th>
                <th style="padding:10px 14px;">Role</th>
                <th style="padding:10px 14px; text-align:center;">@L["Read"]</th>
                <th style="padding:10px 14px; text-align:center;">Email</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Recipients)
            {
                <tr style="border-top:1px solid var(--border);">
                    <td style="padding:10px 14px; font-weight:500;">@r.FullName</td>
                    <td style="padding:10px 14px; color:var(--text-secondary);">@r.Email</td>
                    <td style="padding:10px 14px;">@(r.Role ?? "—")</td>
                    <td style="padding:10px 14px; text-align:center;">
                        @if (r.IsRead)
                        {
                            <span class="badge badge-success" title="@(r.ReadAt?.ToString("dd.MM.yyyy HH:mm"))">@L["Read"]</span>
                        }
                        else
                        {
                            <span class="badge" style="background:var(--bg-hover); color:var(--text-secondary);">@L["Unread"]</span>
                        }
                    </td>
                    <td style="padding:10px 14px; text-align:center;">
                        @if (r.EmailSent)
                        {
                            <i class="fas fa-check-circle" style="color:#16a34a;" title="@(r.EmailSentAt?.ToString("dd.MM.yyyy HH:mm"))"></i>
                        }
                        else if (Model.SendEmail)
                        {
                            <i class="fas fa-times-circle" style="color:#dc2626;" title="Göndərilmədi"></i>
                        }
                        else
                        {
                            <span style="color:var(--text-secondary);">—</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
