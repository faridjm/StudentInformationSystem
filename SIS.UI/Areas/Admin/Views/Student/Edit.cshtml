@model SIS.BLL.Services.DTOs.Student.UpdateStudentDto
@{
    ViewData["Title"] = "Tələbəni Düzəlt";
}
<div style="max-width:560px; margin:0 auto;">
    <div style="display:flex; align-items:center; gap:12px; margin-bottom:20px;">
        <a href="/Admin/Student/Detail/@Model.Id" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left"></i></a>
        <h2 style="font-size:20px; font-weight:700;">Tələbəni Düzəlt</h2>
    </div>
    <form method="post" action="/Admin/Student/Edit">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="@Model.Id" />
        <div class="card">
            <div class="card-body">
                <div class="form-group">
                    <label class="form-label">Ad Soyad *</label>
                    <input name="FullName" value="@Model.FullName" class="form-control" required />
                </div>
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
                    <div class="form-group">
                        <label class="form-label">FİN kod</label>
                        <input name="FinCode" value="@Model.FinCode" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Telefon</label>
                        <input name="PhoneNumber" value="@Model.PhoneNumber" class="form-control" />
                    </div>
                </div>
            </div>
        </div>
        <div style="display:flex; gap:12px; margin-top:16px;">
            <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Yadda saxla</button>
            <a href="/Admin/Student/Detail/@Model.Id" class="btn btn-secondary">Ləğv et</a>
        </div>
    </form>
</div>
