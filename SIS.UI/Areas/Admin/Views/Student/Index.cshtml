@model IEnumerable<SIS.BLL.Services.DTOs.Student.StudentListDto>

@{
    ViewData["Title"] = "Tələbələr";
}

<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
    <h2 style="font-size:20px; font-weight:700;">Tələbələr</h2>
    <a href="/Admin/Student/Create" class="btn btn-primary">
        <i class="fas fa-plus"></i> Yeni Tələbə
    </a>
</div>

<!-- Search -->
<div class="card" style="margin-bottom:16px;">
    <div class="card-body" style="padding:14px 20px;">
        <form method="get" class="search-box">
            <input type="text" name="search" value="@ViewBag.SearchTerm"
                   class="search-input" placeholder="Ad, email və ya tələbə nömrəsi ilə axtar..."
                   style="width:300px;" />
            <button type="submit" class="btn btn-secondary">
                <i class="fas fa-search"></i> Axtar
            </button>
            @if (!string.IsNullOrEmpty(ViewBag.SearchTerm as string))
            {
                <a href="/Admin/Student" class="btn btn-secondary">
                    <i class="fas fa-times"></i> Təmizlə
                </a>
            }
        </form>
    </div>
</div>

<!-- Table -->
<div class="card">
    <div class="card-header">
        <span>Cəmi: @Model.Count() tələbə</span>
    </div>
    <div style="overflow-x:auto;">
        <table class="table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Ad Soyad</th>
                    <th>Email</th>
                    <th>Tələbə №</th>
                    <th>İl</th>
                    <th>GPA</th>
                    <th>Status</th>
                    <th>Əməliyyat</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var student in Model)
                {
                    <tr>
                        <td>@student.Id</td>
                        <td>@student.FullName</td>
                        <td style="color:var(--text-secondary);">@student.Email</td>
                        <td><code style="background:var(--bg-hover); padding:2px 8px; border-radius:4px;">@student.StudentNumber</code></td>
                        <td>@student.EnrollmentYear</td>
                        <td>
                            <span style="font-weight:600; color:@(student.CurrentGPA >= 3 ? "#22c55e" : student.CurrentGPA >= 2 ? "#eab308" : "#ef4444")">
                                @student.CurrentGPA.ToString("F2")
                            </span>
                        </td>
                        <td>
                            @if (student.IsActive)
                            {
                                <span class="badge badge-success">Aktiv</span>
                            }
                            else
                            {
                                <span class="badge badge-danger">Deaktiv</span>
                            }
                        </td>
                        <td>
                            <div style="display:flex; gap:6px;">
                                <a href="/Admin/Student/Detail/@student.Id" class="btn btn-sm btn-secondary">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="/Admin/Student/Edit/@student.Id" class="btn btn-sm btn-secondary">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form method="post" action="/Admin/Student/Delete/@student.Id"
                                      onsubmit="return confirm('Tələbəni silmək istədiyinizdən əminsinizmi?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>