@model IEnumerable<SIS.BLL.Services.DTOs.Student.StudentListDto>

@{
    ViewData["Title"] = L["Students"].Value;
}

<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
    <h2 style="font-size:20px; font-weight:700;">@L["Students"]</h2>
    <a href="/Admin/Student/Create" class="btn btn-primary">
        <i class="fas fa-plus"></i> @L["NewStudent"]
    </a>
</div>

<!-- Search -->
<div class="card" style="margin-bottom:16px;">
    <div class="card-body" style="padding:14px 20px;">
        <form method="get" class="search-box">
            <input type="text" name="search" value="@ViewBag.SearchTerm"
                   class="search-input" placeholder="@L["Search"]"
                   style="width:300px;" />
            <button type="submit" class="btn btn-secondary">
                <i class="fas fa-search"></i> @L["Search"]
            </button>
            @if (!string.IsNullOrEmpty(ViewBag.SearchTerm as string))
            {
                <a href="/Admin/Student" class="btn btn-secondary">
                    <i class="fas fa-times"></i>
                </a>
            }
        </form>
    </div>
</div>

<!-- Table -->
<div class="card">
    <div class="card-header">
        <span>@Model.Count() @L["Students"]</span>
    </div>
    <div style="overflow-x:auto;">
        <table class="table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>@L["FullName"]</th>
                    <th>@L["Email"]</th>
                    <th>İstifadəçi №</th>
                    <th>@L["PDF_EnrollmentYear"]</th>
                    <th>GPA</th>
                    <th>@L["Status"]</th>
                    <th>@L["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var student in Model)
                {
                    <tr>
                        <td>@student.Id</td>
                        <td>@student.FullName</td>
                        <td style="color:var(--text-secondary);">@student.Email</td>
                        <td><code style="background:var(--bg-hover); padding:2px 8px; border-radius:4px;">@student.StudentNumber</code></td>
                        <td>@student.EnrollmentYear</td>
                        <td>
                            <span style="font-weight:600; color:@(student.CurrentGPA >= 3 ? "#22c55e" : student.CurrentGPA >= 2 ? "#eab308" : "#ef4444")">
                                @student.CurrentGPA.ToString("F2")
                            </span>
                        </td>
                        <td>
                            @if (student.IsActive)
                            {
                                <span class="badge badge-success">@L["Active"]</span>
                            }
                            else
                            {
                                <span class="badge badge-danger">Deaktiv</span>
                            }
                        </td>
                        <td>
                            <div style="display:flex; gap:6px;">
                                <a href="/Admin/Student/Detail/@student.Id" class="btn btn-sm btn-secondary">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="/Admin/Student/Edit/@student.Id" class="btn btn-sm btn-secondary">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form method="post" action="/Admin/Student/Delete/@student.Id"
                                      data-confirm="Tələbə silinsin? Bu əməliyyat geri qaytarılmaya bilər."
                                      data-confirm-title="Tələbəni silmək istəyirsiniz?"
                                      data-confirm-text="Sil">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>
