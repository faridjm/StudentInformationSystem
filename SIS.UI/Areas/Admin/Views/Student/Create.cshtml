@{
    ViewData["Title"] = L["NewStudent"].Value;
}
<div style="max-width:560px; margin:0 auto;">
    <div style="display:flex; align-items:center; gap:12px; margin-bottom:20px;">
        <a href="/Admin/Student" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left"></i></a>
        <h2 style="font-size:20px; font-weight:700;">@L["NewStudent"]</h2>
    </div>
    <form method="post" action="/Admin/Student/Create">
        @Html.AntiForgeryToken()
        <div class="card">
            <div class="card-body">
                <div class="form-group">
                    <label class="form-label">@L["FullName"] *</label>
                    <input name="FullName" id="fullNameInput" class="form-control"
                           autocomplete="off" required />
                </div>
                <div class="form-group">
                    <label class="form-label">
                        @L["Email"]
                        <span id="emailHint"
                              style="font-size:12px; color:var(--text-secondary); margin-left:6px; display:none;">
                            (institutional email təklif edildi)
                        </span>
                    </label>
                    <div style="position:relative;">
                        <input name="Email" id="emailInput" type="email" class="form-control"
                               placeholder="ad@@sis.az və ya ad@@gmail.com"
                               autocomplete="off" />
                        <span id="emailSpinner"
                              style="display:none; position:absolute; right:12px; top:50%;
                                     transform:translateY(-50%); color:var(--text-secondary);">
                            <i class="fas fa-spinner fa-spin"></i>
                        </span>
                    </div>
                    <small style="color:var(--text-secondary);">
                        Boş buraxsanız sistem avtomatik @@sis.az email yaradacaq.
                        İstənilən valid email qəbul edilir.
                    </small>
                </div>
                <div class="form-group">
                    <label class="form-label">@L["Password"] *</label>
                    <div style="position:relative;">
                        <input name="Password" id="passwordInput" type="password" class="form-control"
                               placeholder="@L["MinChars"]" required style="padding-right:44px;" />
                        <button type="button" onclick="togglePass()"
                                style="position:absolute; right:12px; top:50%; transform:translateY(-50%);
                                       background:none; border:none; color:var(--text-secondary); cursor:pointer; font-size:16px;">
                            <i id="passIcon" class="fas fa-eye"></i>
                        </button>
                    </div>
                </div>
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
                    <div class="form-group">
                        <label class="form-label">@L["Phone"]</label>
                        <input name="PhoneNumber" class="form-control" placeholder="+994501234567" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">FİN</label>
                        <input name="FinCode" class="form-control" placeholder="7KUE4F8" maxlength="7" />
                    </div>
                </div>
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
                    <div class="form-group">
                        <label class="form-label">@L["BirthDate"]</label>
                        <input name="BirthDate" type="date" class="form-control"
                               max="@DateTime.Today.ToString("yyyy-MM-dd")"
                               placeholder="@L["BirthDate"]" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">@L["RegistrationDate"]</label>
                        <input type="date" class="form-control"
                               value="@DateTime.Today.ToString("yyyy-MM-dd")"
                               readonly
                               style="background:var(--bg-hover); cursor:not-allowed;" />
                    </div>
                </div>
                <input type="hidden" name="EnrollmentYear" value="@DateTime.Now.Year" />
            </div>
        </div>

        <!-- ── Optional: Valideyn paneli hesabı ── -->
        <div class="card" style="margin-top:16px;">
            <div class="card-header"><i class="fas fa-user-shield" style="margin-right:8px;"></i> Valideyn paneli (istəyə bağlı)</div>
            <div class="card-body">
                <div id="ageHelper" style="font-size:13px; padding:8px 12px; border-radius:8px; display:none; margin-bottom:12px;"></div>

                <label style="display:flex; align-items:center; gap:8px; cursor:pointer; font-weight:600;">
                    <input type="checkbox" name="CreateParentAccount" value="true" id="createParentChk" onchange="toggleParentFields()" />
                    Bu tələbə üçün valideyn hesabı yarat
                </label>

                <div id="parentFields" style="display:none; margin-top:14px;">
                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
                        <div class="form-group">
                            <label class="form-label">Valideynin ad-soyadı</label>
                            <input name="ParentFullName" class="form-control" placeholder="Məs: Aysel Məmmədova" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Əlaqə növü</label>
                            <select name="ParentRelationshipType" class="form-control" asp-items="Html.GetEnumSelectList<SIS.Entities.Enums.RelationshipType>()"></select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Email / Login</label>
                            <input name="ParentEmail" type="email" class="form-control" placeholder="boş buraxsanız parent009@@sis.az auto yaranır" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Telefon (optional)</label>
                            <input name="ParentPhone" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Müvəqqəti parol</label>
                            <input name="ParentPassword" class="form-control" placeholder="boş buraxsanız Parent009! auto yaranır" />
                        </div>
                    </div>
                    <div style="font-size:12px; color:var(--text-secondary); margin-top:4px;">
                        Tələbənin birdən çox valideyni olacaqsa, sonradan tələbə detalından əlavə edə bilərsiniz.
                    </div>
                </div>
            </div>
        </div>

        <div style="display:flex; gap:12px; margin-top:16px;">
            <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> @L["Save"]</button>
            <a href="/Admin/Student" class="btn btn-secondary">@L["Cancel"]</a>
        </div>
    </form>
</div>

@section Scripts {
<script>
(function () {
    var fullNameInput = document.getElementById('fullNameInput');
    var emailInput    = document.getElementById('emailInput');
    var emailHint     = document.getElementById('emailHint');
    var emailSpinner  = document.getElementById('emailSpinner');

    var debounceTimer   = null;
    var userEditedEmail = false;

    // Admin əl ilə yazarsa — auto-fill deaktiv olur
    emailInput.addEventListener('input', function () {
        userEditedEmail = true;
        emailHint.style.display = 'none';
    });

    // Email tamamilə silinərsə — auto-fill yenidən aktiv olur
    emailInput.addEventListener('blur', function () {
        if (emailInput.value.trim() === '') {
            userEditedEmail = false;
            triggerGenerate();
        }
    });

    fullNameInput.addEventListener('input', function () {
        clearTimeout(debounceTimer);
        if (userEditedEmail) return;
        debounceTimer = setTimeout(triggerGenerate, 600);
    });

    function triggerGenerate() {
        var raw   = fullNameInput.value.trim();
        var parts = raw.split(/\s+/);
        if (parts.length < 2 || parts[1].length === 0) return;

        var firstName = parts[0];
        var lastName  = parts.slice(1).join(' ');

        emailSpinner.style.display = 'inline';

        fetch('/Admin/Student/GenerateEmail?firstName=' +
              encodeURIComponent(firstName) + '&lastName=' + encodeURIComponent(lastName))
            .then(function (r) { return r.ok ? r.json() : null; })
            .then(function (data) {
                emailSpinner.style.display = 'none';
                if (data && data.email) {
                    emailInput.value            = data.email;
                    emailHint.style.display     = 'inline';
                    userEditedEmail             = false;
                }
            })
            .catch(function () { emailSpinner.style.display = 'none'; });
    }

    window.togglePass = function () {
        var input = document.getElementById('passwordInput');
        var icon  = document.getElementById('passIcon');
        if (input.type === 'password') { input.type = 'text';     icon.className = 'fas fa-eye-slash'; }
        else                           { input.type = 'password'; icon.className = 'fas fa-eye';       }
    };
})();

// Valideyn fields toggle
function toggleParentFields() {
    var chk = document.getElementById('createParentChk');
    var fields = document.getElementById('parentFields');
    if (fields) fields.style.display = chk.checked ? 'block' : 'none';
}

// Yaşa görə helper (18 yoxlaması — yalnız tövsiyə, bloklamır)
(function () {
    var bd = document.querySelector('input[name="BirthDate"]');
    var helper = document.getElementById('ageHelper');
    if (!bd || !helper) return;
    function calc() {
        if (!bd.value) { helper.style.display = 'none'; return; }
        var d = new Date(bd.value);
        var age = Math.floor((Date.now() - d.getTime()) / (365.25 * 24 * 3600 * 1000));
        helper.style.display = 'block';
        if (age < 18) {
            helper.style.background = '#FEF3C7'; helper.style.color = '#92400e';
            helper.textContent = 'Bu tələbə 18 yaşdan kiçikdir (' + age + '). Valideyn hesabı yaratmaq tövsiyə olunur.';
        } else {
            helper.style.background = '#DBEAFE'; helper.style.color = '#1e40af';
            helper.textContent = 'Bu tələbə yetkindir (' + age + '). Valideyn hesabı yaratmaq optionaldır.';
        }
    }
    bd.addEventListener('change', calc);
    calc();
})();
</script>
}
