@using SIS.UI.ViewModels
@model SIS.BLL.Services.DTOs.Student.StudentDetailDto

@{
    ViewData["Title"] = L["StudentDetails"].Value;
    var academicRows = ViewBag.AcademicRows as List<StudentAcademicRowVm> ?? new List<StudentAcademicRowVm>();

    string StatusBadge(EnrollmentStatus s) => s switch
    {
        EnrollmentStatus.Active => "badge-success",
        EnrollmentStatus.Completed => "badge-info",
        EnrollmentStatus.Dropped => "badge-danger",
        _ => "badge-secondary"
    };
}

<div style="display:flex; align-items:center; gap:12px; margin-bottom:20px;">
    <a href="/Admin/Student" class="btn btn-secondary btn-sm">
        <i class="fas fa-arrow-left"></i>
    </a>
    <h2 style="font-size:20px; font-weight:700;">@Model.FullName</h2>
    <span class="badge @(Model.IsActive ? "badge-success" : "badge-danger")">
        @(Model.IsActive ? L["Active"].Value : "Deaktiv")
    </span>
</div>

<div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
    <div class="card">
        <div class="card-header">@L["Details"]</div>
        <div class="card-body">
            <table style="width:100%; font-size:14px;">
                <tr style="border-bottom:1px solid var(--border);">
                    <td style="padding:10px 0; color:var(--text-secondary); width:40%;">@L["FullName"]</td>
                    <td style="padding:10px 0; font-weight:500;">@Model.FullName</td>
                </tr>
                <tr style="border-bottom:1px solid var(--border);">
                    <td style="padding:10px 0; color:var(--text-secondary);">FIN</td>
                    <td style="padding:10px 0;">@(Model.FinCode ?? "—")</td>
                </tr>
                <tr style="border-bottom:1px solid var(--border);">
                    <td style="padding:10px 0; color:var(--text-secondary);">@L["Email"]</td>
                    <td style="padding:10px 0;">@Model.Email</td>
                </tr>
                <tr style="border-bottom:1px solid var(--border);">
                    <td style="padding:10px 0; color:var(--text-secondary);">@L["Phone"]</td>
                    <td style="padding:10px 0;">@(Model.PhoneNumber ?? "—")</td>
                </tr>
                <tr style="border-bottom:1px solid var(--border);">
                    <td style="padding:10px 0; color:var(--text-secondary);">@L["PDF_StudentNo"]</td>
                    <td style="padding:10px 0;"><code style="background:var(--bg-hover); padding:2px 8px; border-radius:4px;">@Model.StudentNumber</code></td>
                </tr>
                <tr style="border-bottom:1px solid var(--border);">
                    <td style="padding:10px 0; color:var(--text-secondary);">@L["PDF_EnrollmentYear"]</td>
                    <td style="padding:10px 0;">@Model.EnrollmentYear</td>
                </tr>
                <tr style="border-bottom:1px solid var(--border);">
                    <td style="padding:10px 0; color:var(--text-secondary);">@L["Status"]</td>
                    <td style="padding:10px 0;"><span class="badge @(Model.IsActive ? "badge-success" : "badge-danger")">@(Model.IsActive ? L["Active"].Value : "Deaktiv")</span></td>
                </tr>
                <tr>
                    <td style="padding:10px 0; color:var(--text-secondary);">Yaradılıb</td>
                    <td style="padding:10px 0;">@Model.CreatedAt.ToString("dd.MM.yyyy")</td>
                </tr>
            </table>
        </div>
    </div>

    <div class="card">
        <div class="card-header">@L["Academic"]</div>
        <div class="card-body">
            <table style="width:100%; font-size:14px;">
                <tr style="border-bottom:1px solid var(--border);">
                    <td style="padding:10px 0; color:var(--text-secondary); width:40%;">@L["PDF_EnrollmentYear"]</td>
                    <td style="padding:10px 0; font-weight:500;">@Model.EnrollmentYear</td>
                </tr>
                <tr>
                    <td style="padding:10px 0; color:var(--text-secondary);">GPA</td>
                    <td style="padding:10px 0;">
                        <span style="font-size:24px; font-weight:700; color:@(Model.CurrentGPA >= 3 ? "#22c55e" : Model.CurrentGPA >= 2 ? "#eab308" : "#ef4444")">
                            @Model.CurrentGPA.ToString("F2")
                        </span>
                        <span style="color:var(--text-secondary); font-size:12px;"> / 4.00</span>
                    </td>
                </tr>
            </table>
        </div>
    </div>
</div>

<!-- F1 — Academic Information: enrollment-lər və akademik xülasə -->
<div class="card" style="margin-top:16px;">
    <div class="card-header">
        <span><i class="fas fa-graduation-cap" style="margin-right:8px;"></i>@L["AcademicInformation"]</span>
        <span class="badge badge-secondary">@academicRows.Count</span>
    </div>
    @if (!academicRows.Any())
    {
        <div class="empty-state">
            <i class="fas fa-folder-open"></i>
            <h4>No academic enrollment found.</h4>
            <p>Bu tələbənin heç bir qrupa qeydiyyatı yoxdur.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-compact">
                <thead>
                    <tr>
                        <th>@L["Course"] / @L["Programme"]</th>
                        <th>@L["Group"]</th>
                        <th>@L["AcademicYear"]</th>
                        <th>@L["Teacher"]</th>
                        <th>@L["Enrollment"]</th>
                        <th>@L["Status"]</th>
                        <th style="text-align:center;">@L["Attendance"] %</th>
                        <th style="text-align:center;">@L["OfficialGrade"] %</th>
                        <th style="text-align:center;">GPA</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in academicRows)
                    {
                        <tr>
                            <td style="font-weight:600;">@r.CourseName</td>
                            <td>@r.GroupName</td>
                            <td>
                                @(r.AcademicYear ?? "—")
                                @if (r.StartDate.HasValue && r.EndDate.HasValue)
                                {
                                    <div style="font-size:11px; color:var(--text-muted);">@r.StartDate.Value.ToString("dd.MM.yy") – @r.EndDate.Value.ToString("dd.MM.yy")</div>
                                }
                            </td>
                            <td style="color:var(--text-muted);">@r.TeacherName</td>
                            <td style="color:var(--text-muted); font-size:12px;">@r.EnrolledAt.ToString("dd.MM.yyyy")</td>
                            <td><span class="badge @StatusBadge(r.Status)">@r.Status</span></td>
                            <td style="text-align:center;">
                                @if (r.AttendancePercentage.HasValue)
                                {
                                    <span class="badge @(r.AttendancePercentage >= 75 ? "badge-success" : r.AttendancePercentage >= 50 ? "badge-warning" : "badge-danger")">@r.AttendancePercentage.Value.ToString("F0")%</span>
                                }
                                else { <span style="color:var(--text-muted);">—</span> }
                            </td>
                            <td style="text-align:center;">
                                @(r.OfficialGrade.HasValue ? r.OfficialGrade.Value.ToString("F1") + "%" : "—")
                            </td>
                            <td style="text-align:center; font-weight:700;">
                                @(r.GPA.HasValue ? r.GPA.Value.ToString("F2") : "—")
                            </td>
                            <td style="text-align:right;">
                                @if (r.TranscriptLoaded)
                                {
                                    <a href="/Admin/Student/Transcript?enrollmentId=@r.EnrollmentId&studentId=@Model.Id" class="btn btn-sm btn-secondary" title="@L["Transcript"]">
                                        <i class="fas fa-file-pdf"></i> PDF
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div style="margin-top:16px; display:flex; gap:10px;">
    <a href="/Admin/Student/Edit/@Model.Id" class="btn btn-primary">
        <i class="fas fa-edit"></i> @L["Edit"]
    </a>
    <button type="button" class="btn btn-secondary" onclick="document.getElementById('pwdCard').style.display='block'; this.style.display='none'">
        <i class="fas fa-key"></i> @L["ChangePassword"]
    </button>
</div>

<div id="pwdCard" class="card" style="max-width:400px; margin-top:16px; display:none;">
    <div class="card-header"><i class="fas fa-key"></i> @L["ChangePassword"]</div>
    <div class="card-body" style="padding:20px;">
        <form method="post" action="/Admin/Student/SetPassword">
            @Html.AntiForgeryToken()
            <input type="hidden" name="userId" value="@Model.AppUserId" />
            <input type="hidden" name="studentId" value="@Model.Id" />
            <div class="form-group">
                <label style="font-size:13px;">@L["NewPassword"]</label>
                <div style="position:relative;">
                    <input type="password" id="adm_pwd1" name="newPassword" class="form-control" required minlength="6" style="padding-right:40px;" />
                    <button type="button" onclick="togglePwd('adm_pwd1',this)" tabindex="-1"
                            style="position:absolute;right:10px;top:50%;transform:translateY(-50%);background:none;border:none;color:var(--text-secondary);cursor:pointer;font-size:14px;">
                        <i class="fas fa-eye"></i>
                    </button>
                </div>
            </div>
            <div class="form-group">
                <label style="font-size:13px;">@L["ConfirmPassword"]</label>
                <div style="position:relative;">
                    <input type="password" id="adm_pwd2" name="confirmPassword" class="form-control" required minlength="6" style="padding-right:40px;" />
                    <button type="button" onclick="togglePwd('adm_pwd2',this)" tabindex="-1"
                            style="position:absolute;right:10px;top:50%;transform:translateY(-50%);background:none;border:none;color:var(--text-secondary);cursor:pointer;font-size:14px;">
                        <i class="fas fa-eye"></i>
                    </button>
                </div>
            </div>
            <div style="display:flex; gap:8px;">
                <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-save"></i> @L["Save"]</button>
                <button type="button" class="btn btn-secondary btn-sm" onclick="document.getElementById('pwdCard').style.display='none'">@L["Cancel"]</button>
            </div>
        </form>
    </div>
</div>

<script>
function togglePwd(id, btn) {
    const input = document.getElementById(id);
    const icon = btn.querySelector('i');
    if (input.type === 'password') {
        input.type = 'text';
        icon.classList.replace('fa-eye', 'fa-eye-slash');
    } else {
        input.type = 'password';
        icon.classList.replace('fa-eye-slash', 'fa-eye');
    }
}
</script>
