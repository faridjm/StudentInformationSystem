@model SIS.BLL.Services.DTOs.Groups.GroupDetailDto
@{
    ViewData["Title"] = L["EditGroup"].Value;
}

<div style="max-width:700px; margin:0 auto;">
    <div style="display:flex; align-items:center; gap:12px; margin-bottom:20px;">
        <a href="/Admin/Group/Detail/@Model.Id" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left"></i></a>
        <h2 style="font-size:20px; font-weight:700;">@Model.Name — Düzəlt</h2>
    </div>

    <form method="post" action="/Admin/Group/Edit" id="groupEditForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="@Model.Id" />
        <input type="hidden" name="CourseId" value="@Model.CourseId" />

        <div class="card" style="margin-bottom:16px;">
            <div class="card-header">@L["Details"]</div>
            <div class="card-body">
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
                    <div class="form-group" style="grid-column:1/-1;">
                        <label class="form-label">@L["Name"] *</label>
                        <input name="Name" value="@Model.Name" class="form-control" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label">@L["Teacher"] *</label>
                        <select name="TeacherId" class="form-control" required>
                            @foreach (var t in (IEnumerable<SIS.BLL.Services.DTOs.Teacher.TeacherListDto>)ViewBag.Teachers)
                            {
                                if (t.Id == Model.TeacherId)
                                {
                                    <option value="@t.Id" selected="selected">@t.FullName</option>
                                }
                                else
                                {
                                    <option value="@t.Id">@t.FullName</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">@L["Seasons"]</label>
                        <select name="AcademicYearId" class="form-control">
                            <option value="">—</option>
                            @foreach (var s in (IEnumerable<SIS.BLL.Services.DTOs.AcademicYear.AcademicYearDto>)ViewBag.Seasons)
                            {
                                if (Model.SeasonName == s.Name)
                                {
                                    <option value="@s.Id" selected="selected">@s.Name</option>
                                }
                                else
                                {
                                    <option value="@s.Id">@s.Name</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">@L["Capacity"]</label>
                        <input name="Capacity" type="number" value="@Model.Capacity" class="form-control" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Aktiv?</label>
                        <select name="IsActive" class="form-control">
                            @if (Model.IsActive)
                            {
                                <option value="true" selected="selected">Aktiv</option>
                                <option value="false">Deaktiv</option>
                            }
                            else
                            {
                                <option value="true">Aktiv</option>
                                <option value="false" selected="selected">Deaktiv</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">@L["StartDate"]</label>
                        <input name="StartDate" type="date" value="@Model.StartDate.ToString("yyyy-MM-dd")" class="form-control" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label">@L["EndDate"]</label>
                        <input name="EndDate" type="date" value="@Model.EndDate.ToString("yyyy-MM-dd")" class="form-control" required />
                    </div>
                </div>
            </div>
        </div>

        <div class="card" style="margin-bottom:16px;">
            <div class="card-header">Tədris formatı</div>
            <div class="card-body">
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
                    <div class="form-group">
                        <label class="form-label">Tədris formatı *</label>
                        <select name="DeliveryMode" id="deliveryMode" class="form-control" onchange="toggleOnlineFields()">
                            <option value="InPerson" selected="@(Model.DeliveryMode == SIS.Entities.Enums.DeliveryMode.InPerson)">Əyani (InPerson)</option>
                            <option value="Online" selected="@(Model.DeliveryMode == SIS.Entities.Enums.DeliveryMode.Online)">Online</option>
                            <option value="Hybrid" selected="@(Model.DeliveryMode == SIS.Entities.Enums.DeliveryMode.Hybrid)">Hibrid (Hybrid)</option>
                        </select>
                    </div>
                    <div class="form-group online-field" id="platformField">
                        <label class="form-label">Platforma</label>
                        <select name="DefaultOnlinePlatform" class="form-control">
                            <option value="GoogleMeet" selected="@(Model.DefaultOnlinePlatform == SIS.Entities.Enums.OnlinePlatform.GoogleMeet)">Google Meet</option>
                            <option value="Zoom" selected="@(Model.DefaultOnlinePlatform == SIS.Entities.Enums.OnlinePlatform.Zoom)">Zoom</option>
                            <option value="MicrosoftTeams" selected="@(Model.DefaultOnlinePlatform == SIS.Entities.Enums.OnlinePlatform.MicrosoftTeams)">Microsoft Teams</option>
                            <option value="Custom" selected="@(Model.DefaultOnlinePlatform == SIS.Entities.Enums.OnlinePlatform.Custom)">Digər (Custom)</option>
                        </select>
                    </div>
                    <div class="form-group online-field" id="meetingUrlField" style="grid-column:1/-1;">
                        <label class="form-label">Default görüş linki (Meeting URL)</label>
                        <input name="DefaultMeetingUrl" type="url" value="@Model.DefaultMeetingUrl" class="form-control" placeholder="https://meet.google.com/..." />
                        <div style="font-size:11px; color:var(--text-secondary); margin-top:4px;">
                            Online/Hibrid qruplarda online dərslər bu linkdən default götürür.
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card" style="margin-bottom:16px;">
            <div class="card-header" style="display:flex; justify-content:space-between; align-items:center;">
                <span>@L["Schedule"]</span>
                <button type="button" onclick="addDay()" class="btn btn-sm btn-secondary"><i class="fas fa-plus"></i></button>
            </div>
            <div class="card-body">
                <div id="scheduleDays">
                    @{ int di = 0; }
                    @foreach (var d in Model.ScheduleDays)
                    {
                        <div id="day_@di" style="display:grid; grid-template-columns:2fr 1fr 1fr auto; gap:10px; align-items:center; margin-bottom:10px;">
                            <select name="ScheduleDays[@di].DayOfWeek" class="form-control">
                                @{
                                    // DayOfWeek enum sırası ilə: 0=Bazar(Sun) ... 6=Şənbə(Sat)
                                    var dayNames = new[]{"Bazar","Bazar ertəsi","Çərşənbə axşamı","Çərşənbə","Cümə axşamı","Cümə","Şənbə"};
                                    for (int wd = 0; wd < 7; wd++)
                                    {
                                        if (d.DayOfWeek == (DayOfWeek)wd)
                                        {
                                            <option value="@wd" selected="selected">@dayNames[wd]</option>
                                        }
                                        else
                                        {
                                            <option value="@wd">@dayNames[wd]</option>
                                        }
                                    }
                                }
                            </select>
                            <input name="ScheduleDays[@di].StartTime" type="time" value="@d.StartTime" class="form-control" />
                            <input name="ScheduleDays[@di].EndTime" type="time" value="@d.EndTime" class="form-control" />
                            <button type="button" onclick="document.getElementById('day_@di').remove()" class="btn btn-sm btn-danger"><i class="fas fa-times"></i></button>
                        </div>
                        di++;
                    }
                </div>
                <div id="dayCounterHolder" data-count="@di"></div>

                <!-- Regenerate sessions panel -->
                <div style="margin-top:14px; padding:14px; border:1px dashed #f59e0b; border-radius:10px; background:rgba(245,158,11,0.06);">
                    <div style="display:flex; align-items:flex-start; gap:10px;">
                        <i class="fas fa-rotate" style="color:#f59e0b; margin-top:3px;"></i>
                        <div style="flex:1;">
                            <div style="font-weight:700; font-size:14px;">Dərs sessiyalarını yenidən yarat</div>
                            <div style="font-size:12px; color:var(--text-secondary); margin-top:4px;">
                                Cədvəl, başlama/bitmə tarixləri və ya dərs günləri dəyişibsə, mövcud sessiyalar
                                yeni cədvələ uyğun yenidən yaradılacaq. Köhnə sessiyalar soft-delete olunur.
                            </div>
                            <label style="display:flex; align-items:center; gap:8px; margin-top:10px; cursor:pointer;">
                                <input type="checkbox" name="RegenerateSessions" id="regenChk" value="true" />
                                <span style="font-size:13px;">Yadda saxlayanda dərs sessiyalarını yenidən yarat</span>
                            </label>
                            <div style="display:flex; gap:10px; margin-top:10px; align-items:center; flex-wrap:wrap;">
                                <label style="font-size:12px; color:var(--text-secondary);">
                                    Dərs sayı (optional, EndDate-i avtomatik hesablamaq üçün):
                                </label>
                                <input type="number" name="TotalSessions" min="1" max="500" placeholder="məs: 30"
                                       class="form-control" style="width:120px; height:32px; font-size:13px;" />
                                <span style="font-size:11px; color:var(--text-secondary);">
                                    Dərs sayı verilərsə, son dərs günü avtomatik EndDate kimi təyin olunur.
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @{
            var roomsListE = ViewBag.Rooms as IEnumerable<SIS.BLL.Services.DTOs.Room.RoomDto>
                             ?? Enumerable.Empty<SIS.BLL.Services.DTOs.Room.RoomDto>();
        }
        <div class="card" style="margin-bottom:16px;" id="roomCard">
            <div class="card-header" style="display:flex; justify-content:space-between; align-items:center;">
                <span><i class="fas fa-door-open"></i> Otaq (yalnız əyani/hibrid)</span>
                <button type="button" onclick="loadAvailableRooms()" class="btn btn-sm btn-secondary">
                    <i class="fas fa-sync"></i> Uyğun otaqları göstər
                </button>
            </div>
            <div class="card-body">
                <div class="form-group" style="margin-bottom:6px;">
                    <select name="RoomId" id="roomSelect" class="form-control">
                        <option value="">— Otaq seçin —</option>
                        @foreach (var room in roomsListE)
                        {
                            if (Model.RoomId == room.Id)
                            {
                                <option value="@room.Id" selected>@room.Name (@room.Type, tutum @room.Capacity)</option>
                            }
                            else
                            {
                                <option value="@room.Id">@room.Name (@room.Type, tutum @room.Capacity)</option>
                            }
                        }
                    </select>
                </div>
                <div id="roomHint" style="font-size:12px; color:var(--text-secondary);">
                    Cari otaq: <strong>@(Model.RoomName ?? "—")</strong>. Cədvəl dəyişsə “Uyğun otaqları göstər” düyməsini istifadə edin.
                </div>
            </div>
        </div>

        <div style="display:flex; gap:12px;">
            <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> @L["Save"]</button>
            <a href="/Admin/Group/Detail/@Model.Id" class="btn btn-secondary">@L["Cancel"]</a>
        </div>
    </form>
</div>

<script>
    var __excludeGroupId = @Model.Id;
    function collectSlotsEdit() {
        const selects = document.querySelectorAll('select[name$=".DayOfWeek"]');
        const slots = [];
        selects.forEach(function (sel) {
            const prefix = sel.name.substring(0, sel.name.lastIndexOf('.'));
            const start = document.querySelector('input[name="' + prefix + '.StartTime"]');
            const end = document.querySelector('input[name="' + prefix + '.EndTime"]');
            if (sel.value && start && end && start.value && end.value) {
                const day = isNaN(sel.value) ? sel.value : parseInt(sel.value);
                slots.push({ dayOfWeek: day, startTime: start.value, endTime: end.value });
            }
        });
        return slots;
    }

    async function loadAvailableRooms() {
        const slots = collectSlotsEdit();
        const startDate = document.querySelector('input[name="StartDate"]')?.value;
        const endDate = document.querySelector('input[name="EndDate"]')?.value;
        const capEl = document.querySelector('input[name="Capacity"]');
        const hint = document.getElementById('roomHint');

        if (!startDate || slots.length === 0) {
            hint.textContent = 'Əvvəlcə başlama tarixi və ən azı 1 dərs günü/saatı seçin.';
            return;
        }

        const payload = {
            groupStart: startDate,
            groupEnd: endDate || startDate,
            capacityRequired: capEl ? parseInt(capEl.value || '0') : null,
            excludeGroupId: __excludeGroupId,
            slots: slots
        };

        hint.textContent = 'Yoxlanılır...';
        try {
            const res = await fetch('/Admin/Group/AvailableRooms', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await res.json();
            if (!Array.isArray(data)) { hint.textContent = 'Otaqlar yüklənə bilmədi.'; return; }

            const select = document.getElementById('roomSelect');
            const current = select.value;
            select.innerHTML = '<option value="">— Otaq seçin —</option>';
            data.forEach(function (r) {
                const opt = document.createElement('option');
                opt.value = r.roomId;
                let label = r.name + ' (tutum ' + r.capacity + ')';
                if (!r.isAvailable) { opt.disabled = true; label += ' — ' + (r.reason || 'Dolu'); }
                else if (r.capacityWarning) { label += ' — ⚠ tutum azdır'; }
                opt.textContent = label;
                if (String(r.roomId) === String(current)) opt.selected = true;
                select.appendChild(opt);
            });
            const freeCount = data.filter(x => x.isAvailable).length;
            hint.textContent = freeCount + ' uyğun otaq tapıldı (' + (data.length - freeCount) + ' dolu).';
        } catch (e) {
            hint.textContent = 'Xəta: otaqlar yüklənə bilmədi.';
        }
    }

    (function () {
        const dm = document.getElementById('deliveryMode');
        const card = document.getElementById('roomCard');
        function sync() { if (dm && card) card.style.display = (dm.value === 'Online') ? 'none' : ''; }
        if (dm) dm.addEventListener('change', sync);
        sync();
    })();
</script>

@section Scripts {
<script>
    // Save zamanı regenerate seçilibsə confirmation soruş
    document.getElementById('groupEditForm')?.addEventListener('submit', function (e) {
        var chk = document.getElementById('regenChk');
        if (!chk || !chk.checked) return; // adi save
        if (this.dataset.acxRegenConfirmed === '1') { this.dataset.acxRegenConfirmed = ''; return; }
        e.preventDefault();
        var form = this;
        if (window.acadexConfirm) {
            window.acadexConfirm({
                title: 'Dərs cədvəlini yenidən yaratmaq istəyirsiniz?',
                message: 'Həftəlik dərs günləri və saatları dəyişib. Mövcud dərs sessiyaları yeni cədvələ görə yenidən hesablanacaq və köhnə sessiyalar soft-delete olunacaq.',
                confirmText: 'Yenidən yarat',
                cancelText: 'Ləğv et',
                type: 'warning'
            }).then(function (ok) {
                if (ok) {
                    form.dataset.acxRegenConfirmed = '1';
                    form.requestSubmit ? form.requestSubmit() : form.submit();
                }
            });
        } else if (confirm('Dərs sessiyalarını yenidən yaratmaq istəyirsiniz?')) {
            form.dataset.acxRegenConfirmed = '1';
            form.requestSubmit ? form.requestSubmit() : form.submit();
        }
    });

    // Tədris formatına görə online sahələri göstər/gizlət
    function toggleOnlineFields() {
        var mode = document.getElementById('deliveryMode').value;
        var show = (mode === 'Online' || mode === 'Hybrid');
        document.querySelectorAll('.online-field').forEach(function (el) {
            el.style.display = show ? '' : 'none';
        });
    }
    // İlk yüklənmədə mövcud dəyərə görə düz vəziyyət
    document.addEventListener('DOMContentLoaded', toggleOnlineFields);

    // DayOfWeek enum sırası ilə (1=Bazar ertəsi/Monday ... 0=Bazar/Sunday)
    const days = [
        { v: 1, t: 'Bazar ertəsi' },
        { v: 2, t: 'Çərşənbə axşamı' },
        { v: 3, t: 'Çərşənbə' },
        { v: 4, t: 'Cümə axşamı' },
        { v: 5, t: 'Cümə' },
        { v: 6, t: 'Şənbə' },
        { v: 0, t: 'Bazar' }
    ];
    let dayCount = parseInt(document.getElementById('dayCounterHolder').dataset.count);

    function addDay() {
        const i = dayCount++;
        const div = document.createElement('div');
        div.id = 'day_' + i;
        div.style.cssText = 'display:grid; grid-template-columns:2fr 1fr 1fr auto; gap:10px; align-items:center; margin-bottom:10px;';
        div.innerHTML = `
            <select name="ScheduleDays[${i}].DayOfWeek" class="form-control">
                ${days.map(d => `<option value="${d.v}">${d.t}</option>`).join('')}
            </select>
            <input name="ScheduleDays[${i}].StartTime" type="time" class="form-control" value="09:00" />
            <input name="ScheduleDays[${i}].EndTime" type="time" class="form-control" value="11:00" />
            <button type="button" onclick="document.getElementById('day_${i}').remove()" class="btn btn-sm btn-danger"><i class="fas fa-times"></i></button>
        `;
        document.getElementById('scheduleDays').appendChild(div);
    }
</script>
}
