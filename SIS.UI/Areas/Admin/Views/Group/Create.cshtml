@{
    ViewData["Title"] = L["NewGroup"].Value;
}

<div style="max-width:800px; margin:0 auto;">
    <div style="display:flex; align-items:center; gap:12px; margin-bottom:20px;">
        <a href="/Admin/Group" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left"></i></a>
        <h2 style="font-size:20px; font-weight:700;">@L["NewGroup"]</h2>
    </div>

    <form method="post" action="/Admin/Group/Create" id="groupForm">
        @Html.AntiForgeryToken()

        <div class="card" style="margin-bottom:16px;">
            <div class="card-header">@L["Details"]</div>
            <div class="card-body">
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
                    <div class="form-group" style="grid-column:1/-1;">
                        <label class="form-label">@L["Name"] *</label>
                        <input name="Name" class="form-control"  required />
                    </div>
                    <div class="form-group">
                        <label class="form-label">@L["Course"] *</label>
                        <select name="CourseId" id="courseSelect" class="form-control" required onchange="filterTemplates()">
                            <option value="">...</option>
                            @foreach (var c in (IEnumerable<SIS.BLL.Services.DTOs.Course.CourseDto>)ViewBag.Courses)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Tədris şablonu (istəyə bağlı)</label>
                        <select name="CurriculumTemplateId" id="templateSelect" class="form-control">
                            <option value="">— Şablonsuz —</option>
                            @foreach (var t in (ViewBag.Templates as List<SIS.BLL.Services.DTOs.Curriculum.CurriculumTemplateDto> ?? new()))
                            {
                                <option value="@t.Id" data-course="@t.CourseId" data-active="@t.IsActive.ToString().ToLower()" style="display:none;">@t.Name (@t.ItemCount dərs)@(t.IsActive ? " ✓" : "")</option>
                            }
                        </select>
                        <div style="font-size:11px; color:var(--text-secondary); margin-top:4px;">Mövzular və qiymətləndirmələr avtomatik yaranır.</div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">@L["Teacher"] *</label>
                        <select name="TeacherId" class="form-control" required>
                            <option value="">...</option>
                            @foreach (var t in (IEnumerable<SIS.BLL.Services.DTOs.Teacher.TeacherListDto>)ViewBag.Teachers)
                            {
                                <option value="@t.Id">@t.FullName</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">@L["Seasons"]</label>
                        <select name="AcademicYearId" class="form-control">
                            <option value="">—</option>
                            @foreach (var s in (IEnumerable<SIS.BLL.Services.DTOs.AcademicYear.AcademicYearDto>)ViewBag.Seasons)
                            {
                                <option value="@s.Id">@s.Name</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">@L["Capacity"] *</label>
                        <input name="Capacity" type="number" min="1" max="100" value="20" class="form-control" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label">@L["StartDate"] *</label>
                        <input name="StartDate" id="startDate" type="date" class="form-control" required onchange="recalcEndDate()" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-calculator" style="font-size:11px;"></i> Calculated EndDate
                        </label>
                        <input name="EndDate" id="endDate" type="date" class="form-control" required readonly
                               style="background:var(--bg-hover); cursor:not-allowed;" />
                        <div id="endDateInfo" style="font-size:11px; color:var(--text-secondary); margin-top:4px;">
                            Şablon, başlama tarixi və dərs günləri seçildikdə avtomatik hesablanır.
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card" style="margin-bottom:16px;">
            <div class="card-header" style="display:flex; justify-content:space-between; align-items:center;">
                <span>@L["Schedule"]</span>
                <button type="button" onclick="addDay()" class="btn btn-sm btn-secondary"><i class="fas fa-plus"></i> +</button>
            </div>
            <div class="card-body">
                <div id="scheduleDays">
                    <div style="color:var(--text-secondary); font-size:13px; margin-bottom:8px;" id="emptyMsg">Hələ gün əlavə edilməyib. Ən azı 1 gün seçin.</div>
                </div>
            </div>
        </div>

        <div style="display:flex; gap:12px;">
            <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> @L["Create"]</button>
            <a href="/Admin/Group" class="btn btn-secondary">@L["Cancel"]</a>
        </div>
    </form>
</div>

@section Scripts {
<script>
    // Seçilmiş kursa görə tədris şablonlarını filtrlə
    function filterTemplates() {
        var courseId = document.getElementById('courseSelect').value;
        var sel = document.getElementById('templateSelect');
        if (!sel) return;
        sel.value = '';
        var firstMatch = '';
        Array.from(sel.options).forEach(function (o) {
            if (!o.value) { o.style.display = ''; return; }
            var match = o.getAttribute('data-course') === courseId;
            o.style.display = match ? '' : 'none';
            if (match && o.getAttribute('data-active') === 'true' && !firstMatch) firstMatch = o.value;
        });
        // aktiv şablonu avtomatik seç
        if (firstMatch) sel.value = firstMatch;
        recalcEndDate();
    }

    // DayOfWeek dəyərləri .NET enum sırası ilə (0=Bazar/Sunday ... 6=Şənbə/Saturday).
    const days = [
        { v: 1, t: 'Bazar ertəsi' },
        { v: 2, t: 'Çərşənbə axşamı' },
        { v: 3, t: 'Çərşənbə' },
        { v: 4, t: 'Cümə axşamı' },
        { v: 5, t: 'Cümə' },
        { v: 6, t: 'Şənbə' },
        { v: 0, t: 'Bazar' }
    ];
    let dayCount = 0;

    function addDay() {
        document.getElementById('emptyMsg')?.remove();
        const i = dayCount++;
        const div = document.createElement('div');
        div.id = 'day_' + i;
        div.style.cssText = 'display:grid; grid-template-columns:2fr 1fr 1fr auto; gap:10px; align-items:center; margin-bottom:10px;';
        div.innerHTML = `
            <select name="ScheduleDays[${i}].DayOfWeek" class="form-control schedule-day" required onchange="recalcEndDate()">
                ${days.map(d => `<option value="${d.v}">${d.t}</option>`).join('')}
            </select>
            <input name="ScheduleDays[${i}].StartTime" type="time" class="form-control" value="09:00" required />
            <input name="ScheduleDays[${i}].EndTime" type="time" class="form-control" value="11:00" required />
            <button type="button" onclick="document.getElementById('day_${i}').remove(); recalcEndDate();" class="btn btn-sm btn-danger"><i class="fas fa-times"></i></button>
        `;
        document.getElementById('scheduleDays').appendChild(div);
        recalcEndDate();
    }

    // ---- Calculated EndDate (AJAX) ----
    let recalcTimer = null;
    function recalcEndDate() {
        // debounce — sürətli dəyişikliklərdə tək sorğu
        clearTimeout(recalcTimer);
        recalcTimer = setTimeout(doRecalcEndDate, 250);
    }

    function selectedDayValues() {
        return Array.from(document.querySelectorAll('.schedule-day'))
            .map(s => parseInt(s.value, 10))
            .filter(v => !isNaN(v));
    }

    function doRecalcEndDate() {
        const endInput = document.getElementById('endDate');
        const info = document.getElementById('endDateInfo');
        const startDate = document.getElementById('startDate').value;
        const templateId = document.getElementById('templateSelect').value;
        const dayValues = selectedDayValues();

        // Şablon seçilməyibsə, EndDate-i admin əl ilə təyin edə bilsin (geriyə uyğunluq).
        if (!templateId) {
            endInput.readOnly = false;
            endInput.style.background = '';
            endInput.style.cursor = '';
            info.textContent = 'Şablon seçilməyib — bitmə tarixini əl ilə daxil edin.';
            return;
        }

        // Şablon seçilib — sahə readonly, sistem hesablayır.
        endInput.readOnly = true;
        endInput.style.background = 'var(--bg-hover)';
        endInput.style.cursor = 'not-allowed';

        if (!startDate || dayValues.length === 0) {
            info.textContent = 'Başlama tarixi və ən azı bir dərs günü seçin.';
            return;
        }

        info.textContent = 'Hesablanır…';

        fetch('/Admin/Group/CalculateEndDate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                startDate: startDate,
                scheduleDays: dayValues,
                curriculumTemplateId: parseInt(templateId, 10)
            })
        })
        .then(r => r.json())
        .then(res => {
            if (res && res.success && res.endDate) {
                endInput.value = res.endDate.substring(0, 10);
                info.innerHTML = `<span style="color:var(--success, #16a34a);"><i class="fas fa-check"></i> `
                    + `${res.totalSessions} dərs · həftədə ${res.daysPerWeek} gün · bitmə: <strong>${endInput.value}</strong></span>`;
            } else {
                endInput.value = '';
                info.innerHTML = `<span style="color:var(--danger, #dc2626);">${(res && res.message) ? res.message : 'Hesablanmadı'}</span>`;
            }
        })
        .catch(() => { info.innerHTML = '<span style="color:var(--danger,#dc2626);">Şəbəkə xətası</span>'; });
    }
</script>
}
