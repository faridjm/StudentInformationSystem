@{
    ViewData["Title"] = "Yeni Qrup";
}

<div style="max-width:800px; margin:0 auto;">
    <div style="display:flex; align-items:center; gap:12px; margin-bottom:20px;">
        <a href="/Admin/Group" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left"></i></a>
        <h2 style="font-size:20px; font-weight:700;">Yeni Qrup Yarat</h2>
    </div>

    <form method="post" action="/Admin/Group/Create" id="groupForm">
        @Html.AntiForgeryToken()

        <div class="card" style="margin-bottom:16px;">
            <div class="card-header">Ümumi məlumat</div>
            <div class="card-body">
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
                    <div class="form-group" style="grid-column:1/-1;">
                        <label class="form-label">Qrup adı *</label>
                        <input name="Name" class="form-control" placeholder="məs: PA101" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Tədris Proqramı *</label>
                        <select name="CourseId" class="form-control" required>
                            <option value="">Seçin...</option>
                            @foreach (var c in (IEnumerable<SIS.BLL.Services.DTOs.Course.CourseDto>)ViewBag.Courses)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Müəllim *</label>
                        <select name="TeacherId" class="form-control" required>
                            <option value="">Seçin...</option>
                            @foreach (var t in (IEnumerable<SIS.BLL.Services.DTOs.Teacher.TeacherListDto>)ViewBag.Teachers)
                            {
                                <option value="@t.Id">@t.FullName</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Sezon</label>
                        <select name="AcademicYearId" class="form-control">
                            <option value="">—</option>
                            @foreach (var s in (IEnumerable<SIS.BLL.Services.DTOs.AcademicYear.AcademicYearDto>)ViewBag.Seasons)
                            {
                                <option value="@s.Id">@s.Name</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Tutum (max tələbə) *</label>
                        <input name="Capacity" type="number" min="1" max="100" value="20" class="form-control" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Başlama tarixi *</label>
                        <input name="StartDate" type="date" class="form-control" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Bitmə tarixi *</label>
                        <input name="EndDate" type="date" class="form-control" required />
                    </div>
                </div>
            </div>
        </div>

        <div class="card" style="margin-bottom:16px;">
            <div class="card-header" style="display:flex; justify-content:space-between; align-items:center;">
                <span>Həftəlik cədvəl günləri</span>
                <button type="button" onclick="addDay()" class="btn btn-sm btn-secondary"><i class="fas fa-plus"></i> Gün əlavə et</button>
            </div>
            <div class="card-body">
                <div id="scheduleDays">
                    <div style="color:var(--text-secondary); font-size:13px; margin-bottom:8px;" id="emptyMsg">Hələ gün əlavə edilməyib. Ən azı 1 gün seçin.</div>
                </div>
            </div>
        </div>

        <div style="display:flex; gap:12px;">
            <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Qrupu Yarat</button>
            <a href="/Admin/Group" class="btn btn-secondary">Ləğv et</a>
        </div>
    </form>
</div>

@section Scripts {
<script>
    const days = ['Bazar ertəsi','Çərşənbə axşamı','Çərşənbə','Cümə axşamı','Cümə','Şənbə','Bazar'];
    let dayCount = 0;

    function addDay() {
        document.getElementById('emptyMsg')?.remove();
        const i = dayCount++;
        const div = document.createElement('div');
        div.id = 'day_' + i;
        div.style.cssText = 'display:grid; grid-template-columns:2fr 1fr 1fr auto; gap:10px; align-items:center; margin-bottom:10px;';
        div.innerHTML = `
            <select name="ScheduleDays[${i}].DayOfWeek" class="form-control" required>
                ${days.map((d,idx) => `<option value="${idx}">${d}</option>`).join('')}
            </select>
            <input name="ScheduleDays[${i}].StartTime" type="time" class="form-control" value="09:00" required />
            <input name="ScheduleDays[${i}].EndTime" type="time" class="form-control" value="11:00" required />
            <button type="button" onclick="document.getElementById('day_${i}').remove()" class="btn btn-sm btn-danger"><i class="fas fa-times"></i></button>
        `;
        document.getElementById('scheduleDays').appendChild(div);
    }
</script>
}
