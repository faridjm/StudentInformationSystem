@model IEnumerable<SIS.BLL.Services.DTOs.CourseOffering.CourseOfferingListDto>

@{
    ViewData["Title"] = "Dərs Cədvəli";
}

<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
    <div>
        <h2 style="font-size:20px; font-weight:700;">Dərs Cədvəli</h2>
        <p style="color:var(--text-secondary); font-size:13px;">Hər kursun həftəlik cədvəlini qurub sessiyaları yaradın</p>
    </div>
</div>

<div class="card">
    <div style="overflow-x:auto;">
        <table class="table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Kurs</th>
                    <th>Semestr</th>
                    <th>Müəllim</th>
                    <th>Tələbə</th>
                    <th>Əməliyyat</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model)
                {
                    <tr>
                        <td>@o.Id</td>
                        <td style="font-weight:500;">
                            @o.CourseName
                            <div style="font-size:11px; color:var(--text-secondary);">@o.CourseCode</div>
                        </td>
                        <td>@o.TermName</td>
                        <td>@o.TeacherName</td>
                        <td><span class="badge badge-info">@o.EnrolledCount / @o.Capacity</span></td>
                        <td>
                            <div style="display:flex; gap:6px;">
                                <a href="/Admin/Schedule/Weekly/@o.Id" class="btn btn-sm btn-secondary">
                                    <i class="fas fa-calendar-week"></i> Həftəlik
                                </a>
                                <a href="/Admin/Schedule/Sessions/@o.Id" class="btn btn-sm btn-primary">
                                    <i class="fas fa-calendar-day"></i> Dərs Günləri
                                </a>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" style="text-align:center; color:var(--text-secondary); padding:30px;">
                            Heç bir kurs təklifi yoxdur. Əvvəlcə "Kurs Təklifləri" bölməsində yaradın.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
