@{
    ViewData["Title"] = "Həftəlik Cədvəl";
    var offering = ViewBag.Offering as SIS.BLL.Services.DTOs.CourseOffering.CourseOfferingDetailDto;
    var patterns = ViewBag.Patterns as List<SIS.BLL.Services.DTOs.WeeklySchedule.WeeklySchedulePatternDto> ?? new();

    string[] dayNames = { "Bazar", "Bazar ertəsi", "Çərşənbə axşamı", "Çərşənbə", "Cümə axşamı", "Cümə", "Şənbə" };
}

@if (TempData["Error"] != null)
{
    <div style="background:rgba(239,68,68,0.15); color:#f87171; padding:10px 14px; border-radius:8px; margin-bottom:10px;">
        @TempData["Error"]
    </div>
}
@if (TempData["Success"] != null)
{
    <div style="background:rgba(34,197,94,0.15); color:#22c55e; padding:10px 14px; border-radius:8px; margin-bottom:10px;">
        @TempData["Success"]
    </div>
}

<div style="display:flex; align-items:center; gap:12px; margin-bottom:20px;">
    <a href="/Admin/Schedule" class="btn btn-secondary btn-sm">
        <i class="fas fa-arrow-left"></i>
    </a>
    <div>
        <h2 style="font-size:20px; font-weight:700;">Həftəlik Cədvəl — @offering?.CourseName</h2>
        <p style="color:var(--text-secondary); font-size:13px;">@offering?.TermName • Müəllim: @offering?.TeacherName</p>
    </div>
</div>

<div style="display:flex; gap:8px; margin-bottom:16px;">
    <a href="/Admin/Schedule/Sessions/@offering?.Id" class="btn btn-secondary btn-sm">
        <i class="fas fa-list"></i> Dərs Günləri
    </a>
    <form method="post" action="/Admin/Schedule/Generate/@offering?.Id" style="display:inline;">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-success btn-sm"
                onclick="return confirm('Cədvələ uyğun bütün dərs günlərini yaratmaq istəyirsiniz?')">
            <i class="fas fa-magic"></i> Sessiyaları Yarat
        </button>
    </form>
</div>

<div class="card">
    <div class="card-header">
        <span>Həftəlik Şablon</span>
        <button type="button" class="btn btn-primary btn-sm" onclick="addSlot()">
            <i class="fas fa-plus"></i> Slot Əlavə Et
        </button>
    </div>
    <div class="card-body">
        <form method="post" action="/Admin/Schedule/SaveWeekly">
            @Html.AntiForgeryToken()
            <input type="hidden" name="courseOfferingId" value="@offering?.Id" />

            <table class="table" id="slotsTable">
                <thead>
                    <tr>
                        <th style="width:200px;">Gün</th>
                        <th style="width:140px;">Başlama</th>
                        <th style="width:140px;">Bitmə</th>
                        <th>Otaq</th>
                        <th style="width:60px;"></th>
                    </tr>
                </thead>
                <tbody id="slotsBody">
                    @if (patterns.Count == 0)
                    {
                        <tr class="slot-row">
                            <td>
                                <select name="dayOfWeek" class="form-control" required>
                                    @for (int d = 0; d < 7; d++)
                                    {
                                        <option value="@d">@dayNames[d]</option>
                                    }
                                </select>
                            </td>
                            <td><input type="time" name="startTime" class="form-control" required /></td>
                            <td><input type="time" name="endTime" class="form-control" required /></td>
                            <td><input type="text" name="room" class="form-control" placeholder="A101" maxlength="50" /></td>
                            <td><button type="button" class="btn btn-sm btn-danger" onclick="removeSlot(this)"><i class="fas fa-trash"></i></button></td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var p in patterns)
                        {
                            <tr class="slot-row">
                                <td>
                                    <select name="dayOfWeek" class="form-control" required>
                                        @for (int d = 0; d < 7; d++)
                                        {
                                            if ((int)p.DayOfWeek == d)
                                            {
                                                <option value="@d" selected>@dayNames[d]</option>
                                            }
                                            else
                                            {
                                                <option value="@d">@dayNames[d]</option>
                                            }
                                        }
                                    </select>
                                </td>
                                <td><input type="time" name="startTime" class="form-control" value="@p.StartTime.ToString("HH:mm")" required /></td>
                                <td><input type="time" name="endTime" class="form-control" value="@p.EndTime.ToString("HH:mm")" required /></td>
                                <td><input type="text" name="room" class="form-control" value="@p.Room" maxlength="50" /></td>
                                <td><button type="button" class="btn btn-sm btn-danger" onclick="removeSlot(this)"><i class="fas fa-trash"></i></button></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

            <div style="display:flex; gap:10px; margin-top:16px;">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> Cədvəli Saxla
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const dayNames = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(dayNames));

        function addSlot() {
            const tbody = document.getElementById('slotsBody');
            const tr = document.createElement('tr');
            tr.className = 'slot-row';
            tr.innerHTML = `
                <td>
                    <select name="dayOfWeek" class="form-control" required>
                        ${dayNames.map((n, i) => `<option value="${i}">${n}</option>`).join('')}
                    </select>
                </td>
                <td><input type="time" name="startTime" class="form-control" required /></td>
                <td><input type="time" name="endTime" class="form-control" required /></td>
                <td><input type="text" name="room" class="form-control" placeholder="A101" maxlength="50" /></td>
                <td><button type="button" class="btn btn-sm btn-danger" onclick="removeSlot(this)"><i class="fas fa-trash"></i></button></td>
            `;
            tbody.appendChild(tr);
        }

        function removeSlot(btn) {
            const rows = document.querySelectorAll('.slot-row');
            if (rows.length <= 1) {
                alert('Ən azı bir slot olmalıdır');
                return;
            }
            btn.closest('tr').remove();
        }
    </script>
}
