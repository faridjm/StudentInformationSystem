@model SIS.BLL.Services.DTOs.AcademicTerm.UpdateAcademicTermDto
@{
    ViewData["Title"] = "Semestri Düzəlt";
    var years = ViewBag.Years as IEnumerable<SIS.BLL.Services.DTOs.AcademicYear.AcademicYearDto>;
}

<div style="display:flex; align-items:center; gap:12px; margin-bottom:20px;">
    <a href="/Admin/AcademicTerm" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left"></i></a>
    <h2 style="font-size:20px; font-weight:700;">Semestri Düzəlt</h2>
</div>

<div class="card" style="max-width:720px;">
    <div class="card-body">
        <form method="post">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" style="color:#f87171; margin-bottom:12px; font-size:13px;"></div>

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
                <div class="form-group">
                    <label class="form-label">Dərs Sezonu</label>
                    <select asp-for="AcademicYearId" class="form-control" required>
                        <option value="">Sezon seçin</option>
                        @if (years != null)
                        {
                            @foreach (var y in years)
                            {
                                <option value="@y.Id">@y.Name (@y.StartDate.ToString("dd.MM.yyyy") – @y.EndDate.ToString("dd.MM.yyyy"))</option>
                            }
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">Ad</label>
                    <input asp-for="Name" class="form-control" maxlength="50" required />
                </div>
            </div>

            <h3 style="font-size:14px; color:var(--text-secondary); margin:16px 0 8px;">Qeydiyyat</h3>
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
                <div class="form-group">
                    <label class="form-label">Qeydiyyat başlanır</label>
                    <input asp-for="RegistrationStart" type="date" class="form-control" required />
                </div>
                <div class="form-group">
                    <label class="form-label">Qeydiyyat bitir</label>
                    <input asp-for="RegistrationEnd" type="date" class="form-control" required />
                </div>
            </div>

            <h3 style="font-size:14px; color:var(--text-secondary); margin:16px 0 8px;">Dərslər</h3>
            <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:12px;">
                <div class="form-group">
                    <label class="form-label">Dərslər başlanır</label>
                    <input asp-for="StartDate" type="date" class="form-control" required />
                </div>
                <div class="form-group">
                    <label class="form-label">Drop son tarixi</label>
                    <input asp-for="DropDeadline" type="date" class="form-control" required />
                </div>
                <div class="form-group">
                    <label class="form-label">Dərslər bitir</label>
                    <input asp-for="EndDate" type="date" class="form-control" required />
                </div>
            </div>

            <h3 style="font-size:14px; color:var(--text-secondary); margin:16px 0 8px;">İmtahanlar və qiymət</h3>
            <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:12px;">
                <div class="form-group">
                    <label class="form-label">İmtahan başlanır</label>
                    <input asp-for="ExamPeriodStart" type="date" class="form-control" required />
                </div>
                <div class="form-group">
                    <label class="form-label">İmtahan bitir</label>
                    <input asp-for="ExamPeriodEnd" type="date" class="form-control" required />
                </div>
                <div class="form-group">
                    <label class="form-label">Qiymət təsdiqi son</label>
                    <input asp-for="GradeSubmissionDeadline" type="date" class="form-control" required />
                </div>
            </div>

            <div style="display:flex; gap:10px; margin-top:8px;">
                <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Yenilə</button>
                <a href="/Admin/AcademicTerm" class="btn btn-secondary">Ləğv et</a>
            </div>
        </form>
    </div>
</div>
