@model IEnumerable<SIS.BLL.Services.DTOs.Enrollment.EnrollmentListDto>
@{
    ViewData["Title"] = L["GroupStudents"].Value;
    var first = Model.FirstOrDefault();

    string StatusBadge(EnrollmentStatus s) => s switch
    {
        EnrollmentStatus.Active => "badge-success",
        EnrollmentStatus.Completed => "badge-info",
        EnrollmentStatus.Dropped => "badge-danger",
        _ => "badge-secondary"
    };
}
<div style="display:flex; align-items:center; gap:12px; margin-bottom:20px;">
    <a href="/Admin/Enrollment" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left"></i></a>
    <div>
        <h2 style="font-size:20px; font-weight:700;">@(first?.GroupName ?? L["GroupStudents"].Value)</h2>
        @if (first != null)
        {
            <div style="font-size:13px; color:var(--text-muted);">
                <i class="fas fa-graduation-cap"></i> @first.CourseName
                · <i class="fas fa-chalkboard-teacher"></i> @first.TeacherName
            </div>
        }
    </div>
    <div style="margin-left:auto;">
        <a href="/Admin/Enrollment/Create?groupId=@ViewBag.GroupId" class="btn btn-primary btn-sm">
            <i class="fas fa-user-plus"></i> Qeydiyyat et
        </a>
    </div>
</div>
<div class="card">
    <div class="card-body" style="padding:0;">
        <table class="table">
            <thead>
                <tr>
                    <th>@L["Student"]</th>
                    <th>@L["PDF_StudentNo"]</th>
                    <th>@L["Email"]</th>
                    <th>Qeydiyyat tarixi</th>
                    <th>@L["Status"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td><strong>@e.StudentName</strong></td>
                        <td><code style="background:var(--bg-hover); padding:2px 8px; border-radius:4px; font-size:12px;">@e.StudentNumber</code></td>
                        <td style="color:var(--text-secondary); font-size:13px;">
                            @if (!string.IsNullOrWhiteSpace(e.StudentEmail))
                            {
                                <a href="mailto:@e.StudentEmail" style="color:var(--accent); text-decoration:none;">@e.StudentEmail</a>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </td>
                        <td style="color:var(--text-secondary); font-size:13px;">@e.EnrolledAt.ToString("dd.MM.yyyy")</td>
                        <td><span class="badge @StatusBadge(e.Status)">@e.Status</span></td>
                        <td>
                            <form method="post" action="/Admin/Enrollment/Drop/@e.Id?groupId=@ViewBag.GroupId"
                                  data-confirm="Bu enrollment-i drop etmək istəyirsiniz?"
                                  data-confirm-title="Tələbəni qrupdan çıxarmaq?"
                                  data-confirm-text="Çıxar">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-danger"><i class="fas fa-user-minus"></i></button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" style="text-align:center; color:var(--text-secondary); padding:30px;">Bu qrupda hələ tələbə yoxdur</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
