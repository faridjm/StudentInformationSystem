@{
    ViewData["Title"] = "Tələbə Qeydiyyatı";
}
<div style="max-width:560px; margin:0 auto;">
    <div style="display:flex; align-items:center; gap:12px; margin-bottom:20px;">
        <a href="/Admin/Enrollment" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left"></i></a>
        <h2 style="font-size:20px; font-weight:700;">Tələbə Qeydiyyatı</h2>
    </div>
    <form method="post" action="/Admin/Enrollment/Create">
        @Html.AntiForgeryToken()
        <div class="card">
            <div class="card-body">
                <div class="form-group">
                    <label class="form-label">Tələbə *</label>
                    <select name="StudentId" class="form-control" required>
                        <option value="">Seçin...</option>
                        @foreach (var s in (IEnumerable<SIS.BLL.Services.DTOs.Student.StudentListDto>)ViewBag.Students)
                        {
                            <option value="@s.Id">@s.FullName (@s.StudentNumber)</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Qrup *</label>
                    <select name="GroupId" class="form-control" required>
                        <option value="">Seçin...</option>
                        @foreach (var g in (IEnumerable<SIS.BLL.Services.DTOs.Groups.GroupListDto>)ViewBag.Groups)
                        {
                            var selected = (int?)ViewBag.SelectedGroupId == g.Id ? "selected" : "";
                            if ((int?)ViewBag.SelectedGroupId == g.Id)
                            {
                                <option value="@g.Id" selected="selected">@g.Name — @g.CourseName (@g.EnrolledCount/@g.Capacity)</option>
                            }
                            else
                            {
                                <option value="@g.Id">@g.Name — @g.CourseName (@g.EnrolledCount/@g.Capacity)</option>
                            }
                        }
                    </select>
                </div>
            </div>
        </div>
        <div style="display:flex; gap:12px; margin-top:16px;">
            <button type="submit" class="btn btn-primary"><i class="fas fa-user-plus"></i> Qeydiyyat et</button>
            <a href="/Admin/Enrollment" class="btn btn-secondary">Ləğv et</a>
        </div>
    </form>
</div>
