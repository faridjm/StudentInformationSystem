@model IEnumerable<SIS.BLL.Services.DTOs.Groups.GroupListDto>
@{
    ViewData["Title"] = "Qeydiyyatlar";
}
<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
    <h2 style="font-size:20px; font-weight:700;">Qeydiyyatlar</h2>
</div>
<div class="card">
    <div class="card-body" style="padding:0;">
        <table class="table">
            <thead>
                <tr>
                    <th>Qrup</th>
                    <th>Tədris Proqramı</th>
                    <th>Müəllim</th>
                    <th>Tələbə sayı</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var g in Model)
                {
                    <tr>
                        <td><strong>@g.Name</strong></td>
                        <td>@g.CourseName</td>
                        <td>@g.TeacherName</td>
                        <td>@g.EnrolledCount / @g.Capacity</td>
                        <td style="text-align:right;">
                            <a href="/Admin/Enrollment/Group?groupId=@g.Id" class="btn btn-sm btn-secondary">
                                <i class="fas fa-users"></i> Tələbələr
                            </a>
                            <a href="/Admin/Enrollment/Create?groupId=@g.Id" class="btn btn-sm btn-primary">
                                <i class="fas fa-user-plus"></i> Qeydiyyat
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="5" style="text-align:center; color:var(--text-secondary); padding:30px;">Hələ qrup yoxdur</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
