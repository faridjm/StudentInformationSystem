@model IEnumerable<SIS.BLL.Services.DTOs.Groups.GroupListDto>
@{
    ViewData["Title"] = L["Enrollments"].Value;
}
<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
    <h2 style="font-size:20px; font-weight:700;">@L["Enrollments"]</h2>
</div>
<div class="card">
    <div class="card-body" style="padding:0;">
        <table class="table">
            <thead>
                <tr>
                    <th>@L["Group"]</th>
                    <th>@L["Course"] / @L["Programme"]</th>
                    <th>@L["AcademicYear"]</th>
                    <th>@L["Teacher"]</th>
                    <th>@L["StudentCount"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var g in Model)
                {
                    <tr>
                        <td>
                            <strong>@g.Name</strong>
                            <div style="font-size:11px; color:var(--text-muted);">@g.StartDate.ToString("dd.MM.yy") – @g.EndDate.ToString("dd.MM.yy")</div>
                        </td>
                        <td>@g.CourseName</td>
                        <td>@(g.SeasonName ?? "—")</td>
                        <td>@g.TeacherName</td>
                        <td>@g.EnrolledCount / @g.Capacity</td>
                        <td style="text-align:right;">
                            <a href="/Admin/Enrollment/Group?groupId=@g.Id" class="btn btn-sm btn-secondary">
                                <i class="fas fa-users"></i> @L["Students"]
                            </a>
                            <a href="/Admin/Enrollment/Create?groupId=@g.Id" class="btn btn-sm btn-primary">
                                <i class="fas fa-user-plus"></i> Qeydiyyat
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" style="text-align:center; color:var(--text-secondary); padding:30px;">@L["NoGroups"]</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
