@using SIS.Entities.Enums
@model SIS.BLL.Services.DTOs.Curriculum.CurriculumTemplateDetailDto
@{
    ViewData["Title"] = "Şablon sıraları";
    string TypeLabel(AssessmentType t) => t switch
    {
        AssessmentType.Quiz => "Quiz",
        AssessmentType.Assignment => "Tapşırıq",
        AssessmentType.FinalProject => "Final Layihə",
        AssessmentType.Exam => "İmtahan",
        AssessmentType.Homework => "Ev tapşırığı",
        _ => t.ToString()
    };

    int TypeValue(AssessmentType t) => (int)t;

    // Növbəti boş SessionNumber default dəyəri (server tərəfdən hesablanır,
    // sonra client AJAX-la yeniləyir)
    int defaultNext = (Model?.Items?.Where(i => i.Id != 0).Select(i => (int?)i.SessionNumber).Max() ?? 0) + 1;
}

@if (Model == null)
{
    <div class="card" style="padding:40px; text-align:center; color:var(--text-secondary);">Şablon tapılmadı</div>
}
else
{
    <div style="display:flex; align-items:center; gap:12px; margin-bottom:6px;">
        <a href="/Admin/Curriculum" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left"></i></a>
        <h2 style="font-size:20px; font-weight:700;">@Model.Name</h2>
        @if (Model.IsActive)
        {
            <span style="padding:3px 10px; border-radius:12px; font-size:11px; font-weight:600; background:#dcfce7; color:#16a34a;">Aktiv</span>
        }
    </div>
    <p style="font-size:12px; color:var(--text-secondary); margin-bottom:16px;">@Model.CourseName · @Model.Items.Count sıra</p>

    <!-- Yeni sıra -->
    <div class="card" style="padding:18px; margin-bottom:18px;">
        <div style="font-weight:700; margin-bottom:10px;"><i class="fas fa-plus"></i> Sıra əlavə et</div>
        <form method="post" action="/Admin/Curriculum/AddItem" id="addSessionForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="templateId" value="@Model.Id" />
            <div style="display:grid; grid-template-columns:120px 1fr; gap:12px; margin-bottom:6px;">
                <div class="form-group" style="margin:0;">
                    <label class="form-label" style="font-size:12px;">Dərs № *</label>
                    <input id="addSessionNumber" name="sessionNumber" type="number" min="1"
                           value="@defaultNext" class="form-control" required />
                </div>
                <div class="form-group" style="margin:0;">
                    <label class="form-label" style="font-size:12px;">Mövzu *</label>
                    <input name="topic" class="form-control" required />
                </div>
            </div>
            <small style="color:var(--text-secondary); font-size:11px; display:block; margin-bottom:10px;">
                Növbəti boş sıra avtomatik təklif olunur, istəsəniz dəyişə bilərsiniz.
            </small>
            <label style="display:flex; align-items:center; gap:8px; font-size:13px; margin-bottom:10px; cursor:pointer;">
                <input type="checkbox" name="hasAssessment" value="true" id="hasAssess"
                       onchange="document.getElementById('assessFields').style.display=this.checked?'grid':'none'"
                       style="width:16px; height:16px;" />
                Bu sırada qiymətləndirmə var
            </label>
            <div id="assessFields" style="display:none; grid-template-columns:1fr 1fr 1fr 1fr; gap:12px;">
                <div class="form-group" style="margin:0;">
                    <label class="form-label" style="font-size:12px;">Başlıq</label>
                    <input name="assessmentTitle" class="form-control" placeholder="Quiz 1" />
                </div>
                <div class="form-group" style="margin:0;">
                    <label class="form-label" style="font-size:12px;">Növ</label>
                    <select name="assessmentType" class="form-control">
                        <option value="0">Quiz</option>
                        <option value="1">Tapşırıq</option>
                        <option value="2">Final Layihə</option>
                        <option value="3">İmtahan</option>
                        <option value="4">Ev tapşırığı</option>
                    </select>
                </div>
                <div class="form-group" style="margin:0;">
                    <label class="form-label" style="font-size:12px;">Çəki %</label>
                    <input name="weightPercent" type="number" step="0.5" min="0" class="form-control" placeholder="10" />
                </div>
                <div class="form-group" style="margin:0;">
                    <label class="form-label" style="font-size:12px;">Maks bal</label>
                    <input name="maxScore" type="number" step="0.5" min="0" class="form-control" placeholder="100" />
                </div>
            </div>
            <div style="margin-top:12px;">
                <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Əlavə et</button>
            </div>
        </form>
    </div>

    <!-- Sıralar -->
    @if (!Model.Items.Any())
    {
        <div class="card" style="padding:30px; text-align:center; color:var(--text-secondary);">Hələ sıra yoxdur</div>
    }
    else
    {
        <div class="card" style="padding:0; overflow-x:auto;">
            <table style="width:100%; border-collapse:collapse; font-size:13px;">
                <thead>
                    <tr style="background:var(--bg-hover); text-align:left;">
                        <th style="padding:10px 14px; width:70px;">Dərs №</th>
                        <th style="padding:10px 14px;">Mövzu</th>
                        <th style="padding:10px 14px;">Qiymətləndirmə</th>
                        <th style="padding:10px 14px; width:80px;">Çəki %</th>
                        <th style="padding:10px 14px; width:80px;">Maks bal</th>
                        <th style="padding:10px 14px; text-align:right; width:120px;">Əməliyyat</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in Model.Items)
                    {
                        <tr style="border-top:1px solid var(--border);">
                            <td style="padding:10px 14px; font-weight:700;">@i.SessionNumber</td>
                            <td style="padding:10px 14px;">@i.Topic</td>
                            <td style="padding:10px 14px;">
                                @if (i.HasAssessment && i.AssessmentType.HasValue)
                                {
                                    <span style="padding:2px 8px; border-radius:10px; font-size:11px; background:var(--accent-soft, rgba(233,69,96,.12)); color:var(--accent);">
                                        @i.AssessmentTitle · @TypeLabel(i.AssessmentType.Value)
                                    </span>
                                }
                                else
                                {
                                    <span style="color:var(--text-secondary);">—</span>
                                }
                            </td>
                            <td style="padding:10px 14px;">@(i.HasAssessment && i.WeightPercent.HasValue ? $"%{i.WeightPercent}" : "—")</td>
                            <td style="padding:10px 14px;">@(i.HasAssessment && i.MaxScore.HasValue ? i.MaxScore.ToString() : "—")</td>
                            <td style="padding:10px 14px; text-align:right; white-space:nowrap;">
                                <button type="button" class="btn btn-sm btn-secondary" onclick='openEdit(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
                                    id = i.Id,
                                    sessionNumber = i.SessionNumber,
                                    topic = i.Topic,
                                    hasAssessment = i.HasAssessment,
                                    assessmentTitle = i.AssessmentTitle,
                                    assessmentType = i.AssessmentType.HasValue ? (int?)TypeValue(i.AssessmentType.Value) : null,
                                    weightPercent = i.WeightPercent,
                                    maxScore = i.MaxScore
                                })))'>
                                    <i class="fas fa-edit"></i>
                                </button>
                                <form method="post" action="/Admin/Curriculum/DeleteItem" style="display:inline;"
                                      onsubmit="return confirmDelete(this, @(i.HasAssessment ? "true" : "false"));">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="itemId" value="@i.Id" />
                                    <input type="hidden" name="templateId" value="@Model.Id" />
                                    <button type="submit" class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <!-- ── EDIT MODAL ── -->
    <div id="editModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,.5); z-index:1000; align-items:center; justify-content:center;">
        <div style="background:var(--bg-card, #fff); border-radius:10px; width:560px; max-width:92%; max-height:92vh; overflow-y:auto;">
            <div style="padding:18px 20px; border-bottom:1px solid var(--border); display:flex; align-items:center; justify-content:space-between;">
                <div style="font-weight:700;">Dərs sırasını redaktə et</div>
                <button type="button" onclick="closeEdit()" class="btn btn-sm btn-secondary"><i class="fas fa-times"></i></button>
            </div>
            <form method="post" action="/Admin/Curriculum/UpdateItem" style="padding:18px 20px;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="edit_id" />
                <input type="hidden" name="templateId" value="@Model.Id" />

                <div style="display:grid; grid-template-columns:120px 1fr; gap:12px; margin-bottom:12px;">
                    <div class="form-group" style="margin:0;">
                        <label class="form-label" style="font-size:12px;">Dərs № *</label>
                        <input id="edit_sessionNumber" name="sessionNumber" type="number" min="1" class="form-control" required />
                    </div>
                    <div class="form-group" style="margin:0;">
                        <label class="form-label" style="font-size:12px;">Mövzu *</label>
                        <input id="edit_topic" name="topic" class="form-control" required />
                    </div>
                </div>

                <label style="display:flex; align-items:center; gap:8px; font-size:13px; margin-bottom:12px; cursor:pointer;">
                    <input type="checkbox" name="hasAssessment" value="true" id="edit_hasAssess"
                           onchange="toggleEditAssess(this.checked)" style="width:16px; height:16px;" />
                    Bu sırada qiymətləndirmə var
                </label>

                <div id="edit_assessFields" style="display:none; grid-template-columns:1fr 1fr 1fr 1fr; gap:12px;">
                    <div class="form-group" style="margin:0;">
                        <label class="form-label" style="font-size:12px;">Başlıq</label>
                        <input id="edit_assessmentTitle" name="assessmentTitle" class="form-control" />
                    </div>
                    <div class="form-group" style="margin:0;">
                        <label class="form-label" style="font-size:12px;">Növ</label>
                        <select id="edit_assessmentType" name="assessmentType" class="form-control">
                            <option value="0">Quiz</option>
                            <option value="1">Tapşırıq</option>
                            <option value="2">Final Layihə</option>
                            <option value="3">İmtahan</option>
                            <option value="4">Ev tapşırığı</option>
                        </select>
                    </div>
                    <div class="form-group" style="margin:0;">
                        <label class="form-label" style="font-size:12px;">Çəki %</label>
                        <input id="edit_weightPercent" name="weightPercent" type="number" step="0.5" min="0" class="form-control" />
                    </div>
                    <div class="form-group" style="margin:0;">
                        <label class="form-label" style="font-size:12px;">Maks bal</label>
                        <input id="edit_maxScore" name="maxScore" type="number" step="0.5" min="0" class="form-control" />
                    </div>
                </div>

                <div id="edit_assessWarning"
                     style="display:none; margin-top:10px; padding:8px 10px; background:#fef3c7; color:#92400e; border-radius:6px; font-size:12px;">
                    <i class="fas fa-exclamation-triangle"></i>
                    Bu sıradakı qiymətləndirmə silinəcək. Saxla deməklə təsdiqləyirsiniz.
                </div>

                <div style="margin-top:16px; display:flex; gap:10px; justify-content:flex-end;">
                    <button type="button" onclick="closeEdit()" class="btn btn-secondary">Ləğv et</button>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Saxla</button>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
<script>
(function () {
    var templateId = @(Model?.Id ?? 0);
    var addSession = document.getElementById('addSessionNumber');

    // Səhifə açıldıqda və əlavə əməliyyatdan sonra növbəti boş sıranı server-dən təzələ
    function refreshNext() {
        if (!addSession || !templateId) return;
        fetch('/Admin/Curriculum/NextSessionNumber?templateId=' + templateId)
            .then(function (r) { return r.ok ? r.json() : null; })
            .then(function (d) {
                if (d && typeof d.next === 'number') addSession.value = d.next;
            })
            .catch(function () {});
    }
    refreshNext();
})();

// Cascade-delete confirm
function confirmDelete(form, hasAssessment) {
    if (hasAssessment) {
        return confirm('Bu dərs sırasında qiymətləndirmə var. Silsəniz, bağlı qiymətləndirmə də silinəcək. Davam etmək istəyirsiniz?');
    }
    return confirm('Sıra silinsin?');
}

// ── Edit modal ──
var initialHadAssess = false;

function openEdit(data) {
    document.getElementById('edit_id').value             = data.id;
    document.getElementById('edit_sessionNumber').value  = data.sessionNumber;
    document.getElementById('edit_topic').value          = data.topic || '';
    document.getElementById('edit_assessmentTitle').value = data.assessmentTitle || '';
    document.getElementById('edit_weightPercent').value   = data.weightPercent  != null ? data.weightPercent : '';
    document.getElementById('edit_maxScore').value        = data.maxScore       != null ? data.maxScore      : '';
    if (data.assessmentType != null)
        document.getElementById('edit_assessmentType').value = data.assessmentType;

    var chk = document.getElementById('edit_hasAssess');
    chk.checked = !!data.hasAssessment;
    initialHadAssess = !!data.hasAssessment;
    toggleEditAssess(chk.checked);

    var modal = document.getElementById('editModal');
    modal.style.display = 'flex';
}

function closeEdit() {
    document.getElementById('editModal').style.display = 'none';
}

function toggleEditAssess(checked) {
    document.getElementById('edit_assessFields').style.display = checked ? 'grid' : 'none';
    var w = document.getElementById('edit_assessWarning');
    if (initialHadAssess && !checked) {
        w.style.display = 'block';
    } else {
        w.style.display = 'none';
    }
}
</script>
}
