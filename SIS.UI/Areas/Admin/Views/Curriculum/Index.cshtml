@model IEnumerable<SIS.BLL.Services.DTOs.Curriculum.CurriculumTemplateDto>
@{
    ViewData["Title"] = "Tədris Şablonları";
    var courses = ViewBag.Courses as List<SIS.BLL.Services.DTOs.Course.CourseDto> ?? new();
}

<h2 style="font-size:20px; font-weight:700; margin-bottom:16px;"><i class="fas fa-stream"></i> Tədris Cədvəli Şablonları</h2>

<div class="card" style="padding:18px; margin-bottom:18px;">
    <div style="font-weight:700; margin-bottom:10px;"><i class="fas fa-plus-circle"></i> Yeni şablon</div>
    <form method="post" action="/Admin/Curriculum/Create">
        @Html.AntiForgeryToken()
        <div style="display:grid; grid-template-columns:1fr 1fr 1.5fr auto; gap:12px; align-items:end;">
            <div class="form-group" style="margin:0;">
                <label class="form-label" style="font-size:12px;">Kurs *</label>
                <select name="courseId" class="form-control" required>
                    <option value="">Seçin...</option>
                    @foreach (var c in courses)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
            </div>
            <div class="form-group" style="margin:0;">
                <label class="form-label" style="font-size:12px;">Ad *</label>
                <input name="name" class="form-control" placeholder="məs: Full Stack 110" required />
            </div>
            <div class="form-group" style="margin:0;">
                <label class="form-label" style="font-size:12px;">Təsvir</label>
                <input name="description" class="form-control" />
            </div>
            <button type="submit" class="btn btn-primary"><i class="fas fa-plus"></i> Yarat</button>
        </div>
    </form>
</div>

@if (!Model.Any())
{
    <div class="card" style="padding:40px; text-align:center; color:var(--text-secondary);">
        <i class="fas fa-stream" style="font-size:48px; opacity:.3; display:block; margin-bottom:12px;"></i>
        <p>Hələ şablon yoxdur</p>
    </div>
}
else
{
    <div class="card" style="padding:0; overflow-x:auto;">
        <table style="width:100%; border-collapse:collapse; font-size:13px; min-width:760px;">
            <thead>
                <tr style="background:var(--bg-hover); text-align:left;">
                    <th style="padding:10px 14px;">Ad</th>
                    <th style="padding:10px 14px;">Kurs</th>
                    <th style="padding:10px 14px;">Dərs sayı</th>
                    <th style="padding:10px 14px;">Qiymətləndirmə</th>
                    <th style="padding:10px 14px;">Status</th>
                    <th style="padding:10px 14px; text-align:right;">Əməliyyat</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model)
                {
                    <tr style="border-top:1px solid var(--border);">
                        <td style="padding:10px 14px; font-weight:600;">@t.Name</td>
                        <td style="padding:10px 14px; color:var(--text-secondary);">@t.CourseName</td>
                        <td style="padding:10px 14px;">@t.ItemCount</td>
                        <td style="padding:10px 14px;">@t.AssessmentCount</td>
                        <td style="padding:10px 14px;">
                            @if (t.IsActive)
                            {
                                <span style="padding:3px 10px; border-radius:12px; font-size:11px; font-weight:600; background:#dcfce7; color:#16a34a;">Aktiv</span>
                            }
                            else
                            {
                                <span style="padding:3px 10px; border-radius:12px; font-size:11px; font-weight:600; background:#f1f5f9; color:#475569;">Deaktiv</span>
                            }
                        </td>
                        <td style="padding:10px 14px; text-align:right; white-space:nowrap;">
                            <a href="/Admin/Curriculum/Manage/@t.Id" class="btn btn-sm btn-secondary"><i class="fas fa-list"></i> Sıralar</a>
                            <form method="post" action="/Admin/Curriculum/SetActive" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@t.Id" />
                                <input type="hidden" name="active" value="@((!t.IsActive).ToString().ToLower())" />
                                <button type="submit" class="btn btn-sm btn-secondary">@(t.IsActive ? "Deaktiv et" : "Aktivləşdir")</button>
                            </form>
                            <form method="post" action="/Admin/Curriculum/Delete" style="display:inline;"
                                  data-confirm="Bu şablon silinsin?"
                                  data-confirm-title="Şablon silinsin?"
                                  data-confirm-text="Sil">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@t.Id" />
                                <button type="submit" class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
