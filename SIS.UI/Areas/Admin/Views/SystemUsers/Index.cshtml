@model SIS.BLL.Services.DTOs.Common.PagedResult<SIS.BLL.Services.DTOs.SystemUsers.SystemUserListItemDto>

@{
    ViewData["Title"] = "Sistem İstifadəçiləri";
    string? search = ViewBag.Search as string;
    string? role = ViewBag.Role as string;
    string status = (ViewBag.Status as string) ?? "all";
    int pageSize = ViewBag.PageSize is int ps ? ps : 20;

    string RoleBadge(string r) => r switch
    {
        "SuperAdmin" => "background:#581c87; color:#fff;",
        "Admin"      => "background:#1d4ed8; color:#fff;",
        "Moderator"  => "background:#0d9488; color:#fff;",
        "Teacher"    => "background:#4f46e5; color:#fff;",
        "Student"    => "background:#059669; color:#fff;",
        _            => "background:#475569; color:#fff;"
    };
}

<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; flex-wrap:wrap; gap:12px;">
    <div>
        <h2 style="font-size:20px; font-weight:700; margin:0;">Sistem İstifadəçiləri</h2>
        <div style="color:var(--text-secondary); font-size:13px; margin-top:4px;">
            Cəmi: <strong style="color:var(--text-primary);">@Model.TotalCount</strong>
        </div>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus"></i> Yeni İstifadəçi
    </a>
</div>

<form method="get" action="/Admin/SystemUsers" class="card" style="padding:16px; margin-bottom:18px;">
    <div style="display:grid; grid-template-columns:2fr 1fr 1fr auto; gap:10px;">
        <input type="text" name="search" value="@search" placeholder="Ad / email axtar..." class="form-control" />
        <select name="role" class="form-control">
            <option value="">Bütün rollar</option>
            @foreach (var r in new[] { "SuperAdmin", "Admin", "Moderator", "Teacher", "Student" })
            {
                <option value="@r" selected="@(r == role)">@r</option>
            }
        </select>
        <select name="status" class="form-control">
            <option value="all" selected="@(status == "all")">Bütün status</option>
            <option value="active" selected="@(status == "active")">Aktiv</option>
            <option value="disabled" selected="@(status == "disabled")">Deaktiv</option>
        </select>
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-magnifying-glass"></i> Axtar
        </button>
    </div>
</form>

@if (Model.Items == null || Model.Items.Count == 0)
{
    <div class="card" style="padding:60px 20px; text-align:center; color:var(--text-secondary);">
        <i class="fas fa-users-slash" style="font-size:42px; opacity:.3; margin-bottom:14px; display:block;"></i>
        <p style="font-weight:600; margin-bottom:6px;">Heç bir istifadəçi tapılmadı.</p>
        <p style="font-size:13px;">Yeni İstifadəçi düyməsi ilə ilkin sistem istifadəçisini yarada bilərsiniz.</p>
    </div>
}
else
{
    <div class="card" style="overflow-x:auto;">
        <table class="table" style="width:100%;">
            <thead>
                <tr>
                    <th>İstifadəçi</th>
                    <th>Email</th>
                    <th>Rol</th>
                    <th>Panel Access</th>
                    <th>Status</th>
                    <th>Yaradıldı</th>
                    <th style="text-align:right;">Əməliyyatlar</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model.Items)
                {
                    <tr>
                        <td>
                            <div style="font-weight:600;">@u.FullName</div>
                            @if (!string.IsNullOrWhiteSpace(u.PhoneNumber))
                            {
                                <div style="color:var(--text-secondary); font-size:12px;">@u.PhoneNumber</div>
                            }
                        </td>
                        <td>
                            @u.Email
                            @if (u.EmailConfirmed)
                            {
                                <i class="fas fa-circle-check" title="Email təsdiqlənmiş" style="color:#10b981; margin-left:6px;"></i>
                            }
                        </td>
                        <td>
                            <span style="@RoleBadge(u.Role); padding:3px 10px; border-radius:999px; font-size:12px; font-weight:700;">@u.Role</span>
                        </td>
                        <td style="font-size:13px; color:var(--text-secondary);">
                            @u.PanelAccess
                            @if (u.Role == "Admin")
                            {
                                @if (u.AdminAccessActive == true)
                                {
                                    <span style="display:inline-block; margin-left:6px; padding:2px 8px; border-radius:999px; background:#dcfce7; color:#166534; font-size:11px; font-weight:700;">access aktiv</span>
                                }
                                else
                                {
                                    <span style="display:inline-block; margin-left:6px; padding:2px 8px; border-radius:999px; background:#f3f4f6; color:#374151; font-size:11px; font-weight:700;">access yox</span>
                                }
                            }
                        </td>
                        <td>
                            @if (u.IsActive)
                            {
                                <span style="background:#dcfce7; color:#166534; padding:3px 10px; border-radius:999px; font-size:12px; font-weight:700;">Aktiv</span>
                            }
                            else
                            {
                                <span style="background:#fee2e2; color:#991b1b; padding:3px 10px; border-radius:999px; font-size:12px; font-weight:700;">Deaktiv</span>
                            }
                        </td>
                        <td style="font-size:12px; color:var(--text-secondary);">@u.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</td>
                        <td style="text-align:right; white-space:nowrap;">
                            <a asp-action="Details" asp-route-id="@u.Id" class="btn btn-sm" title="Bax"><i class="fas fa-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm" title="Redaktə"><i class="fas fa-pen"></i></a>
                            <a asp-action="ChangePassword" asp-route-id="@u.Id" class="btn btn-sm" title="Şifrə"><i class="fas fa-key"></i></a>
                            @if (u.IsActive)
                            {
                                <form method="post" action="/Admin/SystemUsers/Disable/@u.Id" style="display:inline;"
                                      data-confirm="Bu istifadəçini deaktiv etmək istədiyinizə əminsiniz? Login edə bilməyəcək."
                                      data-confirm-title="İstifadəçini deaktiv et?"
                                      data-confirm-text="Deaktiv et">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger" title="Deaktiv et">
                                        <i class="fas fa-ban"></i>
                                    </button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="Enable" asp-route-id="@u.Id" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-success" title="Aktivləşdir">
                                        <i class="fas fa-check"></i>
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div style="display:flex; justify-content:center; gap:6px; margin-top:18px;">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <a href="?search=@search&role=@role&status=@status&page=@i&pageSize=@pageSize"
                   class="btn btn-sm @(i == Model.Page ? "btn-primary" : "")"
                   style="@(i == Model.Page ? "" : "background:var(--bg-hover);")">@i</a>
            }
        </div>
    }
}
