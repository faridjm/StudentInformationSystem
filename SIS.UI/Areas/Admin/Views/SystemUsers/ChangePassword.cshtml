@model SIS.BLL.Services.DTOs.SystemUsers.ChangeSystemUserPasswordDto

@{
    ViewData["Title"] = "Şifrəni Dəyiş";
    string userId = ViewBag.UserId as string ?? "";
    string fn = ViewBag.UserFullName as string ?? "";
    string em = ViewBag.UserEmail as string ?? "";
}

<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:18px;">
    <h2 style="font-size:20px; font-weight:700; margin:0;">Şifrəni Dəyiş</h2>
    <a asp-action="Index" class="btn"><i class="fas fa-arrow-left"></i> Geri</a>
</div>

<div class="card" style="padding:24px; max-width:520px;">
    <div style="margin-bottom:16px; padding:12px 14px; border-radius:10px; background:rgba(99,102,241,0.08); border:1px solid rgba(99,102,241,0.2);">
        <div style="font-weight:600;">@fn</div>
        <div style="color:var(--text-secondary); font-size:13px;">@em</div>
    </div>

    <form asp-action="ChangePassword" asp-route-id="@userId" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="All" class="text-danger" style="margin-bottom:14px;"></div>

        <div style="margin-bottom:14px;">
            <label class="form-label">Yeni şifrə *</label>
            <input asp-for="NewPassword" type="password" class="form-control" required minlength="8" />
        </div>
        <div style="margin-bottom:14px;">
            <label class="form-label">Şifrəni təkrar *</label>
            <input asp-for="ConfirmPassword" type="password" class="form-control" required minlength="8" />
        </div>

        <div style="font-size:12px; color:var(--text-secondary); margin-bottom:16px;">
            <i class="fas fa-circle-info"></i> Şifrə minimum 8 simvol, böyük və kiçik hərf, rəqəm tələb olunur. Şifrə audit logda saxlanılmır.
        </div>

        <div style="display:flex; gap:10px;">
            <button type="submit" class="btn btn-primary"><i class="fas fa-key"></i> Şifrəni dəyiş</button>
            <a asp-action="Index" class="btn">İmtina</a>
        </div>
    </form>
</div>
