@model SIS.BLL.Services.DTOs.Common.PagedResult<SIS.BLL.Services.DTOs.AuditLog.AuditLogDto>

@{
    ViewData["Title"] = L["AuditLogs"].Value;
    var actions  = ViewBag.Actions  as List<string> ?? new List<string>();
    var entities = ViewBag.Entities as List<string> ?? new List<string>();
    string? selAction   = ViewBag.Action     as string;
    string? selEntity   = ViewBag.EntityName as string;
    string? search      = ViewBag.Search     as string;
    string? fromDate    = ViewBag.FromDate   as string;
    string? toDate      = ViewBag.ToDate     as string;
    int pageSize = ViewBag.PageSize is int ps ? ps : 20;

    string ActionBadge(string a) => a.ToLowerInvariant() switch
    {
        "create"   => "background:#dcfce7; color:#166534;",
        "update"   => "background:#dbeafe; color:#1e40af;",
        "delete"   => "background:#fee2e2; color:#991b1b;",
        "submit"   => "background:#ede9fe; color:#5b21b6;",
        "review"   => "background:#fef3c7; color:#92400e;",
        "enroll"   => "background:#cffafe; color:#155e75;",
        "drop"     => "background:#fef2f2; color:#7f1d1d;",
        "activate" => "background:#dcfce7; color:#14532d;",
        "deactivate" => "background:#f3f4f6; color:#374151;",
        _ => "background:var(--bg-hover); color:var(--text-secondary);"
    };
}

<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
    <h2 style="font-size:20px; font-weight:700;">@L["AuditLogs"]</h2>
    <span style="color:var(--text-secondary); font-size:13px;">
        Cəmi: <strong style="color:var(--text-primary);">@Model.TotalCount</strong>
    </span>
</div>

<!-- FILTRƏLƏR -->
<form method="get" action="/Admin/AuditLogs" class="card" style="padding:16px; margin-bottom:18px;">
    <div style="display:grid; grid-template-columns:2fr 1fr 1fr 1fr 1fr auto; gap:10px;">
        <input type="text" name="search" value="@search" placeholder="Axtar (ad, təsvir, ID)..." class="form-control" />
        <select name="action" class="form-control">
            <option value="">Bütün əməliyyatlar</option>
            @foreach (var a in actions)
            {
                <option value="@a" selected="@(a == selAction)">@a</option>
            }
        </select>
        <select name="entityName" class="form-control">
            <option value="">Bütün entity-lər</option>
            @foreach (var e in entities)
            {
                <option value="@e" selected="@(e == selEntity)">@e</option>
            }
        </select>
        <input type="date" name="fromDate" value="@fromDate" class="form-control" title="Bu tarixdən" />
        <input type="date" name="toDate" value="@toDate" class="form-control" title="Bu tarixə qədər" />
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-magnifying-glass"></i> Axtar
        </button>
    </div>
    @if (!string.IsNullOrEmpty(selAction) || !string.IsNullOrEmpty(selEntity)
         || !string.IsNullOrEmpty(search) || !string.IsNullOrEmpty(fromDate) || !string.IsNullOrEmpty(toDate))
    {
        <div style="margin-top:10px;">
            <a href="/Admin/AuditLogs" style="color:var(--accent); font-size:12px;">
                <i class="fas fa-times"></i> Filtri sıfırla
            </a>
        </div>
    }
</form>

@if (!Model.Items.Any())
{
    <div class="card" style="padding:60px 20px; text-align:center; color:var(--text-secondary);">
        <i class="fas fa-clipboard-list" style="font-size:42px; opacity:.3; margin-bottom:14px; display:block;"></i>
        <p style="font-weight:600; margin-bottom:6px;">Heç bir audit log tapılmadı.</p>
        <p style="font-size:13px;">Sistemdə (məsələn, tələbə və ya qrup yaratmaq kimi) əməliyyat icra etdikdə loglar burada görünəcək.</p>
    </div>
}
else
{
    <div class="card" style="padding:0; overflow-x:auto;">
        <table style="width:100%; border-collapse:collapse; font-size:13px;">
            <thead>
                <tr style="background:var(--bg-hover); text-align:left;">
                    <th style="padding:10px 14px; width:140px;">Tarix</th>
                    <th style="padding:10px 14px;">İstifadəçi</th>
                    <th style="padding:10px 14px; width:110px;">Rol</th>
                    <th style="padding:10px 14px; width:120px;">Əməliyyat</th>
                    <th style="padding:10px 14px; width:140px;">Entity</th>
                    <th style="padding:10px 14px;">Təsvir</th>
                    <th style="padding:10px 14px; width:120px;">IP</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model.Items)
                {
                    <tr style="border-top:1px solid var(--border);">
                        <td style="padding:10px 14px; color:var(--text-secondary); white-space:nowrap;">
                            @log.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                        </td>
                        <td style="padding:10px 14px;">
                            @if (!string.IsNullOrEmpty(log.UserFullName))
                            {
                                <span style="font-weight:500;">@log.UserFullName</span>
                            }
                            else
                            {
                                <span style="color:var(--text-secondary); font-style:italic;">System</span>
                            }
                        </td>
                        <td style="padding:10px 14px;">
                            @if (!string.IsNullOrEmpty(log.UserRole))
                            {
                                <span class="badge badge-secondary">@log.UserRole</span>
                            }
                            else { <span style="color:var(--text-secondary);">—</span> }
                        </td>
                        <td style="padding:10px 14px;">
                            <span style="display:inline-block; padding:3px 10px; border-radius:12px; font-size:11px; font-weight:700; @ActionBadge(log.Action)">
                                @log.Action
                            </span>
                        </td>
                        <td style="padding:10px 14px;">
                            <span style="font-weight:500;">@log.EntityName</span>
                            @if (!string.IsNullOrEmpty(log.EntityId))
                            {
                                <span style="color:var(--text-secondary);"> #@log.EntityId</span>
                            }
                        </td>
                        <td style="padding:10px 14px;">
                            @if (!string.IsNullOrEmpty(log.Description))
                            {
                                <span>@log.Description</span>
                            }
                            else { <span style="color:var(--text-secondary);">—</span> }
                        </td>
                        <td style="padding:10px 14px; color:var(--text-secondary); font-family:monospace; font-size:11px;">
                            @(log.IpAddress ?? "—")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- PAGINATION -->
    @if (Model.TotalPages > 1)
    {
        var qs = $"&search={search}&action={selAction}&entityName={selEntity}&fromDate={fromDate}&toDate={toDate}&pageSize={pageSize}";
        <div style="display:flex; justify-content:center; gap:6px; margin-top:18px; flex-wrap:wrap;">
            @if (Model.Page > 1)
            {
                <a href="?page=@(Model.Page - 1)@qs" class="btn btn-sm btn-secondary">
                    <i class="fas fa-chevron-left"></i>
                </a>
            }
            @{
                int start = Math.Max(1, Model.Page - 2);
                int end   = Math.Min(Model.TotalPages, Model.Page + 2);
            }
            @for (int p = start; p <= end; p++)
            {
                if (p == Model.Page)
                {
                    <span class="btn btn-sm btn-primary" style="pointer-events:none;">@p</span>
                }
                else
                {
                    <a href="?page=@p@qs" class="btn btn-sm btn-secondary">@p</a>
                }
            }
            @if (Model.Page < Model.TotalPages)
            {
                <a href="?page=@(Model.Page + 1)@qs" class="btn btn-sm btn-secondary">
                    <i class="fas fa-chevron-right"></i>
                </a>
            }
        </div>
        <div style="text-align:center; margin-top:8px; color:var(--text-secondary); font-size:12px;">
            Səhifə @Model.Page / @Model.TotalPages — @Model.Items.Count() / @Model.TotalCount
        </div>
    }
}
