@model SIS.BLL.Services.DTOs.AcademicProgram.CreateAcademicProgramDto

@{
    ViewData["Title"] = "Yeni Proqram";
}

<div style="display:flex; align-items:center; gap:12px; margin-bottom:20px;">
    <a href="/Admin/AcademicProgram" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left"></i></a>
    <h2 style="font-size:20px; font-weight:700;">Yeni Akademik Proqram</h2>
</div>

<div style="display:grid; grid-template-columns:1fr 300px; gap:16px; align-items:start;">
    <div class="card">
        <div class="card-body">
            <form method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" style="color:#f87171; margin-bottom:12px; font-size:13px;"></div>

                <div class="form-group">
                    <label class="form-label">Ad</label>
                    <input asp-for="Name" class="form-control" placeholder="Proqram adı" />
                    <span asp-validation-for="Name" style="color:#f87171; font-size:12px;"></span>
                </div>

                <div class="form-group">
                    <label class="form-label">Kod</label>
                    <input asp-for="Code" class="form-control" placeholder="BCS" />
                    <span asp-validation-for="Code" style="color:#f87171; font-size:12px;"></span>
                </div>

                <div class="form-group">
                    <label class="form-label">Departament</label>
                    <select asp-for="DepartmentId" class="form-control">
                        <option value="">Departament seçin</option>
                        @foreach (var d in ViewBag.Departments as IEnumerable<SIS.BLL.Services.DTOs.Department.DepartmentDto> ?? [])
                        {
                            <option value="@d.Id">@d.Name</option>
                        }
                    </select>
                    <span asp-validation-for="DepartmentId" style="color:#f87171; font-size:12px;"></span>
                </div>

                <div class="form-group">
                    <label class="form-label">Müddət (il)</label>
                    <input asp-for="DurationYears" type="number" class="form-control" min="1" max="6" placeholder="4" />
                    <span asp-validation-for="DurationYears" style="color:#f87171; font-size:12px;"></span>
                </div>

                <div class="form-group">
                    <label class="form-label">Təsvir</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                </div>

                <div style="display:flex; gap:10px; margin-top:8px;">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Yarat</button>
                    <a href="/Admin/AcademicProgram" class="btn btn-secondary">Ləğv et</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Departament siyahısı -->
    <div class="card">
        <div class="card-header">
            <span><i class="fas fa-building" style="margin-right:8px;"></i>Departamentlər</span>
        </div>
        <div class="card-body" style="padding:12px;">
            @foreach (var d in ViewBag.Departments as IEnumerable<SIS.BLL.Services.DTOs.Department.DepartmentDto> ?? [])
            {
                <div style="display:flex; justify-content:space-between; padding:8px; border-radius:6px; margin-bottom:4px; background:var(--bg-hover);">
                    <span style="font-size:13px;">@d.Name</span>
                    <span style="font-size:12px; color:var(--accent); font-weight:700;">ID: @d.Id</span>
                </div>
            }
        </div>
    </div>
</div>