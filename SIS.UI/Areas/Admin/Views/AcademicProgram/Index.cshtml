@model IEnumerable<SIS.BLL.Services.DTOs.AcademicProgram.AcademicProgramDto>

@{
    ViewData["Title"] = "Akademik Proqramlar";
}

<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
    <h2 style="font-size:20px; font-weight:700;">Akademik Proqramlar</h2>
    <a href="/Admin/AcademicProgram/Create" class="btn btn-primary">
        <i class="fas fa-plus"></i> Yeni Proqram
    </a>
</div>

<div class="card">
    <div style="overflow-x:auto;">
        <table class="table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Ad</th>
                    <th>Kod</th>
                    <th>Departament</th>
                    <th>Müddət</th>
                    <th>Əməliyyat</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>@p.Id</td>
                        <td style="font-weight:500;">@p.Name</td>
                        <td><code style="background:var(--bg-hover); padding:2px 8px; border-radius:4px;">@p.Code</code></td>
                        <td>@p.DepartmentName</td>
                        <td><span class="badge badge-info">@p.DurationYears il</span></td>
                        <td>
                            <div style="display:flex; gap:6px;">
                                <a href="/Admin/AcademicProgram/Edit/@p.Id" class="btn btn-sm btn-secondary">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form method="post" action="/Admin/AcademicProgram/Delete/@p.Id"
                                      onsubmit="return confirm('Proqramı silmək istədiyinizdən əminsinizmi?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>