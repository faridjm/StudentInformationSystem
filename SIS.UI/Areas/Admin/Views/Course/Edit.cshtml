@model SIS.BLL.Services.DTOs.Course.UpdateCourseDto
@{
    ViewData["Title"] = "Proqramı Düzəlt";
}
<div style="max-width:560px; margin:0 auto;">
    <div style="display:flex; align-items:center; gap:12px; margin-bottom:20px;">
        <a href="/Admin/Course" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left"></i></a>
        <h2 style="font-size:20px; font-weight:700;">Proqramı Düzəlt</h2>
    </div>
    <form method="post" action="/Admin/Course/Edit">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="@Model.Id" />
        <div class="card">
            <div class="card-body">
                <div class="form-group">
                    <label class="form-label">Proqram adı *</label>
                    <input name="Name" value="@Model.Name" class="form-control" required />
                </div>
                <div class="form-group">
                    <label class="form-label">Təsvir</label>
                    <textarea name="Description" class="form-control" rows="3">@Model.Description</textarea>
                </div>
                <div class="form-group">
                    <label class="form-label">Status</label>
                    <select name="IsActive" class="form-control">
                        @if (Model.IsActive)
                        {
                            <option value="true" selected="selected">Aktiv</option>
                            <option value="false">Deaktiv</option>
                        }
                        else
                        {
                            <option value="true">Aktiv</option>
                            <option value="false" selected="selected">Deaktiv</option>
                        }
                    </select>
                </div>
            </div>
        </div>
        <div style="display:flex; gap:12px; margin-top:16px;">
            <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Yadda saxla</button>
            <a href="/Admin/Course" class="btn btn-secondary">Ləğv et</a>
        </div>
    </form>
</div>
