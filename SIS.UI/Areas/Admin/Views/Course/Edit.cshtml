@model SIS.BLL.Services.DTOs.Course.UpdateCourseDto

@{
    ViewData["Title"] = "Kursu Düzəlt";
}

<div style="display:flex; align-items:center; gap:12px; margin-bottom:20px;">
    <a href="/Admin/Course" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left"></i></a>
    <h2 style="font-size:20px; font-weight:700;">Kursu Düzəlt</h2>
</div>

<div class="card" style="max-width:500px;">
    <div class="card-body">
        <form method="post">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" style="color:#f87171; margin-bottom:12px; font-size:13px;"></div>

            <div class="form-group">
                <label class="form-label">Ad</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" style="color:#f87171; font-size:12px;"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Kredit</label>
                <input asp-for="Credits" type="number" class="form-control" min="1" max="10" />
                <span asp-validation-for="Credits" style="color:#f87171; font-size:12px;"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Departament</label>
                <select asp-for="DepartmentId" id="DepartmentId" class="form-control" required>
                    <option value="">Departament seçin</option>
                    @foreach (var d in ViewBag.Departments as IEnumerable<SIS.BLL.Services.DTOs.Department.DepartmentDto> ?? [])
                    {
                        <option value="@d.Id" data-deptid="@d.Id">@d.Name</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label class="form-label">Akademik Proqram</label>
                <select asp-for="AcademicProgramId" id="AcademicProgramId" class="form-control" required>
                    <option value="">Proqram seçin</option>
                    @foreach (var p in ViewBag.Programs as IEnumerable<SIS.BLL.Services.DTOs.AcademicProgram.AcademicProgramDto> ?? [])
                    {
                        <option value="@p.Id" data-deptid="@p.DepartmentId">@p.Name (@p.Code)</option>
                    }
                </select>
                <span asp-validation-for="AcademicProgramId" style="color:#f87171; font-size:12px;"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Təsvir</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            </div>

            <div style="display:flex; gap:10px; margin-top:8px;">
                <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Yenilə</button>
                <a href="/Admin/Course" class="btn btn-secondary">Ləğv et</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const deptSelect = document.getElementById('DepartmentId');
            const progSelect = document.getElementById('AcademicProgramId');
            if (!deptSelect || !progSelect) return;

            const allOptions = Array.from(progSelect.querySelectorAll('option[data-deptid]'))
                .map(o => ({ value: o.value, deptId: o.dataset.deptid, text: o.textContent }));

            function refreshPrograms(selectedProgramId) {
                const deptId = deptSelect.value;
                while (progSelect.options.length > 1) progSelect.remove(1);

                if (!deptId) {
                    progSelect.options[0].text = 'Əvvəl departament seçin';
                    return;
                }
                progSelect.options[0].text = 'Proqram seçin';

                const filtered = allOptions.filter(o => o.deptId === deptId);
                filtered.forEach(o => {
                    const opt = document.createElement('option');
                    opt.value = o.value;
                    opt.textContent = o.text;
                    opt.dataset.deptid = o.deptId;
                    if (selectedProgramId && o.value === String(selectedProgramId)) opt.selected = true;
                    progSelect.appendChild(opt);
                });
            }

            deptSelect.addEventListener('change', () => refreshPrograms(null));
            const initialDept = deptSelect.value;
            const initialProg = progSelect.value;
            if (initialDept) refreshPrograms(initialProg);
        })();
    </script>
}