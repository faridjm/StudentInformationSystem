@model SIS.BLL.Services.DTOs.Course.UpdateCourseDto
@{
    ViewData["Title"] = L["EditCourse"].Value;
    var departments = ViewBag.Departments as List<SIS.BLL.Services.DTOs.Department.DepartmentDto> ?? new();
}
<div style="max-width:560px; margin:0 auto;">
    <div style="display:flex; align-items:center; gap:12px; margin-bottom:20px;">
        <a href="/Admin/Course" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left"></i></a>
        <h2 style="font-size:20px; font-weight:700;">@L["EditCourse"]</h2>
    </div>
    <form method="post" action="/Admin/Course/Edit">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="@Model.Id" />
        <div class="card">
            <div class="card-body">
                <div class="form-group">
                    <label class="form-label">@L["Name"] *</label>
                    <input name="Name" value="@Model.Name" class="form-control" required />
                </div>
                <div class="form-group">
                    <label class="form-label">@L["Department"]</label>
                    <select name="DepartmentId" class="form-control">
                        <option value="">@L["SelectDepartment"]</option>
                        @foreach (var d in departments)
                        {
                            <option value="@d.Id" selected="@(Model.DepartmentId == d.Id)">@d.Name</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">@L["Description"]</label>
                    <textarea name="Description" class="form-control" rows="3">@Model.Description</textarea>
                </div>
                <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:12px;">
                    <div class="form-group">
                        <label class="form-label">@L["Credit"]</label>
                        <input name="Credit" type="number" min="0" value="@Model.Credit" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">@L["TotalHours"]</label>
                        <input name="TotalHours" type="number" min="0" value="@Model.TotalHours" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">@L["Level"]</label>
                        <input name="Level" value="@Model.Level" class="form-control" placeholder="Beginner / Intermediate / Advanced" />
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">@L["Status"]</label>
                    <select name="IsActive" class="form-control">
                        @if (Model.IsActive)
                        {
                            <option value="true" selected="selected">@L["Active"]</option>
                            <option value="false">Deaktiv</option>
                        }
                        else
                        {
                            <option value="true">@L["Active"]</option>
                            <option value="false" selected="selected">Deaktiv</option>
                        }
                    </select>
                </div>
            </div>
        </div>
        <div style="display:flex; gap:12px; margin-top:16px;">
            <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> @L["Save"]</button>
            <a href="/Admin/Course" class="btn btn-secondary">@L["Cancel"]</a>
        </div>
    </form>
</div>
