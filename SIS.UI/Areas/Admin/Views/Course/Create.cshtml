@model SIS.BLL.Services.DTOs.Course.CreateCourseDto
@{
    ViewData["Title"] = L["NewCourse"].Value;
}
<div style="max-width:560px; margin:0 auto;">
    <div style="display:flex; align-items:center; gap:12px; margin-bottom:20px;">
        <a href="/Admin/Course" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left"></i></a>
        <h2 style="font-size:20px; font-weight:700;">@L["NewCourse"]</h2>
    </div>
    <form method="post" action="/Admin/Course/Create">
        @Html.AntiForgeryToken()
        <div class="card">
            <div class="card-body">
                <div class="form-group">
                    <label class="form-label">@L["Name"] *</label>
                    <input name="Name" class="form-control"  required />
                </div>
                <div class="form-group">
                    <label class="form-label">@L["Description"]</label>
                    <textarea name="Description" class="form-control" rows="3" ></textarea>
                </div>
            </div>
        </div>
        <div style="display:flex; gap:12px; margin-top:16px;">
            <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> @L["Save"]</button>
            <a href="/Admin/Course" class="btn btn-secondary">@L["Cancel"]</a>
        </div>
    </form>
</div>
