@model SIS.BLL.Services.DTOs.Course.CreateCourseDto
@{
    ViewData["Title"] = "Yeni Tədris Proqramı";
}
<div style="max-width:560px; margin:0 auto;">
    <div style="display:flex; align-items:center; gap:12px; margin-bottom:20px;">
        <a href="/Admin/Course" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left"></i></a>
        <h2 style="font-size:20px; font-weight:700;">Yeni Tədris Proqramı</h2>
    </div>
    <form method="post" action="/Admin/Course/Create">
        @Html.AntiForgeryToken()
        <div class="card">
            <div class="card-body">
                <div class="form-group">
                    <label class="form-label">Proqram adı *</label>
                    <input name="Name" class="form-control" placeholder="məs: Proqramlaşdırma, Data Analytics, AI/ML" required />
                </div>
                <div class="form-group">
                    <label class="form-label">Təsvir</label>
                    <textarea name="Description" class="form-control" rows="3" placeholder="Proqram haqqında qısa məlumat..."></textarea>
                </div>
            </div>
        </div>
        <div style="display:flex; gap:12px; margin-top:16px;">
            <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Yadda saxla</button>
            <a href="/Admin/Course" class="btn btn-secondary">Ləğv et</a>
        </div>
    </form>
</div>
