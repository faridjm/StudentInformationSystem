@model IEnumerable<SIS.BLL.Services.DTOs.Course.CourseDto>

@{
    ViewData["Title"] = L["Courses"].Value;
}

<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
    <h2 style="font-size:20px; font-weight:700;">@L["Courses"]</h2>
    <a href="/Admin/Course/Create" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> @L["NewCourse"]</a>
</div>

<div class="card">
    <table class="table">
        <thead>
            <tr>
                <th>@L["Name"]</th>
                <th>@L["Department"]</th>
                <th>@L["Credit"]</th>
                <th>@L["TotalHours"]</th>
                <th>@L["Level"]</th>
                <th>@L["Groups"]</th>
                <th>@L["Status"]</th>
                <th>@L["Actions"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td style="font-weight:500;">
                        @c.Name
                        @if (!string.IsNullOrEmpty(c.Description))
                        {
                            <div style="color:var(--text-muted); font-size:12px; font-weight:400;">@c.Description</div>
                        }
                    </td>
                    <td>@(string.IsNullOrEmpty(c.DepartmentName) ? L["NoDepartment"].Value : c.DepartmentName)</td>
                    <td>@c.Credit</td>
                    <td>@c.TotalHours</td>
                    <td>@(string.IsNullOrEmpty(c.Level) ? "—" : c.Level)</td>
                    <td>@c.GroupCount</td>
                    <td><span class="badge @(c.IsActive ? "badge-success" : "badge-danger")">@(c.IsActive ? L["Active"].Value : "Deaktiv")</span></td>
                    <td style="display:flex; gap:6px;">
                        <a href="/Admin/Course/Edit/@c.Id" class="btn btn-sm btn-secondary"><i class="fas fa-edit"></i></a>
                        <form method="post" action="/Admin/Course/Delete/@c.Id"
                              data-confirm="Kursu silmək istədiyinizdən əminsinizmi?"
                              data-confirm-title="Kursu silmək?"
                              data-confirm-text="Sil"
                              style="margin:0;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
