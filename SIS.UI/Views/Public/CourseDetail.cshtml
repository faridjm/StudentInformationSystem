@using SIS.UI.ViewModels
@using SIS.UI.Services
@model PublicCourseDetailViewModel
@{
    ViewData["Title"] = Model.Course.Name;
    var c = Model.Course;
    var learn = c.Curriculum.Take(8).ToList();
    var icon = PublicVisuals.CourseIcon(c.Name, c.DepartmentName);
    var grad = PublicVisuals.Grad(c.Id);

    // Total weight % (for assessment plan)
    decimal totalWeight = c.Assessments
        .Where(a => a.WeightPercent.HasValue)
        .Sum(a => a.WeightPercent!.Value);

    // Assessment bar colors
    var barColors = new[] { "#4F46E5", "#7C3AED", "#10B981", "#0EA5E9", "#F59E0B", "#EF4444", "#06B6D4", "#EC4899" };
}

@* ============ HERO ============ *@
<header class="pub-detail-hero">
    <div class="pub-container">
        <a href="/Public/Courses" class="pub-back">
            <i class="fas fa-arrow-left"></i> Bütün kurslar
        </a>

        <div class="pub-cd-hero">
            <div>
                @if (!string.IsNullOrEmpty(c.DepartmentName))
                {
                    <span class="pub-eyebrow"><i class="fas fa-building"></i> @c.DepartmentName</span>
                }
                <h1>@c.Name</h1>
                @if (!string.IsNullOrEmpty(c.Description))
                {
                    <p class="lead">@c.Description</p>
                }
                <div class="pub-pill-row">
                    @if (!string.IsNullOrEmpty(c.Level))    { <span class="pub-pill"><i class="fas fa-signal"></i> @c.Level</span> }
                    @if (c.TotalSessions > 0)               { <span class="pub-pill"><i class="fas fa-list-ol"></i> @c.TotalSessions dərs</span> }
                    @if (c.TotalHours > 0)                  { <span class="pub-pill"><i class="fas fa-clock"></i> @c.TotalHours saat</span> }
                    @if (c.Credit > 0)                      { <span class="pub-pill"><i class="fas fa-star"></i> @c.Credit kredit</span> }
                    @if (c.Groups.Any())                    { <span class="pub-pill"><i class="fas fa-users"></i> @c.Groups.Count açıq qrup</span> }
                </div>
                <div class="pub-hero-actions" style="margin-top:28px;">
                    <a href="/Public/Contact" class="pub-btn pub-btn-solid-light">
                        <i class="fas fa-paper-plane"></i> Əlaqə saxla
                    </a>
                    <a href="#groups" class="pub-btn pub-btn-light">
                        <i class="fas fa-users"></i> Qruplara bax
                    </a>
                </div>
            </div>

            <div class="pub-cd-hero-icon">
                <i class="fas @icon"></i>
            </div>
        </div>
    </div>
</header>

<style>
    .pub-cd-hero { display: grid; grid-template-columns: 1fr auto; gap: 36px; align-items: center; margin-top: 22px; }
    .pub-cd-hero-icon {
        width: 220px; height: 220px; border-radius: 32px;
        display: flex; align-items: center; justify-content: center;
        background: rgba(255,255,255,.10); border: 1px solid rgba(255,255,255,.18);
        box-shadow: 0 30px 60px rgba(2,6,23,.35);
    }
    .pub-cd-hero-icon i { font-size: 88px; color: #fff; filter: drop-shadow(0 8px 16px rgba(0,0,0,.3)); }
    @@media (max-width: 860px) {
        .pub-cd-hero { grid-template-columns: 1fr; gap: 24px; }
        .pub-cd-hero-icon { display: none; }
    }
</style>

<section class="pub-section" style="padding-top:56px;">
    <div class="pub-container pub-grid-2">
        @* =========== LEFT COLUMN =========== *@
        <div>
            @* WHAT YOU WILL LEARN *@
            <div class="pub-panel">
                <h3 class="accent"><i class="fas fa-lightbulb"></i> Nə öyrənəcəksən</h3>
                @if (learn.Any())
                {
                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
                        @foreach (var i in learn)
                        {
                            <div style="display:flex; gap:10px; align-items:flex-start; padding:10px 12px; background:#F8FAFC; border-radius:10px; font-size:14px;">
                                <i class="fas fa-check-circle" style="color:var(--pub-accent); margin-top:3px;"></i>
                                <span>@i.Topic</span>
                            </div>
                        }
                    </div>
                    @if (c.Curriculum.Count > learn.Count)
                    {
                        <div style="margin-top:16px; text-align:center;">
                            <a href="#curriculum" class="pub-btn pub-btn-ghost pub-btn-sm">
                                Tam kurikuluma bax <i class="fas fa-arrow-down"></i>
                            </a>
                        </div>
                    }
                }
                else
                {
                    <p class="pub-panel-lead">
                        @(string.IsNullOrEmpty(c.Description)
                            ? "Bu proqram üçün detal mövzular tezliklə əlavə olunacaq. Bizimlə əlaqə saxlayın və proqram haqqında ətraflı məlumat alın."
                            : c.Description)
                    </p>
                }
            </div>

            @* CURRICULUM OVERVIEW (timeline) *@
            @if (c.Curriculum.Any())
            {
                <div class="pub-panel" id="curriculum">
                    <h3><i class="fas fa-list-check"></i> Kurikulum baxışı (@c.Curriculum.Count dərs)</h3>
                    @if (!string.IsNullOrEmpty(c.CurriculumName))
                    {
                        <p class="pub-panel-lead">Şablon: @c.CurriculumName</p>
                    }
                    <div class="pub-curri">
                        @foreach (var i in c.Curriculum)
                        {
                            <div class="citem">
                                <div class="row1">
                                    <span class="sn">#@i.SessionNumber.ToString("00")</span>
                                    <span class="tt">@i.Topic</span>
                                    @if (i.HasAssessment)
                                    {
                                        <span class="pub-chip warn" style="margin-left:auto;">
                                            <i class="fas fa-clipboard-check"></i>
                                            @(string.IsNullOrEmpty(i.AssessmentTitle) ? "Qiymətləndirmə" : i.AssessmentTitle)
                                        </span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            @* ASSESSMENT PLAN *@
            @if (c.Assessments.Any())
            {
                <div class="pub-panel">
                    <h3 class="violet"><i class="fas fa-clipboard-list"></i> Qiymətləndirmə planı</h3>

                    @if (totalWeight > 0)
                    {
                        <div class="pub-assess-bar">
                            @{
                                int ix = 0;
                                var inv = System.Globalization.CultureInfo.InvariantCulture;
                            }
                            @foreach (var a in c.Assessments.Where(x => x.WeightPercent.HasValue))
                            {
                                var pct = (double)(a.WeightPercent!.Value);
                                var color = barColors[ix % barColors.Length];
                                var pctStr = pct.ToString(inv);
                                var style = $"background:{color}; flex:{pctStr} 0 0;";
                                var title = $"{a.Title} ({pct.ToString("0.#", inv)}%)";
                                <span title="@title" style="@style"></span>
                                ix++;
                            }
                        </div>
                        <div style="display:flex; justify-content:space-between; margin-top:8px; font-size:12px; color:var(--pub-muted);">
                            <span>Cəmi çəki: <strong style="color:var(--pub-ink);">@totalWeight.ToString("0.#")%</strong></span>
                            @if (totalWeight != 100)
                            {
                                <span style="color:var(--pub-warn);"><i class="fas fa-triangle-exclamation"></i> 100%-ə tamamlanmayıb</span>
                            }
                        </div>
                    }

                    <table class="pub-table" style="margin-top:18px;">
                        <thead>
                            <tr>
                                <th>Başlıq</th>
                                <th>Növ</th>
                                <th style="text-align:right;">Çəki</th>
                                <th style="text-align:right;">Maks bal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in c.Assessments)
                            {
                                <tr>
                                    <td><strong>@a.Title</strong></td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(a.Type))
                                        {
                                            <span class="pub-chip">@a.Type</span>
                                        }
                                        else { <span style="color:var(--pub-muted);">—</span> }
                                    </td>
                                    <td style="text-align:right;">
                                        @(a.WeightPercent.HasValue ? a.WeightPercent.Value.ToString("0.#") + "%" : "—")
                                    </td>
                                    <td style="text-align:right;">
                                        @(a.MaxScore.HasValue ? a.MaxScore.Value.ToString("0.#") : "—")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @* LEARNING ENVIRONMENT *@
            @if (Model.Facilities.Any())
            {
                <div class="pub-panel">
                    <h3 class="accent"><i class="fas fa-school"></i> Tədris mühiti</h3>
                    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px,1fr)); gap:14px;">
                        @foreach (var f in Model.Facilities)
                        {
                            <div style="padding:16px; border:1px solid var(--pub-border); border-radius:14px; background:#fff;">
                                <div class="pub-grad-@f.Grad"
                                     style="width:44px; height:44px; border-radius:12px; display:flex; align-items:center; justify-content:center; color:#fff; margin-bottom:12px; font-size:18px;">
                                    <i class="fas @f.Icon"></i>
                                </div>
                                <div style="font-weight:700; font-size:15px;">@f.Name</div>
                                <div style="font-size:12.5px; color:var(--pub-muted); margin-top:4px;">@f.Description</div>
                            </div>
                        }
                    </div>
                </div>
            }

            @* FAQ *@
            <div class="pub-panel">
                <h3><i class="fas fa-circle-question"></i> Tez-tez verilən suallar</h3>
                <div class="pub-faq">
                    <details open>
                        <summary><i class="fas fa-user-graduate"></i> Bu kurs kimlər üçündür?</summary>
                        <div class="ans">
                            Kurs həm yeni başlayanlar, həm də bacarıqlarını sistemləşdirmək istəyən
                            şəxslər üçün nəzərdə tutulub. Hər tələbə üçün başlanğıc səviyyəsi qiymətləndirilir
                            və mentor tərəfindən fərdi yol təklif olunur.
                        </div>
                    </details>
                    <details>
                        <summary><i class="fas fa-chalkboard-user"></i> Dərslər necə keçirilir?</summary>
                        <div class="ans">
                            Dərslər həm əyani auditoriyada, həm də online iştirakla aparılır.
                            Bütün dərs materialları, tapşırıqlar və qiymətlər tələbə panelində izlənir.
                        </div>
                    </details>
                    <details>
                        <summary><i class="fas fa-clipboard-check"></i> Qiymətləndirmə necə aparılır?</summary>
                        <div class="ans">
                            Hər kursda quiz, assignment və final layihə var. Cəmi nəticə GPA və transkript
                            kimi rəsmi formada sənədləşdirilir. Qiymətləndirmə planı yuxarıda göstərilib.
                        </div>
                    </details>
                    <details>
                        <summary><i class="fas fa-file-lines"></i> Transkript verilirmi?</summary>
                        <div class="ans">
                            Bəli — kursu uğurla tamamlayan tələbə Acadex tərəfindən imzalanmış rəsmi
                            transkript və portfolio sənədi alır.
                        </div>
                    </details>
                    <details>
                        <summary><i class="fas fa-diagram-project"></i> Final layihə varmı?</summary>
                        <div class="ans">
                            Hər kurs real istifadəyə uyğun final layihə ilə bitir. Layihə mentor tərəfindən
                            müşayiət olunur və portfolio kimi istifadə edilə bilər.
                        </div>
                    </details>
                </div>
            </div>
        </div>

        @* =========== RIGHT COLUMN =========== *@
        <div>
            @* APPLY / CONTACT CTA STICKY-LIKE *@
            <div class="pub-panel" style="text-align:center; background: linear-gradient(135deg, var(--pub-soft) 0%, var(--pub-soft-2) 100%); border-color:transparent;">
                <h3 style="justify-content:center;"><i class="fas fa-paper-plane"></i> Maraqlanırsan?</h3>
                <p style="color:var(--pub-muted); font-size:14px; margin-bottom:18px;">
                    Bu proqram haqqında ətraflı məlumat almaq üçün bizimlə əlaqə saxlayın —
                    sizə ən uyğun qrup və başlama tarixini təklif edək.
                </p>
                <a href="/Public/Contact" class="pub-btn pub-btn-primary pub-btn-block">
                    İndi əlaqə saxla <i class="fas fa-arrow-right"></i>
                </a>
            </div>

            @* GROUPS *@
            <div class="pub-panel" id="groups">
                <h3><i class="fas fa-users"></i> Açıq qruplar</h3>
                @if (!c.Groups.Any())
                {
                    <div style="text-align:center; padding:18px 0;">
                        <i class="fas fa-calendar-xmark" style="font-size:32px; color:var(--pub-muted); opacity:.4;"></i>
                        <p style="color:var(--pub-muted); font-size:14px; margin-top:10px;">
                            Hazırda açıq qrup yoxdur.<br />
                            Müraciət edin — yeni qrup açılanda sizinlə əlaqə saxlayaq.
                        </p>
                        <a href="/Public/Contact" class="pub-btn pub-btn-ghost pub-btn-sm" style="margin-top:14px;">
                            <i class="fas fa-bell"></i> Xəbər ver
                        </a>
                    </div>
                }
                else
                {
                    foreach (var g in c.Groups)
                    {
                        <div class="pub-group-card">
                            <div class="g-head">
                                <div>
                                    <div style="font-weight:700; font-size:15px;">@g.Name</div>
                                    <div style="font-size:13px; color:var(--pub-muted); margin-top:2px;">
                                        <i class="fas fa-chalkboard-teacher" style="color:var(--pub-primary);"></i> @g.TeacherName
                                    </div>
                                </div>
                                @if (!string.IsNullOrEmpty(g.SeasonName))
                                {
                                    <span class="pub-chip">@g.SeasonName</span>
                                }
                            </div>
                            <div class="pub-group-meta">
                                <span><i class="fas fa-calendar-day"></i>
                                    @g.StartDate.ToString("dd.MM.yyyy") – @g.EndDate.ToString("dd.MM.yyyy")</span>
                                @if (!string.IsNullOrEmpty(g.ScheduleSummary))
                                {
                                    <span><i class="fas fa-clock"></i> @g.ScheduleSummary</span>
                                }
                                @if (g.AvailableSeats > 0)
                                {
                                    <span><i class="fas fa-chair"></i> @g.AvailableSeats boş yer</span>
                                }
                            </div>
                            <a href="/Public/Contact" class="pub-btn pub-btn-primary pub-btn-block" style="margin-top:14px;">
                                Əlaqə saxla
                            </a>
                        </div>
                    }
                }
            </div>

            @* TEACHERS *@
            @if (c.Teachers.Any())
            {
                <div class="pub-panel">
                    <h3 class="violet"><i class="fas fa-user-tie"></i> Müəllimlər</h3>
                    <ul class="pub-list">
                        @foreach (var t in c.Teachers)
                        {
                            <li>
                                <i class="fas fa-user-graduate"></i>
                                <span style="font-weight:600; color:var(--pub-ink-2);">@t</span>
                            </li>
                        }
                    </ul>
                </div>
            }

            @* QUICK INFO *@
            <div class="pub-panel">
                <h3><i class="fas fa-circle-info"></i> Qısa məlumat</h3>
                <ul class="pub-list">
                    @if (!string.IsNullOrEmpty(c.DepartmentName))
                    {
                        <li><i class="fas fa-building"></i> <span><strong>Şöbə:</strong> @c.DepartmentName</span></li>
                    }
                    @if (!string.IsNullOrEmpty(c.Level))
                    {
                        <li><i class="fas fa-signal"></i> <span><strong>Səviyyə:</strong> @c.Level</span></li>
                    }
                    @if (c.TotalSessions > 0)
                    {
                        <li><i class="fas fa-list-ol"></i> <span><strong>Dərs sayı:</strong> @c.TotalSessions</span></li>
                    }
                    @if (c.TotalHours > 0)
                    {
                        <li><i class="fas fa-clock"></i> <span><strong>Cəmi saat:</strong> @c.TotalHours</span></li>
                    }
                    @if (c.Credit > 0)
                    {
                        <li><i class="fas fa-star"></i> <span><strong>Kredit:</strong> @c.Credit</span></li>
                    }
                    <li><i class="fas fa-wifi"></i> <span><strong>Format:</strong> Online · Əyani · Hibrid</span></li>
                </ul>
            </div>
        </div>
    </div>
</section>

@* ============ CTA ============ *@
<section class="pub-section alt">
    <div class="pub-container">
        <div class="pub-cta">
            <h2>@c.Name haqqında daha çox məlumat almaq istəyirsən?</h2>
            <p>
                Komandamız səninlə əlaqə saxlasın, kurikulum, qrup və ödəniş şərtləri haqqında
                bütün suallarına cavab versin.
            </p>
            <div class="pub-hero-actions">
                <a href="/Public/Contact" class="pub-btn pub-btn-solid-light">
                    <i class="fas fa-paper-plane"></i> Bizimlə əlaqə saxla
                </a>
                <a href="/Public/Courses" class="pub-btn pub-btn-light">
                    <i class="fas fa-layer-group"></i> Digər kursları gör
                </a>
            </div>
        </div>
    </div>
</section>
