@using SIS.UI.ViewModels
@model PublicAboutViewModel
@{
    ViewData["Title"] = "Akademiya";
}

<header class="pub-detail-hero">
    <div class="pub-container">
        <h1>Acadex Akademiyası</h1>
        <p style="opacity:.9; margin-top:8px;">Praktik bacarıqlar, real layihələr və ölçülə bilən nəticələr</p>
    </div>
</header>

<!-- STORY -->
<section class="pub-section">
    <div class="pub-container" style="max-width:820px;">
        <div class="pub-section-head" style="margin-bottom:24px;">
            <h2>Hekayəmiz</h2>
        </div>
        <div class="pub-panel">
            <p style="color:var(--pub-muted); font-size:16px; line-height:1.8;">@Model.Story</p>
        </div>
    </div>
</section>

<!-- MISSION + VISION -->
<section class="pub-section alt">
    <div class="pub-container" style="max-width:980px;">
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:22px;">
            <div class="pub-panel" style="margin:0;">
                <h3><i class="fas fa-bullseye"></i> Missiyamız</h3>
                <p style="color:var(--pub-muted); font-size:15px;">@Model.Mission</p>
            </div>
            <div class="pub-panel" style="margin:0;">
                <h3><i class="fas fa-eye"></i> Vizyonumuz</h3>
                <p style="color:var(--pub-muted); font-size:15px;">@Model.Vision</p>
            </div>
        </div>
    </div>
</section>

<!-- FACILITIES -->
<section class="pub-section">
    <div class="pub-container">
        <div class="pub-section-head">
            <h2>Akademiya şəraiti</h2>
            <p>Otaqlar və öyrənmə mühiti</p>
        </div>
        <div class="pub-grid">
            @foreach (var f in Model.Facilities)
            {
                <div class="pub-facility">
                    <div class="pub-imgph pub-grad-@f.Grad">
                        <i class="fas @f.Icon"></i>
                        <span class="tag">@f.Type</span>
                    </div>
                    <div class="body">
                        <h3>@f.Name</h3>
                        <div class="meta"><i class="fas fa-users"></i> @f.Capacity nəfər</div>
                        <p>@f.Description</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- METHODOLOGY -->
@if (Model.Methodology.Any())
{
    <section class="pub-section alt">
        <div class="pub-container" style="max-width:820px;">
            <div class="pub-section-head">
                <h2>Tədris metodologiyası</h2>
                <p>Hər kursumuzda tətbiq etdiyimiz prinsiplər</p>
            </div>
            <div class="pub-panel">
                <ul class="pub-list">
                    @foreach (var m in Model.Methodology)
                    {
                        <li><i class="fas fa-check-circle"></i> @m</li>
                    }
                </ul>
            </div>
        </div>
    </section>
}

<!-- TIMELINE -->
@if (Model.Timeline.Any())
{
    <section class="pub-section">
        <div class="pub-container">
            <div class="pub-section-head">
                <h2>Acadex tarixçəsi</h2>
                <p>İllər ərzində qət etdiyimiz yol</p>
            </div>
            <div class="pub-timeline">
                @foreach (var t in Model.Timeline)
                {
                    <div class="pub-tl-item">
                        <div class="pub-tl-year">@t.Year</div>
                        <div class="pub-tl-body">@t.Text</div>
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- CTA -->
<section class="pub-section alt">
    <div class="pub-container">
        <div class="pub-cta">
            <h2>Növbəti karyera addımını birlikdə atırıq</h2>
            <p>Acadex proqramları ilə tanış ol və sənə uyğun qrupa müraciət et.</p>
            <div class="pub-hero-actions">
                <a href="/Public/Courses" class="pub-btn pub-btn-light"><i class="fas fa-layer-group"></i> Kurslara bax</a>
                <a href="/Public/Contact" class="pub-btn pub-btn-ghost" style="background:#fff;">
                    <i class="fas fa-paper-plane"></i> Bizimlə əlaqə saxla
                </a>
            </div>
        </div>
    </div>
</section>
