@using SIS.UI.ViewModels
@model List<PublicGraduateViewModel>
@{
    ViewData["Title"] = "Məzunlar";
}

<header class="pub-detail-hero">
    <div class="pub-container">
        <span class="pub-eyebrow"><span class="dot"></span> Uğur hekayələri</span>
        <h1>Acadex məzunları</h1>
        <p class="lead">
            Acadex-də başlayan və real iş bazarına keçid edən tələbələrimizin karyera hekayələri.
            Hər biri praktiki layihələrlə öz portfolio-sunu qurmuş və yeni mərhələyə qədəm qoymuşdur.
        </p>
    </div>
</header>

<section class="pub-section" style="padding-top:48px;">
    <div class="pub-container">

        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:34px; flex-wrap:wrap; gap:12px;">
            <div style="color:var(--pub-muted); font-size:14px;">
                <strong style="color:var(--pub-ink); font-size:20px; letter-spacing:-.4px;">@Model.Count</strong> uğur hekayəsi
            </div>
            <a href="/Public/Courses" class="pub-btn pub-btn-ghost pub-btn-sm">
                <i class="fas fa-layer-group"></i> Kurslara bax
            </a>
        </div>

        @if (!Model.Any())
        {
            <div class="pub-empty">
                <i class="fas fa-user-graduate"></i>
                <p>Məzun hekayələri tezliklə əlavə olunacaq.</p>
            </div>
        }
        else
        {
            <div class="pub-graduates">
                @foreach (var g in Model)
                {
                    <div class="pub-grad-card">
                        <span class="quote-mark">"</span>
                        <div class="pub-grad-avatar pub-grad-@g.Grad">@g.Initials</div>
                        <h3>@g.FullName</h3>
                        <div class="role">@g.Position</div>
                        <div class="course">@g.Course · @g.Year</div>
                        <div class="story">"@g.Story"</div>
                    </div>
                }
            </div>
        }
    </div>
</section>

@* ============ STATS ============ *@
<section class="pub-section alt">
    <div class="pub-container">
        <div class="pub-section-head">
            <span class="kicker">Nəticə</span>
            <h2>Acadex məzunlarının yolu</h2>
            <p>Praktiki layihələrlə qurulan portfolio və real iş bazarına keçid</p>
        </div>
        <div class="pub-stats">
            <div class="pub-stat">
                <div class="ico"><i class="fas fa-diagram-project"></i></div>
                <div class="num">100%</div>
                <div class="lbl">Layihə əsaslı bitirmə</div>
            </div>
            <div class="pub-stat">
                <div class="ico"><i class="fas fa-file-lines"></i></div>
                <div class="num">Rəsmi</div>
                <div class="lbl">Transkript və portfolio</div>
            </div>
            <div class="pub-stat">
                <div class="ico"><i class="fas fa-user-tie"></i></div>
                <div class="num">Mentor</div>
                <div class="lbl">Karyera yönləndirmə</div>
            </div>
            <div class="pub-stat">
                <div class="ico"><i class="fas fa-handshake"></i></div>
                <div class="num">Real</div>
                <div class="lbl">İş bazarına hazırlıq</div>
            </div>
        </div>
    </div>
</section>

@* ============ CTA ============ *@
<section class="pub-section">
    <div class="pub-container">
        <div class="pub-cta">
            <h2>Növbəti uğur hekayəsi sənin ola bilər</h2>
            <p>Acadex proqramları ilə tanış ol və karyera yolunu bu gün başlat.</p>
            <div class="pub-hero-actions">
                <a href="/Public/Courses" class="pub-btn pub-btn-solid-light">
                    <i class="fas fa-layer-group"></i> Kurslara bax
                </a>
                <a href="/Public/Contact" class="pub-btn pub-btn-light">
                    <i class="fas fa-paper-plane"></i> Bizimlə əlaqə saxla
                </a>
            </div>
        </div>
    </div>
</section>
