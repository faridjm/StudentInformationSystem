@using SIS.UI.ViewModels
@model PublicCoursesViewModel
@{
    ViewData["Title"] = "Kurslar";
    var hasFilter = !string.IsNullOrEmpty(Model.Q)
                 || !string.IsNullOrEmpty(Model.SelectedDepartment)
                 || !string.IsNullOrEmpty(Model.SelectedLevel);
}

<header class="pub-detail-hero">
    <div class="pub-container">
        <span class="pub-eyebrow"><span class="dot"></span> Proqram kataloqu</span>
        <h1>Kurslar və proqramlar</h1>
        <p class="lead">
            Acadex-in bütün aktiv təhsil proqramları — proqramlaşdırma, data, dizayn və daha çoxu.
            Sənə uyğun istiqaməti tap, kurikulumla tanış ol və açıq qrupa müraciət et.
        </p>
    </div>
</header>

<section class="pub-section" style="padding-top:48px;">
    <div class="pub-container">

        @* ===== FILTER BAR ===== *@
        <form method="get" action="/Public/Courses"
              style="background:#fff; border:1px solid var(--pub-border); border-radius:var(--pub-radius); padding:18px; box-shadow:var(--pub-shadow-sm); display:grid; grid-template-columns:2fr 1fr 1fr auto; gap:12px; margin-bottom:28px;">
            <div style="position:relative;">
                <i class="fas fa-magnifying-glass" style="position:absolute; left:14px; top:50%; transform:translateY(-50%); color:var(--pub-muted);"></i>
                <input type="text" name="q" value="@Model.Q"
                       placeholder="Kurs axtar..."
                       class="pub-input"
                       style="padding-left:40px;" />
            </div>
            <select name="department" class="pub-input">
                <option value="">Bütün şöbələr</option>
                @foreach (var d in Model.Departments)
                {
                    <option value="@d" selected="@(d == Model.SelectedDepartment)">@d</option>
                }
            </select>
            <select name="level" class="pub-input">
                <option value="">Bütün səviyyələr</option>
                @foreach (var lv in Model.Levels)
                {
                    <option value="@lv" selected="@(lv == Model.SelectedLevel)">@lv</option>
                }
            </select>
            <button type="submit" class="pub-btn pub-btn-primary">
                <i class="fas fa-filter"></i> Axtar
            </button>
        </form>

        @* ===== RESULT META ===== *@
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:22px; flex-wrap:wrap; gap:12px;">
            <div style="color:var(--pub-muted); font-size:14px;">
                <strong style="color:var(--pub-ink); font-size:20px; letter-spacing:-.4px;">@Model.Courses.Count</strong>
                proqram tapıldı
                @if (hasFilter) { <span style="color:var(--pub-muted);"> · filtrlənmiş nəticə</span> }
            </div>
            @if (hasFilter)
            {
                <a href="/Public/Courses" class="pub-btn pub-btn-ghost pub-btn-sm">
                    <i class="fas fa-xmark"></i> Filtri sıfırla
                </a>
            }
        </div>

        @if (!Model.Courses.Any())
        {
            <div class="pub-empty">
                <i class="fas fa-folder-open"></i>
                <p>Axtarışınıza uyğun aktiv kurs tapılmadı. Filtrləri sıfırlayın və ya bizimlə əlaqə saxlayın.</p>
                <div style="margin-top:20px;">
                    <a href="/Public/Contact" class="pub-btn pub-btn-primary"><i class="fas fa-paper-plane"></i> Bizimlə əlaqə saxla</a>
                </div>
            </div>
        }
        else
        {
            <div class="pub-grid">
                @foreach (var c in Model.Courses)
                {
                    <partial name="_CourseCard" model="c" />
                }
            </div>
        }
    </div>
</section>

@* ============ CTA ============ *@
<section class="pub-section alt">
    <div class="pub-container">
        <div class="pub-cta">
            <h2>Sizə uyğun kursu tapa bilmədiniz?</h2>
            <p>Bizimlə əlaqə saxlayın — sizə ən uyğun proqramı seçməyə kömək edək.</p>
            <div class="pub-hero-actions">
                <a href="/Public/Contact" class="pub-btn pub-btn-solid-light">
                    <i class="fas fa-paper-plane"></i> Bizimlə əlaqə saxla
                </a>
            </div>
        </div>
    </div>
</section>
