@using SIS.UI.ViewModels
@using SIS.UI.Services
@model PublicHomeViewModel
@{
    ViewData["Title"] = "Ana səhifə";
    string stat(int n) => n > 0 ? n.ToString() : "—";
}

@* ============ HERO ============ *@
<header class="pub-hero">
    <div class="pub-container pub-hero-inner">
        <div>
            <span class="pub-eyebrow">
                <span class="dot"></span> Yeni semestr — qeydiyyat açıqdır
            </span>
            <h1>Karyeranı <span class="hl">Acadex 360</span> ilə növbəti səviyyəyə qaldır</h1>
            <div style="display:inline-flex; align-items:center; gap:8px; margin-top:8px; color:var(--pub-muted); font-size:14px; font-weight:600;">
                <i class="fas fa-globe"></i> Digital Academy Management Platform · Rəqəmsal Akademiya Platforması
            </div>
            <p>
                Real layihələr, peşəkar müəllimlər və strukturlaşdırılmış kurikulum ilə
                praktiki təhsil təcrübəsi. Acadex 360 sənə nəzəriyyəni deyil — bacarıq qazandırır.
            </p>
            <div class="pub-hero-actions">
                <a href="/Public/Courses" class="pub-btn pub-btn-solid-light">
                    <i class="fas fa-layer-group"></i> Kurslara bax
                </a>
                <a href="/Public/About" class="pub-btn pub-btn-light">
                    <i class="fas fa-building-columns"></i> Akademiya ilə tanış ol
                </a>
            </div>
            <div class="pub-hero-trust">
                <div class="tcell"><i class="fas fa-check-circle"></i> Strukturlaşdırılmış kurikulum</div>
                <div class="tcell"><i class="fas fa-check-circle"></i> Real qiymətləndirmə və transkript</div>
                <div class="tcell"><i class="fas fa-check-circle"></i> Online + Əyani format</div>
            </div>
        </div>

        <div class="pub-hero-figure" aria-hidden="true">
            <span class="blob b1"></span>
            <span class="blob b2"></span>
            <div class="stage"><div class="big-icon"><i class="fas fa-laptop-code"></i></div></div>
            <div class="pub-float f1"><i class="fas fa-code"></i> Coding Lab</div>
            <div class="pub-float f2"><i class="fas fa-chart-line"></i> Real layihə</div>
            <div class="pub-float f3"><i class="fas fa-graduation-cap"></i> Transkript</div>
            <div class="pub-float f4"><i class="fas fa-bolt"></i> Mentor dəstəyi</div>
        </div>
    </div>
</header>

@* ============ STATS ============ *@
<section class="pub-section" style="padding-top:64px;">
    <div class="pub-container">
        <div class="pub-stats">
            <div class="pub-stat">
                <div class="ico"><i class="fas fa-layer-group"></i></div>
                <div class="num @(Model.Stats.CourseCount > 0 ? "" : "muted")">@stat(Model.Stats.CourseCount)</div>
                <div class="lbl">Aktiv proqram</div>
            </div>
            <div class="pub-stat">
                <div class="ico"><i class="fas fa-users"></i></div>
                <div class="num @(Model.Stats.GroupCount > 0 ? "" : "muted")">@stat(Model.Stats.GroupCount)</div>
                <div class="lbl">Aktiv qrup</div>
            </div>
            <div class="pub-stat">
                <div class="ico"><i class="fas fa-chalkboard-teacher"></i></div>
                <div class="num @(Model.Stats.TeacherCount > 0 ? "" : "muted")">@stat(Model.Stats.TeacherCount)</div>
                <div class="lbl">Peşəkar müəllim</div>
            </div>
            <div class="pub-stat">
                <div class="ico"><i class="fas fa-building"></i></div>
                <div class="num @(Model.Stats.DepartmentCount > 0 ? "" : "muted")">@stat(Model.Stats.DepartmentCount)</div>
                <div class="lbl">Şöbə / istiqamət</div>
            </div>
        </div>
    </div>
</section>

@* ============ POPULAR COURSES ============ *@
<section class="pub-section alt">
    <div class="pub-container">
        <div class="pub-section-head">
            <span class="kicker">Proqramlarımız</span>
            <h2>Populyar kurslar</h2>
            <p>Ən çox müraciət olunan və aktiv qrupları olan tədris proqramları</p>
        </div>
        @if (!Model.PopularCourses.Any())
        {
            <div class="pub-empty">
                <i class="fas fa-book-open"></i>
                <p>Hazırda aktiv kurs yoxdur. Yeni proqramlar tezliklə əlavə olunacaq.</p>
            </div>
        }
        else
        {
            <div class="pub-grid">
                @foreach (var c in Model.PopularCourses) { <partial name="_CourseCard" model="c" /> }
            </div>
            <div class="pub-mt">
                <a href="/Public/Courses" class="pub-btn pub-btn-ghost">
                    Bütün kurslara bax <i class="fas fa-arrow-right"></i>
                </a>
            </div>
        }
    </div>
</section>

@* ============ WHY ACADEX ============ *@
<section class="pub-section">
    <div class="pub-container">
        <div class="pub-section-head">
            <span class="kicker">Niyə Acadex 360</span>
            <h2>Öyrənməni ölçülə bilən nəticəyə çeviririk</h2>
            <p>Acadex 360 sadəcə dərs platforması deyil — strukturlu öyrənmə, qiymətləndirmə və portfolio sistemi.</p>
        </div>
        <div class="pub-features">
            <div class="pub-feature">
                <div class="ico"><i class="fas fa-diagram-project"></i></div>
                <h3>Praktiki layihə əsaslı təhsil</h3>
                <p>Hər modul real layihə tapşırıqları ilə möhkəmlənir. Nəzəriyyə minimuma, praktika maksimuma.</p>
            </div>
            <div class="pub-feature v3">
                <div class="ico"><i class="fas fa-user-tie"></i></div>
                <h3>Peşəkar mentorlar</h3>
                <p>Şirkətlərdə aktiv işləyən, sahə təcrübəsi olan praktik müəllim heyəti.</p>
            </div>
            <div class="pub-feature">
                <div class="ico"><i class="fas fa-list-check"></i></div>
                <h3>Strukturlaşdırılmış kurikulum</h3>
                <p>Hər dərs üçün planlanmış mövzu, materiallar, tapşırıq və qiymətləndirmə.</p>
            </div>
            <div class="pub-feature v2">
                <div class="ico"><i class="fas fa-square-poll-vertical"></i></div>
                <h3>Real qiymətləndirmə və GPA</h3>
                <p>Quiz, assignment və final layihə əsaslı şəffaf GPA və nəticə izləməsi.</p>
            </div>
            <div class="pub-feature">
                <div class="ico"><i class="fas fa-folder-open"></i></div>
                <h3>Quiz və tapşırıq sistemi</h3>
                <p>Online quiz, assignment yükləmə və avtomatik nəticə hesablaması.</p>
            </div>
            <div class="pub-feature v3">
                <div class="ico"><i class="fas fa-file-lines"></i></div>
                <h3>Transkript və portfolio</h3>
                <p>Rəsmi transkript, davamiyyət hesabatı və real layihə portfolio.</p>
            </div>
            <div class="pub-feature v2">
                <div class="ico"><i class="fas fa-wifi"></i></div>
                <h3>Online və əyani format</h3>
                <p>Online dərs, hibrid iştirak və yazılı sessiyaların təkrar izlənməsi.</p>
            </div>
            <div class="pub-feature">
                <div class="ico"><i class="fas fa-shield-halved"></i></div>
                <h3>Şəffaf və izlənə bilən proses</h3>
                <p>Tələbə, müəllim və idarəetmə üçün tam ayrı, izlənə bilən paneller.</p>
            </div>
        </div>
    </div>
</section>

@* ============ LEARNING JOURNEY ============ *@
<section class="pub-section alt">
    <div class="pub-container">
        <div class="pub-section-head">
            <span class="kicker">Necə işləyir</span>
            <h2>Tələbə yolu — addım-addım</h2>
            <p>Qeydiyyatdan transkriptə qədər bütün proses planlaşdırılıb və izlənir.</p>
        </div>
        <div class="pub-journey">
            <div class="step">
                <span class="stepi"><i class="fas fa-magnifying-glass"></i></span>
                <h4>Kursu seç</h4>
                <p>Sənə uyğun istiqaməti tap.</p>
            </div>
            <div class="step">
                <span class="stepi"><i class="fas fa-user-plus"></i></span>
                <h4>Qrupa qoşul</h4>
                <p>Açıq qrupa müraciət et və başla.</p>
            </div>
            <div class="step">
                <span class="stepi"><i class="fas fa-chalkboard-user"></i></span>
                <h4>Dərslərdə iştirak et</h4>
                <p>Əyani və ya online iştirak et.</p>
            </div>
            <div class="step">
                <span class="stepi"><i class="fas fa-clipboard-check"></i></span>
                <h4>Quiz və tapşırıqlar</h4>
                <p>Bilikləri praktikada möhkəmləndir.</p>
            </div>
            <div class="step">
                <span class="stepi"><i class="fas fa-diagram-project"></i></span>
                <h4>Final layihə</h4>
                <p>Real layihə təqdim et və mentordan rəy al.</p>
            </div>
            <div class="step">
                <span class="stepi"><i class="fas fa-award"></i></span>
                <h4>Transkript</h4>
                <p>Rəsmi nəticəni və portfolio-nu əldə et.</p>
            </div>
        </div>
    </div>
</section>

@* ============ FACILITIES PREVIEW ============ *@
<section class="pub-section">
    <div class="pub-container">
        <div class="pub-section-head">
            <span class="kicker">Akademiya mühiti</span>
            <h2>Müasir öyrənmə şəraiti</h2>
            <p>Otaqlar, laboratoriyalar və online tədris infrastrukturu</p>
        </div>
        <div class="pub-grid">
            @foreach (var f in Model.Facilities.Take(4))
            {
                <div class="pub-facility">
                    <div class="pub-imgph pub-grad-@f.Grad">
                        <i class="fas @f.Icon"></i>
                        <span class="tag">@f.Type</span>
                    </div>
                    <div class="body">
                        <h3>@f.Name</h3>
                        <div class="meta"><i class="fas fa-users"></i> @f.Capacity nəfər tutum</div>
                        <p>@f.Description</p>
                    </div>
                </div>
            }
        </div>
        <div class="pub-mt">
            <a href="/Public/About#facilities" class="pub-btn pub-btn-ghost">
                Bütün şəraiti gör <i class="fas fa-arrow-right"></i>
            </a>
        </div>
    </div>
</section>

@* ============ TEACHERS PREVIEW ============ *@
<section class="pub-section alt">
    <div class="pub-container">
        <div class="pub-section-head">
            <span class="kicker">Müəllim heyəti</span>
            <h2>Sahə təcrübəsi olan peşəkarlar</h2>
            <p>Bilik və real iş təcrübəsini birləşdirən mentor heyəti</p>
        </div>
        @if (!Model.Teachers.Any())
        {
            <div class="pub-empty">
                <i class="fas fa-chalkboard-teacher"></i>
                <p>Müəllim məlumatları tezliklə əlavə olunacaq.</p>
            </div>
        }
        else
        {
            <div class="pub-grid-4">
                @foreach (var t in Model.Teachers.Take(4))
                {
                    var initial = string.IsNullOrEmpty(t.FullName) ? "?" : t.FullName.Substring(0, 1).ToUpper();
                    <div class="pub-teacher-card">
                        <div class="pub-teacher-avatar pub-grad-@(PublicVisuals.Grad(t.Id))">@initial</div>
                        <h3>@t.FullName</h3>
                        <div class="title">@(string.IsNullOrEmpty(t.Title) ? "Mentor müəllim" : t.Title)</div>
                        <div class="chips">
                            <span class="pub-chip"><i class="fas fa-layer-group"></i> @t.GroupCount qrup</span>
                        </div>
                    </div>
                }
            </div>
            <div class="pub-mt">
                <a href="/Public/Teachers" class="pub-btn pub-btn-ghost">
                    Bütün müəllimlər <i class="fas fa-arrow-right"></i>
                </a>
            </div>
        }
    </div>
</section>

@* ============ GRADUATES PREVIEW ============ *@
<section class="pub-section">
    <div class="pub-container">
        <div class="pub-section-head">
            <span class="kicker">Uğur hekayələri</span>
            <h2>Acadex 360 məzunları</h2>
            <p>Karyeralarına Acadex 360-da başlayan və real layihələrə qədəm qoyan məzunlar</p>
        </div>
        <div class="pub-graduates">
            @foreach (var g in Model.Graduates)
            {
                <div class="pub-grad-card">
                    <span class="quote-mark">"</span>
                    <div class="pub-grad-avatar pub-grad-@g.Grad">@g.Initials</div>
                    <h3>@g.FullName</h3>
                    <div class="role">@g.Position</div>
                    <div class="course">@g.Course · @g.Year</div>
                    <div class="story">"@g.Story"</div>
                </div>
            }
        </div>
        <div class="pub-mt">
            <a href="/Public/Graduates" class="pub-btn pub-btn-ghost">
                Bütün məzun hekayələri <i class="fas fa-arrow-right"></i>
            </a>
        </div>
    </div>
</section>

@* ============ CTA ============ *@
<section class="pub-section alt">
    <div class="pub-container">
        <div class="pub-cta">
            <h2>Yeni karyera yoluna bu gün başla</h2>
            <p>Proqramları araşdır, sənə uyğun qrupu seç və komandamızla əlaqə saxla — yolun başında səninləyik.</p>
            <div class="pub-hero-actions">
                <a href="/Public/Courses" class="pub-btn pub-btn-solid-light">
                    <i class="fas fa-layer-group"></i> Kurslara bax
                </a>
                <a href="/Public/Contact" class="pub-btn pub-btn-light">
                    <i class="fas fa-paper-plane"></i> Bizimlə əlaqə saxla
                </a>
            </div>
        </div>
    </div>
</section>
