@{
    ViewData["Title"] = "Əlaqə";
}

<header class="pub-detail-hero">
    <div class="pub-container">
        <span class="pub-eyebrow"><span class="dot"></span> Bizimlə əlaqə</span>
        <h1>Suallarınız üçün bizimlə əlaqə saxlayın</h1>
        <p class="lead">
            Komandamız mümkün qədər tez sizinlə əlaqə saxlayacaq və sizə uyğun proqramı,
            qrupu və başlama tarixini birlikdə müəyyənləşdirəcək.
        </p>
    </div>
</header>

<section class="pub-section" style="padding-top:48px;">
    <div class="pub-container pub-contact-grid">

        @* ===== LEFT: form ===== *@
        <div>
            <div class="pub-panel">
                <h3><i class="fas fa-paper-plane"></i> Bizə yazın</h3>
                <p class="pub-panel-lead">
                    Aşağıdakı formu doldurun və qısa müddətdə sizinlə əlaqə saxlayaq.
                    Bütün məlumatlar konfidensial saxlanılır.
                </p>

                @if (TempData["PubSuccess"] != null)
                {
                    <div class="pub-alert success">
                        <i class="fas fa-circle-check"></i>
                        <span>@TempData["PubSuccess"]</span>
                    </div>
                }

                <form method="post" action="/Public/Contact">
                    @Html.AntiForgeryToken()
                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
                        <div class="pub-field">
                            <label>Ad Soyad *</label>
                            <input name="fullName" class="pub-input" required placeholder="Adınızı və soyadınızı yazın" />
                        </div>
                        <div class="pub-field">
                            <label>Telefon</label>
                            <input name="phone" class="pub-input" placeholder="+994 50 000 00 00" />
                        </div>
                    </div>
                    <div class="pub-field">
                        <label>Email *</label>
                        <input name="email" type="email" class="pub-input" required placeholder="email@example.com" />
                    </div>
                    <div class="pub-field">
                        <label>Mesaj</label>
                        <textarea name="message" rows="5" class="pub-textarea"
                                  placeholder="Sizə necə kömək edə bilərik? Hansı proqramla maraqlanırsınız?"></textarea>
                    </div>
                    <button type="submit" class="pub-btn pub-btn-primary pub-btn-block">
                        <i class="fas fa-paper-plane"></i> Müraciəti göndər
                    </button>
                </form>
            </div>
        </div>

        @* ===== RIGHT: info + login ===== *@
        <div>
            <div class="pub-panel">
                <h3><i class="fas fa-circle-info"></i> Əlaqə məlumatları</h3>

                <div class="pub-info-row">
                    <div class="ico"><i class="fas fa-phone"></i></div>
                    <div>
                        <div class="lbl">Telefon</div>
                        <div class="val">+994 12 000 00 00</div>
                    </div>
                </div>
                <div class="pub-info-row">
                    <div class="ico"><i class="fas fa-envelope"></i></div>
                    <div>
                        <div class="lbl">Email</div>
                        <div class="val">info@acadex.az</div>
                    </div>
                </div>
                <div class="pub-info-row">
                    <div class="ico"><i class="fas fa-location-dot"></i></div>
                    <div>
                        <div class="lbl">Ünvan</div>
                        <div class="val">Bakı, Azərbaycan</div>
                    </div>
                </div>
                <div class="pub-info-row">
                    <div class="ico"><i class="fas fa-clock"></i></div>
                    <div>
                        <div class="lbl">İş saatları</div>
                        <div class="val">B.e – Cümə · 09:00 – 19:00</div>
                    </div>
                </div>
            </div>

            <div class="pub-map-placeholder">
                <div class="pin">
                    <i class="fas fa-location-dot"></i>
                    <div>Acadex Akademiyası</div>
                    <div style="font-size:13px; font-weight:500; color:var(--pub-muted); margin-top:4px;">Bakı, Azərbaycan</div>
                </div>
            </div>

            <div class="pub-panel" style="text-align:center; margin-top:24px;
                        background: linear-gradient(135deg, var(--pub-soft) 0%, var(--pub-soft-2) 100%);
                        border-color: transparent;">
                <h3 style="justify-content:center;"><i class="fas fa-right-to-bracket"></i> Artıq tələbəsən?</h3>
                <p style="color:var(--pub-muted); font-size:14px; margin-bottom:16px;">
                    Hesabınla sistemə daxil ol və panelinə keç.
                </p>
                <a href="/Auth/Login" class="pub-btn pub-btn-primary pub-btn-block">
                    Sistemə daxil ol <i class="fas fa-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
</section>
