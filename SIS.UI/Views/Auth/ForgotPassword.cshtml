@{
    ViewData["Title"] = L["ForgotPasswordTitle"].Value;
    Layout = null;
    bool sent = ViewBag.Sent == true;
}
<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Acadex 360 — @L["ForgotPasswordTitle"]</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        * { margin:0; padding:0; box-sizing:border-box; }
        body { font-family:'Inter','Segoe UI',sans-serif; background:#0f1117; color:#e2e8f0; min-height:100vh; display:flex; align-items:center; justify-content:center; }
        .card { background:#1a1d27; border-radius:16px; padding:40px; width:100%; max-width:400px; box-shadow:0 20px 60px rgba(0,0,0,.4); }
        .logo { text-align:center; margin-bottom:28px; }
        .logo-text { font-size:28px; font-weight:800; color:#e94560; letter-spacing:-1px; }
        .logo-sub { font-size:12px; color:#64748b; margin-top:4px; }
        h2 { font-size:18px; font-weight:600; margin-bottom:6px; }
        p { font-size:13px; color:#94a3b8; margin-bottom:24px; line-height:1.5; }
        .form-group { margin-bottom:16px; }
        label { font-size:12px; color:#94a3b8; margin-bottom:6px; display:block; }
        input { width:100%; padding:10px 14px; background:#0f1117; border:1px solid #2d3748; border-radius:8px; color:#e2e8f0; font-size:14px; outline:none; transition:border-color .2s; }
        input:focus { border-color:#e94560; }
        .btn { width:100%; padding:11px; background:#e94560; color:#fff; border:none; border-radius:8px; font-size:14px; font-weight:600; cursor:pointer; margin-top:8px; }
        .btn:hover { background:#c73652; }
        .btn-secondary { background:#2d3748; color:#e2e8f0; }
        .btn-secondary:hover { background:#374151; }
        .error { color:#f87171; font-size:12px; margin-bottom:12px; }
        .back { text-align:center; margin-top:20px; font-size:13px; color:#64748b; }
        .back a { color:#e94560; text-decoration:none; }
        .success-icon { font-size:48px; color:#e94560; text-align:center; margin-bottom:16px; }
        .success-title { font-size:20px; font-weight:700; text-align:center; margin-bottom:10px; }
        .success-msg { font-size:13px; color:#94a3b8; text-align:center; line-height:1.6; margin-bottom:28px; }
        .success-msg span { color:#e2e8f0; font-weight:500; }
    </style>
</head>
<body>
<div class="card">
    <div class="logo">
        <div class="logo-text">Acadex <span style="display:inline-block; margin-left:4px; padding:3px 9px; border-radius:999px; background:linear-gradient(135deg,#10B981,#4F46E5); color:#fff; font-size:11px; font-weight:800; letter-spacing:.5px; vertical-align:middle;">360</span></div>
        <div class="logo-sub">Digital Academy Management Platform</div>
    </div>

    @if (sent)
    {
        <div class="success-icon"><i class="fas fa-envelope-open-text"></i></div>
        <div class="success-title">@L["EmailSent"]</div>
        <div class="success-msg">
            @L["CheckEmail"]<br />
            <span>@L["ResetLinkSent"]</span> @L["LinkSentSuffix"]<br /><br />
            @L["LinkValid24h"]
        </div>
        <a href="/Auth/Login" class="btn btn-secondary" style="display:block; text-align:center; text-decoration:none;">
            <i class="fas fa-arrow-left"></i> @L["BackToLogin"]
        </a>
    }
    else
    {
        <h2>@L["ForgotPasswordTitle"]</h2>
        <p>@L["ForgotPasswordDesc"]</p>

        @if (!ViewData.ModelState.IsValid)
        {
            foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div class="error"><i class="fas fa-exclamation-circle"></i> @err.ErrorMessage</div>
            }
        }

        <form method="post">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label>@L["Email"]</label>
                <input type="email" name="email" placeholder="email@example.com" required autofocus />
            </div>
            <button type="submit" class="btn"><i class="fas fa-paper-plane"></i> @L["SendLink"]</button>
        </form>
        <div class="back"><a href="/Auth/Login"><i class="fas fa-arrow-left"></i> @L["GoBack"]</a></div>
    }
</div>
</body>
</html>
