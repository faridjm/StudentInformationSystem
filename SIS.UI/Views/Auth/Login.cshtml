@model SIS.BLL.Services.DTOs.Auth.LoginDto

@{
    ViewData["Title"] = "Daxil ol";
    Layout = null;
}

<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SIS — Daxil ol</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
            * { box-sizing: border-box; margin: 0; padding: 0; }
            body {
                background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f3460 100%);
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                font-family: 'Inter', system-ui, sans-serif;
            }
            .login-card {
                background: rgba(30,41,59,0.95);
                backdrop-filter: blur(10px);
                border: 1px solid rgba(255,255,255,0.08);
                border-radius: 16px;
                padding: 40px;
                width: 100%;
                max-width: 420px;
                box-shadow: 0 25px 50px rgba(0,0,0,0.4);
            }
            .logo-text { font-size: 28px; font-weight: 800; color: #e94560; }
            .logo-sub { font-size: 11px; color: rgba(255,255,255,0.35); letter-spacing: 1px; text-transform: uppercase; margin-bottom: 32px; margin-top: 2px; }
            h2 { color: #f1f5f9; font-weight: 700; font-size: 22px; margin-bottom: 6px; }
            .subtitle { color: rgba(255,255,255,0.4); font-size: 14px; margin-bottom: 28px; }
            .form-group { margin-bottom: 18px; }
            .form-label { display: block; color: rgba(255,255,255,0.6); font-size: 13px; margin-bottom: 6px; font-weight: 500; }
            .form-control {
                width: 100%; background: rgba(255,255,255,0.06);
                border: 1px solid rgba(255,255,255,0.1); color: #f1f5f9;
                border-radius: 10px; padding: 12px 16px; font-size: 14px;
                transition: border-color 0.2s; outline: none;
            }
            .form-control:focus { border-color: #e94560; box-shadow: 0 0 0 3px rgba(233,69,96,0.15); background: rgba(255,255,255,0.08); }
            .form-control::placeholder { color: rgba(255,255,255,0.2); }
            .form-check { display: flex; align-items: center; gap: 8px; margin-bottom: 24px; }
            .form-check-input { width: 16px; height: 16px; accent-color: #e94560; cursor: pointer; }
            .form-check-label { color: rgba(255,255,255,0.5); font-size: 13px; cursor: pointer; }
            .btn-login {
                width: 100%; background: linear-gradient(135deg, #e94560, #c62a47);
                border: none; border-radius: 10px; padding: 13px;
                font-weight: 600; font-size: 15px; color: #fff; cursor: pointer;
                transition: opacity 0.2s;
            }
            .btn-login:hover { opacity: 0.9; }
            .text-danger { color: #f87171; font-size: 12px; margin-top: 4px; display: block; }
            .validation-summary {
                background: rgba(248,113,113,0.1); border: 1px solid rgba(248,113,113,0.3);
                border-radius: 8px; padding: 10px 14px; margin-bottom: 16px;
                color: #f87171; font-size: 13px;
            }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="logo-text">SIS</div>
        <div class="logo-sub">Student Information System</div>
        <h2>Xoş gəldiniz</h2>
        <p class="subtitle">Sisteme daxil olmaq üçün məlumatlarınızı daxil edin</p>

        <form asp-action="Login" asp-controller="Auth" method="post">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="validation-summary">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

            <div class="form-group">
                <label class="form-label">Email / Tələbə kodu / Müəllim kodu</label>
                <input asp-for="Email" class="form-control" placeholder="email@sis.az və ya STU001" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Şifrə</label>
                <input asp-for="Password" class="form-control" placeholder="••••••••" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-check">
                <input asp-for="RememberMe" class="form-check-input" id="RememberMe" />
                <label class="form-check-label" for="RememberMe">Məni xatırla</label>
            </div>

            <button type="submit" class="btn-login">
                <i class="fas fa-sign-in-alt" style="margin-right:8px;"></i>Daxil ol
            </button>
        </form>
    </div>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>