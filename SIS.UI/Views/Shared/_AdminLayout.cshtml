<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Acadex 360 Admin</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="/css/acadex-theme.css" asp-append-version="true" />
</head>
<body class="admin-theme">
    <div class="sidebar-overlay" onclick="document.querySelector('.sidebar').classList.remove('open');this.classList.remove('show');"></div>

    <!-- Sidebar -->
    <nav class="sidebar">
        <div class="sidebar-logo">
            <div class="logo-text">Acadex <span style="font-size:13px; font-weight:700; padding:2px 7px; border-radius:6px; background:rgba(255,255,255,0.15); margin-left:4px; vertical-align:middle;">360</span></div>
            <div class="logo-sub">@L["AdminPanel"]</div>
        </div>

        <div class="sidebar-section">@L["Main"]</div>
        <a href="/Admin/Dashboard" class="sidebar-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
            <i class="fas fa-chart-pie"></i> @L["Dashboard"]
        </a>

        <div class="sidebar-section">@L["AcademicStructure"]</div>
        <a href="/Admin/Department" class="sidebar-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Department" ? "active" : "")">
            <i class="fas fa-building"></i> @L["Departments"]
        </a>
        <a href="/Admin/Course" class="sidebar-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Course" ? "active" : "")">
            <i class="fas fa-graduation-cap"></i> @L["CoursesProgrammes"]
        </a>
        <a href="/Admin/AcademicYear" class="sidebar-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "AcademicYear" ? "active" : "")">
            <i class="fas fa-calendar-alt"></i> @L["AcademicYearSeason"]
        </a>
        <a href="/Admin/Curriculum" class="sidebar-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Curriculum" ? "active" : "")">
            <i class="fas fa-stream"></i> @L["CurriculumTemplates"]
        </a>
        <a href="/Admin/Group" class="sidebar-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Group" ? "active" : "")">
            <i class="fas fa-users"></i> @L["Groups"]
        </a>
        <a href="/Admin/Enrollment" class="sidebar-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Enrollment" ? "active" : "")">
            <i class="fas fa-clipboard-list"></i> @L["Enrollments"]
        </a>

        <div class="sidebar-section">@L["Users"]</div>
        <a href="/Admin/Student" class="sidebar-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Student" ? "active" : "")">
            <i class="fas fa-user-graduate"></i> @L["Students"]
        </a>
        <a href="/Admin/Teacher" class="sidebar-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Teacher" ? "active" : "")">
            <i class="fas fa-chalkboard-teacher"></i> @L["Teachers"]
        </a>
        @if (User.IsInRole("SuperAdmin"))
        {
            <a href="/Admin/AdminAccess" class="sidebar-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "AdminAccess" ? "active" : "")">
                <i class="fas fa-user-shield"></i> @L["AdminAccess"]
            </a>
        }

        <div class="sidebar-section">@L["AcademicOperations"]</div>
        <a href="/Admin/Announcement" class="sidebar-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Announcement" ? "active" : "")">
            <i class="fas fa-bullhorn"></i> @L["Announcements"]
        </a>
        <a href="/Admin/OnlineLessons" class="sidebar-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "OnlineLessons" ? "active" : "")">
            <i class="fas fa-video"></i> @L["OnlineLessons"]
        </a>
        <a href="/Notifications" class="sidebar-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Notifications" ? "active" : "")">
            <i class="fas fa-bell"></i> @L["Notifications"]
        </a>

        @if (User.IsInRole("SuperAdmin"))
        {
            <div class="sidebar-section">Public Website</div>
            <a href="/PublicAdmin/Dashboard" class="sidebar-item">
                <i class="fas fa-globe"></i> PublicAdmin Panel
            </a>
        }

        @if (User.IsInRole("SuperAdmin"))
        {
            <div class="sidebar-section">@L["System"]</div>
            <a href="/Admin/SystemUsers" class="sidebar-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "SystemUsers" ? "active" : "")">
                <i class="fas fa-users-gear"></i> Sistem İstifadəçiləri
            </a>
            <a href="/Admin/AuditLogs" class="sidebar-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "AuditLogs" ? "active" : "")">
                <i class="fas fa-clipboard-list"></i> @L["AuditLogs"]
            </a>
            <a href="/Admin/Archive/Chats" class="sidebar-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Archive" ? "active" : "")">
                <i class="fas fa-box-archive"></i> @L["Archive"]
            </a>
        }

        <div class="sidebar-footer">
            <form asp-area="" asp-controller="Auth" asp-action="Logout" method="post">
                <button type="submit" class="sidebar-item w-100" style="border:none; background:none; cursor:pointer; width:100%;">
                    <i class="fas fa-sign-out-alt"></i> @L["Logout"]
                </button>
            </form>
        </div>
    </nav>

    <!-- Main -->
    <div class="main-content">
        <header class="top-navbar">
            <div style="display:flex; align-items:center; gap:10px;">
                <button type="button" class="sidebar-toggle" aria-label="Menu" onclick="document.querySelector('.sidebar').classList.toggle('open');document.querySelector('.sidebar-overlay').classList.toggle('show');"><i class="fas fa-bars"></i></button>
                <span class="page-title">@(ViewData["Title"] ?? "Dashboard")</span>
            </div>
            <div class="navbar-right">
                @await Html.PartialAsync("_LanguageSwitcher")
                @await Html.PartialAsync("_NotificationBell")
                <div class="dropdown">
                    <button class="user-btn" onclick="this.nextElementSibling.classList.toggle('show')">
                        <div class="user-avatar">@(User.Identity?.Name?.FirstOrDefault().ToString().ToUpper() ?? "A")</div>
                        <span>@User.Identity?.Name</span>
                        <i class="fas fa-chevron-down" style="font-size:10px; color:var(--text-secondary)"></i>
                    </button>
                    <div class="dropdown-menu">
                        <form asp-area="" asp-controller="Auth" asp-action="Logout" method="post">
                            <button class="dropdown-item" type="submit">
                                <i class="fas fa-sign-out-alt"></i> @L["Logout"]
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </header>

        @inject SIS.UI.Time.GlobalSimulationState SimState
        <main class="page-content">
            @if (SimState.IsActive)
            {
                <div style="background:rgba(234,179,8,0.15); border:1px solid rgba(234,179,8,0.3); color:#eab308; padding:10px 16px; border-radius:8px; margin-bottom:12px; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:8px;">
                    <div>
                        <i class="fas fa-clock"></i>
                        <strong>@L["SimulationMode"]:</strong> @L["SimulationAllUsers"] <strong>@SimState.DateDisplay</strong> @L["AcceptedAs"]
                    </div>
                    <div style="display:flex; gap:6px; align-items:center;">
                        <form method="post" action="/Simulation/Set" style="display:flex; gap:6px; align-items:center;">
                            @Html.AntiForgeryToken()
                            <input type="date" name="date" value="@SimState.DateString" style="background:var(--bg-hover); border:1px solid var(--border); color:var(--text-primary); border-radius:6px; padding:4px 8px; font-size:13px;" />
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                            <button type="submit" class="btn btn-sm btn-primary">@L["Change"]</button>
                        </form>
                        <form method="post" action="/Simulation/Clear" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                            <button type="submit" class="btn btn-sm btn-danger">@L["Close"]</button>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <div style="margin-bottom:12px;">
                    <form method="post" action="/Simulation/Set" style="display:flex; gap:6px; align-items:center;">
                        @Html.AntiForgeryToken()
                        <input type="date" name="date" style="background:var(--bg-hover); border:1px solid var(--border); color:var(--text-primary); border-radius:6px; padding:4px 8px; font-size:13px;" />
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                        <button type="submit" class="btn btn-sm btn-secondary"><i class="fas fa-clock"></i> @L["StartSimulation"]</button>
                    </form>
                </div>
            }
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success"><i class="fas fa-check-circle me-2"></i>@TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger"><i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]</div>
            }
            <script>
                (function () {
                    var ok = document.querySelector('.alert-success');
                    var err = document.querySelector('.alert-danger');
                    if (!ok && !err) return;
                    try {
                        var ctx = new (window.AudioContext || window.webkitAudioContext)();
                        var play = function () {
                            var o = ctx.createOscillator(), g = ctx.createGain();
                            o.connect(g); g.connect(ctx.destination);
                            o.type = 'sine';
                            o.frequency.value = err ? 330 : 680;
                            g.gain.setValueAtTime(0.0001, ctx.currentTime);
                            g.gain.exponentialRampToValueAtTime(0.18, ctx.currentTime + 0.02);
                            g.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 0.32);
                            o.start(); o.stop(ctx.currentTime + 0.34);
                        };
                        if (ctx.state === 'suspended') ctx.resume().then(play).catch(function () { });
                        else play();
                    } catch (e) { }
                })();
            </script>
            @RenderBody()
        </main>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.0/jquery.min.js"></script>
    <script src="/js/acadex-confirm.js" asp-append-version="true"></script>
    <script>
        // Dropdown close on outside click
        document.addEventListener('click', function(e) {
        if (!e.target.closest('.dropdown')) {
        document.querySelectorAll('.dropdown-menu').forEach(m => m.classList.remove('show'));
        }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>