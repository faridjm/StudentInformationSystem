@model SIS.BLL.Services.DTOs.OnlineLesson.OnlineLessonDto
@using Microsoft.Extensions.Configuration
@inject IConfiguration Config
@{
    Layout = ViewBag.IsTeacher == true ? "_TeacherLayout" : "_StudentLayout";
    ViewData["Title"] = Model.Title;
    var isTeacher = ViewBag.IsTeacher == true;
    var accessToken = User.FindFirst("AccessToken")?.Value ?? "";
    var apiBase = Config["ApiSettings:BaseUrl"]?.TrimEnd('/') ?? "";
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
    var currentUserName = User.Identity?.Name ?? "";
}

<style>
    /* ========================================
       ACADEX 360 — ONLINE CLASSROOM (premium UI)
       JS DOM ID-ləri toxunulmazdır.
       ======================================== */
    :root {
        --cls-bg: #0B1020;
        --cls-stage: linear-gradient(135deg, #0F172A 0%, #1E293B 50%, #0F172A 100%);
        --cls-card: #1E293B;
        --cls-card-2: #0F172A;
        --cls-border: rgba(255,255,255,0.08);
        --cls-border-soft: rgba(255,255,255,0.05);
        --cls-text: #E2E8F0;
        --cls-text-muted: #94A3B8;
        --cls-text-dim: #64748B;
        --cls-accent: #7C3AED;
        --cls-accent-2: #4F46E5;
        --cls-success: #10B981;
        --cls-danger: #EF4444;
        --cls-warning: #F59E0B;
    }

    .cls-shell { background: var(--cls-bg); border-radius: 16px; padding: 0; overflow: hidden;
        box-shadow: 0 20px 60px rgba(0,0,0,.4); border: 1px solid var(--cls-border); }

    /* HEADER */
    .cls-header { display:flex; align-items:center; gap:14px; padding:14px 20px;
        background: linear-gradient(180deg, rgba(124,58,237,.12), rgba(15,23,42,.0));
        border-bottom: 1px solid var(--cls-border); }
    .cls-h-icon { width:42px; height:42px; border-radius:11px;
        background: linear-gradient(135deg, var(--cls-accent), var(--cls-accent-2));
        display:flex; align-items:center; justify-content:center; color:#fff; font-size:18px;
        box-shadow:0 6px 18px rgba(124,58,237,.45); flex:0 0 auto; }
    .cls-h-title { font-size:18px; font-weight:800; color:#fff; margin:0; line-height:1.2; display:flex; align-items:center; gap:10px; flex-wrap:wrap; }
    .cls-h-meta { font-size:12px; color:var(--cls-text-muted); margin-top:4px; display:flex; gap:8px; flex-wrap:wrap; align-items:center; }
    .cls-h-meta i { color:var(--cls-accent); font-size:10px; }
    .cls-h-right { margin-left:auto; display:flex; gap:8px; align-items:center; flex-wrap:wrap; }
    .cls-pill { display:inline-flex; align-items:center; gap:6px; padding:5px 11px; border-radius:999px;
        font-size:11px; font-weight:700; letter-spacing:.4px; }
    .cls-pill.live { background:rgba(16,185,129,.15); color:#34D399; border:1px solid rgba(16,185,129,.3); }
    .cls-pill.live::before { content:''; width:7px; height:7px; border-radius:50%; background:#34D399; animation:cls-blink 1.5s infinite; }
    .cls-pill.session { background:rgba(255,255,255,.06); color:var(--cls-text-muted); border:1px solid var(--cls-border); }
    @@keyframes cls-blink { 0%,100% { opacity:1;} 50% { opacity:.3; } }

    /* GRID LAYOUT */
    .classroom-grid { display:grid; grid-template-columns: 1fr 340px; gap:0; height: calc(100vh - 200px); min-height:520px; background:var(--cls-bg); }

    /* VIDEO AREA */
    .video-area { display:flex; flex-direction:column; background:var(--cls-stage); overflow:hidden; min-height:0; position:relative; }

    .video-grid { flex:1; display:grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap:12px; padding:18px; overflow:auto; min-height:0;
        background-image: radial-gradient(circle at 50% 0%, rgba(124,58,237,.08), transparent 70%);
    }

    .video-tile { position:relative; background:var(--cls-card-2); border-radius:14px; aspect-ratio:16/9;
        overflow:hidden; border:1px solid var(--cls-border); transition:transform .2s, box-shadow .2s, border-color .2s; }
    .video-tile:hover { transform:translateY(-2px); box-shadow:0 10px 30px rgba(0,0,0,.4); border-color: rgba(124,58,237,.4); }
    .video-tile video { width:100%; height:100%; object-fit:cover; background:var(--cls-card-2); }
    .video-tile .name { position:absolute; bottom:10px; left:12px;
        background: rgba(15,23,42,.75); backdrop-filter: blur(10px);
        color:#fff; font-size:12px; font-weight:600; padding:5px 12px; border-radius:8px;
        border:1px solid var(--cls-border); }
    .video-tile.local .name {
        background: linear-gradient(135deg, rgba(124,58,237,.85), rgba(79,70,229,.85));
        border:none;
    }
    /* Empty state on tile (camera off) */
    .video-tile.cam-off video { display:none; }
    .video-tile .cam-off-state { display:none; position:absolute; inset:0; flex-direction:column;
        align-items:center; justify-content:center; gap:10px; color:var(--cls-text-muted); }
    .video-tile.cam-off .cam-off-state { display:flex; }

    /* Tile böyüt düyməsi */
    .tile-expand { position:absolute; top:10px; left:12px;
        background:rgba(15,23,42,.7); backdrop-filter:blur(8px);
        color:#fff; border:1px solid var(--cls-border); border-radius:8px;
        width:32px; height:32px; cursor:pointer; opacity:0; transition:opacity .15s, background .15s; font-size:13px; }
    .video-tile:hover .tile-expand, .screen-stage:hover .tile-expand { opacity:1; }
    .tile-expand:hover { background:rgba(124,58,237,.5); }

    /* SCREEN SHARE STAGE */
    .screen-stage { position:relative; flex:1; background:#000; min-height:0; display:none;
        border-bottom: 2px solid var(--cls-success); }
    .screen-stage video { width:100%; height:100%; object-fit:contain; background:#000; }
    .screen-stage-badge { position:absolute; top:14px; left:16px; display:inline-flex; align-items:center; gap:8px;
        background: linear-gradient(135deg, rgba(16,185,129,.95), rgba(5,150,105,.95));
        color:#fff; font-size:13px; font-weight:700; padding:7px 14px; border-radius:10px;
        box-shadow:0 8px 20px rgba(0,0,0,.4);
        backdrop-filter:blur(12px); border:1px solid rgba(255,255,255,.15); }
    .screen-stage .tile-expand { top:auto; bottom:14px; right:16px; left:auto; width:38px; height:38px; opacity:.95; }

    /* Stage active: video grid horizontal strip */
    .video-area.has-stage .screen-stage { display:block; }
    .video-area.has-stage .video-grid { flex:0 0 auto; height:140px; display:flex; gap:10px; padding:12px 18px;
        overflow-x:auto; overflow-y:hidden; background:var(--cls-card-2); border-top:1px solid var(--cls-border); }
    .video-area.has-stage .video-grid .video-tile { flex:0 0 220px; aspect-ratio:16/9; }
    .video-area.has-stage .video-grid::-webkit-scrollbar { height:6px; }
    .video-area.has-stage .video-grid::-webkit-scrollbar-thumb { background:var(--cls-border); border-radius:3px; }

    .video-tile .share-tag { position:absolute; top:10px; right:12px;
        background:linear-gradient(135deg, var(--cls-success), #059669); color:#fff;
        font-size:10px; font-weight:800; padding:3px 9px; border-radius:6px; display:none;
        box-shadow:0 4px 12px rgba(16,185,129,.4); letter-spacing:.5px; }
    .video-tile.sharing .share-tag { display:inline-block; }

    /* Empty stage hint when nothing is going on */
    .stage-empty { position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center;
        gap:14px; color:var(--cls-text-muted); pointer-events:none; padding:30px; text-align:center; }
    .stage-empty-icon { width:84px; height:84px; border-radius:50%;
        background:rgba(124,58,237,.12); display:flex; align-items:center; justify-content:center;
        color:var(--cls-accent); font-size:30px; border:1px solid rgba(124,58,237,.2); }
    .stage-empty-title { color:#E2E8F0; font-size:16px; font-weight:700; }
    .stage-empty-sub { font-size:13px; color:var(--cls-text-muted); max-width:380px; line-height:1.5; }

    /* TOOLBAR (bottom floating controls) */
    .toolbar { display:flex; gap:8px; padding:14px 20px; align-items:center;
        background: linear-gradient(180deg, rgba(15,23,42,0), rgba(15,23,42,.85));
        flex:0 0 auto; z-index:20; flex-wrap:wrap; justify-content:center;
        border-top:1px solid var(--cls-border-soft); }
    .tb-btn { background:rgba(255,255,255,.08); color:#fff; border:1px solid var(--cls-border);
        border-radius:50%; width:46px; height:46px; cursor:pointer; transition:all .15s;
        flex:0 0 auto; display:inline-flex; align-items:center; justify-content:center; font-size:15px;
        box-shadow:0 4px 12px rgba(0,0,0,.2); position:relative; }
    .tb-btn:hover { background:rgba(255,255,255,.18); transform:translateY(-2px);
        box-shadow:0 6px 18px rgba(0,0,0,.3); }
    .tb-btn:active { transform:translateY(0); }
    .tb-btn.off { background:linear-gradient(135deg,#DC2626,#B91C1C); border-color:#7F1D1D; }
    .tb-btn.sharing { background:linear-gradient(135deg, var(--cls-success), #059669); border-color:#047857;
        box-shadow:0 0 0 3px rgba(16,185,129,.2); }
    .tb-btn.leave { background:linear-gradient(135deg,#DC2626,#B91C1C); border-color:#7F1D1D;
        width:auto; min-width:46px; padding:0 18px; border-radius:23px; font-weight:700; font-size:13px; gap:8px; }
    .tb-btn.end { background:linear-gradient(135deg, var(--cls-accent), var(--cls-accent-2)); border-color:transparent;
        width:auto; min-width:46px; padding:0 18px; border-radius:23px; font-weight:700; font-size:13px; gap:8px; }
    .tb-btn[data-tooltip]::after { content: attr(data-tooltip); position:absolute; bottom:calc(100% + 6px); left:50%;
        transform:translateX(-50%); background:#0F172A; color:#fff; padding:4px 10px; border-radius:6px;
        font-size:11px; white-space:nowrap; opacity:0; pointer-events:none; transition:opacity .15s;
        border:1px solid var(--cls-border); }
    .tb-btn[data-tooltip]:hover::after { opacity:1; }

    .tb-divider { width:1px; height:30px; background:var(--cls-border); margin:0 4px; flex:0 0 auto; }

    /* SIDE PANEL */
    .side-panel { display:flex; flex-direction:column; background:var(--cls-card-2);
        border-left:1px solid var(--cls-border); overflow:hidden; }
    .side-tabs { display:flex; border-bottom:1px solid var(--cls-border);
        background:rgba(255,255,255,.02); padding:6px 6px 0; gap:4px; }
    .side-tabs button { flex:1; padding:10px 12px; border:none; background:transparent;
        color:var(--cls-text-muted); font-size:13px; font-weight:600; cursor:pointer;
        border-radius:10px 10px 0 0; display:inline-flex; align-items:center; justify-content:center; gap:6px;
        transition:all .15s; }
    .side-tabs button:hover { color:#fff; background:rgba(255,255,255,.04); }
    .side-tabs button.active { color:#fff; background:var(--cls-card);
        border-bottom:2px solid var(--cls-accent); }
    .side-tabs button .pill { background:rgba(124,58,237,.18); color:#A78BFA; border-radius:999px;
        padding:1px 8px; font-size:11px; font-weight:700; }

    .side-content { flex:1; overflow:auto; padding:14px; background:var(--cls-card); }
    .side-content::-webkit-scrollbar { width:6px; }
    .side-content::-webkit-scrollbar-thumb { background:var(--cls-border); border-radius:3px; }

    /* Participants */
    .participant-row { display:flex; align-items:center; gap:10px; padding:9px 10px; border-radius:10px;
        margin-bottom:4px; transition:background .15s; }
    .participant-row:hover { background:rgba(255,255,255,.04); }
    .participant-avatar { width:32px; height:32px; border-radius:50%;
        background:linear-gradient(135deg, var(--cls-accent), var(--cls-accent-2));
        color:#fff; display:flex; align-items:center; justify-content:center;
        font-size:12px; font-weight:700; flex:0 0 auto;
        text-transform:uppercase; box-shadow:0 4px 10px rgba(124,58,237,.35); }
    .participant-dot { width:8px; height:8px; border-radius:50%; background:var(--cls-success); flex:0 0 auto;
        box-shadow:0 0 0 3px rgba(16,185,129,.18); }
    .participant-dot.muted { background:#94A3B8; box-shadow:0 0 0 3px rgba(148,163,184,.18); }
    .participant-name { flex:1; font-size:13px; font-weight:500; color:#E2E8F0;
        overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .participant-role { font-size:10px; font-weight:700; padding:2px 8px; border-radius:999px;
        flex:0 0 auto; letter-spacing:.3px; }
    .participant-role.teacher { background:rgba(124,58,237,.2); color:#C4B5FD; border:1px solid rgba(124,58,237,.3); }
    .participant-role.student { background:rgba(16,185,129,.15); color:#6EE7B7; border:1px solid rgba(16,185,129,.25); }
    .participant-mic { font-size:12px; color:var(--cls-text-muted); flex:0 0 auto; }
    .participant-mic.muted { color:#EF4444; }
    .p-mute-btn { background:rgba(239,68,68,.1); border:1px solid rgba(239,68,68,.25); color:#FCA5A5;
        border-radius:7px; padding:4px 10px; font-size:11px; font-weight:600; cursor:pointer;
        transition:all .15s; flex:0 0 auto; }
    .p-mute-btn:hover { background:#EF4444; color:#fff; border-color:#EF4444; }

    /* Chat */
    .chat-msgs { flex:1; overflow:auto; padding:14px; display:flex; flex-direction:column; gap:8px;
        background:var(--cls-card); }
    .chat-msgs::-webkit-scrollbar { width:6px; }
    .chat-msgs::-webkit-scrollbar-thumb { background:var(--cls-border); border-radius:3px; }
    .chat-msg { padding:9px 12px; border-radius:12px; background:rgba(255,255,255,.04);
        font-size:13px; color:#E2E8F0; border:1px solid var(--cls-border-soft); animation:cls-msg-in .2s ease; }
    @@keyframes cls-msg-in { from { opacity:0; transform:translateY(6px); } to { opacity:1; transform:none; } }
    .chat-msg .meta { font-size:10.5px; color:var(--cls-text-muted); margin-bottom:3px;
        display:flex; justify-content:space-between; gap:8px; font-weight:600; }
    .chat-msg .meta span:first-child { color:#A78BFA; }
    .chat-input { display:flex; gap:8px; padding:12px; border-top:1px solid var(--cls-border);
        background:var(--cls-card-2); }
    .chat-input input { flex:1; padding:9px 14px; border:1px solid var(--cls-border); border-radius:10px;
        background:rgba(255,255,255,.04); color:#E2E8F0; font-size:13px; transition:border-color .15s; }
    .chat-input input:focus { outline:none; border-color:var(--cls-accent); background:rgba(255,255,255,.08); }
    .chat-input input::placeholder { color:var(--cls-text-dim); }
    .chat-input button { padding:0 18px; background:linear-gradient(135deg, var(--cls-accent), var(--cls-accent-2));
        color:#fff; border:none; border-radius:10px; cursor:pointer; font-size:13px; transition:transform .1s;
        box-shadow:0 4px 12px rgba(124,58,237,.35); }
    .chat-input button:hover { transform:translateY(-1px); }

    /* Empty states */
    .cls-empty { padding:40px 16px; text-align:center; color:var(--cls-text-muted); }
    .cls-empty i { font-size:34px; opacity:.4; margin-bottom:12px; display:block; }
    .cls-empty .t { color:#E2E8F0; font-size:14px; font-weight:600; margin-bottom:4px; }
    .cls-empty .s { font-size:12px; }

    /* ENDED OVERLAY */
    .ended-overlay { position:fixed; inset:0; background:rgba(0,0,0,.92); z-index:10000;
        display:flex; align-items:center; justify-content:center; flex-direction:column; gap:18px; color:#fff;
        backdrop-filter:blur(8px); }
    .ended-overlay i { font-size:64px; color:#EF4444; }
    .ended-overlay div { font-size:20px; font-weight:700; }

    /* FULLSCREEN MODAL */
    .fs-modal { position:fixed; inset:0; background:rgba(0,0,0,.94); z-index:10001;
        display:none; align-items:center; justify-content:center; flex-direction:column;
        backdrop-filter:blur(10px); }
    .fs-modal.open { display:flex; }
    .fs-modal video { max-width:96vw; max-height:88vh; object-fit:contain; background:#000;
        border-radius:14px; box-shadow:0 30px 80px rgba(0,0,0,.6);
        border:1px solid var(--cls-border); }
    .fs-modal-close { position:absolute; top:22px; right:26px;
        background:rgba(255,255,255,.12); color:#fff; border:1px solid var(--cls-border);
        border-radius:12px; width:48px; height:48px; cursor:pointer; font-size:18px;
        backdrop-filter:blur(10px); transition:background .15s; }
    .fs-modal-close:hover { background:rgba(239,68,68,.6); border-color:#EF4444; }
    .fs-modal-title { position:absolute; top:26px; left:28px; color:#fff; font-size:14px; font-weight:600;
        opacity:.85; background:rgba(15,23,42,.6); padding:6px 14px; border-radius:8px;
        backdrop-filter:blur(10px); border:1px solid var(--cls-border); }

    /* TOAST */
    .cls-toast { position:fixed; bottom:30px; left:50%; transform:translateX(-50%);
        background:#0F172A; color:#fff; padding:14px 22px; border-radius:12px; font-size:13.5px; z-index:10002;
        box-shadow:0 15px 35px rgba(0,0,0,.5); display:none; align-items:center; gap:12px;
        border:1px solid var(--cls-border); }
    .cls-toast i { color:var(--cls-accent); font-size:16px; }
    .cls-toast.show { display:flex; animation:toastIn .25s ease; }
    @@keyframes toastIn { from { opacity:0; transform:translate(-50%, 12px); } to { opacity:1; transform:translate(-50%, 0); } }

    /* PRE-JOIN LOBBY */
    .prejoin-overlay { position:fixed; inset:0;
        background:linear-gradient(135deg, #0F172A 0%, #1E1B4B 50%, #0F172A 100%);
        z-index:10005; display:flex; align-items:center; justify-content:center; padding:20px; }
    .prejoin-overlay.hidden { display:none; }
    .prejoin-overlay::before { content:''; position:absolute; inset:0;
        background-image: radial-gradient(circle at 20% 30%, rgba(124,58,237,.18), transparent 50%),
                          radial-gradient(circle at 80% 70%, rgba(16,185,129,.12), transparent 50%);
        pointer-events:none; }
    .prejoin-card { position:relative; background:rgba(15,23,42,.85); backdrop-filter:blur(20px);
        border-radius:20px; width:min(94vw,500px); padding:28px; box-shadow:0 30px 80px rgba(0,0,0,.6);
        border:1px solid var(--cls-border); }
    .prejoin-title { font-size:18px; font-weight:800; display:flex; align-items:center; gap:10px; color:#fff; }
    .prejoin-sub { font-size:13px; color:var(--cls-text-muted); margin:6px 0 18px; }
    .prejoin-preview { position:relative; background:#000; border-radius:14px; aspect-ratio:16/9;
        overflow:hidden; margin-bottom:16px; border:1px solid var(--cls-border); }
    .prejoin-preview video { width:100%; height:100%; object-fit:cover; transform:scaleX(-1); }
    .prejoin-cam-off { position:absolute; inset:0; display:none; flex-direction:column;
        align-items:center; justify-content:center; gap:10px; color:var(--cls-text-muted); }
    .prejoin-cam-off i { font-size:38px; }
    .prejoin-cam-off span { font-size:13px; }
    .prejoin-preview.cam-off video { display:none; }
    .prejoin-preview.cam-off .prejoin-cam-off { display:flex; }
    .prejoin-toggles { display:flex; gap:10px; margin-bottom:14px; }
    .prejoin-toggle { flex:1; display:flex; align-items:center; justify-content:center; gap:8px;
        padding:11px; border-radius:11px; border:1px solid var(--cls-border);
        background:rgba(255,255,255,.04); color:#E2E8F0; font-size:13px; font-weight:600; cursor:pointer;
        transition:all .15s; }
    .prejoin-toggle.on { border-color:rgba(124,58,237,.5); color:#C4B5FD;
        background:rgba(124,58,237,.12); }
    .prejoin-toggle.off { background:rgba(239,68,68,.15); border-color:rgba(239,68,68,.4); color:#FCA5A5; }
    .prejoin-hint { font-size:12px; color:var(--cls-text-muted); margin-bottom:18px;
        display:flex; gap:8px; align-items:flex-start; padding:10px 12px;
        background:rgba(255,255,255,.04); border-radius:10px; border:1px solid var(--cls-border-soft); }
    .prejoin-hint i { color:var(--cls-accent); margin-top:2px; }
    .prejoin-actions { display:flex; gap:10px; }
    .prejoin-actions .btn { flex:1; padding:12px; border-radius:11px; border:none;
        font-size:14px; font-weight:700; cursor:pointer; transition:transform .1s; }
    .prejoin-actions .btn-primary {
        background:linear-gradient(135deg, var(--cls-accent), var(--cls-accent-2)); color:#fff;
        box-shadow:0 8px 22px rgba(124,58,237,.4); }
    .prejoin-actions .btn:hover { transform:translateY(-1px); }
    .prejoin-actions .btn:not(.btn-primary) { background:rgba(255,255,255,.08); color:#E2E8F0;
        border:1px solid var(--cls-border); }

    @@media (max-width: 1024px) {
        .classroom-grid { grid-template-columns: 1fr; height:auto; }
        .video-area { min-height:55vh; }
        .side-panel { border-left:none; border-top:1px solid var(--cls-border); min-height:380px; }
        .cls-h-right .cls-pill.session { display:none; }
    }
</style>

<!-- Pre-join lobby -->
<div id="preJoinOverlay" class="prejoin-overlay">
    <div class="prejoin-card">
        <div class="prejoin-title"><i class="fas fa-video" style="color:#A78BFA;"></i> Dərsə qoşulmağa hazırsınız?</div>
        <div class="prejoin-sub">@Model.Title · @Model.GroupName</div>

        <div class="prejoin-preview">
            <video id="preJoinVideo" autoplay muted playsinline></video>
            <div class="prejoin-cam-off" id="preJoinCamOff"><i class="fas fa-video-slash"></i><span>Kamera bağlıdır</span></div>
        </div>

        <div class="prejoin-toggles">
            <button type="button" class="prejoin-toggle on" id="preMic">
                <i class="fas fa-microphone"></i> <span>Mikrofon</span>
            </button>
            <button type="button" class="prejoin-toggle on" id="preCam">
                <i class="fas fa-video"></i> <span>Kamera</span>
            </button>
        </div>

        <div class="prejoin-hint" id="preJoinHint">
            <i class="fas fa-circle-info"></i>
            <span>Mikrofon və kameranı qoşulduqdan sonra da idarə edə bilərsiniz.</span>
        </div>

        <div class="prejoin-actions">
            <button type="button" class="btn btn-primary" id="preJoinBtn">
                <i class="fas fa-right-to-bracket"></i> İndi qoşul
            </button>
            <button type="button" class="btn" id="preJoinNoMedia">
                Media olmadan qoşul
            </button>
        </div>
    </div>
</div>

<!-- Classroom shell -->
<div class="cls-shell">
    <!-- Header -->
    <div class="cls-header">
        <div class="cls-h-icon"><i class="fas fa-chalkboard-user"></i></div>
        <div style="min-width:0; flex:1;">
            <h2 class="cls-h-title">
                @Model.Title
                <span class="cls-pill live">LIVE</span>
            </h2>
            <div class="cls-h-meta">
                <span><i class="fas fa-circle"></i> @Model.GroupName</span>
                <span style="opacity:.5;">·</span>
                <span>@Model.CourseName</span>
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <span style="opacity:.5;">·</span>
                    <span>@Model.Description</span>
                }
            </div>
        </div>
        <div class="cls-h-right">
            <span class="cls-pill session">
                <i class="fas fa-list-ol" style="color:#94A3B8; font-size:9px;"></i>
                Sessiya #@Model.SessionNumber · @Model.SessionDate.ToString("dd.MM.yyyy")
            </span>
        </div>
    </div>

    <!-- Grid -->
    <div class="classroom-grid" id="classroomRoot"
         data-lesson-id="@Model.Id"
         data-is-teacher="@(isTeacher ? "true" : "false")"
         data-api-base="@apiBase"
         data-token="@accessToken"
         data-user-id="@currentUserId"
         data-user-name="@currentUserName">
        <!-- Video area -->
        <div class="video-area">
            <!-- Screen share stage -->
            <div class="screen-stage" id="screenStage">
                <video id="screenStageVideo" autoplay playsinline></video>
                <div class="screen-stage-badge">
                    <i class="fas fa-desktop"></i>
                    <span><strong id="screenSharerName">İştirakçı</strong> ekranını paylaşır</span>
                </div>
                <button class="tile-expand" type="button" title="Böyüt"
                        onclick="window.acadexClassroomExpand && window.acadexClassroomExpand('screenStageVideo', document.getElementById('screenSharerName')?.textContent)">
                    <i class="fas fa-expand"></i>
                </button>
            </div>

            <!-- Video tiles grid -->
            <div class="video-grid" id="videoGrid">
                <div class="video-tile local" id="localTile">
                    <video id="localVideo" autoplay muted playsinline></video>
                    <div class="cam-off-state">
                        <i class="fas fa-video-slash" style="font-size:30px;"></i>
                        <span style="font-size:12px;">Kamera bağlıdır</span>
                    </div>
                    <div class="name">Siz · @currentUserName</div>
                    <button class="tile-expand" type="button" title="Böyüt"
                            onclick="window.acadexClassroomExpand && window.acadexClassroomExpand('localVideo', 'Siz')">
                        <i class="fas fa-expand"></i>
                    </button>
                </div>
            </div>

            <!-- Floating bottom controls -->
            <div class="toolbar">
                <button class="tb-btn" id="btnMic" data-tooltip="Mikrofon"><i class="fas fa-microphone"></i></button>
                <button class="tb-btn" id="btnCam" data-tooltip="Kamera"><i class="fas fa-video"></i></button>
                <button class="tb-btn" id="btnScreen" data-tooltip="Ekranı paylaş"><i class="fas fa-desktop"></i></button>
                @if (isTeacher)
                {
                    <div class="tb-divider"></div>
                    <button class="tb-btn" id="btnMuteAll" data-tooltip="Hamısını sustur"><i class="fas fa-microphone-slash"></i></button>
                }
                <div class="tb-divider"></div>
                <button class="tb-btn leave" id="btnLeave" data-tooltip="Tərk et">
                    <i class="fas fa-sign-out-alt"></i> <span style="display:none;">Tərk et</span>
                </button>
                @if (isTeacher)
                {
                    <button class="tb-btn end" id="btnEnd" data-tooltip="Dərsi bitir">
                        <i class="fas fa-stop"></i> <span style="display:none;">Bitir</span>
                    </button>
                }
            </div>
        </div>

        <!-- Side panel -->
        <div class="side-panel">
            <div class="side-tabs">
                <button class="active" data-tab="participants">
                    <i class="fas fa-users"></i> İştirakçılar
                    <span class="pill" id="partCount">1</span>
                </button>
                <button data-tab="chat"><i class="fas fa-comment"></i> Söhbət</button>
            </div>
            <div class="side-content" id="sideParticipants">
                <div id="participantList">
                    <div class="participant-row">
                        <div class="participant-avatar">@(currentUserName?.FirstOrDefault().ToString().ToUpper() ?? "S")</div>
                        <span class="participant-name">@currentUserName (siz)</span>
                        <span class="participant-role @(isTeacher ? "teacher" : "student")">@(isTeacher ? "Müəllim" : "Tələbə")</span>
                        <span class="participant-mic"><i class="fas fa-microphone"></i></span>
                    </div>
                </div>
            </div>
            <div class="side-content" id="sideChat" style="display:none; padding:0; flex-direction:column;">
                <div class="chat-msgs" id="chatMsgs"></div>
                <div class="chat-input">
                    <input id="chatInput" type="text" maxlength="2000" placeholder="Mesaj yaz..." />
                    <button id="chatSend" type="button"><i class="fas fa-paper-plane"></i></button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Ended overlay -->
<div id="endedOverlay" class="ended-overlay" style="display:none;">
    <i class="fas fa-stop-circle"></i>
    <div>Online dərs bitdi</div>
    <a href="javascript:history.back()" class="btn btn-primary" style="padding:10px 22px; background:linear-gradient(135deg,#7C3AED,#4F46E5); color:#fff; border:none; border-radius:10px; font-weight:700; text-decoration:none;">Geri qayıt</a>
</div>

<!-- Fullscreen modal -->
<div id="fsModal" class="fs-modal">
    <div class="fs-modal-title" id="fsModalTitle"></div>
    <button class="fs-modal-close" id="fsModalClose" type="button" title="Kiçilt (ESC)"><i class="fas fa-times"></i></button>
    <video id="fsModalVideo" autoplay playsinline></video>
</div>

<!-- Toast -->
<div id="clsToast" class="cls-toast"><i class="fas fa-circle-info"></i> <span id="clsToastText"></span></div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="~/js/online-classroom.js" asp-append-version="true"></script>
}
