@model int
@if (Model > 0)
{
    <span style="position:absolute; right:12px; top:50%; transform:translateY(-50%); background:#e94560; color:#fff; font-size:10px; font-weight:700; min-width:18px; height:18px; border-radius:9px; display:flex; align-items:center; justify-content:center; padding:0 5px;">@Model</span>
}
