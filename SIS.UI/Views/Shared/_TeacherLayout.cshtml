<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @inject IHtmlLocalizer<SIS.UI.SharedResource> L
    <title>@ViewData["Title"] — Acadex 360 @L["TeacherPanel"].Value</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="/css/acadex-theme.css" asp-append-version="true" />
</head>
<body class="teacher-theme">
    <div class="sidebar-overlay" onclick="document.querySelector('.sidebar').classList.remove('open');this.classList.remove('show');"></div>

    <nav class="sidebar">
        <div class="sidebar-logo">
            <div class="logo-text">Acadex <span style="font-size:13px; font-weight:700; padding:2px 7px; border-radius:6px; background:rgba(255,255,255,0.15); margin-left:4px; vertical-align:middle;">360</span></div>
            <div class="logo-sub">@L["TeacherPanel"]</div>
        </div>

        <div class="sidebar-section">@L["Main"]</div>
        <a href="/Teacher/Dashboard" class="sidebar-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
            <i class="fas fa-chart-pie"></i> @L["Dashboard"]
        </a>

        <div class="sidebar-section">@L["Teaching"]</div>
        <a href="/Teacher/Courses" class="sidebar-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Courses" ? "active" : "")">
            <i class="fas fa-layer-group"></i> @L["MyGroups"]
        </a>
        <a href="/Teacher/Assessments" class="sidebar-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Assessments" ? "active" : "")">
            <i class="fas fa-tasks"></i> @L["Assessment"]
        </a>
        <a href="/Teacher/Assignments" class="sidebar-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Assignments" ? "active" : "")">
            <i class="fas fa-file-alt"></i> @L["Assignments"]
        </a>
        <a href="/Teacher/Quizzes" class="sidebar-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Quizzes" ? "active" : "")">
            <i class="fas fa-clipboard-question"></i> Quizlər
        </a>
        <div class="sidebar-section">@L["Schedule"]</div>
        <a href="/Teacher/Schedule" class="sidebar-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Schedule" ? "active" : "")">
            <i class="fas fa-calendar-alt"></i> @L["ClassSchedule"]
        </a>

        <div class="sidebar-section">@L["Communication"]</div>
        <a href="/Teacher/Messages" class="sidebar-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Messages" ? "active" : "")" style="position:relative;">
            <i class="fas fa-comments"></i> @L["Messages"]
            @await Component.InvokeAsync("UnreadChatCount")
        </a>

        <div class="sidebar-footer">
            <a href="/Teacher/Profile/ChangePassword" class="sidebar-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Profile" ? "active" : "")">
                <i class="fas fa-key"></i> @L["ChangePassword"]
            </a>
            <form asp-area="" asp-controller="Auth" asp-action="Logout" method="post">
                <button type="submit" class="sidebar-item w-100" style="border:none; background:none; cursor:pointer; width:100%;">
                    <i class="fas fa-sign-out-alt"></i> @L["Logout"]
                </button>
            </form>
        </div>
    </nav>

    <div class="main-content">
        <header class="top-navbar">
            <div style="display:flex; align-items:center; gap:10px;">
                <button type="button" class="sidebar-toggle" aria-label="Menu" onclick="document.querySelector('.sidebar').classList.toggle('open');document.querySelector('.sidebar-overlay').classList.toggle('show');"><i class="fas fa-bars"></i></button>
                <span class="page-title">@(ViewData["Title"] ?? "Dashboard")</span>
            </div>
            <div class="navbar-right">
                @await Html.PartialAsync("_LanguageSwitcher")
                @await Html.PartialAsync("_NotificationBell")
                <div class="dropdown">
                    <button class="user-btn" onclick="this.nextElementSibling.classList.toggle('show')">
                        <div class="user-avatar">@(User.Identity?.Name?.FirstOrDefault().ToString().ToUpper() ?? "T")</div>
                        <span>@User.Identity?.Name</span>
                        <i class="fas fa-chevron-down" style="font-size:10px; color:var(--text-secondary)"></i>
                    </button>
                    <div class="dropdown-menu">
                        <form asp-area="" asp-controller="Auth" asp-action="Logout" method="post">
                            <button class="dropdown-item" type="submit">
                                <i class="fas fa-sign-out-alt"></i> @L["Logout"]
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </header>

        @inject SIS.UI.Time.GlobalSimulationState SimState
        <main class="page-content">
            @if (SimState.IsActive)
            {
                <div style="background:rgba(234,179,8,0.15); border:1px solid rgba(234,179,8,0.3); color:#eab308; padding:10px 16px; border-radius:8px; margin-bottom:12px; display:flex; align-items:center; gap:8px;">
                    <i class="fas fa-clock"></i>
                    <strong>@L["SimulationMode"]:</strong> @L["SimulationToday"] <strong>@SimState.DateDisplay</strong> @L["AcceptedAs"]
                </div>
            }

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success"><i class="fas fa-check-circle"></i> @TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger"><i class="fas fa-exclamation-circle"></i> @TempData["Error"]</div>
            }
            <script>
                (function () {
                    var ok = document.querySelector('.alert-success');
                    var err = document.querySelector('.alert-danger');
                    if (!ok && !err) return;
                    try {
                        var ctx = new (window.AudioContext || window.webkitAudioContext)();
                        var play = function () {
                            var o = ctx.createOscillator(), g = ctx.createGain();
                            o.connect(g); g.connect(ctx.destination);
                            o.type = 'sine';
                            o.frequency.value = err ? 330 : 680;
                            g.gain.setValueAtTime(0.0001, ctx.currentTime);
                            g.gain.exponentialRampToValueAtTime(0.18, ctx.currentTime + 0.02);
                            g.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 0.32);
                            o.start(); o.stop(ctx.currentTime + 0.34);
                        };
                        if (ctx.state === 'suspended') ctx.resume().then(play).catch(function () { });
                        else play();
                    } catch (e) { }
                })();
            </script>
            @RenderBody()
        </main>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.0/jquery.min.js"></script>
    <script src="/js/acadex-confirm.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('click', function(e) {
        if (!e.target.closest('.dropdown')) {
        document.querySelectorAll('.dropdown-menu').forEach(m => m.classList.remove('show'));
        }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>